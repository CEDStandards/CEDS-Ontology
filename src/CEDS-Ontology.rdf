		<skos:definition>The credential related to early childhood education or development held by a person.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000829">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000829</dc:identifier>
		<rdfs:label>Has Early Childhood Program Enrollment Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200093" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000829" />
		<skos:notation>hasEarlyChildhoodProgramEnrollmentType</skos:notation>
