		<skos:notation>FundsTransferAmount</skos:notation>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000470">
