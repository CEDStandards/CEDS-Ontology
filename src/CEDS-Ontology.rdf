		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<skos:notation>hasRelatedCredentialAward</skos:notation>
		<dc:description>The relationship between two credential awards, generally used to capture extensions to an award (e.g., An endorsement for a teaching license).</dc:description>
		<skos:definition>The relationship between two credential awards, generally used to capture extensions to an award (e.g., An endorsement for a teaching license).</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Corrected the property range from Credential Criteria Course (C200415) to Credential Award (C200079) </changeDescription>
