			<editHistoryEntry> 	
				<changeDescription>Changes to option set</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The purpose of the work in the context of education.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002028">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002028</dc:identifier>
		<rdfs:label>Has Learning Resource Identification System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200230" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002028" />
		<skos:notation>hasLearningResourceIdentificationSystem</skos:notation>
		<dc:description>A coding scheme that is used for identification and record-keeping purposes to refer to a learning resource.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A coding scheme that is used for identification and record-keeping purposes to refer to a learning resource.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000923">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000923</dc:identifier>
		<rdfs:label>Has Learning Resource Intended End User Role</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000923" />
		<skos:notation>hasLearningResourceIntendedEndUserRole</skos:notation>
		<dc:description>The individual or group for which the resource was produced.</dc:description>
		<skos:definition>The individual or group for which the resource was produced.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001565">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001565</dc:identifier>
		<rdfs:label>Has Learning Resource Interaction Mode</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001565" />
		<skos:notation>hasLearningResourceInteractionMode</skos:notation>
		<dc:description>The primary type of interaction, synchronous or asynchronous, defined for the learning resource.</dc:description>
		<skos:definition>The primary type of interaction, synchronous or asynchronous, defined for the learning resource.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000927">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000927</dc:identifier>
		<rdfs:label>Has Learning Resource Interactivity Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000927" />
		<skos:notation>hasLearningResourceInteractivityType</skos:notation>
		<dc:description>The predominate mode of learning supported by the learning resource. Acceptable values are active, expositive, or mixed.</dc:description>
		<skos:definition>The predominate mode of learning supported by the learning resource. Acceptable values are active, expositive, or mixed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000919">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000919</dc:identifier>
		<rdfs:label>Has Learning Resource Language</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000317" />
		<skos:notation>hasLearningResourceLanguage</skos:notation>
		<dc:description>The primary language of the resource.</dc:description>
		<rdfs:comment>The CEDS ISO 639-2 Language Code option set comes from the &lt;a href="http://www.loc.gov/standards/iso639-2/langhome.html"&gt;ISO 639-2 standard&lt;/a&gt;, the character encoding in ISO 8859-1 download.  Discontinued codes from the ISO standard are not included in the CEDS list.&lt;BR/&gt;Note: For accessible resources LRMI uses language codes from the IETF BCP 47 standard which also refers to ISO 639. (Equivalent of the AfA languageOfAdaptation property.)</rdfs:comment>
		<skos:definition>The primary language of the resource.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated usage note.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updating to reflect the latest version of the ISO 639-2 standard.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated to reflect the latest version of the ISO 639-2 standard.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001399">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001399</dc:identifier>
		<rdfs:label>Has Learning Resource Media Feature Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200232" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001399" />
		<skos:notation>hasLearningResourceMediaFeatureType</skos:notation>
		<dc:description>Accessible content features included with the learning resource.</dc:description>
		<rdfs:comment>Options derive primarily from IMS Global's Access for All (AfA) specification, specifically: AdaptationTypeRequired.Type/adaptationRequest.</rdfs:comment>
		<skos:definition>Accessible content features included with the learning resource.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600468">
