	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000242129395">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school that focuses primarily on serving the educational needs of students with disabilities (IDEA) and which adapts curriculum, materials, or instruction for these students.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000242129395</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000242" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Special Education School</rdfs:label>
		<skos:definition>A school that focuses primarily on serving the educational needs of students with disabilities (IDEA) and which adapts curriculum, materials, or instruction for these students.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000242"/>
		<skos:notation>Special</skos:notation>
		<skos:prefLabel>Special Education School</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000242129396">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school that focuses primarily on providing secondary students with an occupationally relevant or career�related curriculum, including formal preparation for technical or professional occupations.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000242129396</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000242" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Career and Technical Education School</rdfs:label>
		<skos:definition>A school that focuses primarily on providing secondary students with an occupationally relevant or career�related curriculum, including formal preparation for technical or professional occupations.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000242" />
		<skos:notation>CareerAndTechnical</skos:notation>
		<skos:prefLabel>Career and Technical Education School</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000242129397">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school that addresses the needs of students that typically cannot be met in a regular school program and is designed to meet the needs of students with academic difficulties, students with discipline problems, or both students with academic difficulties and discipline problems.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000242129397</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000242" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Alternative Education School</rdfs:label>
		<skos:definition>A school that addresses the needs of students that typically cannot be met in a regular school program and is designed to meet the needs of students with academic difficulties, students with discipline problems, or both students with academic difficulties and discipline problems.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000242" />
		<skos:notation>Alternative</skos:notation>
		<skos:prefLabel>Alternative Education School</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000242129398">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The permitted value "reportable program" is available for SEAs that have data to report to EDFacts at the school level that the SEA has determined does not meet the definition of a public elementary/secondary school.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000242129398</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000242" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Reportable Program</rdfs:label>
		<skos:definition>The permitted value "reportable program" is available for SEAs that have data to report to EDFacts at the school level that the SEA has determined does not meet the definition of a public elementary/secondary school.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000242" />
		<skos:notation>Reportable</skos:notation>
		<skos:prefLabel>Reportable Program</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001467172951">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The role/relationship type assigned to an organization, institution, or agency responsible for transporting the student to the physical location of the school or facility in which educational services are delivered.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001467172951</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001467" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Transportation</rdfs:label>
		<skos:definition>The role/relationship type assigned to an organization, institution, or agency responsible for transporting the student to the physical location of the school or facility in which educational services are delivered.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001467" />
		<skos:notation>Transportation</skos:notation>
		<skos:prefLabel>Transportation</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001467172952">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The role/relationship type assigned to an organization, institution, or agency responsible for creating and maintaining the student's IEP, a written instructional plan for students with disabilities designated as special education students under the Individuals with Disabilities Education Act (IDEA-Part B) which includes: 1) a statement of present levels of educational performance of a child; 2) a statement of annual goals including short-term instructional objectives; 3) a statement of specific education and related services to be provided and the extent to which the child will be able to participate in regular educational programs; 4) a projected date for initiation and anticipated duration of services; and 5) appropriate objectives, criteria and evaluation procedures and schedules for determining, on at least an annual basis, whether instructional objectives are being achieved.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001467172952</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001467" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Individualized education program (IEP)</rdfs:label>
		<skos:definition>The role/relationship type assigned to an organization, institution, or agency responsible for creating and maintaining the student's IEP, a written instructional plan for students with disabilities designated as special education students under the Individuals with Disabilities Education Act (IDEA-Part B) which includes: 1) a statement of present levels of educational performance of a child; 2) a statement of annual goals including short-term instructional objectives; 3) a statement of specific education and related services to be provided and the extent to which the child will be able to participate in regular educational programs; 4) a projected date for initiation and anticipated duration of services; and 5) appropriate objectives, criteria and evaluation procedures and schedules for determining, on at least an annual basis, whether instructional objectives are being achieved.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001467"/>
		<skos:notation>IndividualizedEducationProgram</skos:notation>
		<skos:prefLabel>Individualized education program (IEP)</skos:prefLabel>
	</owl:NamedIndividual>
