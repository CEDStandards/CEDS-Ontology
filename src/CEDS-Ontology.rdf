	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200399">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200399</dc:identifier>
