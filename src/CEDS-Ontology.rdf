	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162917">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Greek for Young Learners (prior-to-secondary) courses provide instruction at multiple grade levels in Greek and may apply to a range of consecutive grades. These courses prepare students to communicate authentically in Greek by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on concrete topics. These courses introduce the relationships among the products, practices, and perspectives of Greek-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162917</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Greek for Young Learners (prior-to-secondary)</rdfs:label>
		<skos:definition>Greek for Young Learners (prior-to-secondary) courses provide instruction at multiple grade levels in Greek and may apply to a range of consecutive grades. These courses prepare students to communicate authentically in Greek by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on concrete topics. These courses introduce the relationships among the products, practices, and perspectives of Greek-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24300</skos:notation>
		<skos:prefLabel>Greek for Young Learners (prior-to-secondary)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162918">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Greek Immersion (prior-to-secondary) courses engage students in developmentally appropriate activities to acquire literacy in Greek and grade-specific content using Greek as the language of instruction. Greek Immersion courses prepare students to communicate authentically in Greek by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information about standards-based academic content and incorporate the relationships among the products, practices, and perspectives of Greek-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162918</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Greek Immersion (prior-to-secondary)</rdfs:label>
		<skos:definition>Greek Immersion (prior-to-secondary) courses engage students in developmentally appropriate activities to acquire literacy in Greek and grade-specific content using Greek as the language of instruction. Greek Immersion courses prepare students to communicate authentically in Greek by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information about standards-based academic content and incorporate the relationships among the products, practices, and perspectives of Greek-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24301</skos:notation>
		<skos:prefLabel>Greek Immersion (prior-to-secondary)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162919">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Designed to introduce students to Greek language and culture, Greek I courses prepare students to communicate authentically in Greek by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on a variety of topics. They introduce the relationships among the products, practices, and perspectives of Greek-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162919</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Greek I</rdfs:label>
		<skos:definition>Designed to introduce students to Greek language and culture, Greek I courses prepare students to communicate authentically in Greek by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on a variety of topics. They introduce the relationships among the products, practices, and perspectives of Greek-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24302</skos:notation>
