		<editHistory rdf:parseType="Collection">
			<editHistoryEntry> 	
				<changeDescription>Added Has Individualized Program as an object property of Program Participation (C200407)</changeDescription> 	
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/945</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001504">
