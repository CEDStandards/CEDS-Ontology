	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001160">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001160</dc:identifier>
		<rdfs:label>Has Virtual Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200110" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200199" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200329" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001160" />
		<skos:notation>hasVirtualIndicator</skos:notation>
		<dc:description>An indication that a childcare, early education, or early learning program, school, institution, program, or course section focuses primarily on instruction in which children and teachers are separated by time and/or location and interact through the use of computers and/or telecommunications technology.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs. Changed definition of element to support other domains.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that a childcare, early education, or early learning program, school, institution, program, or course section focuses primarily on instruction in which children and teachers are separated by time and/or location and interact through the use of computers and/or telecommunications technology.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000027">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000027</dc:identifier>
		<rdfs:label>Has Course Section Assessment Reporting Method</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200075" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000027" />
		<skos:notation>hasCourseSectionAssessmentReportingMethod</skos:notation>
		<dc:description>The method that the instructor of the course uses to report the performance and achievement of all students. It may be a qualitative method such as individualized teacher comments or a quantitative method such as a letter or a numerical grade. In some cases, more than one type of reporting method may be used.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new option to the existing option set.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Class Section Assessment Reporting Method.  Definition updated.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The method that the instructor of the course uses to report the performance and achievement of all students. It may be a qualitative method such as individualized teacher comments or a quantitative method such as a letter or a numerical grade. In some cases, more than one type of reporting method may be used.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000976">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000976</dc:identifier>
		<rdfs:label>Has Course Section Enrollment Status Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000976" />
		<skos:notation>hasCourseSectionEnrollmentStatusType</skos:notation>
		<dc:description>The status related to a student enrollment in an instance of a course.</dc:description>
		<rdfs:comment>Enrollment statuses may overlap, for example at one point in time a student may be both pre-registered and wait listed for enrollment in a course, the start dates may be different and the end dates may be the same as the start date for "enrolled" status when the student moves off the wait list.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Class Section Enrollment Status Type.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The status related to a student enrollment in an instance of a course.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000650">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000650</dc:identifier>
		<rdfs:label>Has Course Section Entry Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000650" />
		<skos:notation>hasCourseSectionEntryType</skos:notation>
		<dc:description>The process by which a student enters a school (Course Section) during a given academic session.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Class Section Entry Type.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The process by which a student enters a school (Course Section) during a given academic session.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000652">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000652</dc:identifier>
