		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001154</dc:identifier>
		<rdfs:label>Competency Definition Text Complexity Minimum Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
