				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600291">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600291</dc:identifier>
		<rdfs:label>Has Rubric Criterion</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200068" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200353" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200048" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200354" />
		<skos:notation>hasRubricCriterion</skos:notation>
		<dc:description>References a single criterion by which one aspect of an entity's competence may be evaluated.</dc:description>
		<skos:definition>References a single criterion by which one aspect of an entity's competence may be evaluated.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000877">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000877</dc:identifier>
		<rdfs:label>Has Competency Set Completion Criteria</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200068" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000877" />
		<skos:notation>hasCompetencySetCompletionCriteria</skos:notation>
		<dc:description>The criteria for the set of competencies that represent completion or partial completion of a unit, course, program, degree, certification, or other achievement/award. Specifies whether completion requires achievement of all items in the set or some number of items.</dc:description>
		<rdfs:comment>The criteria may be 'all' competencies in the set or 'at-least' # of competencies. Sets may be nested, e.g. all in subset A and 3 of 5 from subset B.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES context to support K12 Implementation.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added option set.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The criteria for the set of competencies that represent completion or partial completion of a unit, course, program, degree, certification, or other achievement/award. Specifies whether completion requires achievement of all items in the set or some number of items.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001923">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001923</dc:identifier>
		<rdfs:label>Has Comprehensive Support and Improvement Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200250" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001923" />
		<skos:notation>hasComprehensiveSupportAndImprovementStatus</skos:notation>
		<dc:description>The designation given to a school by the state for comprehensive support and improvement as part of its statewide system of annual meaningful differentiation.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added element to support EDFacts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The designation given to a school by the state for comprehensive support and improvement as part of its statewide system of annual meaningful differentiation.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000429">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000429</dc:identifier>
		<rdfs:label>Has Continuation of Services Reason</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000429" />
		<skos:notation>hasContinuationOfServicesReason</skos:notation>
		<dc:description>Reason why the student is being served under the continuation of services provision of the MEP.</dc:description>
		<skos:definition>Reason why the student is being served under the continuation of services provision of the MEP.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000737">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000737</dc:identifier>
		<rdfs:label>Has Contract Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200405"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000737"/>
		<skos:notation>hasContractType</skos:notation>
		<dc:description>The type of employment contract used by an institution.</dc:description>
		<rdfs:comment>Option set defined in IPEDS</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of employment contract used by an institution.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000048">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000048</dc:identifier>
		<rdfs:label>Has Control of Institution</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200110" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200329" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000048" />
		<skos:notation>hasControlOfInstitution</skos:notation>
		<dc:description>A classification of whether a postsecondary institution is operated by publicly elected or appointed officials (public control) or by privately elected or appointed officials and derives its major source of funds from private sources (private control).</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A classification of whether a postsecondary institution is operated by publicly elected or appointed officials (public control) or by privately elected or appointed officials and derives its major source of funds from private sources (private control).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000813">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000813</dc:identifier>
		<rdfs:label>Has Early Learning Core Knowledge Area</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200071" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000813" />
		<skos:notation>hasEarlyLearningCoreKnowledgeArea</skos:notation>
		<dc:description>A description of the core knowledge areas addressed by Early Learning professional development.</dc:description>
		<skos:definition>A description of the core knowledge areas addressed by Early Learning professional development.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001296">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001296</dc:identifier>
		<rdfs:label>Has Correctional Education Facility Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200316" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001296" />
		<skos:notation>hasCorrectionalEducationFacilityType</skos:notation>
		<dc:description>The type of facility in which an inmate receives correctional education services.</dc:description>
		<skos:definition>The type of facility in which an inmate receives correctional education services.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001297">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001297</dc:identifier>
		<rdfs:label>Has Correctional Education Reentry Services Participation Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200407" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001297" />
		<skos:notation>hasCorrectionalEducationReentryServicesParticipationIndicator</skos:notation>
		<dc:description>An indication of whether an adult correctional education student who receives instructional services (e.g., life skills, cognitive restructuring, etc.) to support reentry into society.</dc:description>
		<skos:definition>An indication of whether an adult correctional education student who receives instructional services (e.g., life skills, cognitive restructuring, etc.) to support reentry into society.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000049">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000049</dc:identifier>
		<rdfs:label>Has Corrective Action Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200200" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000049" />
		<skos:notation>hasCorrectiveActionType</skos:notation>
		<dc:description>The types of corrective actions under ESEA as amended.</dc:description>
		<skos:definition>The types of corrective actions under ESEA as amended.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001507">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001507</dc:identifier>
		<rdfs:label>Has Child Outcomes Summary Rating A</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200098" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001507" />
		<skos:notation>hasCOSRatingA</skos:notation>
		<dc:description>Child's level of functioning in positive social-emotional skills (including social relationships).</dc:description>
		<skos:definition>Child's level of functioning in positive social-emotional skills (including social relationships).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001508">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001508</dc:identifier>
		<rdfs:label>Has Child Outcomes Summary Rating B</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200098" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001508" />
		<skos:notation>hasCOSRatingB</skos:notation>
		<dc:description>Child's level of functioning in the acquisition and use of knowledge and skills (including early language/communication.</dc:description>
		<skos:definition>Child's level of functioning in the acquisition and use of knowledge and skills (including early language/communication.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001509">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001509</dc:identifier>
		<rdfs:label>Has Child Outcomes Summary Rating C</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200098" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<skos:notation>hasCOSRatingC</skos:notation>
		<dc:description>Child's level of functioning in the use of appropriate behaviors to meet their needs.</dc:description>
		<skos:definition>Child's level of functioning in the use of appropriate behaviors to meet their needs.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000050">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000050</dc:identifier>
		<rdfs:label>Has Country Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200238" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200278" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000050" />
		<skos:notation>hasCountryCode</skos:notation>
		<dc:description>The unique two character International Organization for Standardization (ISO) code for the country in which an address is located.</dc:description>
		<rdfs:comment>The CEDS Country Code option set comes from the &lt;a href="http://www.iso.org/iso/country_codes.htm"&gt;ISO 3166 standard&lt;/a&gt;, the short name for Officially assigned codes.   Discontinued codes from the ISO standard are not included in the CEDS list.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updating to reflect the latest version of the ISO 3166 standard.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The unique two character International Organization for Standardization (ISO) code for the country in which an address is located.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000051">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000051</dc:identifier>
		<rdfs:label>Has Country of Birth Code</rdfs:label>
		<dc:description>The unique two digit International Organization for Standardization (ISO) code for the country in which a person is born.</dc:description>
		<skos:definition>The unique two digit International Organization for Standardization (ISO) code for the country in which a person is born.</skos:definition>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200278"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000050"/>
		<skos:notation>hasCountryOfBirthCode</skos:notation>
		<rdfs:comment>The CEDS Country Code option set comes from the &lt;a href="http://www.iso.org/iso/country_codes.htm"&gt;ISO 3166 standard&lt;/a&gt;, the short name for Officially assigned codes.   Discontinued codes from the ISO standard are not included in the CEDS list.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updating to reflect the latest version of the ISO 3166 standard.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Element applied to additional DES contexts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001209">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001209</dc:identifier>
		<rdfs:label>Has County ANSI Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200238" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>hasCountyANSICode</skos:notation>
		<dc:description>County code as defined for the identification of counties and equivalent areas of the United States, Puerto Rico, and the insular areas as established by the American National Standards Institute (ANSI) Inter-National Committee for Information Technology Standards (INCITS) in specification BSR INCITS 31-200x or more current updates. See https://www.census.gov/library/reference/code-lists/ansi.html#par_statelist.</dc:description>
		<minLength>5</minLength>
		<maxLength>5</maxLength>
		<textFormat>Integer</textFormat>
		<skos:definition>County code as defined for the identification of counties and equivalent areas of the United States, Puerto Rico, and the insular areas as established by the American National Standards Institute (ANSI) Inter-National Committee for Information Technology Standards (INCITS) in specification BSR INCITS 31-200x or more current updates. See https://www.census.gov/library/reference/code-lists/ansi.html#par_statelist.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Definition updated</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Corrected broken census.gov URL in definition. Element applied to additional DES contexts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600443">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600443</dc:identifier>
		<rdfs:label>Has Career And Technical Course</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200090" />
		<skos:notation>hasCareerAndTechnicalCourse</skos:notation>
		<dc:description>References the organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time (e.g., a semester or two-week workshop) to an individual or group of students (e.g., a class).</dc:description>
		<skos:definition>References the organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time (e.g., a semester or two-week workshop) to an individual or group of students (e.g., a class).</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600352">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600352</dc:identifier>
		<rdfs:label>Has Course</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200311" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200415" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<skos:notation>hasCourse</skos:notation>
		<dc:description>References the organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time.</dc:description>
		<skos:definition>References the organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600350">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600350</dc:identifier>
		<rdfs:label>Has Course Funding Source</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200073" />
		<skos:notation>hasCourseFundingSource</skos:notation>
		<dc:description>References the relationship between course and the financial account that would be used to fund the course.</dc:description>
		<skos:definition>References the relationship between course and the financial account that would be used to fund the course.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001994">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001994</dc:identifier>
		<rdfs:label>Has Course Level Approval Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001994" />
		<skos:notation>hasCourseLevelApprovalIndicator</skos:notation>
		<dc:description>An indication that there are school or program developed requirements for student participation in the course.</dc:description>
		<rdfs:comment>This element is used in conjunction with Course Level Characteristic.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that there are school or program developed requirements for student participation in the course.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001299">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001299</dc:identifier>
		<rdfs:label>Has Course Academic Grade Status Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001299" />
		<skos:notation>hasCourseAcademicGradeStatusCode</skos:notation>
		<dc:description>Additional information regarding the context of the given grade.</dc:description>
		<skos:definition>Additional information regarding the context of the given grade.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001301">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001301</dc:identifier>
		<rdfs:label>Has Course Applicable Education Level</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002175"/>
		<skos:notation>hasCourseApplicableEducationLevel</skos:notation>
		<dc:description>The education level, grade level or primary instructional level at which a course is intended.</dc:description>
		<rdfs:comment>This element is repeatable for most use cases.  Examples: (1.) SCED identifiers may specify a grade span of two or more grades.  (2) A postsecondary course designed to qualify a student for an associates degree and professional certification could be repeated with both of those options.</rdfs:comment>
		<skos:definition>The education level, grade level or primary instructional level at which a course is intended.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000056">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000056</dc:identifier>
		<rdfs:label>Has Course Code System</rdfs:label>
