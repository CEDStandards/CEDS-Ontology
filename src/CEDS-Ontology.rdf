		<rdfs:label>Student Course Section Enrollment</rdfs:label>
		<skos:notation>StudentCourseSectionEnrollment</skos:notation>
		<dc:description>A specific type of Membership that represents a student’s enrollment in a specific course section, characterized by properties related to their participation and performance over a defined period of time.</dc:description>
		<skos:definition>A specific type of Membership that represents a student’s enrollment in a specific course section, characterized by properties related to their participation and performance over a defined period of time.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200375">
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200407"/>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600559"/>
