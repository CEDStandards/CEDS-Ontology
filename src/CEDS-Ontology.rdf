	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001592">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001592</dc:identifier>
		<rdfs:label>Early Learning Enrollment Application Verification Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200101" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>EarlyLearningEnrollmentApplicationVerificationDate</skos:notation>
		<dc:description>Date the required document was verified for the enrollment application</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>Date the required document was verified for the enrollment application</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001593">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001593</dc:identifier>
		<rdfs:label>Early Learning Enrollment Application Document Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200101" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>EarlyLearningEnrollmentApplicationDocumentIdentifier</skos:notation>
		<dc:description>Identifier for an enrollment application document record.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Identifier for an enrollment application document record.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001594">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001594</dc:identifier>
		<rdfs:label>Early Learning Enrollment Application Document Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200101" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>EarlyLearningEnrollmentApplicationDocumentName</skos:notation>
		<dc:description>Document name for an enrollment application document record.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Document name for an enrollment application document record.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001595">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001595</dc:identifier>
		<rdfs:label>Early Learning Enrollment Application Document Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200101" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>EarlyLearningEnrollmentApplicationDocumentType</skos:notation>
		<dc:description>Document type for an enrollment application document record.</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Document type for an enrollment application document record.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001597">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001597</dc:identifier>
		<rdfs:label>Early Learning Application Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200101" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>EarlyLearningApplicationIdentifier</skos:notation>
		<dc:description>Identifier for the application for enrollment or direct services filled out on behalf of a child</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Identifier for the application for enrollment or direct services filled out on behalf of a child</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001600">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001600</dc:identifier>
		<rdfs:label>Early Learning Enrollment Application Verification Reason Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200101" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>EarlyLearningEnrollmentApplicationVerificationReasonType</skos:notation>
		<dc:description>Identifies the reason for verification of enrollment application information</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Identifies the reason for verification of enrollment application information</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001627">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001627</dc:identifier>
		<rdfs:label>Site Preference Rank</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200101" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>SitePreferenceRank</skos:notation>
		<dc:description>The applicant preference that the family has for the program sites.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The applicant preference that the family has for the program sites.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001364">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001364</dc:identifier>
		<rdfs:label>IDEA Part C to Part B Notification Opt Out Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200102" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>IDEAPartCToPartBNotificationOptOutDate</skos:notation>
		<dc:description>The date that parents of a child potentially eligible for Part B preschool services opt out of the impending notification to the local education agency.</dc:description>
