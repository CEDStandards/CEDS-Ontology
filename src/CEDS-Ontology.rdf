	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000599">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000599</dc:identifier>
		<rdfs:label>Has Absent Attendance Category</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200351" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>hasAbsentAttendanceCategory</skos:notation>
		<dc:description> The category that describes how the student spends his or her time not physically present on school grounds and not participating in instruction or instruction-related activities at an approved off-grounds location.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set definitions based on Forum document.</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition> The category that describes how the student spends his or her time not physically present on school grounds and not participating in instruction or instruction-related activities at an approved off-grounds location.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000002">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000002</dc:identifier>
		<rdfs:label>Has Academic Award Level Conferred</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200335" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000002" />
		<skos:notation>hasAcademicAwardLevelConferred</skos:notation>
		<dc:description>An indicator of the category of award conferred by a college, university, or other postsecondary education institution as official recognition for the successful completion of a program of study.   </dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Both name and definition have been modified.</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indicator of the category of award conferred by a college, university, or other postsecondary education institution as official recognition for the successful completion of a program of study.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001666">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001666</dc:identifier>
		<rdfs:label>Has Academic Award Prerequisite Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200335" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001666" />
		<skos:notation>hasAcademicAwardPrerequisiteType</skos:notation>
		<dc:description>Prerequisite conditions for earning an academic award.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Based on suggestion from PESC COMMON CREDENTIAL draft standard., change source: PESC</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Prerequisite conditions for earning an academic award.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000004">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000004</dc:identifier>
		<rdfs:label>Has Academic Honors Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200209" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000004" />
		<skos:notation>hasAcademicHonorsType</skos:notation>
		<dc:description>A designation of the type of academic distinctions earned by or awarded to the student.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added option for National Technical Education Honor Society</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A designation of the type of academic distinctions earned by or awarded to the student.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000740">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000740</dc:identifier>
		<rdfs:label>Has Academic Rank</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200334" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000740" />
		<skos:notation>hasAcademicRank</skos:notation>
		<dc:description>The academic rank of staff whose primary responsibility is instruction, research, and/or public service.  Institutions without standard academic ranks should code staff whose primary responsibility is instruction, research, and/or public service as "No Academic Rank."</dc:description>
		<rdfs:comment>Element definition and option set defined in IPEDS.  Adjunct is not included since it can be determined from a combination of the elements Instructional Staff Faculty Tenure Status and Full-time Status.</rdfs:comment>
		<skos:definition>The academic rank of staff whose primary responsibility is instruction, research, and/or public service. Institutions without standard academic ranks should code staff whose primary responsibility is instruction, research, and/or public service as "No Academic Rank."</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000727">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000727</dc:identifier>
		<rdfs:label>Has Academic Term Designator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200245" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200336" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000727" />
		<skos:notation>hasAcademicTermDesignator</skos:notation>
		<dc:description>The academic term for which the data apply.</dc:description>
		<rdfs:comment>Needs to be used in combination with Predominant Calendar System element in order to determine if the option set is referring to a semester, quarter, or some other term length.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The academic term for which the data apply.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002088">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002088</dc:identifier>
		<rdfs:label>Has Accessible Format Issued Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200158" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002088" />
		<skos:notation>hasAccessibleFormatIssuedIndicator</skos:notation>
		<dc:description>An indication that the student was issued an accessible format according to their IEP or 504 Plan.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that the student was issued an accessible format according to their IEP or 504 Plan.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002092">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002092</dc:identifier>
		<rdfs:label>Has Accessible Format Required Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200158" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002092" />
		<skos:notation>hasAccessibleFormatRequiredIndicator</skos:notation>
		<dc:description>An indication that the student requires an accessible format according to their IEP or 504 Plan.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that the student requires an accessible format according to their IEP or 504 Plan.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002089">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002089</dc:identifier>
		<rdfs:label>Has Accessible Format Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200158" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002089" />
		<skos:notation>hasAccessibleFormatType</skos:notation>
		<dc:description>An alternative manner or form that gives an eligible person access to the work when the copy or phonorecord in the accessible format is used exclusively by the eligible person to permit him or her to have access as feasibly and comfortably as a person without such disability (20 U.S.C. � 121(d)(1)).</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An alternative manner or form that gives an eligible person access to the work when the copy or phonorecord in the accessible format is used exclusively by the eligible person to permit him or her to have access as feasibly and comfortably as a person without such disability (20 U.S.C. � 121(d)(1)).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001277">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001277</dc:identifier>
		<rdfs:label>Has Accommodations Needed Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200285" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001277" />
		<skos:notation>hasAccommodationsNeededType</skos:notation>
		<dc:description>Codes identifying the set of health accommodations.</dc:description>
		<skos:definition>Codes identifying the set of health accommodations.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000385">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000385</dc:identifier>
		<rdfs:label>Has Accessibility Feature Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200012" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200159" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000385" />
		<skos:notation>hasAccessibilityFeatureType</skos:notation>
		<dc:description>The type of design elements or functionalities integrated into products, services, or environments to ensure equitable access for all individuals, aiming to eliminate barriers and facilitate ease of use.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Changed element name, defintion, added new DES location, new options, deprecated existing options.</changeDescription> 	
				<changeVersion>13</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of design elements or functionalities integrated into products, services, or environments to ensure equitable access for all individuals, aiming to eliminate barriers and facilitate ease of use.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000982">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000982</dc:identifier>
		<rdfs:label>Has Accreditation Agency</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200240" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000982" />
		<skos:notation>hasAccreditationAgency</skos:notation>
		<dc:description>The agency that accredited a program.</dc:description>
		<rdfs:comment>Organization Name may be used with Organization Type='Accrediting Organization' when Accreditation Agency is set to 'Other Accreditation Agency.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added "Other" to option set.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The agency that accredited a program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001528">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001528</dc:identifier>
		<rdfs:label>Has Activity Time Measurement Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200211" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001528" />
		<skos:notation>hasActivityTimeMeasurementType</skos:notation>
		<dc:description>The type of measurement for the amount of time the student participated in the events and procedures of an activity, such as a co-curricular or extra-curricular activity that is offered at an education institution.</dc:description>
		<skos:definition>The type of measurement for the amount of time the student participated in the events and procedures of an activity, such as a co-curricular or extra-curricular activity that is offered at an education institution.</skos:definition>
