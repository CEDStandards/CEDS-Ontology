				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The designation given to a school by the state for targeted support and improvement as part of its statewide system of annual meaningful differentiation.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000774">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000774</dc:identifier>
