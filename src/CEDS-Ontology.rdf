		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24566</skos:notation>
		<skos:prefLabel>IB Language B (Vietnamese), Middle Years Program</skos:prefLabel>
