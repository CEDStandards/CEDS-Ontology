		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000347</dc:identifier>
		<rdfs:label>Has Employment Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200405" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000347" />
