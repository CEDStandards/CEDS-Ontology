	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000316151872">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The language specified by the related Language Code is the language the person's other language proficiency.</dc:description>
