		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200140" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilitySiteIdentifier</skos:notation>
		<dc:description>The lot and square number, or equivalent unique municipal number identification, of a parcel of land.</dc:description>
		<maxLength>20</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The lot and square number, or equivalent unique municipal number identification, of a parcel of land.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001856">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001856</dc:identifier>
		<rdfs:label>Building Hours of Public Use Per Week</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200141" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>BuildingHoursOfPublicUsePerWeek</skos:notation>
		<dc:description>The number of hours that all or part of a building is used for purposes other than general education by the community or other organizations.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The number of hours that all or part of a building is used for purposes other than general education by the community or other organizations.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001857">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001857</dc:identifier>
		<rdfs:label>Building Net Area of Instructional Space</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200141" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>BuildingNetAreaOfInstructionalSpace</skos:notation>
		<dc:description>The area of space directly used for instruction excluding circulation, administration, student services, and building support.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The area of space directly used for instruction excluding circulation, administration, student services, and building support.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001858">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001858</dc:identifier>
		<rdfs:label>Building Number of Teaching Stations</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200141" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>BuildingNumberOfTeachingStations</skos:notation>
		<dc:description>The number of teaching stations, as defined by how many spaces have, or could have, a teacher assigned to them for classroom instruction.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The number of teaching stations, as defined by how many spaces have, or could have, a teacher assigned to them for classroom instruction.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001859">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001859</dc:identifier>
		<rdfs:label>Building Public Use Policy Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200141" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>BuildingPublicUsePolicyDescription</skos:notation>
		<dc:description>A description of the policy that enables the community or other organizations to use all or part of a building for purposes other than general education.</dc:description>
		<maxLength>80</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the policy that enables the community or other organizations to use all or part of a building for purposes other than general education.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001904">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001904</dc:identifier>
		<rdfs:label>Facility Enrollment Capacity</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200141" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>FacilityEnrollmentCapacity</skos:notation>
		<dc:description>The maximum number of age appropriate students who can be enrolled in a facility such that the district's programmatic, operational, and student/teacher work load requirements are met.</dc:description>
		<rdfs:comment>This element will be phased out in version 12. It is being replaced by Enrollment Capacity.</rdfs:comment>
		<textFormat>Integer</textFormat>
		<skos:definition>The maximum number of age appropriate students who can be enrolled in a facility such that the district's programmatic, operational, and student/teacher work load requirements are met.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added Usage Note.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002012">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002012</dc:identifier>
		<rdfs:label>Enrollment Capacity</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200141" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200249" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>EnrollmentCapacity</skos:notation>
		<dc:description>Maximum number of age-appropriate students who can be enrolled.</dc:description>
		<rdfs:comment>Enrollment capacity can be collected at a variety of levels, such as classroom, grade, school, and facility.</rdfs:comment>
		<textFormat>Integer</textFormat>
		<skos:definition>Maximum number of age-appropriate students who can be enrolled.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001346">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001346</dc:identifier>
		<rdfs:label>Financial Account Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200142" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FinancialAccountDescription</skos:notation>
		<dc:description>The description for the financial account in an organization's accounting system.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The description for the financial account in an organization's accounting system.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed definition and added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001348">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001348</dc:identifier>
		<rdfs:label>Financial Account Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200142" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FinancialAccountName</skos:notation>
		<dc:description>The name given to the financial account in an organization's accounting system.</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name given to the financial account in an organization's accounting system.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed definition and added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001554">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001554</dc:identifier>
		<rdfs:label>Financial Account Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200142" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FinancialAccountNumber</skos:notation>
		<dc:description>A number given to a financial account within a local source accounting system. The number may be a concatenation of a standard  prefix for the type of account with digits added that have specific meaning within the local system.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A number given to a financial account within a local source accounting system. The number may be a concatenation of a standard  prefix for the type of account with digits added that have specific meaning within the local system.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001556">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001556</dc:identifier>
		<rdfs:label>Financial Expenditure Project Reporting Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200142" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>FinancialExpenditureProjectReportingCode</skos:notation>
		<dc:description>The project/reporting code permits organizations to accumulate expenditures to meet a variety of specialized reporting requirements at the local, state, and federal levels. It is a three-digit code with the format 00X. The first two digits identify the particular funding source, authority, or expenditure purpose for which a special record or report is required. The third digit is available to identify particular projects and the fiscal year of the appropriation within that funding source. Each classification is presented by a code range followed by a description.</dc:description>
		<rdfs:comment>Based on the following code conventions specified in the NCES Handbook &lt;a href="http://nces.ed.gov/pubs2015/fin_acct/chapter6_7.asp"&gt;"Financial Accounting for Local and State School Systems: 2014 Edition"&lt;/a&gt;:&lt;BR/&gt;&lt;BR/&gt;010 to 190 Local Projects. Expenditures that require specialized reporting and are funded from local sources. &lt;BR/&gt;&lt;BR/&gt;200 to 390 State Projects. Expenditures that require specialized reporting for categorically funded state programs.&lt;BR/&gt;&lt;BR/&gt;400 to 990 Federal Projects. Expenditures that require specialized reporting to the federal government directly or through the state.&lt;BR/&gt;&lt;BR/&gt;1000 Noncategorical. Expenditures that do not require specialized reporting.</rdfs:comment>
		<textFormat>Numeric</textFormat>
		<skos:definition>The project/reporting code permits organizations to accumulate expenditures to meet a variety of specialized reporting requirements at the local, state, and federal levels. It is a three-digit code with the format 00X. The first two digits identify the particular funding source, authority, or expenditure purpose for which a special record or report is required. The third digit is available to identify particular projects and the fiscal year of the appropriation within that funding source. Each classification is presented by a code range followed by a description.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name, technical name, and definition. Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001645">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001645</dc:identifier>
		<rdfs:label>Financial Account Program Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200143" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FinancialAccountProgramName</skos:notation>
		<dc:description>The name given to the program area in an organization's accounting system.</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name given to the program area in an organization's accounting system.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed definition. Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001646">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001646</dc:identifier>
		<rdfs:label>Financial Account Program Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200143" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FinancialAccountProgramNumber</skos:notation>
		<dc:description>A number given to a program area within an organization's accounting system.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A number given to a program area within an organization's accounting system.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed definition. Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001611">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001611</dc:identifier>
		<rdfs:label>Financial Aid Year Designator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200144" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200145" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FinancialAidYearDesignator</skos:notation>
		<dc:description>The school year for which the student's financial aid application and award data apply.  Generally, this is the 12-month period from July 1 to June 30.</dc:description>
		<minLength>9</minLength>
		<maxLength>9</maxLength>
		<textFormat>YYYY-YYYY</textFormat>
		<skos:definition>The school year for which the student's financial aid application and award data apply.  Generally, this is the 12-month period from July 1 to June 30.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000112">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000112</dc:identifier>
		<rdfs:label>Financial Aid Award Amount</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200145" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>FinancialAidAwardAmount</skos:notation>
		<dc:description>The amount of financial aid awarded to a person for the term/year.</dc:description>
		<rdfs:comment>Linked to financial aid award type.   &lt;BR/&gt;Note:  For any given individual this cluster of fields may be repeated multiple times.</rdfs:comment>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The amount of financial aid awarded to a person for the term/year.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000903">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000903</dc:identifier>
		<rdfs:label>Goal Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200146" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>GoalDescription</skos:notation>
		<dc:description>A statement that describes the desired outcomes.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A statement that describes the desired outcomes.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Removed 300 character maximum restriction per Special Education Data Model (SEDM) recommendation</changeDescription> 	
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/977</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry> 			
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES context to support K12 Implementation.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001165">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001165</dc:identifier>
		<rdfs:label>Goal Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200146" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>GoalStartDate</skos:notation>
		<dc:description>The date on which the goal becomes active.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the goal becomes active.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001166">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001166</dc:identifier>
		<rdfs:label>Goal End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200146" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>GoalEndDate</skos:notation>
		<dc:description>The date on which the goal expires or has been achieved.</dc:description>
		<rdfs:comment>For federal reporting use cases some codes are required to be reported and others are not. All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the goal expires or has been achieved.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000902">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000902</dc:identifier>
		<rdfs:label>Goal Success Criteria</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200147" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>GoalSuccessCriteria</skos:notation>
		<dc:description>One or more statements that describes the criteria used by teachers and students to check for attainment of a goal.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>One or more statements that describes the criteria used by teachers and students to check for attainment of a goal.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES context to support K12 Implementation.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001695">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001695</dc:identifier>
		<rdfs:label>Goal Measurement Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200147" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>GoalMeasurementDescription</skos:notation>
		<dc:description>The procedures and/or instruments that will be used to measure achievement of a goal or short-term objective.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The procedures and/or instruments that will be used to measure achievement of a goal or short-term objective.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001696">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001696</dc:identifier>
		<rdfs:label>Goal Measurement Schedule</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200147" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>GoalMeasurementSchedule</skos:notation>
		<dc:description>Frequency of evaluation of progress toward meeting the goal or short-term objective.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Frequency of evaluation of progress toward meeting the goal or short-term objective.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001691">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001691</dc:identifier>
		<rdfs:label>Goal Measurement Criterion Accuracy Percent</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200148" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>GoalMeasurementCriterionAccuracyPercent</skos:notation>
		<dc:description>The percent of correct results that will be considered to represent successful achievement of a goal.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>1</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The percent of correct results that will be considered to represent successful achievement of a goal.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001692">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001692</dc:identifier>
		<rdfs:label>Goal Measurement Criterion Attempts Count</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200148" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>GoalMeasurementCriterionAttemptsCount</skos:notation>
		<dc:description>The number of attempts representing a completed trial for assessing achievement of a goal.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The number of attempts representing a completed trial for assessing achievement of a goal.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001693">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001693</dc:identifier>
		<rdfs:label>Goal Measurement Criterion Metric</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200148" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>GoalMeasurementCriterionMetric</skos:notation>
		<dc:description>A metric used for evaluating achievement of a goal.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A metric used for evaluating achievement of a goal.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES context to support K12 Implementation.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
