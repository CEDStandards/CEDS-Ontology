	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001755127811">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A secondary school that: 1) addresses needs of students which cannot typically be met in a regular school; 2) provides nontraditional education; and 3) falls outside of the categories of regular, magnet/special program emphasis, or career and technical education.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001755127811</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Alternative/Non-Traditional School</rdfs:label>
		<skos:definition>A secondary school that: 1) addresses needs of students which cannot typically be met in a regular school; 2) provides nontraditional education; and 3) falls outside of the categories of regular, magnet/special program emphasis, or career and technical education.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<skos:notation>NonTraditional</skos:notation>
		<skos:prefLabel>Alternative/Non-Traditional School</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001755127812">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An organization such as a college or university: (1) whose sole purpose is to provide postsecondary education defined as the provision of a formal instructional program whose curriculum is designed primarily for students who are beyond the compulsory age for high school and (2) has the authority to award degrees. This includes programs whose purpose is academic, vocational, and continuing professional education.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001755127812</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Postsecondary Educational Institution</rdfs:label>
		<skos:definition>An organization such as a college or university: (1) whose sole purpose is to provide postsecondary education defined as the provision of a formal instructional program whose curriculum is designed primarily for students who are beyond the compulsory age for high school and (2) has the authority to award degrees. This includes programs whose purpose is academic, vocational, and continuing professional education.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<skos:notation>Postsecondary</skos:notation>
		<skos:prefLabel>Postsecondary Educational Institution</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001755127813">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An organization that primarily operates online.</dc:description>
