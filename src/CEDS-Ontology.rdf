		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>FacilityLeaseAmount</skos:notation>
		<dc:description>The amount of money the school must pay to rent the facility that it is in.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
