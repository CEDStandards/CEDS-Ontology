		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000746</dc:identifier>
		<rdfs:label>Has Tuition Unit</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200330" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000746" />
		<skos:notation>hasTuitionUnit</skos:notation>
		<dc:description>The component for which tuition is being charged.  It might be a time period (term, quarter, year, etc.) or it might be an entity of education (course, credit hour, etc.).</dc:description>
		<rdfs:comment>As defined in IPEDS</rdfs:comment>
		<skos:definition>The component for which tuition is being charged. It might be a time period (term, quarter, year, etc.) or it might be an entity of education (course, credit hour, etc.).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000486">
