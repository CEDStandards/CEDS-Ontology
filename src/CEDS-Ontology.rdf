		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>FacilityReplacementValue</skos:notation>
		<dc:description>The estimated cost of replacing a facility using current per square foot estimates of total project costs.</dc:description>
