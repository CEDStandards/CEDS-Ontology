	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001235">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001235</dc:identifier>
		<rdfs:label>Has Individualized Program Transition Plan Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200157" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001235" />
		<skos:notation>hasIndividualizedProgramTransitionPlanType</skos:notation>
		<dc:description>The post-school transition plan for the student recorded on their Individualized Education Program.</dc:description>
		<skos:definition>The post-school transition plan for the student recorded on their Individualized Education Program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000320">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000320</dc:identifier>
		<rdfs:label>Has Individualized Program Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200157" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000320" />
		<skos:notation>hasIndividualizedProgramType</skos:notation>
		<dc:description>A designation of the type of program developed for a student.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added to option set.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed option to reflect LEP change to English Learner in Section 8101(20) of the ESEA, as amended by the ESSA</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A designation of the type of program developed for a student.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000167">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000167</dc:identifier>
		<rdfs:label>Has Institution Telephone Number Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200272" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000167" />
		<skos:notation>hasInstitutionTelephoneNumberType</skos:notation>
		<dc:description>The type of communication number listed for an organization.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Corrected element "Institution Telephone Number Type"; removed option "Facsimile phone number".</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of communication number listed for an organization.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000169">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000169</dc:identifier>
		<rdfs:label>Has Instructional Activity Hours Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000169" />
		<skos:notation>hasInstructionalActivityHoursType</skos:notation>
		<dc:description>The unit of measure of student instructional activity.</dc:description>
		<skos:definition>The unit of measure of student instructional activity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000735">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000735</dc:identifier>
		<rdfs:label>Has Instructional Staff Contract Length</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200122" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200334" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000735" />
		<skos:notation>hasInstructionalStaffContractLength</skos:notation>
		<dc:description>The contracted teaching period for faculty.</dc:description>
		<rdfs:comment>Option set new for IPEDS in 2012 survey year; IPEDS does not include the Less than 9-month code</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The contracted teaching period for faculty.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000739">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000739</dc:identifier>
		<rdfs:label>Has Instructional Staff Faculty Tenure Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200334" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000739" />
		<skos:notation>hasInstructionalStaffFacultyTenureStatus</skos:notation>
		<dc:description>An indicator of the type of faculty status a person has if, by institutional definition, a staff member has faculty status.</dc:description>
		<rdfs:comment>Option set defined in IPEDS</rdfs:comment>
		<skos:definition>An indicator of the type of faculty status a person has if, by institutional definition, a staff member has faculty status.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000741">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000741</dc:identifier>
		<rdfs:label>Has Instruction Credit Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200334" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000741" />
		<skos:notation>hasInstructionCreditType</skos:notation>
		<dc:description>A designation of the type(s) of instruction being delivered by staff whose primary responsibility is instruction.  Instruction that is for "credit" can be applied toward the requirements for a postsecondary degree, diploma, certificate or other formal award.</dc:description>
		<rdfs:comment>Element definition and option set defined in IPEDS; new collection element for the 2012 survey year</rdfs:comment>
		<skos:definition>A designation of the type(s) of instruction being delivered by staff whose primary responsibility is instruction. Instruction that is for "credit" can be applied toward the requirements for a postsecondary degree, diploma, certificate or other formal award.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000448">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000448</dc:identifier>
		<rdfs:label>Has Instruction Language</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000317" />
		<skos:notation>hasInstructionLanguage</skos:notation>
		<dc:description>The language of instruction, other than English, used in the program or course.</dc:description>
		<rdfs:comment>The CEDS ISO 639-2 Language Code option set comes from the &lt;a href="http://www.loc.gov/standards/iso639-2/langhome.html"&gt;ISO 639-2 standard&lt;/a&gt;, the character encoding in ISO 8859-1 download.  Discontinued codes from the ISO standard are not included in the CEDS list.</rdfs:comment>
		<skos:definition>The language of instruction, other than English, used in the program or course.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updating to reflect the latest version of the ISO 639-2 standard.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated to reflect the latest version of the ISO 639-2 standard.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000335">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000335</dc:identifier>
		<rdfs:label>Has Insurance Coverage</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200288" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000335" />
		<skos:notation>hasInsuranceCoverage</skos:notation>
		<dc:description>The nature of insurance covering an person's hospitalization and other health or medical care.</dc:description>
		<rdfs:comment>Use cases may utilize subsets of the option set.  For example, the option set for Parent/Guardian may not include the "Children's health insurance program" option.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added Military and Veteran coverage to option set.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added usage note.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The nature of insurance covering an person's hospitalization and other health or medical care.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000170">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000170</dc:identifier>
		<rdfs:label>Has Integrated Technology Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200190" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000170" />
		<skos:notation>hasIntegratedTechnologyStatus</skos:notation>
		<dc:description>An indication of the extent to which the district has effectively and fully integrated technology, as defined by the state.</dc:description>
		<skos:definition>An indication of the extent to which the district has effectively and fully integrated technology, as defined by the state.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000587">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000587</dc:identifier>
		<rdfs:label>Has Internet Access</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200110" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200203" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000587" />
		<skos:notation>hasInternetAccess</skos:notation>
		<dc:description>The type of internet access available.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of internet access available.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001936">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001936</dc:identifier>
		<rdfs:label>Has Internet Access Type In Residence</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200283" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001936" />
		<skos:notation>hasInternetAccessTypeInResidence</skos:notation>
		<dc:description>The primary type of internet service used in the student's primary place of residence.</dc:description>
		<rdfs:comment>When asking for this information on a parent or student survey, the question could be phrased like this: "What is the primary type of internet service used in the student's primary place of residence?"</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The primary type of internet service used in the student's primary place of residence.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001937">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001937</dc:identifier>
		<rdfs:label>Has Internet Performance In Residence</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200283" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001937" />
		<skos:notation>hasInternetPerformanceInResidence</skos:notation>
		<dc:description>An indication of whether the student can complete the full range of learning activities, including video streaming and assignment upload, without interruptions caused by poor internet performance in their primary place of residence.</dc:description>
		<rdfs:comment>When asking for this information on a parent or student survey, the question could be phrased like this: "Can the student complete learning activities such as streaming a video and uploading assignments without interruptions caused by poor internet performance?"</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether the student can complete the full range of learning activities, including video streaming and assignment upload, without interruptions caused by poor internet performance in their primary place of residence.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001671">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001671</dc:identifier>
		<rdfs:label>Has IPEDS Finance FASB Financial Position Category</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200174" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001671" />
		<skos:notation>hasIPEDSFinanceFASBFinancialPositionCategory</skos:notation>
		<dc:description>IPEDS financial position classification used by degree-granting private, not-for-profit institutions and public institutions using FASB Reporting Standards for reporting the assets, liabilities, and net assets in a manner consistent with the Statement of Financial Position in the General Purpose Financial Statements (GPFS).</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IPEDS Finance Survey</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>IPEDS financial position classification used by degree-granting private, not-for-profit institutions and public institutions using FASB Reporting Standards for reporting the assets, liabilities, and net assets in a manner consistent with the Statement of Financial Position in the General Purpose Financial Statements (GPFS).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001659">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001659</dc:identifier>
		<rdfs:label>Has IPEDS Finance FASB Functional Expense Category</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200174" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001659" />
		<skos:notation>hasIPEDSFinanceFASBFunctionalExpenseCategory</skos:notation>
		<dc:description>A functional expense classification is a method of grouping expenses according to the purpose for which the costs are incurred. The classifications tell why an expense was incurred rather than what was purchased.</dc:description>
		<rdfs:comment>(NACUBO FARM, section 700)</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IPEDS Finance Survey</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A functional expense classification is a method of grouping expenses according to the purpose for which the costs are incurred. The classifications tell why an expense was incurred rather than what was purchased.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001680">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001680</dc:identifier>
		<rdfs:label>Has IPEDS Finance FASB Pell Grant Transactions</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200174" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001680" />
		<skos:notation>hasIPEDSFinanceFASBPellGrantTransactions</skos:notation>
		<dc:description>Method of reporting Pell Grants in IPEDS by degree-granting private, not-for-profit institutions and public institutions using FASB Reporting Standards.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IPEDS Finance Survey</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
