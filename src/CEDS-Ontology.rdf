	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164456">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Drafting�Workplace Experience courses provide work experience in a field related to drafting. Goals are typically set cooperatively by the student, teacher, and employer (although students are not necessarily paid). These courses may include classroom activities as well, involving further study of the field or discussion regarding experiences that students encounter in the workplace.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164456</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
