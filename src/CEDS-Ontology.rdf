		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600127</dc:identifier>
		<rdfs:label>Has Assessment Item Response</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<skos:notation>hasAssessmentItemResponse</skos:notation>
		<dc:description>References information about a learner response and subsequent information about feedback and scoring of the response. Some properties like DescriptiveFeedback are for support of a formative assessment process. Some properties are used within intelligent tutoring systems such as HintCount and ScaffoldingItemFlag.</dc:description>
		<skos:definition>References information about a learner response and subsequent information about feedback and scoring of the response. Some properties like DescriptiveFeedback are for support of a formative assessment process. Some properties are used within intelligent tutoring systems such as HintCount and ScaffoldingItemFlag.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600129">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600129</dc:identifier>
		<rdfs:label>Has Assessment Item Response Theory</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<skos:notation>hasAssessmentItemResponseTheory</skos:notation>
		<dc:description>References information representing the difficulty of an assessment itme and other measures of the relationship between any individuals' performances on the test item and the test takers' levels of performance on an overall measure of the ability that item was designed to measure.</dc:description>
		<skos:definition>References information representing the difficulty of an assessment itme and other measures of the relationship between any individuals' performances on the test item and the test takers' levels of performance on an overall measure of the ability that item was designed to measure.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600077">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600077</dc:identifier>
		<rdfs:label>Has Rubric</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
