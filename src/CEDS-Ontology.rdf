		<rdfs:label>Has Awaiting Foster Care Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200309" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001929" />
