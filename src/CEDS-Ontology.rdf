	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600373">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600373</dc:identifier>
		<rdfs:label>Has Credential Definition Criteria Definition</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200068" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200415" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200085" />
		<skos:notation>hasCredentialDefinitionCriteriaDefinition</skos:notation>
		<dc:description>References the criteria by which a credential may be issued.</dc:description>
