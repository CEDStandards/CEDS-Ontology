	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001287141404">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A model in which within a given course or subject, students rotate between learning modalities, at least one of which is online learning. Other modalities might include activities such as small-group or full-class instruction, group projects, individual tutoring, and pencil-and-paper assignments.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001287141404</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Rotation model</rdfs:label>
		<skos:definition>A model in which within a given course or subject, students rotate between learning modalities, at least one of which is online learning. Other modalities might include activities such as small-group or full-class instruction, group projects, individual tutoring, and pencil-and-paper assignments.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<skos:notation>Rotation</skos:notation>
		<skos:prefLabel>Rotation model</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001287141405">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A model in which online learning is the backbone of student learning, even if it directs students to offline activities at times. Students move on an individually customized, fluid schedule among learning modalities, and the teacher of record is on-site. The teacher-of-record or other adults provide face-to-face support on a flexible and adaptive as-needed basis through activities such as small-group instruction, group projects, and individual tutoring.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001287141405</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Flex model</rdfs:label>
		<skos:definition>A model in which online learning is the backbone of student learning, even if it directs students to offline activities at times. Students move on an individually customized, fluid schedule among learning modalities, and the teacher of record is on-site. The teacher-of-record or other adults provide face-to-face support on a flexible and adaptive as-needed basis through activities such as small-group instruction, group projects, and individual tutoring.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<skos:notation>FlexModel</skos:notation>
		<skos:prefLabel>Flex model</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001287141406">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A model in which students take one or more courses entirely online with an online teacher of record and at the same time continue to have brick-and-mortar educational experiences. Students may take the online courses either on the brick-and-mortar campus or off-site. This differs from full-time online learning and the Enriched Virtual model because it is not a whole-school experience.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001287141406</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>A La Carte model</rdfs:label>
		<skos:definition>A model in which students take one or more courses entirely online with an online teacher of record and at the same time continue to have brick-and-mortar educational experiences. Students may take the online courses either on the brick-and-mortar campus or off-site. This differs from full-time online learning and the Enriched Virtual model because it is not a whole-school experience.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<skos:notation>ALaCarte</skos:notation>
		<skos:prefLabel>A La Carte model</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001287141407">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A whole-school experience in which within each course, students divide their time between attending a brick-and-mortar campus and learning remotely, off-site, using online delivery of content and instruction.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001287141407</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Enriched Virtual model</rdfs:label>
		<skos:definition>A whole-school experience in which within each course, students divide their time between attending a brick-and-mortar campus and learning remotely, off-site, using online delivery of content and instruction.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<skos:notation>EnrichedVirtual</skos:notation>
		<skos:prefLabel>Enriched Virtual model</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001287141408">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A model for implementing blended learning that does not fit the definition of the other blended learning model types</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001287141408</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Other</rdfs:label>
		<skos:definition>A model for implementing blended learning that does not fit the definition of the other blended learning model types</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<skos:notation>Other</skos:notation>
