	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000011">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000011</dc:identifier>
		<rdfs:label>Has Adequate Yearly Progress Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200250" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000011" />
		<skos:notation>hasAYPStatus</skos:notation>
		<dc:description>An indication of whether the state, district, or school met the Adequate Yearly Progress (AYP) requirements for the school year, as determined by the state-established criteria.</dc:description>
		<skos:definition>An indication of whether the state, district, or school met the Adequate Yearly Progress (AYP) requirements for the school year, as determined by the state-established criteria.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000449">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000449</dc:identifier>
		<rdfs:label>Has Barrier to Educating Homeless</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200190" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000449" />
		<skos:notation>hasBarrierToEducatingHomeless</skos:notation>
		<dc:description>Barriers to the enrollment and success of homeless children and youths.</dc:description>
		<skos:definition>Barriers to the enrollment and success of homeless children and youths.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001935">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001935</dc:identifier>
		<rdfs:label>Has Barrier to Internet Access In Residence</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200283" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001935" />
		<skos:notation>hasBarrierToInternetAccessInResidence</skos:notation>
		<dc:description>An indication of the barrier to having internet access in the student's primary place of residence.</dc:description>
		<rdfs:comment>This element is used in combination with the element "Internet Access in Residence." When asking for this information on a parent or student survey, the question could be phrased like this: "If the student is unable to access the internet in their primary place of residence, why not?"</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the barrier to having internet access in the student's primary place of residence.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001582">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001582</dc:identifier>
		<rdfs:label>Has Billable Basis Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200112" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001582" />
		<skos:notation>hasBillableBasisType</skos:notation>
		<dc:description>The event/action that results in a billable action.</dc:description>
		<skos:definition>The event/action that results in a billable action.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001287">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001287</dc:identifier>
		<rdfs:label>Has Blended Learning Model Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200105" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200203" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001287" />
		<skos:notation>hasBlendedLearningModelType</skos:notation>
		<dc:description>A type of formal education program in which a student learns at least in part through online learning, with some element of student control over time, place, path, and/or pace; at least in part in a supervised brick-and-mortar location away from home; and the modalities along each student's learning path within a course or subject are connected to provide an integrated learning experience.</dc:description>
		<rdfs:comment>This may be an attribute of a Course (as designed) or a Class Section (as delivered). It also may be attributed to a school, institution, or program for "whole-school" blended models.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Correcting a gap in the DES: Per the usage note "Blended Learning Model Type" should have the additional context of "K12 School" to account for whole school blended models.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added the option of Other to support stakeholder request.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A type of formal education program in which a student learns at least in part through online learning, with some element of student control over time, place, path, and/or pace; at least in part in a supervised brick-and-mortar location away from home; and the modalities along each student's learning path within a course or subject are connected to provide an integrated learning experience.</skos:definition>
	</rdf:Property>
