		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>FinancialAccountingPeriodActualValue</skos:notation>
		<dc:description>The actual value of a financial account for the specified accounting period or fiscal year.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The actual value of a financial account for the specified accounting period or fiscal year.</skos:definition>
