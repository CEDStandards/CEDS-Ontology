	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001940">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001940</dc:identifier>
		<rdfs:label>Has WIOA Barriers to Employment</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200327" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001940" />
		<skos:notation>hasWIOABarrierstoEmployment</skos:notation>
		<dc:description>A self-identified barrier as defined by the Workforce Innovation and Opportunity Act (WIOA) that is presumed to affect placement of a participant in unsubsidized employment.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new option to option set, change option set, and add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A self-identified barrier as defined by the Workforce Innovation and Opportunity Act (WIOA) that is presumed to affect placement of a participant in unsubsidized employment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001499">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001499</dc:identifier>
		<rdfs:label>Has Work-based Learning Opportunity Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200198" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200332" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200345" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200316" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001499" />
		<skos:notation>hasWorkBasedLearningOpportunityType</skos:notation>
		<dc:description>The type of work-based learning opportunity a student participated in.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new option to existing option set and add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of work-based learning opportunity a student participated in.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001412">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001412</dc:identifier>
		<rdfs:label>Has Military Enlistment After Exit</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200373" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001412" />
		<skos:notation>hasMilitaryEnlistmentAfterExit</skos:notation>
		<dc:description>An individual who is a member of the uniformed armed forces of the United States as reported through FEDES after exiting secondary, postsecondary, or adult education or workforce programs.</dc:description>
		<rdfs:comment>Information on military enlistment is collected as a part of the FEDES program which facilitates periodic matches with the Department of Defense Manpower Information Center.  While the unemployment insurance data cannot be used to indicate that an individual is not employed, the DOD Enlistment data can suggest "not enlisted when there is no match."  These data are included in FEDES matches and may need to be "unduplicated" from employment counts.</rdfs:comment>
		<skos:definition>An individual who is a member of the uniformed armed forces of the United States as reported through FEDES after exiting secondary, postsecondary, or adult education or workforce programs.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000997">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000997</dc:identifier>
		<rdfs:label>Has Workforce Program Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200375" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000997" />
		<skos:notation>hasWorkforceProgramType</skos:notation>
		<dc:description>The type of workforce and employment development program that an individual is participating in.</dc:description>
		<rdfs:comment>A reference period for identifying program participation during or after enrollment in secondary education, postsecondary education, or adult education will have to be defined by the agency in collaboration with other agency partners.  At this point this element is intended only to indicate program participation and does not delve into programmatic details, persistence, or completion.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new option to option set</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: v6 Comment</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of workforce and employment development program that an individual is participating in.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001993">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001993</dc:identifier>
		<rdfs:label>Has Interdisciplinary Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001993"/>
		<skos:notation>hasInterdisciplinaryIndicator</skos:notation>
		<dc:description>An indication that the course, projects, and/or learning activities develop knowledge and skills across multiple subject areas and highlight connections between subject area domains, with formal collaboration among teachers across subject areas.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that the course, projects, and/or learning activities develop knowledge and skills across multiple subject areas and highlight connections between subject area domains, with formal collaboration among teachers across subject areas.</skos:definition>
	</rdf:Property>
