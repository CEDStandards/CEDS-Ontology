				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The category used to report the school's performance on the progress of achieving the English language proficiency indicator.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000561">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000561</dc:identifier>
		<rdfs:label>Has Progress Level</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200210" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000561" />
		<skos:notation>hasProgressLevel</skos:notation>
		<dc:description>The amount of progress shown in academic subjects.</dc:description>
		<skos:definition>The amount of progress shown in academic subjects.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001992">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001992</dc:identifier>
		<rdfs:label>Has Project-Based Learning Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200264" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001992" />
		<skos:notation>hasProjectBasedLearningType</skos:notation>
		<dc:description>The type of project-based instruction being offered.</dc:description>
		<rdfs:comment>Select all that apply.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of project-based instruction being offered.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002026">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002026</dc:identifier>
		<rdfs:label>Has Projected High School Diploma Type</rdfs:label>
