		<skos:notation>OrganizationEnrollmentCapacity</skos:notation>
		<dc:description>Information about the capacity for an enrollment in an organization such as school, program, or course.</dc:description>
		<skos:definition>Information about the capacity for an enrollment in an organization such as school, program, or course.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200250">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200250</dc:identifier>
		<rdfs:label>Organization Federal Accountability</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>OrganizationFederalAccountability</skos:notation>
		<dc:description>Information on the status of the organization on various federal accountability measures.</dc:description>
		<skos:definition>Information on the status of the organization on various federal accountability measures.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
