		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000648" />
		<skos:notation>hasTeachingAssignmentRole</skos:notation>
		<dc:description>The role that the Staff Member has been assigned for a Class Section.  (A teacher may have the lead responsibility for one section and serve a supporting role for another section of the same course.)</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The role that the Staff Member has been assigned for a Class Section. (A teacher may have the lead responsibility for one section and serve a supporting role for another section of the same course.)</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000277">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000277</dc:identifier>
		<rdfs:label>Has Teaching Credential Basis</rdfs:label>
