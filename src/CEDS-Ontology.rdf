		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>LearningResourceStatusQuantity</skos:notation>
		<dc:description>The total number of a specific related learning resource for each distinct learning resource status.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The total number of a specific related learning resource for each distinct learning resource status.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
