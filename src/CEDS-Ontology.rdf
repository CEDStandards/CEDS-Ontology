		<rdfs:label>Has Credits Earned</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200369" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200414" />
		<skos:notation>hasCreditsEarned</skos:notation>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to CEDS.</changeDescription> 	
				<changeVersion>13</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P201004">
