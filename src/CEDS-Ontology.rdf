	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600182">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600182</dc:identifier>
		<rdfs:label>Has Job</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200207"/>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239"/>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200180"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200175"/>
		<skos:notation>hasJob</skos:notation>
		<dc:description>References an entity that represent any type of job.</dc:description>
		<skos:definition>References an entity that represent any type of job.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000525">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000525</dc:identifier>
		<rdfs:label>Has Primary Assignment Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200207" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000525" />
		<skos:notation>hasPrimaryAssignmentIndicator</skos:notation>
		<dc:description>An indication of whether the assignment is the staff member's primary assignment.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Corrected typo; removed "this" before "the staff" in the definition.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether the assignment is the staff member's primary assignment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000647">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000647</dc:identifier>
		<rdfs:label>Has Teacher of Record</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200207" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000647" />
		<skos:notation>hasTeacherOfRecord</skos:notation>
		<dc:description>Staff member who has a Teacher of Record responsibility for a Class Section based upon the state's definition of Teacher of Record.</dc:description>
		<rdfs:comment>There is usually one Teacher of Record assignment in a Class Section except in the case of co-teaching/team-teaching.</rdfs:comment>
		<skos:definition>Staff member who has a Teacher of Record responsibility for a Class Section based upon the state's definition of Teacher of Record.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000087">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000087</dc:identifier>
		<rdfs:label>Has K12 Staff Classification</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200120" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200178" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200207" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200208" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000087" />
		<skos:notation>hasK12StaffClassification</skos:notation>
		<dc:description>The titles of employment, official status, or rank of education staff.</dc:description>
		<skos:definition>The titles of employment, official status, or rank of education staff.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Education Staff Classification.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Correct punctuation in option definition for K12 Staff Classification : Instructional Coordinators.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set to support EDFacts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000234">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000234</dc:identifier>
		<rdfs:label>Has Salary for Teaching Assignment Only Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200208" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000234" />
		<skos:notation>hasSalaryForTeachingAssignmentOnlyIndicator</skos:notation>
		<dc:description>Indicator to determine whether the teacher's base salary includes pay for teaching assignments alone.</dc:description>
		<skos:definition>Indicator to determine whether the teacher's base salary includes pay for teaching assignments alone.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000133">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000133</dc:identifier>
		<rdfs:label>Has Graduation Rate Survey Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200212" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000133" />
		<skos:notation>hasGraduationRateSurveyIndicator</skos:notation>
		<dc:description>An indication of whether or not the student is in a GRS cohort; meaning the student began as a first-time, full-time, degree seeking student in the fall of a given year.</dc:description>
		<skos:definition>An indication of whether or not the student is in a GRS cohort; meaning the student began as a first-time, full-time, degree seeking student in the fall of a given year.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600313">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600313</dc:identifier>
		<rdfs:label>Has K12 Student Course Section Mark</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215"/>
		<skos:notation>hasK12StudentCourseSectionMark</skos:notation>
		<dc:description>References the detail information for the reason and action taken for a discipline event of a K12 student.</dc:description>
		<skos:definition>References the detail information for the reason and action taken for a discipline event of a K12 student.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600550">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600550</dc:identifier>
		<rdfs:label>Has K12 Student Enrollment</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200219"/>
		<skos:notation>hasK12StudentEnrollment</skos:notation>
		<dc:description>References information about a student enrollment that is unique to the K12 context.</dc:description>
		<skos:definition>References information about a student enrollment that is unique to the K12 context.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001575">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001575</dc:identifier>
		<rdfs:label>Has Tuition Funded</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200279" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001575" />
		<skos:notation>hasTuitionFunded</skos:notation>
		<dc:description>Indicates that tuition for person's participation in a program, service, or course is funded or partially funded by an external grant program.</dc:description>
		<rdfs:comment>The initial use case is for professional development courses/programs, but could apply to student programs/courses as well.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates that tuition for person's participation in a program, service, or course is funded or partially funded by an external grant program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001142">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001142</dc:identifier>
		<rdfs:label>Has Student Course Section Mark Final Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200214" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001142" />
		<skos:notation>hasStudentCourseSectionMarkFinalIndicator</skos:notation>
		<dc:description>Indicates that the mark is a final mark the learner has earned for the course section.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Student Class Section Mark Final Indicator.  Definition updated.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates that the mark is a final mark the learner has earned for the course section.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001322">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001322</dc:identifier>
		<rdfs:label>Has Disciplinary Action IEP Placement Meeting Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001322" />
		<skos:notation>hasDisciplinaryActionIEPPlacementMeetingIndicator</skos:notation>
		<dc:description>An indication as to whether an offense and/or disciplinary action resulted in a meeting of a student's Individualized Education Program (IEP) team to determine appropriate placement.</dc:description>
		<skos:definition>An indication as to whether an offense and/or disciplinary action resulted in a meeting of a student's Individualized Education Program (IEP) team to determine appropriate placement.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000578">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000578</dc:identifier>
		<rdfs:label>Has Educational Services After Removal</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000578" />
		<skos:notation>hasEducationalServicesAfterRemoval</skos:notation>
		<dc:description>An indication of whether children (students) were provided educational services when removed from the regular school program for disciplinary reasons.</dc:description>
		<skos:definition>An indication of whether children (students) were provided educational services when removed from the regular school program for disciplinary reasons.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000513">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000513</dc:identifier>
		<rdfs:label>Has Full Year Expulsion</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000513" />
		<skos:notation>hasFullYearExpulsion</skos:notation>
		<dc:description>An expulsion with or without services for a period of one full year (i.e., 365 days).</dc:description>
		<skos:definition>An expulsion with or without services for a period of one full year (i.e., 365 days).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600314">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600314</dc:identifier>
		<rdfs:label>Has Incident</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200257" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<skos:notation>hasIncident</skos:notation>
		<dc:description>References the details for an incident involving a student or school.</dc:description>
		<skos:definition>References the details for an incident involving a student or school.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000512">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000512</dc:identifier>
		<rdfs:label>Has Related to Zero Tolerance Policy</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000512" />
		<skos:notation>hasRelatedToZeroTolerancePolicy</skos:notation>
		<dc:description>An indication of whether or not any of the disciplinary actions taken against a student were imposed as a consequence of state or local zero tolerance policies.</dc:description>
		<skos:definition>An indication of whether or not any of the disciplinary actions taken against a student were imposed as a consequence of state or local zero tolerance policies.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000514">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000514</dc:identifier>
		<rdfs:label>Has Shortened Expulsion</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000514" />
		<skos:notation>hasShortenedExpulsion</skos:notation>
		<dc:description>An expulsion with or without services that is shortened to a term of less than one year by the superintendent or chief administrator of a school district.</dc:description>
		<skos:definition>An expulsion with or without services that is shortened to a term of less than one year by the superintendent or chief administrator of a school district.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000610">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000610</dc:identifier>
		<rdfs:label>Has Displaced Student Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200219" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000610" />
		<skos:notation>hasDisplacedStudentStatus</skos:notation>
		<dc:description>A student who was enrolled, or eligible for enrollment, but has enrolled in another place because of a crisis.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A student who was enrolled, or eligible for enrollment, but has enrolled in another place because of a crisis.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001654">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001654</dc:identifier>
		<rdfs:label>Has National School Lunch Program Direct Certification Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200219" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001654" />
		<skos:notation>hasNationalSchoolLunchProgramDirectCertificationIndicator</skos:notation>
		<dc:description>Indicates that the student's National School Lunch Program (NSLP) eligibility has been determined through direct certification.</dc:description>
		<rdfs:comment>This element was introduced in version 6 of CEDS with plans for further development of elements needed to fully support direct certification use cases.</rdfs:comment>
		<skos:definition>Indicates that the student's National School Lunch Program (NSLP) eligibility has been determined through direct certification.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001988">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001988</dc:identifier>
		<rdfs:label>Has Home Language Survey Administration Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200221" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001988" />
		<skos:notation>hasHomeLanguageSurveyAdministrationIndicator</skos:notation>
		<dc:description>An indication that the parent or guardian of this student was administered the Home Language Survey - a questionnaire given to parents or guardians that helps schools and local education agencies identify which students are potential English Learners and who will require assessment of their English language proficiency to determine whether they are eligible for language assistance services.</dc:description>
		<rdfs:comment>The term "administration" would indicate that the results of the home language survey for this student have been provided to the school. The intent of this element is not to determine whether or not the school provided a home language survey to the parents/guardians of the student but instead to determine if the school received the results of that home language survey back from the parents/guardians of the student.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that the parent or guardian of this student was administered the Home Language Survey - a questionnaire given to parents or guardians that helps schools and local education agencies identify which students are potential English Learners and who will require assessment of their English language proficiency to determine whether they are eligible for language assistance services.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000467">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000467</dc:identifier>
		<rdfs:label>Has Literacy Goal Met Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200222" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000467" />
		<skos:notation>hasLiteracyGoalMetStatus</skos:notation>
		<dc:description>The participant showed "significant learning gains" on measures of reading, the definition of which is determined at the State level.</dc:description>
		<skos:definition>The participant showed "significant learning gains" on measures of reading, the definition of which is determined at the State level.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000468">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000468</dc:identifier>
		<rdfs:label>Has Literacy Post Test Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200222" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000468" />
		<skos:notation>hasLiteracyPostTestStatus</skos:notation>
		<dc:description>The participant completed a literacy post-test.</dc:description>
		<skos:definition>The participant completed a literacy post-test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000469">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000469</dc:identifier>
		<rdfs:label>Has Literacy Pre Test Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200222" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000469" />
		<skos:notation>hasLiteracyPreTestStatus</skos:notation>
		<dc:description>The participant completed a literacy pre-test.</dc:description>
		<skos:definition>The participant completed a literacy pre-test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000447">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000447</dc:identifier>
		<rdfs:label>Has Title III Language Instruction Program Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200224" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200325" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000447" />
		<skos:notation>hasTitleIIILanguageInstructionProgramType</skos:notation>
		<dc:description>The type of Title III language instructional education programs.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>To align with EDFacts specifications, changing element definition for "Title III Language Instruction Program Type" to "The type of Title III language instructional education programs," and adding option: NewcomerPrograms - "The type of Title III language instructional program is Newcomer programs."</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of Title III language instructional education programs.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000491">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000491</dc:identifier>
		<rdfs:label>Has Kindergarten Daily Length</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200198" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000491" />
		<skos:notation>hasKindergartenDailyLength</skos:notation>
		<dc:description>The portion of a day that a kindergarten program is provided to the students it serves.</dc:description>
		<skos:definition>The portion of a day that a kindergarten program is provided to the students it serves.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000714">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000714</dc:identifier>
		<rdfs:label>Has Kindergarten Program Participation Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200407"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000714"/>
		<skos:notation>hasKindergartenProgramParticipationType</skos:notation>
		<dc:description>The type of Kindergarten program the student is enrolled in.</dc:description>
		<skos:definition>The type of Kindergarten program the student is enrolled in.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000316">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000316</dc:identifier>
		<rdfs:label>Has Language Type</rdfs:label>
