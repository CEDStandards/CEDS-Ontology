	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000594172951">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The role/relationship type assigned to an organization, institution, or agency responsible for transporting the student to the physical location of the school or facility in which educational services are delivered.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000594172951</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000594" />
