		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000036" />
		<skos:notation>hasCTECompleter</skos:notation>
		<dc:description>An indication of a student who reached a state-defined threshold of a career and technical education program/pathway.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated definition</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of a student who reached a state-defined threshold of a career and technical education program/pathway.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000037">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000037</dc:identifier>
		<rdfs:label>Has Career and Technical Education Concentrator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000037" />
		<skos:notation>hasCTEConcentrator</skos:notation>
		<dc:description>An indication of a student who has met the state-defined threshold of career and technical education concentrators, as defined in the State's approved Perkins IV State Plan.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated definition</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Definition has been updated.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of a student who has met the state-defined threshold of career and technical education concentrators, as defined in the State's approved Perkins IV State Plan.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000593">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000593</dc:identifier>
		<rdfs:label>Has Career and Technical Education Nontraditional Completion</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000593" />
		<skos:notation>hasCTENontraditionalCompletion</skos:notation>
		<dc:description>An indication that the CTE student has completed a CTE program in a nontraditional field (where one gender comprises less than 25 percent of the persons employed in those occupations or fields of work).</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name and definition have been modified.  Former name: Career and Technical Education Student Preparing for Nontraditional Fields</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that the CTE student has completed a CTE program in a nontraditional field (where one gender comprises less than 25 percent of the persons employed in those occupations or fields of work).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000592">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000592</dc:identifier>
		<rdfs:label>Has Career and Technical Education Participant</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000592" />
		<skos:notation>hasCTEParticipant</skos:notation>
		<dc:description>An indication a student has met the state-defined threshold of Career and Technical Education participation as defined in the State's approved Perkins IV State Plan.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Definition updated</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication a student has met the state-defined threshold of Career and Technical Education participation as defined in the State's approved Perkins IV State Plan.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000580">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000580</dc:identifier>
		<rdfs:label>Has Single Parent or Single Pregnant Woman Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200309" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000580" />
		<skos:notation>hasSingleParentOrSinglePregnantWomanStatus</skos:notation>
		<dc:description>A student who, at some time during the school year, is either a pregnant female student who is unmarried; or a male or female student who is unmarried or legally separated from a spouse and has a minor child or children.</dc:description>
		<skos:definition>A student who, at some time during the school year, is either a pregnant female student who is unmarried; or a male or female student who is unmarried or legally separated from a spouse and has a minor child or children.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000307">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000307</dc:identifier>
