	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164087">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Medical/Clerical Assisting courses enable students to develop knowledge and skills that combine the medical and clerical fields. Students typically develop skills such as patient exam preparation, assessment of vital signs, routine lab procedures, medical transcription, financial accounting, patient and insurance company billing, and record-keeping.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164087</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Medical/Clerical Assisting</rdfs:label>
		<skos:definition>Medical/Clerical Assisting courses enable students to develop knowledge and skills that combine the medical and clerical fields. Students typically develop skills such as patient exam preparation, assessment of vital signs, routine lab procedures, medical transcription, financial accounting, patient and insurance company billing, and record-keeping.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>14151</skos:notation>
		<skos:prefLabel>Medical/Clerical Assisting</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164088">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Pharmacy Assisting courses emphasize the knowledge and skills necessary to assist a pharmacist or pharmacy technician. Course topics and experiences enable students to understand medical terminology, keep and maintain records, label medications, perform computer patient billing, perform stock inventory, and order supplies. These courses also emphasize pharmaceutical classification, drug interactions, and interpersonal/communication skills.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164088</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Pharmacy Assisting</rdfs:label>
		<skos:definition>Pharmacy Assisting courses emphasize the knowledge and skills necessary to assist a pharmacist or pharmacy technician. Course topics and experiences enable students to understand medical terminology, keep and maintain records, label medications, perform computer patient billing, perform stock inventory, and order supplies. These courses also emphasize pharmaceutical classification, drug interactions, and interpersonal/communication skills.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>14152</skos:notation>
		<skos:prefLabel>Pharmacy Assisting</skos:prefLabel>
	</owl:NamedIndividual>
