	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000537129334">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A local government administrative authority which governs the education system at a specified local level on behalf of the public and the state and is NOT a component of a supervisory union.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000537129334</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000537" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Regular public school district that is NOT a component of a supervisory union</rdfs:label>
		<skos:definition>A local government administrative authority which governs the education system at a specified local level on behalf of the public and the state and is NOT a component of a supervisory union.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000537" />
		<skos:notation>RegularNotInSupervisoryUnion</skos:notation>
		<skos:prefLabel>Regular public school district that is NOT a component of a supervisory union</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000537129335">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A local government administrative authority which governs the education system at a specified local level on behalf of the public and the state and is a component of a supervisory union.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000537129335</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000537" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Regular public school district that is a component of a supervisory union</rdfs:label>
		<skos:definition>A local government administrative authority which governs the education system at a specified local level on behalf of the public and the state and is a component of a supervisory union.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000537" />
		<skos:notation>RegularInSupervisoryUnion</skos:notation>
		<skos:prefLabel>Regular public school district that is a component of a supervisory union</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000537129336">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An administrative center or county superintendent's office serving as the administrative center.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000537129336</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000537" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label> Supervisory Union</rdfs:label>
		<skos:definition>An administrative center or county superintendent's office serving as the administrative center.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000537"/>
		<skos:notation>SupervisoryUnion</skos:notation>
		<skos:prefLabel> Supervisory Union</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000537129337">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school district that operates one or more schools that are designed for a specific educational need or purpose.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000537129337</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000537" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Specialized Public School District</rdfs:label>
		<skos:definition>A school district that operates one or more schools that are designed for a specific educational need or purpose.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000537" />
		<skos:notation>SpecializedPublicSchoolDistrict</skos:notation>
		<skos:prefLabel>Specialized Public School District</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000537129338">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An agency that does not operate schools, instead it provides specialized educational services (such as career and technical education) or related services (such as services in IEPs) to other education agencies that the agencies cannot readily provide for themselves.</dc:description>
