	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000273172824">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Services that allow individuals who can not comprehend or communicate using either the spoken or written word to understand or express themselves (e.g., foreign language translator and sign language interpreter).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000273172824</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000273" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Translation/interpreter services</rdfs:label>
		<skos:definition>Services that allow individuals who can not comprehend or communicate using either the spoken or written word to understand or express themselves (e.g., foreign language translator and sign language interpreter).</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000273" />
		<skos:notation>00327</skos:notation>
		<skos:prefLabel>Translation/interpreter services</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000273172825">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Individualized or small group instruction for students who need assistance in learning one or more components of a prescribed curriculum. Tutoring usually supplements a regular school program, and may be provided by peer students, teachers, or other personnel at school, in an individual's home, or at a community agency site.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000273172825</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000273" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Tutoring services</rdfs:label>
		<skos:definition>Individualized or small group instruction for students who need assistance in learning one or more components of a prescribed curriculum. Tutoring usually supplements a regular school program, and may be provided by peer students, teachers, or other personnel at school, in an individual's home, or at a community agency site.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000273"/>
		<skos:notation>00329</skos:notation>
		<skos:prefLabel>Tutoring services</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000273172826">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Services that include: 1) evaluation and assessment of visual functioning, including the diagnosis and appraisal of specific visual disorders, delays, and disabilities; 2) referrals for medical or other professional services necessary for the habilitation or rehabilitation of visual functioning disorders; and 3) training for communication, communication, orientation and mobility, visual, and independent living skills, and any additional training necessary to activate visual motor abilities.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000273172826</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000273" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Vision services</rdfs:label>
		<skos:definition>Services that include: 1) evaluation and assessment of visual functioning, including the diagnosis and appraisal of specific visual disorders, delays, and disabilities; 2) referrals for medical or other professional services necessary for the habilitation or rehabilitation of visual functioning disorders; and 3) training for communication, communication, orientation and mobility, visual, and independent living skills, and any additional training necessary to activate visual motor abilities.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000273" />
		<skos:notation>00330</skos:notation>
		<skos:prefLabel>Vision services</skos:prefLabel>
	</owl:NamedIndividual>
