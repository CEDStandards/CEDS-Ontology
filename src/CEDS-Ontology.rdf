		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001751" />
		<skos:notation>hasCredentialRevokedIndicator</skos:notation>
		<dc:description>Indicates whether the credential has been revoked by the credential provider.</dc:description>
