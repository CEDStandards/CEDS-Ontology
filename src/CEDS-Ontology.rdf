		<skos:prefLabel>Related to Zero Tolerance Policy</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000513">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An expulsion with or without services for a period of one full year (i.e., 365 days).</dc:description>
