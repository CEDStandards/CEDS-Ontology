			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The classification of the operational condition of a local education agency (LEA) at the start of the school year.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000934">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000934</dc:identifier>
		<rdfs:label>Has Learner Action Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200225" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000934" />
		<skos:notation>hasLearnerActionType</skos:notation>
		<dc:description>The type of action taken by the learner.</dc:description>
		<rdfs:comment>The CEDS Learner Action Type option set comes from the &lt;a href="https://w3id.org/xapi/adl"&gt;ADL Controlled Vocabulary&lt;/a&gt;, xAPI specification.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed option set.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set to include definitions and limit description length to 150 characters.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of action taken by the learner.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600389">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600389</dc:identifier>
		<rdfs:label>Has Course Section</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200226"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074"/>
		<skos:notation>hasCourseSection</skos:notation>
		<dc:description>References information about an instance of a course offered/delivered in a specific timeframe and/or place or through specific media or mode of study or to a specific section of students. (In the CEDS IDS, CourseSection is a subclass of organization that can be linked to persons and roles using Membership. Subclasses include K12 Course, PsCourse, CteCoure, AeCourse)</dc:description>
		<skos:definition>References information about an instance of a course offered/delivered in a specific timeframe and/or place or through specific media or mode of study or to a specific section of students. (In the CEDS IDS, CourseSection is a subclass of organization that can be linked to persons and roles using Membership. Subclasses include K12 Course, PsCourse, CteCoure, AeCourse)</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000949">
		<dc:creator>Common Education Data Standards</dc:creator>
