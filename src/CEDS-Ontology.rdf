	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000325">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000325</dc:identifier>
		<rdfs:label>Has Participation in School Food Service Programs</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200106" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200319" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000325" />
		<skos:notation>hasParticipationInSchoolFoodServicePrograms</skos:notation>
		<dc:description>An indication of a student's participation in free, reduced price, full price breakfast, lunch, snack, supper, and milk programs.</dc:description>
		<skos:definition>An indication of a student's participation in free, reduced price, full price breakfast, lunch, snack, supper, and milk programs.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000208">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000208</dc:identifier>
		<rdfs:label>Has Participation Status for Math</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200250" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000208" />
		<skos:notation>hasParticipationStatusForMath</skos:notation>
		<dc:description>An indication of whether the school or district met the 95 percent participation requirement in the mathematics assessment in accordance with state definition for the purposes of determining AYP.</dc:description>
		<skos:definition>An indication of whether the school or district met the 95 percent participation requirement in the mathematics assessment in accordance with state definition for the purposes of determining AYP.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000209">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000209</dc:identifier>
		<rdfs:label>Has Participation Status for Reading and Language Arts</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200250" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000209" />
		<skos:notation>hasParticipationStatusForReadingAndLanguageArts</skos:notation>
		<dc:description>An indication of whether the school or district met the 95 percent participation requirement on the reading/language arts assessment in accordance with state definition for the purposes of determining AYP.</dc:description>
		<skos:definition>An indication of whether the school or district met the 95 percent participation requirement on the reading/language arts assessment in accordance with state definition for the purposes of determining AYP.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001230">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001230</dc:identifier>
