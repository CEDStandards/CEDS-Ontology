		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>RubricCriterionLevelScore</skos:notation>
		<dc:description>The points awarded for achieving this level.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The points awarded for achieving this level.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001714">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001714</dc:identifier>
		<rdfs:label>Frequency Instances Per Cycle</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200356" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>FrequencyInstancesperCycle</skos:notation>
		<dc:description>The number of recurrences within a cycle.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The number of recurrences within a cycle.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001715">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001715</dc:identifier>
		<rdfs:label>Frequency Length</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200356" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>FrequencyLength</skos:notation>
		<dc:description>The number of units within a repeating cycle. Used with Frequency and Frequency Units elements to describe the occurrence of repeating events such as student services delivered 3 times a week for 16 weeks.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The number of units within a repeating cycle. Used with Frequency and Frequency Units elements to describe the occurrence of repeating events such as student services delivered 3 times a week for 16 weeks.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001716">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001716</dc:identifier>
		<rdfs:label>Duration Length in Minutes</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200356" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>DurationLengthinMinutes</skos:notation>
		<dc:description>The number of minutes in an instance.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The number of minutes in an instance.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES context to support K12 Implementation.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001488">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001488</dc:identifier>
		<rdfs:label>Reason for Declined Services</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200357" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ReasonForDeclinedServices</skos:notation>
		<dc:description>The reason given for declining the recommended services.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The reason given for declining the recommended services.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001712">
