	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002052">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002052</dc:identifier>
		<rdfs:label>Military Deployment Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200298" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>MilitaryDeploymentDescription</skos:notation>
		<dc:description>A textual description of the person's military deployment.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<maxLength>200</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A textual description of the person's military deployment.</skos:definition>
