		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200080" />
		<skos:notation>hasCredentialAwardCredit</skos:notation>
		<dc:description>References information related to a specific course instance(CousreSection) that a Person completed to qualify for a CredentialAward using MembershipId and/or it could use CredentialCriteriaCourseId to reference the course completed.</dc:description>
		<skos:definition>References information related to a specific course instance(CousreSection) that a Person completed to qualify for a CredentialAward using MembershipId and/or it could use CredentialCriteriaCourseId to reference the course completed.</skos:definition>
