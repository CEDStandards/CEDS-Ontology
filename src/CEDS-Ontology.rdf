	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162856">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>IB Language B�French courses prepare students to take the International Baccalaureate Language B exams. These courses focus on improving students' accuracy and fluency in oral and written communication (usually in the students' "second" language).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162856</dc:identifier>
