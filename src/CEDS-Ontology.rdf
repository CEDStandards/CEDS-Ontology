		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Assessment Score Metric Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>The specific method used to report the performance and achievement of the assessment. This is the metric that is being used to derive the scores.</skos:definition>
		<skos:notation>AssessmentScoreMetricType</skos:notation>
		<skos:prefLabel>Assessment Score Metric Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000035">
