	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163602">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Drama�General courses involve content that is not grade differentiated and may apply to a range of consecutive grades (e.g., "by third grade, students should know and be able to do..."). These courses include content that may be applicable to states or localities that do not employ grade-level content standards. [These courses provide broad content that is not organized as described elsewhere (i.e., Drama, early childhood education through grade 8).]</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517163602</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
