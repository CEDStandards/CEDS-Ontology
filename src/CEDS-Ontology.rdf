	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000876">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Classification of the Competency Definition using intelligences defined for Howard Earl Gardner's Theory of Multiple Intelligences.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000876</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Competency Definition Multiple Intelligence</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
