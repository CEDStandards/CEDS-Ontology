	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001509105747">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child does not yet show functioning expected of a child his or her age in any situation. Child's functioning does not yet include immediate foundational skills upon which to build age-appropriate functioning. Child functioning reflects skills that developmentally come before immediate foundational skills.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001509105747</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Does not show functioning expected at age - does not include immediate foundational skills</rdfs:label>
		<skos:definition>Child does not yet show functioning expected of a child his or her age in any situation. Child's functioning does not yet include immediate foundational skills upon which to build age-appropriate functioning. Child functioning reflects skills that developmentally come before immediate foundational skills.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<skos:notation>01</skos:notation>
		<skos:prefLabel>Does not show functioning expected at age - does not include immediate foundational skills</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001509105748">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child occasionally uses immediate foundational skills across settings and situations. More functioning reflects skills that are not immediate foundational than are immediate foundational.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001509105748</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Occasionally uses immediate foundational skills across settings and situations</rdfs:label>
		<skos:definition>Child occasionally uses immediate foundational skills across settings and situations. More functioning reflects skills that are not immediate foundational than are immediate foundational.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001509"/>
		<skos:notation>02</skos:notation>
		<skos:prefLabel>Occasionally uses immediate foundational skills across settings and situations</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001509105749">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child does not yet show functioning expected of a child of his or her age in any situation. Child uses immediate foundational skills, most or all of the time, across settings and situations. Immediate foundational skills are the skills upon which to build age-appropriate functioning.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001509105749</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Does not show functioning expected at age - uses immediate foundational skills</rdfs:label>
		<skos:definition>Child does not yet show functioning expected of a child of his or her age in any situation. Child uses immediate foundational skills, most or all of the time, across settings and situations. Immediate foundational skills are the skills upon which to build age-appropriate functioning.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<skos:notation>03</skos:notation>
		<skos:prefLabel>Does not show functioning expected at age - uses immediate foundational skills</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001509105750">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child shows occasional age-appropriate functioning across settings and situations. More functioning is not age-appropriate than age-appropriate.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001509105750</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Shows occasional age-appropriate functioning across settings and situations</rdfs:label>
		<skos:definition>Child shows occasional age-appropriate functioning across settings and situations. More functioning is not age-appropriate than age-appropriate.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<skos:notation>04</skos:notation>
		<skos:prefLabel>Shows occasional age-appropriate functioning across settings and situations</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001509105751">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child shows functioning expected for his or her age some of the time and/or in some settings and situations. Child's functioning is a mix of age-appropriate and not age-appropriate behaviors and skills.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001509105751</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Shows functioning expected at age some of the time and/or in some settings and situations</rdfs:label>
		<skos:definition>Child shows functioning expected for his or her age some of the time and/or in some settings and situations. Child's functioning is a mix of age-appropriate and not age-appropriate behaviors and skills.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<skos:notation>05</skos:notation>
		<skos:prefLabel>Shows functioning expected at age some of the time and/or in some settings and situations</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001509105752">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child's functioning generally is considered appropriate for his or her age but there are some significant concerns about the child's functioning in this outcome area. These concerns are substantial enough to suggest monitoring or possible additional support.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001509105752</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Functioning generally is considered appropriate for age but there are some significant concerns</rdfs:label>
		<skos:definition>Child's functioning generally is considered appropriate for his or her age but there are some significant concerns about the child's functioning in this outcome area. These concerns are substantial enough to suggest monitoring or possible additional support.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<skos:notation>06</skos:notation>
		<skos:prefLabel>Functioning generally is considered appropriate for age but there are some significant concerns</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001509105753">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child shows functioning expected for his or her age in all or almost all everyday situations that are part of the child's life. Functioning is considered appropriate for his or her age.</dc:description>
