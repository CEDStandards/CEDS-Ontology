	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164524">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>IB Language A: Literature�Danish courses prepare students to take the International Baccalaureate Language A: Literature exams. Course content includes in-depth study of a range of literary texts in a number of literary forms and from different times and places, written analyses and critiques of this literature, and other oral and written assignments. The course is designed for students highly competent in using Danish in an academic context and is intended for students with native or near-native fluency in the language.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164524</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>IB Language A: Literature�Danish</rdfs:label>
		<skos:definition>IB Language A: Literature�Danish courses prepare students to take the International Baccalaureate Language A: Literature exams. Course content includes in-depth study of a range of literary texts in a number of literary forms and from different times and places, written analyses and critiques of this literature, and other oral and written assignments. The course is designed for students highly competent in using Danish in an academic context and is intended for students with native or near-native fluency in the language.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24269</skos:notation>
		<skos:prefLabel>IB Language A: Literature�Danish</skos:prefLabel>
	</owl:NamedIndividual>
