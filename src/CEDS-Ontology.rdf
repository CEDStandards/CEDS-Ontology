		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200056" />
		<skos:notation>hasAuthorizationDocument</skos:notation>
		<dc:description>References information about a document that authorizes a deision or plan such as a document authorizing an IEP.</dc:description>
		<skos:definition>References information about a document that authorizes a deision or plan such as a document authorizing an IEP.</skos:definition>
		<editHistory rdf:parseType="Collection">
