	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002074181488">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>This type of job comprises positions and assignments that provide non-instructional services to support the general welfare of students, including students with disabilities.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002074181488</dc:identifier>
