	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000574">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000574</dc:identifier>
