		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Pre-conviction facility</rdfs:label>
		<skos:definition>Confines pre-convicted adults. A pre-convicted adult is an individual (typically 21 years of age or older) who has been charged, but who has not participated in the court process that determines (judges) if the adult committed the act for which the adult is charged.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002192" />
		<skos:notation>Preconviction</skos:notation>
		<skos:prefLabel>Pre-conviction facility</skos:prefLabel>
