		<skos:notation>hasLearningResourcePhysicalMedia</skos:notation>
		<dc:description>References information about physical media on which the Learning Resource is delivered or available.</dc:description>
		<skos:definition>References information about physical media on which the Learning Resource is delivered or available.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
