	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000784">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000784</dc:identifier>
		<rdfs:label>Has Adult Education Postsecondary Transition Action</rdfs:label>
