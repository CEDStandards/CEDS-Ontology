		<skos:definition>Person-level employment and earnings information from quarterly employment and earnings-related data from sources such as State UI Wage Records, the Wage Record Interchange System, or the Federal Employment Data Exchange System (FEDES).</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200381">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200381</dc:identifier>
		<rdfs:label>Recruiter</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>Recruiter</skos:notation>
		<dc:description>An organization responsible for identifying and/or selecting prospective employees to fill vacant positions in an organization.</dc:description>
		<skos:definition>An organization responsible for identifying and/or selecting prospective employees to fill vacant positions in an organization.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200394">
