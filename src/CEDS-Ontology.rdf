		<skos:notation>CredentialAwardRelationshipDetail</skos:notation>
		<dc:description>The relationship between two credential awards, genrally used to capture extentions to an award (e.g., An endorsement for a teaching license).</dc:description>
		<skos:definition>The relationship between two credential awards, genrally used to capture extentions to an award (e.g., An endorsement for a teaching license).</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200087">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200087</dc:identifier>
		<rdfs:label>Credential Definition</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CredentialDefinition</skos:notation>
		<dc:description>Defines a qualification, achievement, personal or organizational quality, or aspect of an identity typically used to indicate suitability.</dc:description>
		<skos:definition>Defines a qualification, achievement, personal or organizational quality, or aspect of an identity typically used to indicate suitability.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200083">
