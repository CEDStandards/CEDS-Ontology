		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200089" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200088" />
		<skos:notation>hasCredentialIssuer</skos:notation>
		<dc:description>References an organization or person that issues a credential.</dc:description>
		<skos:definition>References an organization or person that issues a credential.</skos:definition>
		<editHistory rdf:parseType="Collection">
