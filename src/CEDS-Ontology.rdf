	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163021">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Vietnamese for Young Learners (prior-to-secondary) courses provide instruction at multiple grade levels in Vietnamese and may apply to a range of consecutive grades. These courses prepare students to communicate authentically in Vietnamese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on concrete topics. These courses introduce the relationships among the products, practices, and perspectives of Vietnamese-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517163021</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Vietnamese for Young Learners (prior-to-secondary)</rdfs:label>
		<skos:definition>Vietnamese for Young Learners (prior-to-secondary) courses provide instruction at multiple grade levels in Vietnamese and may apply to a range of consecutive grades. These courses prepare students to communicate authentically in Vietnamese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on concrete topics. These courses introduce the relationships among the products, practices, and perspectives of Vietnamese-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24550</skos:notation>
		<skos:prefLabel>Vietnamese for Young Learners (prior-to-secondary)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163022">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Vietnamese Immersion (prior-to-secondary) courses engage students in developmentally appropriate activities to acquire literacy in Vietnamese and grade-specific content using Vietnamese as the language of instruction. Vietnamese Immersion courses prepare students to communicate authentically in Vietnamese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information about standards-based academic content and incorporate the relationships among the products, practices, and perspectives of Vietnamese-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517163022</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Vietnamese Immersion (prior-to-secondary)</rdfs:label>
		<skos:definition>Vietnamese Immersion (prior-to-secondary) courses engage students in developmentally appropriate activities to acquire literacy in Vietnamese and grade-specific content using Vietnamese as the language of instruction. Vietnamese Immersion courses prepare students to communicate authentically in Vietnamese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information about standards-based academic content and incorporate the relationships among the products, practices, and perspectives of Vietnamese-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24551</skos:notation>
		<skos:prefLabel>Vietnamese Immersion (prior-to-secondary)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163023">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Designed to introduce students to Vietnamese language and culture, Vietnamese I courses prepare students to communicate authentically in Vietnamese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on a variety of topics. They introduce the relationships among the products, practices, and perspectives of Vietnamese-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517163023</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Vietnamese I</rdfs:label>
		<skos:definition>Designed to introduce students to Vietnamese language and culture, Vietnamese I courses prepare students to communicate authentically in Vietnamese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on a variety of topics. They introduce the relationships among the products, practices, and perspectives of Vietnamese-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24552</skos:notation>
