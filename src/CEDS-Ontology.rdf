	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001261">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001261</dc:identifier>
		<rdfs:label>Has Assessment Item Linking Item Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001261" />
		<skos:notation>hasAssessmentItemLinkingItemIndicator</skos:notation>
		<dc:description>Indicates that the item is intended to be administered in two different grades for the goal of establishing cross grade comparison.</dc:description>
		<skos:definition>Indicates that the item is intended to be administered in two different grades for the goal of establishing cross grade comparison.</skos:definition>
