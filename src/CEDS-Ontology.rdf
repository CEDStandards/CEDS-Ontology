	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001831">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001831</dc:identifier>
		<rdfs:label>Has Building Space Design Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200058" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001831" />
		<skos:notation>hasBuildingSpaceDesignType</skos:notation>
		<dc:description>The primary design or purpose of a space, as determined by its physical layout and built-in systems and equipment, regardless of its current use.</dc:description>
		<skos:definition>The primary design or purpose of a space, as determined by its physical layout and built-in systems and equipment, regardless of its current use.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001902">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001902</dc:identifier>
		<rdfs:label>Has Available Utilized Instructional Space</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200059" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001902" />
		<skos:notation>hasAvailableUtilizedInstructionalSpace</skos:notation>
		<dc:description>An indication that the instruction space in a school is used in the calculation of student capacity.</dc:description>
		<skos:definition>An indication that the instruction space in a school is used in the calculation of student capacity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001903">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001903</dc:identifier>
		<rdfs:label>Has Building Capacity Factor Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200059" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001903" />
		<skos:notation>hasBuildingCapacityFactorIndicator</skos:notation>
		<dc:description>A designation as to whether the space is included in the calculation of school building capacity under state or local guidelines.</dc:description>
		<skos:definition>A designation as to whether the space is included in the calculation of school building capacity under state or local guidelines.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001863">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001863</dc:identifier>
		<rdfs:label>Has Building Unassigned Space Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200059" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001863" />
		<skos:notation>hasBuildingUnassignedSpaceIndicator</skos:notation>
		<dc:description>An indication that the space in a school, including circulation, administration offices, support spaces, and common areas, is not part of the calculation for capacity.</dc:description>
		<skos:definition>An indication that the space in a school, including circulation, administration offices, support spaces, and common areas, is not part of the calculation for capacity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001832">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001832</dc:identifier>
		<rdfs:label>Has Building Special Education Specialty Space Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200058" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001832" />
		<skos:notation>hasBuildingSpecialEducationSpecialtySpaceType</skos:notation>
		<dc:description>The space designed, located, furnished, and equipped to support instruction of children with special physical, emotional, and/or educational needs.</dc:description>
		<skos:definition>The space designed, located, furnished, and equipped to support instruction of children with special physical, emotional, and/or educational needs.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001833">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001833</dc:identifier>
		<rdfs:label>Has Building Student Support Space Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200058" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001833" />
		<skos:notation>hasBuildingStudentSupportSpaceType</skos:notation>
		<dc:description>The space designed to provide student support services such as administrative, technical (e.g., guidance and health), and logistical support to facilitate and enhance instruction.</dc:description>
		<skos:definition>The space designed to provide student support services such as administrative, technical (e.g., guidance and health), and logistical support to facilitate and enhance instruction.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600296">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600296</dc:identifier>
		<rdfs:label>Has Building System Category</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200061" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200060" />
		<skos:notation>hasBuildingSystemCategory</skos:notation>
		<dc:description>References type of building within a school such as a playground, gym, or classroom.</dc:description>
		<skos:definition>References type of building within a school such as a playground, gym, or classroom.</skos:definition>
