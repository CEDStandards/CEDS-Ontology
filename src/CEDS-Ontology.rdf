	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173078">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A public or private institution, organization, or agency that provides instructional or support services to students or staff at any level.</dc:description>
