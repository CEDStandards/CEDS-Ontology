	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001876129113">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A plan that addresses the maintenance in which a critical system, component, equipment, or furnishing breaks down and must be repaired to secure the safety of students, staff, or visitors and/or for operation of the program or service to continue. Unexpected events beyond normal wear and tear may mandate overtime, as situations may have to be dealt with immediately.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001876129113</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Emergency maintenance repair</rdfs:label>
		<skos:definition>A plan that addresses the maintenance in which a critical system, component, equipment, or furnishing breaks down and must be repaired to secure the safety of students, staff, or visitors and/or for operation of the program or service to continue. Unexpected events beyond normal wear and tear may mandate overtime, as situations may have to be dealt with immediately.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<skos:notation>02989</skos:notation>
		<skos:prefLabel>Emergency maintenance repair</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001876129114">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The process of monitoring selected performance data for a system, component, or equipment against a baseline reference to identify and predict impending failures for just-in-time maintenance attention. A system of maintenance in which computers and software are used to forecast the failure of a piece of equipment based on its age, user demand, and various performance measures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001876129114</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Predictive</rdfs:label>
		<skos:definition>The process of monitoring selected performance data for a system, component, or equipment against a baseline reference to identify and predict impending failures for just-in-time maintenance attention. A system of maintenance in which computers and software are used to forecast the failure of a piece of equipment based on its age, user demand, and various performance measures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<skos:notation>02839</skos:notation>
		<skos:prefLabel>Predictive</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001876129115">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The process of performing scheduled equipment inspection, testing, and repair services. Activities are performed on a scheduled basis annually, or more frequently, to identify additional maintenance or required systems testing.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001876129115</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Preventive</rdfs:label>
		<skos:definition>The process of performing scheduled equipment inspection, testing, and repair services. Activities are performed on a scheduled basis annually, or more frequently, to identify additional maintenance or required systems testing.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<skos:notation>02838</skos:notation>
		<skos:prefLabel>Preventive</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001876129116">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A work-order based approach to maintenance that addresses lists of broken items, deteriorated finishes or equipment/parts nearing the end of their life cycle, maintenance required as a result of normal wear and tear, equipment/parts that should be fixed or replaced during a regular work day eliminating the need for overtime pay.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001876129116</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Routine</rdfs:label>
		<skos:definition>A work-order based approach to maintenance that addresses lists of broken items, deteriorated finishes or equipment/parts nearing the end of their life cycle, maintenance required as a result of normal wear and tear, equipment/parts that should be fixed or replaced during a regular work day eliminating the need for overtime pay.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<skos:notation>02837</skos:notation>
		<skos:prefLabel>Routine</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001876129117">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An approach to maintenance in which management allows equipment and parts to run until they break down or wear out beyond repair.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001876129117</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Run to fail</rdfs:label>
		<skos:definition>An approach to maintenance in which management allows equipment and parts to run until they break down or wear out beyond repair.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001876" />
		<skos:notation>02836</skos:notation>
		<skos:prefLabel>Run to fail</skos:prefLabel>
	</owl:NamedIndividual>
