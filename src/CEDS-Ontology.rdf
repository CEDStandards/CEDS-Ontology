		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentActivityDescription</skos:notation>
		<dc:description>A description of the content covered in the professional development activity.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the content covered in the professional development activity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001440">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001440</dc:identifier>
		<rdfs:label>Professional Development Activity Objective</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200311" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentActivityObjective</skos:notation>
		<dc:description>The expected outcomes of a participant in an activity.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The expected outcomes of a participant in an activity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000804">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000804</dc:identifier>
		<rdfs:label>Required Training Clock Hours</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200312" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>RequiredTrainingClockHours</skos:notation>
		<dc:description>Number of clock hours of training required for providers to meet requirements of the state.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>Number of clock hours of training required for providers to meet requirements of the state.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001443">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001443</dc:identifier>
		<rdfs:label>Professional Development Funding Source</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentFundingSource</skos:notation>
		<dc:description>The primary source of funding for a professional development session.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The primary source of funding for a professional development session.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001446">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001446</dc:identifier>
		<rdfs:label>Professional Development Session Capacity</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>ProfessionalDevelopmentSessionCapacity</skos:notation>
		<dc:description>The total number of participants that can be accommodated by a professional development session.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The total number of participants that can be accommodated by a professional development session.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001447">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001447</dc:identifier>
		<rdfs:label>Professional Development Session End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ProfessionalDevelopmentSessionEndDate</skos:notation>
		<dc:description>The year, month and day a professional development session ends.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day a professional development session ends.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001448">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001448</dc:identifier>
		<rdfs:label>Professional Development Session End Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentSessionEndTime</skos:notation>
		<dc:description>The time at which a professional development session ends.</dc:description>
		<textFormat>HH:MM</textFormat>
		<skos:definition>The time at which a professional development session ends.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001449">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001449</dc:identifier>
		<rdfs:label>Professional Development Session Evaluation Method</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentSessionEvaluationMethod</skos:notation>
		<dc:description>The method used to evaluate a professional development session.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The method used to evaluate a professional development session.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001450">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001450</dc:identifier>
		<rdfs:label>Professional Development Session Evaluation Score</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentSessionEvaluationScore</skos:notation>
		<dc:description>The score or rating used to determine if a professional development session was successful.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The score or rating used to determine if a professional development session was successful.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001451">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001451</dc:identifier>
		<rdfs:label>Professional Development Activity Expiration Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ProfessionalDevelopmentActivityExpirationDate</skos:notation>
		<dc:description>The year, month, and day on which any certificate awarded as part of a professional development activity expires.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month, and day on which any certificate awarded as part of a professional development activity expires.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001452">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001452</dc:identifier>
		<rdfs:label>Professional Development Session Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentSessionIdentifier</skos:notation>
		<dc:description>The unique, non-duplicated,  identification number assigned by the registry data system for a session of a particular professional development activity.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The unique, non-duplicated,  identification number assigned by the registry data system for a session of a particular professional development activity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001454">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001454</dc:identifier>
		<rdfs:label>Professional Development Session Location Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentSessionLocationName</skos:notation>
		<dc:description>The name of a location where a professional development session will be held.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of a location where a professional development session will be held.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001455">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001455</dc:identifier>
		<rdfs:label>Professional Development Session Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ProfessionalDevelopmentSessionStartDate</skos:notation>
		<dc:description>The year, month, and day a professional development session begins.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month, and day a professional development session begins.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001456">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001456</dc:identifier>
		<rdfs:label>Professional Development Session Start Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ProfessionalDevelopmentSessionStartTime</skos:notation>
		<dc:description>The time at which a professional development session begins.</dc:description>
		<textFormat>HH:MM</textFormat>
		<skos:definition>The time at which a professional development session begins.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001489">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001489</dc:identifier>
		<rdfs:label>Sponsoring Agency Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>SponsoringAgencyName</skos:notation>
		<dc:description>The name of the sponsoring agency.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the sponsoring agency.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001628">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001628</dc:identifier>
		<rdfs:label>Training and Technical Assistance Level</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>TrainingAndTechnicalAssistanceLevel</skos:notation>
		<dc:description>The level of expertise an individual training and technical assistance specialist has based on a set of established criteria.</dc:description>
		<rdfs:comment>Technical assistance may be for organizations or staff depending on context. See the document &lt;a href="https://ceds.ed.gov/pdf/ceds-addresses-professional-development-data-elements.pdf"&gt;https://ceds.ed.gov/pdf/ceds-addresses-professional-development-data-elements.pdf&lt;/a&gt;.</rdfs:comment>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The level of expertise an individual training and technical assistance specialist has based on a set of established criteria.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add usage note to make it clear that "technical assistance" may have to do with assistance to organizations or individuals including professional development.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000790">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000790</dc:identifier>
		<rdfs:label>Proxy Contact Hours</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200316" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>ProxyContactHours</skos:notation>
		<dc:description>The number of instructional hours completed by an adult enrolled in a distance learning program.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>1</decimalPlaces>
		<skos:definition>The number of instructional hours completed by an adult enrolled in a distance learning program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001081">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001081</dc:identifier>
		<rdfs:label>Adult Education Postsecondary Transition Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200316" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AdultEducationPostsecondaryTransitionDate</skos:notation>
		<dc:description>The year, month and day on which a person previously enrolled in adult education entered and began to receive instructional services or training at a postsecondary institution.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day on which a person previously enrolled in adult education entered and began to receive instructional services or training at a postsecondary institution.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001583">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001583</dc:identifier>
		<rdfs:label>Career Pathways Program Participation Exit Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CareerPathwaysProgramParticipationExitDate</skos:notation>
		<dc:description>The year, month and day on which the person ceased to participate in a program.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day on which the person ceased to participate in a program.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001584">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001584</dc:identifier>
		<rdfs:label>Career Pathways Program Participation Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CareerPathwaysProgramParticipationStartDate</skos:notation>
		<dc:description>The year, month and day on which the person began to participate in a career pathway program.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day on which the person began to participate in a career pathway program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000171">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000171</dc:identifier>
		<rdfs:label>Last Qualifying Move Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>LastQualifyingMoveDate</skos:notation>
		<dc:description>The year, month and day of the last qualifying move of a migrant student.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day of the last qualifying move of a migrant student.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000430">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000430</dc:identifier>
		<rdfs:label>Migrant Education Program Eligibility Expiration Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>MigrantEducationProgramEligibilityExpirationDate</skos:notation>
		<dc:description>The year, month, and day on which the child is no longer eligible for the Migrant Education Program. This date should initially be a date equal to 36 months from the Qualifying Arrival Date to indicate the end of MEP eligibility or the student reaches 22 years of age, whichever comes first.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month, and day on which the child is no longer eligible for the Migrant Education Program. This date should initially be a date equal to 36 months from the Qualifying Arrival Date to indicate the end of MEP eligibility or the student reaches 22 years of age, whichever comes first.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000432">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000432</dc:identifier>
		<rdfs:label>Migrant Student Qualifying Arrival Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>MigrantStudentQualifyingArrivalDate</skos:notation>
		<dc:description>The qualifying arrival date (QAD) is the month, date, and year that the child completed a move with his or her parent to enable the parent to find qualifying employment. In some cases, the child and worker may not always move together, in which case the QAD would be the date that the child joins the worker who has  already moved, or the date the worker joins the child who has already moved. The QAD is the date the child's eligibility for the Migrant Education Program begins.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The qualifying arrival date (QAD) is the month, date, and year that the child completed a move with his or her parent to enable the parent to find qualifying employment. In some cases, the child and worker may not always move together, in which case the QAD would be the date that the child joins the worker who has  already moved, or the date the worker joins the child who has already moved. The QAD is the date the child's eligibility for the Migrant Education Program begins.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000433">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000433</dc:identifier>
		<rdfs:label>Qualifying Move From City</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>QualifyingMoveFromCity</skos:notation>
		<dc:description>The name of the city in which the child resided prior to the qualifying move.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the city in which the child resided prior to the qualifying move.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000436">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000436</dc:identifier>
		<rdfs:label>Designated Graduation School Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>DesignatedGraduationSchoolIdentifier</skos:notation>
		<dc:description>The NCES school identification number that identifies the school or facility from which a student expects to graduate.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The NCES school identification number that identifies the school or facility from which a student expects to graduate.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000263">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000263</dc:identifier>
		<rdfs:label>Special Education Services Exit Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200322" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>SpecialEducationServicesExitDate</skos:notation>
		<dc:description>The year, month and day a child with disabilities (IDEA) ages 14 through 21 exited special education.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day a child with disabilities (IDEA) ages 14 through 21 exited special education.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001242">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001242</dc:identifier>
		<rdfs:label>Special Education Full Time Equivalency</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200322" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200360" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>SpecialEducationFTE</skos:notation>
		<dc:description>Calculated ratio of time the student is in a special education setting. Values range from 0.00 to 1.00. If the student is in a special education setting 25% of the time, the value is .25; if 100% of the time, the value is 1.00.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>1</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>Calculated ratio of time the student is in a special education setting. Values range from 0.00 to 1.00. If the student is in a special education setting 25% of the time, the value is .25; if 100% of the time, the value is 1.00.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001704">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001704</dc:identifier>
		<rdfs:label>IDEA Placement Rationale</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200322" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>IDEAPlacementRationale</skos:notation>
		<dc:description>The rationale for the placement decision and if applicable, an explanation of the extent, if any, to which the child will not participate with nondisabled children in the regular class and in the activities described in paragraph (a)(4) of CFR. �300.320.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The rationale for the placement decision and if applicable, an explanation of the extent, if any, to which the child will not participate with nondisabled children in the regular class and in the activities described in paragraph (a)(4) of CFR. �300.320.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000772">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000772</dc:identifier>
		<rdfs:label>Supervised Clinical Experience Clock Hours</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200323" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>SupervisedClinicalExperienceClockHours</skos:notation>
		<dc:description>An indication of  the number of clock hours (minimum) a student is required to complete associated with a supervised clinical experience.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>An indication of  the number of clock hours (minimum) a student is required to complete associated with a supervised clinical experience.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000989">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000989</dc:identifier>
		<rdfs:label>Quarterly Earnings</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200347" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>QuarterlyEarnings</skos:notation>
		<dc:description>The quarterly amount paid to individuals found employed during the reference period.</dc:description>
		<rdfs:comment>Workforce Notes: Quarterly earnings are the sum of all the reported earnings for each individual for all jobs held during the reference quarter. "Reference" quarter is the period of employment defined by the agency for its purposes either for students who are enrolled or after they exit. The amount is expressed as a numeric dollar amount. Note that it may be desirable to collect these data over time, in a longitudinal sense, to measure things related to persistence and growth in employment.</rdfs:comment>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The quarterly amount paid to individuals found employed during the reference period.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Quarterly Employment Record Earnings.  Updated definition.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000992">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000992</dc:identifier>
		<rdfs:label>Employment Record Reference Period Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200347" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>EmploymentRecordReferencePeriodStartDate</skos:notation>
		<dc:description>The year, month, and day of the first day of the employment record reference period.</dc:description>
		<rdfs:comment>The reference quarter is the 13-week period around which employment and earnings data are collected. For unemployment insurance purposes, quarters are defined by 13-week periods. In most state cases, a reference quarter is defined to coincide with an enrollment period (e.g., a term or semester) or as a certain number of quarters after exiting a program, such as "3d quarter after exit." In some cases, states have defined the reference quarter to represent a period where employment and earnings data are collected for all of a previous year's exits and graduates. This is often the October- December quarter. Ultimately, the most value to be gained from the use of employment and earnings data is when data are collected continuously, both in a longitudinal sense for defined cohorts of students, as well as for an "annual set" of students.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month, and day of the first day of the employment record reference period.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Quarterly Employment Record Reference Quarter Start Date.  Updated definitioin.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000993">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000993</dc:identifier>
		<rdfs:label>Employment Record Reference Period End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200347" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>EmploymentRecordReferencePeriodEndDate</skos:notation>
		<dc:description>The year, month, and day of the last day of the employment record reference period.</dc:description>
		<rdfs:comment>The reference quarter is the 13-week period around which employment and earnings data are collected. For unemployment insurance purposes, quarters are defined by 13-week periods. In most state cases, a reference quarter is defined to coincide with an enrollment period (e.g., a term or semester) or as a certain number of quarters after exiting a program, such as "3d quarter after exit." In some cases, states have defined the reference quarter to represent a period where employment and earnings data are collected for all of a previous year's exits and graduates. This is often the October - December quarter. Ultimately, the most value to be gained from the use of employment and earnings data is when data are collected continuously, both in a longitudinal sense for defined cohorts of students, as well as for an "annual set" of students.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month, and day of the last day of the employment record reference period.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Quarterly Employment Record Reference Quarter End Date.  Updated definiton.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000201">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000201</dc:identifier>
		<rdfs:label>Number of Days Absent</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200350" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>NumberOfDaysAbsent</skos:notation>
		<dc:description>The number of days a person is absent when school is in session during a given reporting period.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The number of days a person is absent when school is in session during a given reporting period.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000271">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000271</dc:identifier>
		<rdfs:label>Student Attendance Rate</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200350" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>StudentAttendanceRate</skos:notation>
		<dc:description>The number of school days during the regular school year (plus summer, if applicable, if part of implementing the restart, transformation, or turnaround model) the student attended school divided by the maximum number of days the student could have attended school during the regular school year.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>1</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>6</decimalPlaces>
		<skos:definition>The number of school days during the regular school year (plus summer, if applicable, if part of implementing the restart, transformation, or turnaround model) the student attended school divided by the maximum number of days the student could have attended school during the regular school year.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001957">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001957</dc:identifier>
		<rdfs:label>Number of Days Tardy</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200350" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>NumberofDaysTardy</skos:notation>
		<dc:description>The number of days a person is tardy when school is in session during a given reporting period.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The number of days a person is tardy when school is in session during a given reporting period.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001649">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001649</dc:identifier>
		<rdfs:label>Attendance Event Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200351" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AttendanceEventDate</skos:notation>
		<dc:description>The date on which an attendance event takes place.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which an attendance event takes place.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002014">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002014</dc:identifier>
		<rdfs:label>Attendance Event Duration Minutes</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200351" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AttendanceEventDurationMinutes</skos:notation>
		<dc:description>The duration of the attendance event in minutes.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The duration of the attendance event in minutes.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002015">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002015</dc:identifier>
		<rdfs:label>Attendance Event Duration Hours</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200351" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AttendanceEventDurationHours</skos:notation>
		<dc:description>The duration of the attendance event in hours.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The duration of the attendance event in hours.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002098">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002098</dc:identifier>
		<rdfs:label>Attendance Event Duration Day</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200351" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AttendanceEventDurationDay</skos:notation>
		<dc:description>The duration of the attendance event captured as one whole day or a portion of a day.</dc:description>
		<rdfs:comment>When used to capture daily attendance, 1.0 would represent a whole day. Other examples would include 0.5 as a half-day and 0.33 as one-third of a day. For capturing course section attendance, the recommendation would be to use the element "Attendance Event Duration Minutes".</rdfs:comment>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The duration of the attendance event captured as one whole day or a portion of a day.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000975">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000975</dc:identifier>
		<rdfs:label>Course Section Enrollment Status End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>CourseSectionEnrollmentStatusEndDate</skos:notation>
		<dc:description>The date on which the enrollment status ended related to a student enrolled in an instance of a course.</dc:description>
		<rdfs:comment>Enrollment statuses may overlap, for example at one point in time a student may be both pre-registered and wait-listed for enrollment in a course, the start dates may be different and the end dates may be the same as the start date for "enrolled" status when the student moves off the wait list. All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the enrollment status ended related to a student enrolled in an instance of a course.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Class Section Enrollment Status End Date.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000421">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000421</dc:identifier>
		<rdfs:label>Rubric Title</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200353" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentRubricTitle</skos:notation>
		<dc:description>The title of the rubric.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The title of the rubric.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Assessment Item Rubric Name.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000422">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000422</dc:identifier>
		<rdfs:label>Rubric Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200353" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentRubricIdentifier</skos:notation>
		<dc:description>An identifier assigned to a rubric.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An identifier assigned to a rubric.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Assessment Item Rubric Identifier.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000423">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000423</dc:identifier>
		<rdfs:label>Rubric URL Reference</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200353" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentRubricURLReference</skos:notation>
		<dc:description>The URL location where the rubric may be found.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The URL location where the rubric may be found.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Assessment Item Rubric URL Reference.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001479">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001479</dc:identifier>
		<rdfs:label>Rubric Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200353" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>RubricDescription</skos:notation>
		<dc:description>Text describing the intended use of the rubric.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Text describing the intended use of the rubric.</skos:definition>
