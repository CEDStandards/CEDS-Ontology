	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000768">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000768</dc:identifier>
		<rdfs:label>Has Teacher Preparation Program Completer Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200323" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000768" />
		<skos:notation>hasTeacherPreparationProgramCompleterStatus</skos:notation>
		<dc:description>An indication of whether a person completed a state-approved teacher preparation program.  The fact that a person has or has not been recommended to the state for initial certification or licensure may not be used as a criterion for determining who is a program completer.</dc:description>
		<skos:definition>An indication of whether a person completed a state-approved teacher preparation program. The fact that a person has or has not been recommended to the state for initial certification or licensure may not be used as a criterion for determining who is a program completer.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000767">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000767</dc:identifier>
		<rdfs:label>Has Teacher Preparation Program Enrollment Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200323" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200352" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000767" />
		<skos:notation>hasTeacherPreparationProgramEnrollmentStatus</skos:notation>
		<dc:description>An indication of whether a person is pursuing certification as a teacher.</dc:description>
		<skos:definition>An indication of whether a person is pursuing certification as a teacher.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000648">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000648</dc:identifier>
		<rdfs:label>Has Teaching Assignment Role</rdfs:label>
