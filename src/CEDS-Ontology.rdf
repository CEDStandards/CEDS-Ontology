		<skos:notation>AssessmentPersonalNeedsProfileActivateByDefault</skos:notation>
		<skos:prefLabel>Assessment Personal Needs Profile Activate by Default</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001007">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>If this score is preliminary, then this attribute value should be set. Preliminary scores may be provided for early use by the assessment program or user while final scoring is occurring.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001007</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Assessment Result Preliminary Indicator</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>If this score is preliminary, then this attribute value should be set. Preliminary scores may be provided for early use by the assessment program or user while final scoring is occurring.</skos:definition>
		<skos:notation>AssessmentResultPreliminaryIndicator</skos:notation>
		<skos:prefLabel>Assessment Result Preliminary Indicator</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001001">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Program ensures that policies are in place for Individualized Education Programs (IEPs) or Individual Family Service Plans (IFSPs) to meet the child's unique needs.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001001</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Special Needs Policy</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>Program ensures that policies are in place for Individualized Education Programs (IEPs) or Individual Family Service Plans (IFSPs) to meet the child's unique needs.</skos:definition>
		<skos:notation>SpecialNeedsPolicy</skos:notation>
		<skos:prefLabel>Special Needs Policy</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001016">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Indicates if this registration is for a retest (retake). Retest can occur if a student failed a prior attempt and is eligible to retake. Other retest scenarios also can occur.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001016</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Assessment Registration Retest Indicator</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Indicates if this registration is for a retest (retake). Retest can occur if a student failed a prior attempt and is eligible to retake. Other retest scenarios also can occur.</skos:definition>
		<skos:notation>AssessmentRegistrationRetestIndicator</skos:notation>
		<skos:prefLabel>Assessment Registration Retest Indicator</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001030">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the Access for All (AfA) preference to invert the foreground and background Colors.</dc:description>
