		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002095</dc:identifier>
		<rdfs:label>Learning Resource Ordered Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200233" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>LearningResourceOrderedDate</skos:notation>
		<dc:description>The date the learning resource was ordered for the student.</dc:description>
