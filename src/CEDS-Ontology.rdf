		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Loans Payable</rdfs:label>
		<skos:definition>An unconditional written promise signed by the maker to pay a certain sum of money 1 year or more after the issuance date.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001353" />
		<skos:notation>521</skos:notation>
		<skos:prefLabel>Loans Payable</skos:prefLabel>
	</owl:NamedIndividual>
