	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162881">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Portuguese for Young Learners (prior-to-secondary) courses provide instruction at multiple grade levels in Portuguese and may apply to a range of consecutive grades. These courses prepare students to communicate authentically in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on concrete topics. These courses introduce the relationships among the products, practices, and perspectives of Portuguese-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162881</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Portuguese for Young Learners (prior-to-secondary)</rdfs:label>
		<skos:definition>Portuguese for Young Learners (prior-to-secondary) courses provide instruction at multiple grade levels in Portuguese and may apply to a range of consecutive grades. These courses prepare students to communicate authentically in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on concrete topics. These courses introduce the relationships among the products, practices, and perspectives of Portuguese-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24200</skos:notation>
		<skos:prefLabel>Portuguese for Young Learners (prior-to-secondary)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162882">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Portuguese Immersion (prior-to-secondary) courses engage students in developmentally appropriate activities to acquire literacy in Portuguese and grade-specific content using Portuguese as the language of instruction. Portuguese Immersion courses prepare students to communicate authentically in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information about standards-based academic content and incorporate the relationships among the products, practices, and perspectives of Portuguese-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162882</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Portuguese Immersion (prior-to-secondary)</rdfs:label>
		<skos:definition>Portuguese Immersion (prior-to-secondary) courses engage students in developmentally appropriate activities to acquire literacy in Portuguese and grade-specific content using Portuguese as the language of instruction. Portuguese Immersion courses prepare students to communicate authentically in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information about standards-based academic content and incorporate the relationships among the products, practices, and perspectives of Portuguese-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24201</skos:notation>
		<skos:prefLabel>Portuguese Immersion (prior-to-secondary)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162883">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Designed to introduce students to Portuguese language and culture, Portuguese I courses prepare students to communicate authentically in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on a variety of topics. They introduce the relationships among the products, practices, and perspectives of Portuguese-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162883</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Portuguese I</rdfs:label>
		<skos:definition>Designed to introduce students to Portuguese language and culture, Portuguese I courses prepare students to communicate authentically in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on a variety of topics. They introduce the relationships among the products, practices, and perspectives of Portuguese-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24202</skos:notation>
		<skos:prefLabel>Portuguese I</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162884">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Portuguese II courses build upon skills developed in Portuguese I, preparing students to communicate authentically in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on concrete topics. Portuguese II courses introduce the relationships among the products, practices, and perspectives of Portuguese-speaking cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162884</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Portuguese II</rdfs:label>
		<skos:definition>Portuguese II courses build upon skills developed in Portuguese I, preparing students to communicate authentically in Portuguese by interpreting (reading, listening, viewing), exchanging (speaking and listening; reading and writing), and presenting (speaking, writing) information on concrete topics. Portuguese II courses introduce the relationships among the products, practices, and perspectives of Portuguese-speaking cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24203</skos:notation>
