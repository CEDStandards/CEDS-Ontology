	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000277113645">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Associate's degree (two years or more) is the pre-determined criteria for granting the teaching credential that a person holds.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000277113645</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000277"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdfs:label>Associate's degree (two years or more)</rdfs:label>
		<skos:definition>Associate's degree (two years or more) is the pre-determined criteria for granting the teaching credential that a person holds.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000277"/>
		<skos:notation>01050</skos:notation>
		<skos:prefLabel>Associate's degree (two years or more)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000277113664">
