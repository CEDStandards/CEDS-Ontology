	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002087181577">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>National or community service refers to a service program that receives assistance under title I of the National and Community Service Act of 1990 (42 U.S.C. 12511 et seq.). Peace Corps refers to volunteers as described in section 5(a) of the Peace Corps Act (22 U.S.C. 2504(a)).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002087181577</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002087" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>National or community service or Peace Corps</rdfs:label>
		<skos:definition>National or community service refers to a service program that receives assistance under title I of the National and Community Service Act of 1990 (42 U.S.C. 12511 et seq.). Peace Corps refers to volunteers as described in section 5(a) of the Peace Corps Act (22 U.S.C. 2504(a)).</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002087" />
		<skos:notation>1003</skos:notation>
		<skos:prefLabel>National or community service or Peace Corps</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002087181578">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The indication of the post-program status of a CTE Concentrator in the second quarter after exiting from secondary education is an option other than the specific Perkins Post-Program Placement of: 1) Advanced training, 2) Military service, 3) National or community service or Peace Corps, 4) Employment, 5) Postsecondary education, 6) Postsecondary certificate, 7) Postsecondary associate degree, or 8) Postsecondary baccalaureate degree</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002087181578</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002087" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Not engaged Perkins Post-Program Placement</rdfs:label>
		<skos:definition>The indication of the post-program status of a CTE Concentrator in the second quarter after exiting from secondary education is an option other than the specific Perkins Post-Program Placement of: 1) Advanced training, 2) Military service, 3) National or community service or Peace Corps, 4) Employment, 5) Postsecondary education, 6) Postsecondary certificate, 7) Postsecondary associate degree, or 8) Postsecondary baccalaureate degree</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002087" />
		<skos:notation>9998</skos:notation>
		<skos:prefLabel>Not engaged Perkins Post-Program Placement</skos:prefLabel>
	</owl:NamedIndividual>
