				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		<editHistoryEntry>
				<changeDescription>Updating NCLB references in elements</changeDescription>
				<changeVersion>7.1</changeVersion>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that the student is participating in programs for neglected or delinquent students (N or D) under Title I, Part D, Subpart 1 (state agencies) or Subpart 2 (local agencies) of ESEA as amended.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002084">
