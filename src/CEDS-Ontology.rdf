			<editHistoryEntry> 	
				<changeDescription>Name changed from Class Section Instructional Delivery Mode.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The primary setting or medium of delivery for the course.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000258">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000258</dc:identifier>
		<rdfs:label>Has Course Section Single Sex Class Status</rdfs:label>
