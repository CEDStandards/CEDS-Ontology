		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<skos:notation>hasAssessmentItemApip</skos:notation>
		<dc:description>References accessible Portable Item Protocol information for an assessment item that may use the IMS Global APIP(R) standards.</dc:description>
