		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>RubricCriterionPosition</skos:notation>
		<dc:description>A numeric value representing this criterion's position in the criteria list for this rubric.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>A numeric value representing this criterion's position in the criteria list for this rubric.</skos:definition>
