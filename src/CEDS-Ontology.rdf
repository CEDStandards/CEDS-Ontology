	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162875">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>IB Language B�Italian courses prepare students to take the International Baccalaureate Language B exams. These courses focus on improving students' accuracy and fluency in oral and written communication (usually in the students' "second" language).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162875</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>IB Language B�Italian</rdfs:label>
		<skos:definition>IB Language B�Italian courses prepare students to take the International Baccalaureate Language B exams. These courses focus on improving students' accuracy and fluency in oral and written communication (usually in the students' "second" language).</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517"/>
		<skos:notation>24163</skos:notation>
		<skos:prefLabel>IB Language B�Italian</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162876">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Designed by the College Board to parallel third-year college-level courses in Italian language, AP Italian Language and Culture courses build upon prior knowledge and develop students' ability to express ideas, exchange opinions, and present information in Italian, both orally and in writing. These courses also help students understand and interpret written and spoken Italian. In addition, students explore the culture of Italian-speaking people in historical and contemporary contexts.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162876</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>AP Italian Language and Culture</rdfs:label>
		<skos:definition>Designed by the College Board to parallel third-year college-level courses in Italian language, AP Italian Language and Culture courses build upon prior knowledge and develop students' ability to express ideas, exchange opinions, and present information in Italian, both orally and in writing. These courses also help students understand and interpret written and spoken Italian. In addition, students explore the culture of Italian-speaking people in historical and contemporary contexts.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517"/>
		<skos:notation>24164</skos:notation>
		<skos:prefLabel>AP Italian Language and Culture</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162877">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Language B (Italian), Middle Years Program courses enable students to gain competence in modern Italian and encourage respect for and understanding of other languages and cultures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162877</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>IB Language B (Italian), Middle Years Program</rdfs:label>
		<skos:definition>Language B (Italian), Middle Years Program courses enable students to gain competence in modern Italian and encourage respect for and understanding of other languages and cultures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24166</skos:notation>
		<skos:prefLabel>IB Language B (Italian), Middle Years Program</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162878">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>IB Language A: Language and Literature�Italian courses prepare students to take the International Baccalaureate Language A: Language and Literature exams. Course content includes in-depth study of various text types and literary forms, composition for purpose and audience, and the context and elements of literature. The course includes oral and written assignments and is designed for students highly competent in using Italian in an academic context.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162878</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>IB Language A: Language and Literature�Italian</rdfs:label>
		<skos:definition>IB Language A: Language and Literature�Italian courses prepare students to take the International Baccalaureate Language A: Language and Literature exams. Course content includes in-depth study of various text types and literary forms, composition for purpose and audience, and the context and elements of literature. The course includes oral and written assignments and is designed for students highly competent in using Italian in an academic context.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24167</skos:notation>
		<skos:prefLabel>IB Language A: Language and Literature�Italian</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162879">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>IB Language Ab Initio�Italian courses prepare students to take the International Baccalaureate exam. These courses focus on developing the linguistic abilities of students with little or no experience with the language of study. Course content includes the study of individuals and society, leisure and work, and urban and rural environments. These courses also provide students with the opportunity to practice and explore this language.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517162879</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>IB Language Ab Initio�Italian</rdfs:label>
		<skos:definition>IB Language Ab Initio�Italian courses prepare students to take the International Baccalaureate exam. These courses focus on developing the linguistic abilities of students with little or no experience with the language of study. Course content includes the study of individuals and society, leisure and work, and urban and rural environments. These courses also provide students with the opportunity to practice and explore this language.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>24168</skos:notation>
		<skos:prefLabel>IB Language Ab Initio�Italian</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517162880">
