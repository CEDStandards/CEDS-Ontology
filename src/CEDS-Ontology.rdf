		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Labor Union</rdfs:label>
		<skos:definition>A membership organization of workers formed for the purpose of advancing its members' interests in respect to wages, benefits, and working conditions.</skos:definition>
