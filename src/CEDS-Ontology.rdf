	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001828">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001828</dc:identifier>
		<rdfs:label>Has Building School Design Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200139" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001828" />
		<skos:notation>hasBuildingSchoolDesignType</skos:notation>
		<dc:description>The physical layout and character of a school facility, as determined by age groups served and educational programs provided.</dc:description>
		<skos:definition>The physical layout and character of a school facility, as determined by age groups served and educational programs provided.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001829">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001829</dc:identifier>
		<rdfs:label>Has Building Science Specialty Space Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200058" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001829" />
		<skos:notation>hasBuildingScienceSpecialtySpaceType</skos:notation>
		<dc:description>The space designed, located, furnished, and equipped for instruction and experimentation in science.</dc:description>
		<skos:definition>The space designed, located, furnished, and equipped for instruction and experimentation in science.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001804">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001804</dc:identifier>
		<rdfs:label>Has Building Security System Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200060" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001804" />
		<skos:notation>hasBuildingSecuritySystemType</skos:notation>
		<dc:description>The type of system that protects the facility from intrusion.</dc:description>
		<skos:definition>The type of system that protects the facility from intrusion.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001860">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001860</dc:identifier>
		<rdfs:label>Has Building Site Use Restrictions Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200140" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001860" />
		<skos:notation>hasBuildingSiteUseRestrictionsType</skos:notation>
		<dc:description>A characterization of a site that would define restrictions or opportunities.</dc:description>
		<skos:definition>A characterization of a site that would define restrictions or opportunities.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600295">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600295</dc:identifier>
		<rdfs:label>Has Building Space Utilization</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200058" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200059" />
		<skos:notation>hasBuildingSpaceUtilization</skos:notation>
		<dc:description>References information about the capacity and assigned utilization of an area within a building including if the area is unassigned.</dc:description>
		<skos:definition>References information about the capacity and assigned utilization of an area within a building including if the area is unassigned.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
