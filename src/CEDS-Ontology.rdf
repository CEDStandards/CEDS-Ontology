		<skos:prefLabel>Early Childhood Program Enrollment Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000079">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person's classification as dependent or independent with regards to eligibility for Title IV Federal Student aid.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000079</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Dependency Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
