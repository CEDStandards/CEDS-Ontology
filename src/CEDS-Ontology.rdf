	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163512">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>These courses examine a particular topic in sociology, such as culture and society or the individual in society, rather than provide an overview of the field of sociology.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517163512</dc:identifier>
