	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600453">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600453</dc:identifier>
		<rdfs:label>Has Early Learning Child Outcome Summary</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200275" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200098" />
		<skos:notation>hasEarlyLearningChildOutcomeSummary</skos:notation>
		<dc:description>References the Child Outcomes Summary (COS) process is a way for states to measure the progress of preschool and pre-K students receiving IEP services.</dc:description>
		<skos:definition>References the Child Outcomes Summary (COS) process is a way for states to measure the progress of preschool and pre-K students receiving IEP services.</skos:definition>
