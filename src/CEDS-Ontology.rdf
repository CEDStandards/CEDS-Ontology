		</editHistory>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600567">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600567</dc:identifier>
		<dc:description>A code that identifies the type of identifier assigned to an organization. This element distinguishes among various identification systems or authorities (e.g., state-assigned ID, NCES ID, federal EIN) that issue unique identifiers to education organizations such as schools, districts, or agencies.</dc:description>
		<skos:definition>A code that identifies the type of identifier assigned to an organization. This element distinguishes among various identification systems or authorities (e.g., state-assigned ID, NCES ID, federal EIN) that issue unique identifiers to education organizations such as schools, districts, or agencies.</skos:definition>
		<rdfs:label>Has Organization Identifier Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239" /><schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200252" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200416" />
		<skos:notation>hasOrganizationIdentifierType</skos:notation>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 
				<changeDescription>Added domain relationship to Organization Identification class to support soft typing.</changeDescription> 
				<changeVersion>13</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>		
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001540">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001540</dc:identifier>
		<dc:description>A globally unique identifier for an instance of a person taking an assessment.</dc:description>
		<skos:definition>A globally unique identifier for an instance of a person taking an assessment.</skos:definition>
		<rdfs:label>Assessment Participant Session GUID</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:notation>AssessmentParticipantSessionGUID</skos:notation>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to CEDS.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<rdfs:comment>CEDS "GUID" elements are defined as RFC 4122 compliant 32-character hexadecimal strings (36 characters with dashes). For example, 21EC2020-3AEA-1069-A2DD-08002B30309D. Values MAY be encoded using a hash function such as HMAC-MD5 or HMAC-SHA1, resulting in a string up to 40 characters.</rdfs:comment>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600568">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600568</dc:identifier>
		<dc:description>A quantifiable unit of recognition awarded for the successful completion of a learning activity measured according to a predefined standard.</dc:description>
