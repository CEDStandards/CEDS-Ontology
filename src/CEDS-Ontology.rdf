		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200344" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001610" />
		<skos:notation>hasFinancialAidVeteransBenefitType</skos:notation>
