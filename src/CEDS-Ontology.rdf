		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200203" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001766" />
		<skos:notation>hasVirtualSchoolStatus</skos:notation>
		<dc:description>An indication of the extent to which a school offers instruction in which students and teachers are separated by time and/or location, and interaction occurs via computers and/or telecommunications technologies.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs. Changed definition of element to support other domains.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the extent to which a school offers instruction in which students and teachers are separated by time and/or location, and interaction occurs via computers and/or telecommunications technologies.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000196">
