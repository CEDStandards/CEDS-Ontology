	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001508105749">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child does not yet show functioning expected of a child of his or her age in any situation. Child uses immediate foundational skills, most or all of the time, across settings and situations. Immediate foundational skills are the skills upon which to build age-appropriate functioning.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001508105749</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001508" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Does not show functioning expected at age - uses immediate foundational skills</rdfs:label>
		<skos:definition>Child does not yet show functioning expected of a child of his or her age in any situation. Child uses immediate foundational skills, most or all of the time, across settings and situations. Immediate foundational skills are the skills upon which to build age-appropriate functioning.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001508" />
		<skos:notation>03</skos:notation>
		<skos:prefLabel>Does not show functioning expected at age - uses immediate foundational skills</skos:prefLabel>
	</owl:NamedIndividual>
