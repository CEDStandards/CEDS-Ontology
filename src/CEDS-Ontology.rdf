			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The designation of a school's poverty quartile for purposes of determining classes taught by highly qualified teachers in high and low poverty schools, according to state's indicator of poverty.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002068">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002068</dc:identifier>
		<rdfs:label>Has Student Dropout Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200216" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002068" />
		<skos:notation>hasStudentDropoutStatus</skos:notation>
		<dc:description>An indication of the status of this student as dropout.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the status of this student as dropout.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001862">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001862</dc:identifier>
		<rdfs:label>Has Student Enrollment Access Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200219" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001862" />
		<skos:notation>hasStudentEnrollmentAccessType</skos:notation>
		<dc:description>The designation of how students secure access to age appropriate public schools, or publicly funded charter or private schools.</dc:description>
		<skos:definition>The designation of how students secure access to age appropriate public schools, or publicly funded charter or private schools.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000272">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000272</dc:identifier>
		<rdfs:label>Has Student Level</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000272" />
		<skos:notation>hasStudentLevel</skos:notation>
		<dc:description>Classification of a person enrolling in credit-granting courses at a postsecondary institution since completing high school (or its equivalent) as either an undergraduate or graduate student.</dc:description>
		<skos:definition>Classification of a person enrolling in credit-granting courses at a postsecondary institution since completing high school (or its equivalent) as either an undergraduate or graduate student.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001963">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001963</dc:identifier>
		<rdfs:label>Has Student School Affiliation State Defined Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200197" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001963" />
		<skos:notation>hasStudentSchoolAffiliationStateDefinedStatus</skos:notation>
		<dc:description>An indication of the nature of a student's affiliation, as defined by the state, with a public school and used generally, but not exclusively, for the purpose of determining residency, funding, or accountability.</dc:description>
		<rdfs:comment>This element should be used in conjunction with the Public School Residence Status and the Responsible School Type elements to create specificity about the role a school plays or should play in the education of the student.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the nature of a student's affiliation, as defined by the state, with a public school and used generally, but not exclusively, for the purpose of determining residency, funding, or accountability.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001998">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001998</dc:identifier>
		<rdfs:label>Has Student Support Service Availability Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200262" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001998" />
		<skos:notation>hasStudentSupportServiceAvailabilityType</skos:notation>
		<dc:description>The group of students to whom related or ancillary service is offered within the formal educational system or by an outside agency which provides non-instructional service to support the general welfare of students.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The group of students to whom related or ancillary service is offered within the formal educational system or by an outside agency which provides non-instructional service to support the general welfare of students.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000771">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000771</dc:identifier>
