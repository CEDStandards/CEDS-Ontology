		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Other Metalwork courses.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164048</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
