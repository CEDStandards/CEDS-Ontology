	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164442">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Engineering and Technology�Workplace Experience courses provide students with work experience in a field related to engineering or technology. Goals are typically set cooperatively by the student, teacher, and employer (although students are not necessarily paid). These courses may include classroom activities as well, involving further study of the field or discussion regarding experiences that students encounter in the workplace.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164442</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Engineering and Technology�Workplace Experience</rdfs:label>
		<skos:definition>Engineering and Technology�Workplace Experience courses provide students with work experience in a field related to engineering or technology. Goals are typically set cooperatively by the student, teacher, and employer (although students are not necessarily paid). These courses may include classroom activities as well, involving further study of the field or discussion regarding experiences that students encounter in the workplace.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>21998</skos:notation>
		<skos:prefLabel>Engineering and Technology�Workplace Experience</skos:prefLabel>
	</owl:NamedIndividual>
