	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001354">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001354</dc:identifier>
		<rdfs:label>Has Financial Expenditure Function Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200142" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001354" />
		<skos:notation>hasFinancialExpenditureFunctionCode</skos:notation>
		<dc:description>The function describes the activity for which a service or material object is acquired. The functions of an organization are classified into five broad areas: instruction, support services, operation of non-instructional services, facilities acquisition and construction, and debt service. Functions are further classified into sub functions.</dc:description>
		<rdfs:comment>Based on codes specified in the NCES Handbook &lt;a href="http://nces.ed.gov/pubs2015/fin_acct/chapter6_5.asp"&gt;"Financial Accounting for Local and State School Systems: 2014 Edition"&lt;/a&gt;.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name and technical name. Added elements to DES contexts to support Early Learning needs. Changed definition of element to support other domains.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated usage note.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The function describes the activity for which a service or material object is acquired. The functions of an organization are classified into five broad areas: instruction, support services, operation of non-instructional services, facilities acquisition and construction, and debt service. Functions are further classified into sub functions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001555">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001555</dc:identifier>
		<rdfs:label>Has Financial Expenditure Level of Instruction Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200142" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>hasFinancialExpenditureLevelofInstructionCode</skos:notation>
		<dc:description>This classification permits expenditures to be segregated by instructional level.</dc:description>
		<rdfs:comment>Based on codes specified in the NCES Handbook &lt;a href="http://nces.ed.gov/pubs2015/fin_acct/chapter6_8.asp"&gt;"Financial Accounting for Local and State School Systems: 2014 Edition"&lt;/a&gt;.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name and technical name. Added option to the existing option set. Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>This classification permits expenditures to be segregated by instructional level.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002004">
