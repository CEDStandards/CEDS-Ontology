	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001939162253">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The participant exits the program because he or she has become incarcerated in a correctional institution or has become a resident of an institution or facility providing 24-hour support such as a hospital or treatment center during the course of receiving services as a participant.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001939162253</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001939" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Incarceration in a correctional institution or resident of 24-hour support facility</rdfs:label>
		<skos:definition>The participant exits the program because he or she has become incarcerated in a correctional institution or has become a resident of an institution or facility providing 24-hour support such as a hospital or treatment center during the course of receiving services as a participant.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001939" />
		<skos:notation>1000</skos:notation>
		<skos:prefLabel>Incarceration in a correctional institution or resident of 24-hour support facility</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001939162254">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The participant exits the program because of medical treatment and that treatment is expected to last longer than 90 days and precludes entry into unsubsidized employment or continued participation in the program.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001939162254</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001939" />
