	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000202">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000202</dc:identifier>
		<rdfs:label>Number of Days in Attendance</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200106" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200350" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>NumberOfDaysInAttendance</skos:notation>
		<dc:description>The number of days a person is present when school is in session during a given reporting period.</dc:description>
		<rdfs:comment>Note: This applies to an enrollment period record.  Separate records using this element definition could capture attendance for regular enrollment, an out-of-school program or other program requiring attendance records.  CEDS now supports the detailed attendance events to capture attendance status on any given day, class period, or session.  CEDS generally doesn't include elements for counts when it has the unit level elements to calculate the count.  However, this element has been retained to support the intended use cases, recognizing that the rules for attendance vary based on location.</rdfs:comment>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The number of days a person is present when school is in session during a given reporting period.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000324">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000324</dc:identifier>
