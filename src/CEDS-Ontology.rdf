				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001536">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001536</dc:identifier>
		<rdfs:label>Has Assessment Form Section Item Field Test Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001536" />
		<skos:notation>hasAssessmentFormSectionItemFieldTestIndicator</skos:notation>
		<dc:description>Indicates that the assessment item is being field tested on this form of the test, and is not to be included for scoring.</dc:description>
		<skos:definition>Indicates that the assessment item is being field tested on this form of the test, and is not to be included for scoring.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001139">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001139</dc:identifier>
		<rdfs:label>Has Assessment Item Adaptive Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001139" />
		<skos:notation>hasAssessmentItemAdaptiveIndicator</skos:notation>
		<dc:description>This indicator determines whether an assessment item is an adaptive item.</dc:description>
		<skos:definition>This indicator determines whether an assessment item is an adaptive item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600078">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600078</dc:identifier>
		<rdfs:label>Has Assessment Item Apip</rdfs:label>
