		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200404" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200360" />
		<skos:notation>hasServicesReceived</skos:notation>
		<dc:description>References information about services received such as services received by a student. May link individual services received to a service plan.</dc:description>
		<skos:definition>References information about services received such as services received by a student. May link individual services received to a service plan.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
