		<skos:notation>TransportationStateAidQualificationType</skos:notation>
		<skos:prefLabel>Transportation State Aid Qualification Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002022">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Indicates whether a student was absent 10% or more school days during the school year with an absence being defined as a student not physically on school grounds and was not participating in instruction or instruction-related activities at an approved off-grounds location for at least half the school day.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C002022</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Chronic Student Absenteeism Indicator</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Indicates whether a student was absent 10% or more school days during the school year with an absence being defined as a student not physically on school grounds and was not participating in instruction or instruction-related activities at an approved off-grounds location for at least half the school day.</skos:definition>
		<skos:notation>ChronicStudentAbsenteeismIndicator</skos:notation>
		<skos:prefLabel>Chronic Student Absenteeism Indicator</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002025">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A classification of a postsecondary institution's most prevalent level.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C002025</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Most Prevalent Level of Institution</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>A classification of a postsecondary institution's most prevalent level.</skos:definition>
		<skos:notation>MostPrevalentLevelOfInstitution</skos:notation>
		<skos:prefLabel>Most Prevalent Level of Institution</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002026">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The type of projected diploma/credential a person would be awarded in recognition of his/her completion of the curricular requirements.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C002026</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Projected High School Diploma Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>The type of projected diploma/credential a person would be awarded in recognition of his/her completion of the curricular requirements.</skos:definition>
		<skos:notation>ProjectedHighSchoolDiplomaType</skos:notation>
		<skos:prefLabel>Projected High School Diploma Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001320">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Codes identifying the set of disability conditions.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001320</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Disability Condition Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Codes identifying the set of disability conditions.</skos:definition>
		<skos:notation>DisabilityConditionType</skos:notation>
		<skos:prefLabel>Disability Condition Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001321">
		<dc:creator>Common Education Data Standards</dc:creator>
