		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>CredentialDefinitionMinimumAge</skos:notation>
		<dc:description>The minimum allowed age in years at which a person is eligible for the credential.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The minimum allowed age in years at which a person is eligible for the credential.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001748">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001748</dc:identifier>
		<rdfs:label>Credential Definition Minimum Duration</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200085" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionMinimumDuration</skos:notation>
		<dc:description>The minimum amount of time in minutes it will take to earn the described credential.</dc:description>
		<textFormat>HH:MM</textFormat>
		<skos:definition>The minimum amount of time in minutes it will take to earn the described credential.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000900">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000900</dc:identifier>
		<rdfs:label>Credential Award Issuer Origin URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200088" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialAwardIssuerOriginURL</skos:notation>
		<dc:description>The Uniform Resource Locator (URL) from which the qualification, achievement, personal or organizational quality, or aspect of an identity was issued.</dc:description>
		<rdfs:comment>Used only if an award is issued electronically for the achievement.</rdfs:comment>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The Uniform Resource Locator (URL) from which the qualification, achievement, personal or organizational quality, or aspect of an identity was issued.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001662">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001662</dc:identifier>
		<rdfs:label>Credential Issuer Revocation List URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200088" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialIssuerRevocationListURL</skos:notation>
		<dc:description>The URL to a document that includes a list of credential award assertions an issuer has revoked.</dc:description>
		<rdfs:comment>See OpenBadges standard example &lt;a href="http://openbadges.github.io/openbadges-specification/#RevocationList"&gt;http://openbadges.github.io/openbadges-specification/#RevocationList&lt;/a&gt;</rdfs:comment>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The URL to a document that includes a list of credential award assertions an issuer has revoked.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added to reflect OpenBadges 2.0 standard,, change source: Badges 2.0 spec</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>The DES v7.1 had "Credential Issuer Revocation List URL" under the PS domain.  The correct place for the concept is under "Credential Award".</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001911">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001911</dc:identifier>
		<rdfs:label>Credential Offered Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200089" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CredentialOfferedStartDate</skos:notation>
		<dc:description>The first date a credential was offered.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The first date a credential was offered.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>The "Credential Offered" entity requires, at minimum, the OrganizationId, Credential(Definition)Id, Start Date, and End Date. Existing start and end date elements in CEDS are contextualized.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001912">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001912</dc:identifier>
		<rdfs:label>Credential Offered End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200089" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CredentialOfferedEndDate</skos:notation>
		<dc:description>The last date a credential was offered.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The last date a credential was offered.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>The "Credential Offered" entity requires, at minimum, the OrganizationId, Credential(Definition)Id, Start Date, and End Date. Existing start and end date elements in CEDS are contextualized.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001631">
		<dc:creator>Common Education Data Standards</dc:creator>
