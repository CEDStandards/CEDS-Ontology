		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200136" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilityStateOrLocalMandateName</skos:notation>
		<dc:description>The specific law, rule, regulation, or standard of a state or local government that pertains to public school facilities.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The specific law, rule, regulation, or standard of a state or local government that pertains to public school facilities.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001890">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001890</dc:identifier>
		<rdfs:label>Facility Mortgage Interest Amount</rdfs:label>
