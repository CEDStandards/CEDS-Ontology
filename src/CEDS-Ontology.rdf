	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001193">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Indicates this section is sealed, meaning the test taker cannot enter the section until authorized by the proctor.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001193</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
