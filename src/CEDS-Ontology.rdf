				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001762">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001762</dc:identifier>
		<rdfs:label>Has LEA Full Academic Year</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200046" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001762" />
		<skos:notation>hasLEAFullAcademicYear</skos:notation>
		<dc:description>An indication of whether a student was in membership in the LEA education unit for a full academic year, according to the state's definition of Full Academic Year.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: Generate</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether a student was in membership in the LEA education unit for a full academic year, according to the state's definition of Full Academic Year.</skos:definition>
