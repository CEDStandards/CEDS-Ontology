	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002148190541">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A specialized braille code that uses Unified English Braille (UEB) for literary content and incorporates the Nemeth Code for representing mathematical and scientific notation, providing a structured system for transcribing technical content into braille to ensure effective access for individuals with visual impairments.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002148190541</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002148" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>UEB with Nemeth</rdfs:label>
		<skos:definition>A specialized braille code that uses Unified English Braille (UEB) for literary content and incorporates the Nemeth Code for representing mathematical and scientific notation, providing a structured system for transcribing technical content into braille to ensure effective access for individuals with visual impairments.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002148" />
		<skos:notation>Nemeth</skos:notation>
		<skos:prefLabel>UEB with Nemeth</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Updated label from "Nemeth" to "UEB with Nemeth" and updated definition per NCEO accessibility update and Braille Authority of North America guidance</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/983</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
