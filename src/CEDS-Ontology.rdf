		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200233" />
		<skos:notation>hasLearningResourceOrder</skos:notation>
		<dc:description>References information related to an organization ordering or purchasing a learning resource.</dc:description>
		<skos:definition>References information related to an organization ordering or purchasing a learning resource.</skos:definition>
