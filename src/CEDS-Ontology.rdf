		<dc:description>Information related to policies within a K12 location education agency.</dc:description>
		<skos:definition>Information related to policies within a K12 location education agency.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200192">
