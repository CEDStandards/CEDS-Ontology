	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127625">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all tuition and fees (including student activity fees) revenue received from students for education purposes. Include revenues for tuition and fees net of discounts and allowances from institutional and governmental scholarships, waivers, etc. (report gross revenues minus discounts and allowances). Includes those tuition and fees that are remitted to the state as an offset to state appropriations. (Charges for room, board, and other services rendered by auxiliary enterprises are not reported here.)</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127625</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Tuition and fees (net discounts and allowances)</rdfs:label>
		<skos:definition>Used for reporting all tuition and fees (including student activity fees) revenue received from students for education purposes. Include revenues for tuition and fees net of discounts and allowances from institutional and governmental scholarships, waivers, etc. (report gross revenues minus discounts and allowances). Includes those tuition and fees that are remitted to the state as an offset to state appropriations. (Charges for room, board, and other services rendered by auxiliary enterprises are not reported here.)</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Tuitionfeesnetofdiscountsallowances</skos:notation>
		<skos:prefLabel>Tuition and fees (net discounts and allowances)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127626">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting revenues from federal governmental agencies that are for specific research projects or other types of programs and that are classified as operating revenues. Examples are research projects and similar activities for which amounts are received or expenditures are reimbursable under the terms of a grant or contract. Includes federal land grant appropriations if considered operating revenue. Does not include Pell grants or other federal student aid. Does not include any ARRA revenues.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127626</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Federal operating grants and contracts</rdfs:label>
		<skos:definition>Used for reporting revenues from federal governmental agencies that are for specific research projects or other types of programs and that are classified as operating revenues. Examples are research projects and similar activities for which amounts are received or expenditures are reimbursable under the terms of a grant or contract. Includes federal land grant appropriations if considered operating revenue. Does not include Pell grants or other federal student aid. Does not include any ARRA revenues.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Federaloperatinggrantscontracts</skos:notation>
		<skos:prefLabel>Federal operating grants and contracts</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127627">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting revenues from state governmental agencies that are for specific research projects or other types of programs and that are classified as operating revenues. Examples are research projects and similar activities for which amounts are received or expenditures are reimbursable under the terms of a grant or contract. Does not include any ARRA revenues.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127627</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>State operating grants and contracts</rdfs:label>
		<skos:definition>Used for reporting revenues from state governmental agencies that are for specific research projects or other types of programs and that are classified as operating revenues. Examples are research projects and similar activities for which amounts are received or expenditures are reimbursable under the terms of a grant or contract. Does not include any ARRA revenues.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Stateoperatinggrantscontracts</skos:notation>
		<skos:prefLabel>State operating grants and contracts</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127628">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting revenues from local governmental agencies that are for specific research projects or other types of programs and that are classified as operating revenues. Examples are research projects and similar activities for which amounts are received or expenditures are reimbursable under the terms of a grant or contract.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127628</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Local government operating grants and contracts</rdfs:label>
		<skos:definition>Used for reporting revenues from local governmental agencies that are for specific research projects or other types of programs and that are classified as operating revenues. Examples are research projects and similar activities for which amounts are received or expenditures are reimbursable under the terms of a grant or contract.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Localgovernmentoperatinggrantscontracts</skos:notation>
		<skos:prefLabel>Local government operating grants and contracts</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127629">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting revenues from nongovernmental agencies and organizations that are for specific research projects or other types of programs and that are classified as operating revenues. Examples are research projects and similar activities for which amounts are received or expenditures are reimbursable under the terms of a grant or contract.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127629</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Private operating grants and contracts</rdfs:label>
		<skos:definition>Used for reporting revenues from nongovernmental agencies and organizations that are for specific research projects or other types of programs and that are classified as operating revenues. Examples are research projects and similar activities for which amounts are received or expenditures are reimbursable under the terms of a grant or contract.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Privateoperatinggrantscontracts</skos:notation>
		<skos:prefLabel>Private operating grants and contracts</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127630">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting revenues (net of discounts and allowances) generated by auxiliary enterprises that exist to furnish a service to students, faculty, or staff, and that charge a fee that is directly related to the cost of the service. Examples are residence halls, food services, student health services, intercollegiate athletics, college unions, college stores, and movie theaters.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127630</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Sales and services of auxiliary enterprises (net discounts and allowances)</rdfs:label>
		<skos:definition>Used for reporting revenues (net of discounts and allowances) generated by auxiliary enterprises that exist to furnish a service to students, faculty, or staff, and that charge a fee that is directly related to the cost of the service. Examples are residence halls, food services, student health services, intercollegiate athletics, college unions, college stores, and movie theaters.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Salesservicesofauxiliaryenterprisesnetofdiscounts</skos:notation>
		<skos:prefLabel>Sales and services of auxiliary enterprises (net discounts and allowances)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127631">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Includes operating revenues (net of patient contractual allowances) for a hospital operated by the institution and clinics associated with training. Excludes clinics that are part of the student health services program.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127631</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Sales and services of hospitals (after deducting patient contractual allowances)</rdfs:label>
		<skos:definition>Includes operating revenues (net of patient contractual allowances) for a hospital operated by the institution and clinics associated with training. Excludes clinics that are part of the student health services program.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Salesservicesofhospitalsafterdeducting</skos:notation>
		<skos:prefLabel>Sales and services of hospitals (after deducting patient contractual allowances)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127632">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Includes all operating revenues derived from the sales of goods or services that are incidental to the conduct of instruction, research or public service, and revenues of activities that exist to provide instructional and laboratory experience for students and that incidentally create goods and services that may be sold. Examples include film rentals, scientific and literary publications, testing services, university presses, dairies, and patient care clinics that are not part of a hospital.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127632</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Sales and services of educational activities</rdfs:label>
		<skos:definition>Includes all operating revenues derived from the sales of goods or services that are incidental to the conduct of instruction, research or public service, and revenues of activities that exist to provide instructional and laboratory experience for students and that incidentally create goods and services that may be sold. Examples include film rentals, scientific and literary publications, testing services, university presses, dairies, and patient care clinics that are not part of a hospital.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Salesservicesofeducationalactivities</skos:notation>
		<skos:prefLabel>Sales and services of educational activities</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127633">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Includes all operating revenues associated with operations independent of the primary missions of the institution. This category generally includes only those revenues associated with major federally funded research and development centers. Does not include the net profit (or loss) from operations owned and managed as investments of the institution's endowment funds.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127633</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Independent operations</rdfs:label>
		<skos:definition>Includes all operating revenues associated with operations independent of the primary missions of the institution. This category generally includes only those revenues associated with major federally funded research and development centers. Does not include the net profit (or loss) from operations owned and managed as investments of the institution's endowment funds.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Independentoperations</skos:notation>
		<skos:prefLabel>Independent operations</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127634">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all other sources not reported elsewhere.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127634</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Other operating revenue</rdfs:label>
		<skos:definition>Used for reporting all other sources not reported elsewhere.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Otheroperatingrevenue</skos:notation>
		<skos:prefLabel>Other operating revenue</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127635">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all amounts received by the institution through acts of a federal legislative body, except grants and contracts. Funds reported in this category are for meeting current operating expenses, not for specific projects or programs. An example is federal land-grant appropriations. If your institution accounts for land grant appropriations as operating revenue, they are excluded from this amount. Does not include any ARRA revenues.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127635</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Federal appropriations</rdfs:label>
		<skos:definition>Used for reporting all amounts received by the institution through acts of a federal legislative body, except grants and contracts. Funds reported in this category are for meeting current operating expenses, not for specific projects or programs. An example is federal land-grant appropriations. If your institution accounts for land grant appropriations as operating revenue, they are excluded from this amount. Does not include any ARRA revenues.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Federalappropriations</skos:notation>
		<skos:prefLabel>Federal appropriations</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127636">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all amounts received by the institution through acts of a state legislative body, except grants and contracts and amounts reportable as capital appropriations. Funds reported in this category are for meeting current operating expenses, not for specific projects or programs. Does not include any ARRA revenues.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127636</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>State appropriations</rdfs:label>
		<skos:definition>Used for reporting all amounts received by the institution through acts of a state legislative body, except grants and contracts and amounts reportable as capital appropriations. Funds reported in this category are for meeting current operating expenses, not for specific projects or programs. Does not include any ARRA revenues.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Stateappropriations</skos:notation>
		<skos:prefLabel>State appropriations</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127637">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all amounts received from property or other taxes assessed directly by or for an institution below the state level. Include any other similar general support provided to the institution from governments below the state level, including local government appropriations.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001672127637</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Local appropriations, education district taxes, and similar support</rdfs:label>
		<skos:definition>Used for reporting all amounts received from property or other taxes assessed directly by or for an institution below the state level. Include any other similar general support provided to the institution from governments below the state level, including local government appropriations.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Localappropriationseducationdistrict</skos:notation>
		<skos:prefLabel>Local appropriations, education district taxes, and similar support</skos:prefLabel>
	</owl:NamedIndividual>
