	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200352">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200352</dc:identifier>
		<rdfs:label>Role Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>RoleStatus</skos:notation>
		<dc:description>RoleStatus supports cases such as when a student "applied" for enrollment in a Course Section, Program, or School/Institution, was "accepted," and then was "enrolled." Each status may have different begin and end dates.</dc:description>
		<skos:definition>RoleStatus supports cases such as when a student "applied" for enrollment in a Course Section, Program, or School/Institution, was "accepted," and then was "enrolled." Each status may have different begin and end dates.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200353">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200353</dc:identifier>
		<rdfs:label>Rubric</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Rubric</skos:notation>
		<dc:description>A set of criteria or indicators that assist in determining whether an entity possesses a given competence or level of performance in a task or work product.</dc:description>
		<skos:definition>A set of criteria or indicators that assist in determining whether an entity possesses a given competence or level of performance in a task or work product.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200354">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200354</dc:identifier>
		<rdfs:label>Rubric Criterion</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>RubricCriterion</skos:notation>
		<dc:description>A single criterion by which one aspect of an entity's competence may be evaluated.</dc:description>
		<skos:definition>A single criterion by which one aspect of an entity's competence may be evaluated.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200355">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200355</dc:identifier>
		<rdfs:label>Rubric Criterion Level</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>RubricCriterionLevel</skos:notation>
		<dc:description>A degree or level of competence.</dc:description>
		<skos:definition>A degree or level of competence.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200356">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200356</dc:identifier>
		<rdfs:label>Service Frequency</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>ServiceFrequency</skos:notation>
		<dc:description>Information about the schedule and frequency by which services are planned to be deliverd.</dc:description>
		<skos:definition>Information about the schedule and frequency by which services are planned to be deliverd.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200357">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200357</dc:identifier>
		<rdfs:label>Service Plan</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>ServicePlan</skos:notation>
		<dc:description>A plan to provide services to a person, group, or a person's family, such as services delivered under Individualized Education Programs or Individualized Family Services Plans.</dc:description>
		<skos:definition>A plan to provide services to a person, group, or a person's family, such as services delivered under Individualized Education Programs or Individualized Family Services Plans.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200358">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200358</dc:identifier>
		<rdfs:label>Service Provided</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>ServiceProvided</skos:notation>
		<dc:description>Services available from an organization or person that may be linked ServicePlan and ServicesRecieved information.</dc:description>
		<skos:definition>Services available from an organization or person that may be linked ServicePlan and ServicesRecieved information.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200359">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200359</dc:identifier>
		<rdfs:label>Service Provider</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>ServiceProvider</skos:notation>
		<dc:description>An organization responsible for administering services to an individual or organization participating in a program or receiving services.</dc:description>
		<skos:definition>An organization responsible for administering services to an individual or organization participating in a program or receiving services.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200360">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200360</dc:identifier>
		<rdfs:label>Services Received</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>ServicesReceived</skos:notation>
		<dc:description>Information about services received such as services received by a student. May link individual services received to a service plan.</dc:description>
		<skos:definition>Information about services received such as services received by a student. May link individual services received to a service plan.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200361">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200361</dc:identifier>
		<rdfs:label>Service Staff</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>ServiceStaff</skos:notation>
		<dc:description>Relationship to the person-role that provided the service.</dc:description>
		<skos:definition>Relationship to the person-role that provided the service.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200018">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200018</dc:identifier>
		<rdfs:label>SHEEO Agency</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>SHEEOAgency</skos:notation>
		<dc:description>An entity tasked with overseeing higher education in its state and is led by a state higher education executive officer.</dc:description>
		<skos:definition>An entity tasked with overseeing higher education in its state and is led by a state higher education executive officer.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200362">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200362</dc:identifier>
		<rdfs:label>Staff Compensation</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>StaffCompensation</skos:notation>
		<dc:description>Information related to the compensation of staff members.</dc:description>
		<skos:definition>Information related to the compensation of staff members.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200363">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200363</dc:identifier>
		<rdfs:label>Staff Compensation Funding Source</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>StaffCompensationFundingSource</skos:notation>
		<dc:description>The relationship between the staff compensation and the financial account used for the compensation.</dc:description>
		<skos:definition>The relationship between the staff compensation and the financial account used for the compensation.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200364">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200364</dc:identifier>
		<rdfs:label>Staff Credential</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>StaffCredential</skos:notation>
		<dc:description>A credential held by a staff member.</dc:description>
		<skos:definition>A credential held by a staff member.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200380">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200380</dc:identifier>
		<rdfs:label>Staff Development Provider</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>StaffDevelopmentProvider</skos:notation>
		<dc:description>An individual or organization who provides a planned, structured process through which an individual improves his or her job-related knowledge, skills, or attitudes. Such a process is deigned to enable a staff member to grow within a profession or organization or to attain an initial or additional credential.</dc:description>
		<skos:definition>An individual or organization who provides a planned, structured process through which an individual improves his or her job-related knowledge, skills, or attitudes. Such a process is deigned to enable a staff member to grow within a profession or organization or to attain an initial or additional credential.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200366">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200366</dc:identifier>
		<rdfs:label>Staff Evaluation</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>StaffEvaluation</skos:notation>
		<dc:description>Evaluation of a staff member's performance.</dc:description>
		<skos:definition>Evaluation of a staff member's performance.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200367">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200367</dc:identifier>
		<rdfs:label>Staff Evaluation Part</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>StaffEvaluationPart</skos:notation>
		<dc:description>Information about the score and sections of a staff evaluation assessment.</dc:description>
		<skos:definition>Information about the score and sections of a staff evaluation assessment.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200368">
