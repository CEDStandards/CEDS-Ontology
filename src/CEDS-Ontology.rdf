		<rdfs:label>Liabilities: Government grants refundable under student loan programs</rdfs:label>
		<skos:definition>Includes amounts advanced to the institution by a governmental entity for purposes of making loans to students (if recognized as a liability in the GPFS).</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001671" />
		<skos:notation>LiabilitiesGovernmentgrantsrefundableunder</skos:notation>
		<skos:prefLabel>Liabilities: Government grants refundable under student loan programs</skos:prefLabel>
	</owl:NamedIndividual>
