	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600063">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600063</dc:identifier>
		<rdfs:label>Has Learning Resource</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200226" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<skos:notation>hasLearningResource</skos:notation>
		<dc:description>References a persistent resource that has one or more physical or digital representations, and that explicitly involves, specifies or entails a learning activity or learning experience.</dc:description>
		<skos:definition>References a persistent resource that has one or more physical or digital representations, and that explicitly involves, specifies or entails a learning activity or learning experience.</skos:definition>
