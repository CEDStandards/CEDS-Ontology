		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001609" />
		<skos:notation>hasFinancialAidVeteransBenefitStatus</skos:notation>
		<dc:description>An indication of whether a person is receiving Veteran's benefits.</dc:description>
		<skos:definition>An indication of whether a person is receiving Veteran's benefits.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001610">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001610</dc:identifier>
