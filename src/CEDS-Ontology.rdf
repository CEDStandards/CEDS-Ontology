		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000484" />
		<skos:notation>hasNeglectedOrDelinquentObtainedEmployment</skos:notation>
		<dc:description>An indication that a Neglected or Delinquent student obtained employment.</dc:description>
		<skos:definition>An indication that a Neglected or Delinquent student obtained employment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000194">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000194</dc:identifier>
		<rdfs:label>Has Neglected or Delinquent Program Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200321" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000194" />
		<skos:notation>hasNeglectedOrDelinquentProgramType</skos:notation>
		<dc:description>The type of program under ESEA Title I, Part D, Subpart 1 (state programs) or Subpart 2 (LEA).</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new option to option set</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of program under ESEA Title I, Part D, Subpart 1 (state programs) or Subpart 2 (LEA).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000031">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000031</dc:identifier>
		<rdfs:label>Has Awaiting Initial IDEA Evaluation Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200322" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000031" />
		<skos:notation>hasAwaitingInitialIDEAEvaluationStatus</skos:notation>
		<dc:description>Awaiting initial evaluation for special education programs and related services under the Individuals with Disabilities Education Act (IDEA).</dc:description>
		<skos:definition>Awaiting initial evaluation for special education programs and related services under the Individuals with Disabilities Education Act (IDEA).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002086">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002086</dc:identifier>
		<rdfs:label>Has Part B Postsecondary Outcomes Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200322" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002086" />
		<skos:notation>hasPartBPostsecondaryOutcomesIndicator</skos:notation>
		<dc:description>An indication of the status of a person within one year of leaving secondary school and who had an individualized education program in effect at the time they left secondary school.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the status of a person within one year of leaving secondary school and who had an individualized education program in effect at the time they left secondary school.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600417">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600417</dc:identifier>
		<rdfs:label>Has Teacher Education Credential Exam</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200323" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200371" />
		<skos:notation>hasTeacherEducationCredentialExam</skos:notation>
		<dc:description>References the exam and score of a person on a teaching credential exam.</dc:description>
		<skos:definition>References the exam and score of a person on a teaching credential exam.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600200">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600200</dc:identifier>
		<rdfs:label>Has Program Participation WIOA Barriers</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200326" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200327" />
		<skos:notation>hasProgramParticipationWIOABarriers</skos:notation>
		<dc:description>References information related to barries to employment for a person who participated in programs through the Workforce Innovation and Opportunity Act (WIOA).</dc:description>
		<skos:definition>References information related to barries to employment for a person who participated in programs through the Workforce Innovation and Opportunity Act (WIOA).</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001941">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001941</dc:identifier>
		<rdfs:label>Has WIOA Career Services</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200326" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001941" />
		<skos:notation>hasWIOACareerServices</skos:notation>
		<dc:description>An indication of whether or not the individual has received services as identified in sec. 134(c)(2) of the Workforce Innovation and Opportunity Act (WIOA) consisting of (a) basic career services, (b) individualized career services, or (c) follow-up services.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether or not the individual has received services as identified in sec. 134(c)(2) of the Workforce Innovation and Opportunity Act (WIOA) consisting of (a) basic career services, (b) individualized career services, or (c) follow-up services.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001942">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001942</dc:identifier>
		<rdfs:label>Has WIOA Training Services</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200326" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001942" />
		<skos:notation>hasWIOATrainingServices</skos:notation>
		<dc:description>An indication of whether or not the individual has received services as defined by the Workforce Innovation and Opportunity Act (WIOA), one or more courses or classes, or a structured regimen that provides the services in 20 CFR part 680.200 and leads to: (a) An industry-recognized certificate or certification, a certificate of completion of a registered apprenticeship, a license recognized by the State involved or the Federal Government, an associate or baccalaureate degree, or community college certificate of completion; (b) Consistent with � 680.350, a secondary school diploma or its equivalent; (c) Employment; or (d) Measurable skill gains toward a credential described in paragraph (a) or (b) of this section or employment.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether or not the individual has received services as defined by the Workforce Innovation and Opportunity Act (WIOA), one or more courses or classes, or a structured regimen that provides the services in 20 CFR part 680.200 and leads to: (a) An industry-recognized certificate or certification, a certificate of completion of a registered apprenticeship, a license recognized by the State involved or the Federal Government, an associate or baccalaureate degree, or community college certificate of completion; (b) Consistent with � 680.350, a secondary school diploma or its equivalent; (c) Employment; or (d) Measurable skill gains toward a credential described in paragraph (a) or (b) of this section or employment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000856">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000856</dc:identifier>
		<rdfs:label>Has Program Provides Parent Education</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200254" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000856" />
		<skos:notation>hasProgramProvidesParentEducation</skos:notation>
		<dc:description>An indication of whether the program provides parent training/education/workshops.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether the program provides parent training/education/workshops.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000855">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000855</dc:identifier>
		<rdfs:label>Has Program Provides Parent Involvement Opportunity</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200254" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000855" />
		<skos:notation>hasProgramProvidesParentInvolvementOpportunity</skos:notation>
		<dc:description>An indication of whether the program provides opportunities to parents to be involved with their children's activities.</dc:description>
		<skos:definition>An indication of whether the program provides opportunities to parents to be involved with their children's activities.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000845">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000845</dc:identifier>
		<rdfs:label>Has Program Provides Translated Materials</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200254" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000845" />
		<skos:notation>hasProgramProvidesTranslatedMaterials</skos:notation>
		<dc:description>An indication of whether a program translates written materials into the individual's home or parent's language.</dc:description>
		<skos:definition>An indication of whether a program translates written materials into the individual's home or parent's language.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000853">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000853</dc:identifier>
		<rdfs:label>Has Program Provides Written Handbook</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200254" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000853" />
		<skos:notation>hasProgramProvidesWrittenHandbook</skos:notation>
		<dc:description>An indication of whether the program provides each parent with a written handbook.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether the program provides each parent with a written handbook.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000716">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000716</dc:identifier>
		<rdfs:label>Has Program Sponsor Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200364" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000716" />
		<skos:notation>hasProgramSponsorType</skos:notation>
		<dc:description>A type of organization providing funds for a particular educational or service program or activity or for an individual's participation in the program or activity.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated definition.  Additions to Option Set.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A type of organization providing funds for a particular educational or service program or activity or for an individual's participation in the program or activity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000225">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000225</dc:identifier>
		<rdfs:label>Has Program Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200263" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000225" />
		<skos:notation>hasProgramType</skos:notation>
		<dc:description>The system outlining instructional or non-instructional activities and procedures designed to accomplish a predetermined educational objective or set of objectives or to provide support services to a person and/or the community.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new options to the existing option set</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added element to DES contexts and added new options to the existing option set.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new option to option set</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Option set updated to include addition adult education options.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated definition.  Added option for targeted intervention.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add option for Foster Care</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added "Title I" to the option set to support EDFacts.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The system outlining instructional or non-instructional activities and procedures designed to accomplish a predetermined educational objective or set of objectives or to provide support services to a person and/or the community.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001915">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001915</dc:identifier>
		<rdfs:label>Has Progress Achieving English Language Proficiency Indicator Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200203" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001915" />
		<skos:notation>hasProgressAchievingEnglishLanguageProficiencyIndicatorType</skos:notation>
		<dc:description>The category used to report the school's performance on the progress of achieving the English language proficiency indicator.</dc:description>
