	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000076116995">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Is absent at the time a given schedule when attendance begins but is present before the close of that time period.</dc:description>
