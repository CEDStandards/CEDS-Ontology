	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101916">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A forced-choice assessment item featuring a stem (which is a prompt) and two or more choices, one of which is the correct answer, and the remainder are distractors.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101916</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Multiple-choice</rdfs:label>
		<skos:definition>A forced-choice assessment item featuring a stem (which is a prompt) and two or more choices, one of which is the correct answer, and the remainder are distractors.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>MultipleChoice</skos:notation>
		<skos:prefLabel>Multiple-choice</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101917">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A short-answer item in which examinees are presented with a sentence in which a word or words is missing, and are asked to provide the missing word(s).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101917</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Fill-in-the-blank</rdfs:label>
		<skos:definition>A short-answer item in which examinees are presented with a sentence in which a word or words is missing, and are asked to provide the missing word(s).</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>FillInTheBlank</skos:notation>
		<skos:prefLabel>Fill-in-the-blank</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101918">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A declarative statement that examinees judge true or false. Variants of the true/false item have examinees identify: fact/opinion, supported by the narrative or not, etc.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101918</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>True/False</rdfs:label>
		<skos:definition>A declarative statement that examinees judge true or false. Variants of the true/false item have examinees identify: fact/opinion, supported by the narrative or not, etc.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390"/>
		<skos:notation>TrueFalse</skos:notation>
		<skos:prefLabel>True/False</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101920">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An assessment item in which examinees are presented with a set of premises and are asked to link them to a set of responses, via directions for identifying the correspondences.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101920</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Matching</rdfs:label>
		<skos:definition>An assessment item in which examinees are presented with a set of premises and are asked to link them to a set of responses, via directions for identifying the correspondences.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>Matching</skos:notation>
		<skos:prefLabel>Matching</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101921">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An assessment item that asks examinees to provide a very short response, such as an item asking for a correct computational or text-based answer, or a closed item.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101921</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Short answer</rdfs:label>
		<skos:definition>An assessment item that asks examinees to provide a very short response, such as an item asking for a correct computational or text-based answer, or a closed item.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>ShortAnswer</skos:notation>
		<skos:prefLabel>Short answer</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101922">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An assessment item that presents an image or object, such as a graph, diagram, or geometric shape, and asks examinees to apply one or more descriptive, symbolic, or quantitative labels.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101922</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Labeling</rdfs:label>
		<skos:definition>An assessment item that presents an image or object, such as a graph, diagram, or geometric shape, and asks examinees to apply one or more descriptive, symbolic, or quantitative labels.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>Labeling</skos:notation>
		<skos:prefLabel>Labeling</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101923">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An assessment item that asks examinees to create simple graphics (e.g., sketches, schematics, diagrams) to generate evidence of understanding a key concept or its application.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101923</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Visual representation</rdfs:label>
		<skos:definition>An assessment item that asks examinees to create simple graphics (e.g., sketches, schematics, diagrams) to generate evidence of understanding a key concept or its application.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>VisualRepresentation</skos:notation>
		<skos:prefLabel>Visual representation</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101924">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An assessment item that asks examinees to show preparatory work for the creation of a product, performance, or extended text. The item may be treated as one component of a task leading to a final product or may be stand-alone, as evidence of preliminary thinking and problem-solving.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101924</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Show your work</rdfs:label>
		<skos:definition>An assessment item that asks examinees to show preparatory work for the creation of a product, performance, or extended text. The item may be treated as one component of a task leading to a final product or may be stand-alone, as evidence of preliminary thinking and problem-solving.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390"/>
		<skos:notation>ShowYourWork</skos:notation>
		<skos:prefLabel>Show your work</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101925">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Any assessment item that asks the examinee to develop answers without suggested answer choices and that does not fit the definition of the other assessment item types.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101925</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Other constructed response</rdfs:label>
		<skos:definition>Any assessment item that asks the examinee to develop answers without suggested answer choices and that does not fit the definition of the other assessment item types.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>OtherConstructedResponse</skos:notation>
		<skos:prefLabel>Other constructed response</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101926">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An item or set of items that directs examinees to demonstrate what they know and can do via a performance, given a set of conditions and expectations for the task(s). The range of possible performances is long, and may include oral, written, procedural, artistic, and/or psychomotor performances such as conducting science experiments, developing informational materials, or participating in a recital, to name a few. An extended constructed response or essay item is a specific instance of a performance task.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101926</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Performance task</rdfs:label>
		<skos:definition>An item or set of items that directs examinees to demonstrate what they know and can do via a performance, given a set of conditions and expectations for the task(s). The range of possible performances is long, and may include oral, written, procedural, artistic, and/or psychomotor performances such as conducting science experiments, developing informational materials, or participating in a recital, to name a few. An extended constructed response or essay item is a specific instance of a performance task.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390"/>
		<skos:notation>PerformanceTask</skos:notation>
		<skos:prefLabel>Performance task</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101929">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An assessment item that asks examinees to reorder items, such as pictures of events within a chronological sequence, items forming a pattern, or text within a passage.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101929</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Reordering</rdfs:label>
		<skos:definition>An assessment item that asks examinees to reorder items, such as pictures of events within a chronological sequence, items forming a pattern, or text within a passage.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>Reordering</skos:notation>
		<skos:prefLabel>Reordering</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101930">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An assessment item that presents visual or written stimulus with incomplete or incorrect information and asks examinees to correct or complete the information.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101930</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Substitution</rdfs:label>
		<skos:definition>An assessment item that presents visual or written stimulus with incomplete or incorrect information and asks examinees to correct or complete the information.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>Substitution</skos:notation>
		<skos:prefLabel>Substitution</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390101931">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Other assessment item type.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390101931</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Other</rdfs:label>
		<skos:definition>Other assessment item type.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>Other</skos:notation>
		<skos:prefLabel>Other</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390104760">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A multiple choice assessment item that directs examinees to select all of the options that apply.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390104760</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Multiple Response</rdfs:label>
		<skos:definition>A multiple choice assessment item that directs examinees to select all of the options that apply.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<skos:notation>MultipleResponse</skos:notation>
		<skos:prefLabel>Multiple Response</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390104761">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An assessment item type that asks examinees to prepare and deliver an organized, cohesive response to an item prompt. The essay item is one type of extended constructed response. Others include the development and sequencing of mathematical proofs, extended analytical papers, and research papers.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390104761</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Extended Response (Essay)</rdfs:label>
		<skos:definition>An assessment item type that asks examinees to prepare and deliver an organized, cohesive response to an item prompt. The essay item is one type of extended constructed response. Others include the development and sequencing of mathematical proofs, extended analytical papers, and research papers.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390"/>
		<skos:notation>ExtendedResponse</skos:notation>
		<skos:prefLabel>Extended Response (Essay)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000390104762">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An interactive assessment item delivered in an online or computerized testing environment such that the manipulation of the stem, options, or other facet of the item by the examinees becomes part of the item prompt or part of the item response. Scalise and Gifford (2006**) present a taxonomy of 28 innovative item types that include: Drag and Drop, Reordering, and other experiential items.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000390104762</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000390" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Technology Enhanced / Interactive</rdfs:label>
		<skos:definition>An interactive assessment item delivered in an online or computerized testing environment such that the manipulation of the stem, options, or other facet of the item by the examinees becomes part of the item prompt or part of the item response. Scalise and Gifford (2006**) present a taxonomy of 28 innovative item types that include: Drag and Drop, Reordering, and other experiential items.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000390"/>
		<skos:notation>TechnologyEnhancedInteractive</skos:notation>
		<skos:prefLabel>Technology Enhanced / Interactive</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000002113286">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Postsecondary award, certificate, or diploma of less than 1 academic year is the category of award conferred by a college, university, or other postsecondary education institution as official recognition for the successful completion of a program of study.</dc:description>
