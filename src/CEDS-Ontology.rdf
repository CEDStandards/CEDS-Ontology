		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Capital grants and gifts</rdfs:label>
		<skos:definition>Used for reporting amounts received from gifts or grants primarily intended to provide for the acquisition or construction of capital assets for the institution.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Capitalgrantsgifts</skos:notation>
		<skos:prefLabel>Capital grants and gifts</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127646">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting gifts and other additions to endowments that are permanently nonexpendable.</dc:description>
