		<dc:description>An indication of whether the person is a member of a professional organization or association.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000807</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Professional Association Membership Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>An indication of whether the person is a member of a professional organization or association.</skos:definition>
		<skos:notation>ProfessionalAssociationMembershipStatus</skos:notation>
		<skos:prefLabel>Professional Association Membership Status</skos:prefLabel>
