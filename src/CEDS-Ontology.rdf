		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001353" />
		<skos:notation>282</skos:notation>
		<skos:prefLabel>Accumulated Amortization of Intangible Assets</skos:prefLabel>
	</owl:NamedIndividual>
