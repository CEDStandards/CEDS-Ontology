		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>EligibilityPriorityPoints</skos:notation>
		<dc:description>Priority points used to determine eligibility and placement order</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Priority points used to determine eligibility and placement order</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001635">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001635</dc:identifier>
		<rdfs:label>Service Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200100" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ServiceDate</skos:notation>
		<dc:description>The year, month, and day on which a service was provided.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
