		</editHistory>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200240">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200240</dc:identifier>
		<rdfs:label>Organization Accreditation</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>OrganizationAccreditation</skos:notation>
		<dc:description>The accreditation status of an organization and accreditation agency.</dc:description>
		<skos:definition>The accreditation status of an organization and accreditation agency.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200241">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200241</dc:identifier>
		<rdfs:label>Organization Calendar</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>OrganizationCalendar</skos:notation>
		<dc:description>OrganizationCalendar represents a calendar owned by an Organization. The details of the calendar are defined by OrganizationCalendarEvent, OrganizationCalendarDay, OrganizationCalendarSession, and OrganizationCalendarCrisis.</dc:description>
		<skos:definition>OrganizationCalendar represents a calendar owned by an Organization. The details of the calendar are defined by OrganizationCalendarEvent, OrganizationCalendarDay, OrganizationCalendarSession, and OrganizationCalendarCrisis.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200242">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200242</dc:identifier>
		<rdfs:label>Organization Calendar Crisis</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>OrganizationCalendarCrisis</skos:notation>
		<dc:description>OrganizationCalendarCrisis provides the unschehduled exceptions to the calendar such as a natural disaster, that causes closing of a school or the displacement of students from a school or institution over multiple days, weeks or months.</dc:description>
		<skos:definition>OrganizationCalendarCrisis provides the unschehduled exceptions to the calendar such as a natural disaster, that causes closing of a school or the displacement of students from a school or institution over multiple days, weeks or months.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200243">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200243</dc:identifier>
		<rdfs:label>Organization Calendar Day</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>OrganizationCalendarDay</skos:notation>
		<dc:description>OrganzationCalendarDay is for naming days within the regular schedule.</dc:description>
		<skos:definition>OrganzationCalendarDay is for naming days within the regular schedule.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200244">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200244</dc:identifier>
		<rdfs:label>Organization Calendar Event</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>OrganizationCalendarEvent</skos:notation>
		<dc:description>OrganizationCalendarEvent handles scheduled or unscheduled events such as holidays or closings that may interrupt the course section schedule on a specified date. See CEDS element definition and option set for Calendar Event Type.</dc:description>
		<skos:definition>OrganizationCalendarEvent handles scheduled or unscheduled events such as holidays or closings that may interrupt the course section schedule on a specified date. See CEDS element definition and option set for Calendar Event Type.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200245">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200245</dc:identifier>
		<rdfs:label>Organization Calendar Session</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>OrganizationCalendarSession</skos:notation>
		<dc:description>OrganizationCalendarSession provides the beginning and end date of the period of time, such as a term or semester. It has multiple uses. For example, it may be flagged as an "attendance term" with a value for DaysInSession, or the specific days applicable for attendance may be derived using OrganizationCalendarEvent. Early learning use cases use this entity to specify instructional session start and end times within the context of a day.</dc:description>
		<skos:definition>OrganizationCalendarSession provides the beginning and end date of the period of time, such as a term or semester. It has multiple uses. For example, it may be flagged as an "attendance term" with a value for DaysInSession, or the specific days applicable for attendance may be derived using OrganizationCalendarEvent. Early learning use cases use this entity to specify instructional session start and end times within the context of a day.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200247">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200247</dc:identifier>
		<rdfs:label>Organization Email</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>OrganizationEmail</skos:notation>
		<dc:description>An email address for an organization.</dc:description>
		<skos:definition>An email address for an organization.</skos:definition>
	</rdfs:Class>
