		<rdfs:label>National guard or other reserve active duty</rdfs:label>
		<skos:definition>The participant exits the program because the participant is a member of the National Guard or other reserve military unit of the armed forces and is called to active duty for at least 90 days.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001939" />
		<skos:notation>1002</skos:notation>
		<skos:prefLabel>National guard or other reserve active duty</skos:prefLabel>
	</owl:NamedIndividual>
