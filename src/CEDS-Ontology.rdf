	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000799">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indication of whether the person is a member of a union.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000799</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Union Membership Status</rdfs:label>
