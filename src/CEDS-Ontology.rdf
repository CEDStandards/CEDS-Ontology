		<skos:notation>hasOtherNameType</skos:notation>
		<dc:description>The types of previous, alternate or other names for a person.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The types of previous, alternate or other names for a person.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000207">
		<dc:creator>Common Education Data Standards</dc:creator>
