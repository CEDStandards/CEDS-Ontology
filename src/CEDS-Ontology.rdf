		<skos:notation>hasFinancialAidApplicationType</skos:notation>
		<dc:description>The type of financial application completed by an individual.</dc:description>
		<rdfs:comment>Common Data Set definition.  This element may be repeated multiple times.</rdfs:comment>
		<skos:definition>The type of financial application completed by an individual.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000363">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000363</dc:identifier>
		<rdfs:label>Has Financial Aid Award Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200145" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000363" />
		<skos:notation>hasFinancialAidAwardStatus</skos:notation>
		<dc:description>An indication of whether the financial aid type being reported is aid that has been awarded, accepted or dispersed.</dc:description>
		<rdfs:comment>Linked to financial aid type, financial aid amount.   &lt;BR/&gt;Note:  For any given individual this field may be repeated multiple times.</rdfs:comment>
		<skos:definition>An indication of whether the financial aid type being reported is aid that has been awarded, accepted or dispersed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000113">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000113</dc:identifier>
		<rdfs:label>Has Financial Aid Award Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200145" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000113" />
		<skos:notation>hasFinancialAidAwardType</skos:notation>
		<dc:description>The classification of financial aid awarded to a person for the academic term/year.</dc:description>
		<rdfs:comment>Linked to financial aid type.&lt;BR/&gt;Note:  For any given individual this cluster of fields may be repeated multiple times.</rdfs:comment>
		<skos:definition>The classification of financial aid awarded to a person for the academic term/year.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001609">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001609</dc:identifier>
		<rdfs:label>Has Financial Aid Veteran's Benefit Status</rdfs:label>
