		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Student was served by Title I, Part D, Subpart 2 of ESEA as amended for at least 90 consecutive days during the reporting period who took both a pre- and post-test.</skos:definition>
		<skos:notation>NeglectedOrDelinquentAcademicOutcomeIndicator</skos:notation>
		<skos:prefLabel>Neglected or Delinquent Academic Outcome Indicator</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000647">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Staff member who has a Teacher of Record responsibility for a Class Section based upon the state's definition of Teacher of Record.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000647</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Teacher of Record</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Staff member who has a Teacher of Record responsibility for a Class Section based upon the state's definition of Teacher of Record.</skos:definition>
		<skos:notation>TeacherOfRecord</skos:notation>
		<skos:prefLabel>Teacher of Record</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000732">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Staff whose primary function/occupational activity is primarily instruction or instruction combined with research and/or public service. Does not include medical school staff.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000732</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Instructional Staff Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>Staff whose primary function/occupational activity is primarily instruction or instruction combined with research and/or public service. Does not include medical school staff.</skos:definition>
		<skos:notation>InstructionalStaffStatus</skos:notation>
		<skos:prefLabel>Instructional Staff Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000733">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Staff employed by or employees working in the medical school component of a postsecondary institution or in a free standing medical school. Does not include staff employed by or employees working strictly in a hospital associated with a medical school or those who work in health or allied health schools or departments such as dentistry, veterinary medicine, nursing or dental hygiene.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000733</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Medical School Staff Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>Staff employed by or employees working in the medical school component of a postsecondary institution or in a free standing medical school. Does not include staff employed by or employees working strictly in a hospital associated with a medical school or those who work in health or allied health schools or departments such as dentistry, veterinary medicine, nursing or dental hygiene.</skos:definition>
		<skos:notation>MedicalSchoolStaffStatus</skos:notation>
		<skos:prefLabel>Medical School Staff Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000738">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indicator of whether an institution has personnel positions that lead to consideration for tenure.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000738</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Tenure System</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>An indicator of whether an institution has personnel positions that lead to consideration for tenure.</skos:definition>
		<skos:notation>TenureSystem</skos:notation>
		<skos:prefLabel>Tenure System</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000742">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Graduate-level students employed on a part-time basis, not limited to, but often employed for the primary purpose of assisting in classroom or laboratory instruction or in the conduct of research. Graduate students having titles such as graduate assistant, teaching assistant, teaching associate, teaching fellow, or research assistant typically hold these positions.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000742</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Graduate Assistant Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>Graduate-level students employed on a part-time basis, not limited to, but often employed for the primary purpose of assisting in classroom or laboratory instruction or in the conduct of research. Graduate students having titles such as graduate assistant, teaching assistant, teaching associate, teaching fellow, or research assistant typically hold these positions.</skos:definition>
		<skos:notation>GraduateAssistantStatus</skos:notation>
		<skos:prefLabel>Graduate Assistant Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000748">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indication of whether an institution has any residence hall or housing facility located on- or off-campus that is owned or controlled by an institution and used by the institution in direct support of or in a manner related to, the institution's educational purposes.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000748</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Institutionally Controlled Housing Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>An indication of whether an institution has any residence hall or housing facility located on- or off-campus that is owned or controlled by an institution and used by the institution in direct support of or in a manner related to, the institution's educational purposes.</skos:definition>
		<skos:notation>InstitutionallyControlledHousingStatus</skos:notation>
		<skos:prefLabel>Institutionally Controlled Housing Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000755">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An individual who has fulfilled the institution's requirements to be considered for admission (including payment or waiving of the application fee, if any) and who has been notified of one of the following actions: admission, nonadmission, placement on waiting list, or application withdrawn (by applicant or institution). Include early decision, early action, and students who began studies during summer in this cohort.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000755</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Postsecondary Applicant</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>An individual who has fulfilled the institution's requirements to be considered for admission (including payment or waiving of the application fee, if any) and who has been notified of one of the following actions: admission, nonadmission, placement on waiting list, or application withdrawn (by applicant or institution). Include early decision, early action, and students who began studies during summer in this cohort.</skos:definition>
		<skos:notation>PostsecondaryApplicant</skos:notation>
		<skos:prefLabel>Postsecondary Applicant</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000760">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student resides in a residence hall or housing facility owned or controlled by an institution within the same reasonably contiguous geographic area and used by the institution in direct support of or in a manner related to, the institution's educational purposes.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000760</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Postsecondary Student Housing On-Campus</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>The student resides in a residence hall or housing facility owned or controlled by an institution within the same reasonably contiguous geographic area and used by the institution in direct support of or in a manner related to, the institution's educational purposes.</skos:definition>
		<skos:notation>PostsecondaryStudentHousingOnCampus</skos:notation>
		<skos:prefLabel>Postsecondary Student Housing On-Campus</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000761">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Student is in membership of a chiefly social organization of men students at a college or university, usually designated by Greek letters.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000761</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Fraternity Participation Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Student is in membership of a chiefly social organization of men students at a college or university, usually designated by Greek letters.</skos:definition>
		<skos:notation>FraternityParticipationStatus</skos:notation>
		<skos:prefLabel>Fraternity Participation Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000762">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Student is in membership in a chiefly social organization of women students at a college or university, usually designated by Greek letters.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000762</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Sorority Participation Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Student is in membership in a chiefly social organization of women students at a college or university, usually designated by Greek letters.</skos:definition>
		<skos:notation>SororityParticipationStatus</skos:notation>
		<skos:prefLabel>Sorority Participation Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000763">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Any applicant who submits any one of the institutionally required financial aid applications/forms, such as the Free Application for Federal Student Aid (FAFSA).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000763</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Financial Aid Applicant</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>Any applicant who submits any one of the institutionally required financial aid applications/forms, such as the Free Application for Federal Student Aid (FAFSA).</skos:definition>
		<skos:notation>FinancialAidApplicant</skos:notation>
		<skos:prefLabel>Financial Aid Applicant</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000775">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who receives or is a member of a family who receives a total family income in the 6 months prior to enrollment of 70 percent of the income standard for a family of that size or that does not exceed the poverty line, or the person is receiving or is a member of a family who is receiving cash assistance payments from Federal, State, or local agencies or food stamps, or the person can be designated as homeless under the McKinney Act.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000775</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Low-income Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>A person who receives or is a member of a family who receives a total family income in the 6 months prior to enrollment of 70 percent of the income standard for a family of that size or that does not exceed the poverty line, or the person is receiving or is a member of a family who is receiving cash assistance payments from Federal, State, or local agencies or food stamps, or the person can be designated as homeless under the McKinney Act.</skos:definition>
		<skos:notation>LowIncomeStatus</skos:notation>
		<skos:prefLabel>Low-income Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000776">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An individual who has been terminated or laid off, or who has received a notice of termination or layoff from employment, or an individual who was self-employed but is unemployed as a result of general economic conditions in the community in which the individual resides or because of natural disasters.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000776</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Dislocated Worker Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>An individual who has been terminated or laid off, or who has received a notice of termination or layoff from employment, or an individual who was self-employed but is unemployed as a result of general economic conditions in the community in which the individual resides or because of natural disasters.</skos:definition>
		<skos:notation>DislocatedWorkerStatus</skos:notation>
		<skos:prefLabel>Dislocated Worker Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000777">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who receives financial assistance from Federal, State, or local government agencies, including Temporary Assistance for Needy Families or equivalent.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000777</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Public Assistance Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>A person who receives financial assistance from Federal, State, or local government agencies, including Temporary Assistance for Needy Families or equivalent.</skos:definition>
		<skos:notation>PublicAssistanceStatus</skos:notation>
		<skos:prefLabel>Public Assistance Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000778">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who resides in a place with a population of less than 2,500 that is not near any metropolitan area with a population greater than 50,000, or in a city with adjacent areas of high density.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000778</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Rural Residency Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>A person who resides in a place with a population of less than 2,500 that is not near any metropolitan area with a population greater than 50,000, or in a city with adjacent areas of high density.</skos:definition>
		<skos:notation>RuralResidencyStatus</skos:notation>
		<skos:prefLabel>Rural Residency Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000757">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who meets the admission requirements but will only be offered a place in the class if space becomes available.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000757</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Wait Listed Student</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>A person who meets the admission requirements but will only be offered a place in the class if space becomes available.</skos:definition>
		<skos:notation>WaitListedStudent</skos:notation>
		<skos:prefLabel>Wait Listed Student</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000789">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Staff has a degree in early childhood regardless of level.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000789</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
