				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updating to reflect the latest version of the ISO 639-3 standard.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated to reflect the latest version of the ISO 639-3 standard. Element applied to additional DES contexts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The code for the specific language or dialect that a person uses to communicate.</skos:definition>
