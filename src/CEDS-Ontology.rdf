		<dc:description>A location such as a physical address or mailing address.</dc:description>
		<skos:definition>A location such as a physical address or mailing address.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200238">
