				<changeDescription>Updated usage note.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>This classification is used to describe the service or commodity obtained as the result of a specific expenditure. Nine major object categories have codes ending in 00 and are further subdivided.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001224">
