		<rdfs:label>Animal Systems�Independent Study</rdfs:label>
		<skos:definition>Courses in Animal Systems�Independent Study, often conducted with instructors as mentors, enable students to explore topics of interest related to animal systems. Independent Study courses may serve as an opportunity for students to expand their expertise in a particular application, to explore a topic in greater detail, or to develop more advanced skills.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>18147</skos:notation>
		<skos:prefLabel>Animal Systems�Independent Study</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164280">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Other Agricultural Production and Processing courses.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164280</dc:identifier>
