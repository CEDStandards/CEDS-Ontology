	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000193">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indication that the student is participating in programs for neglected or delinquent students (N or D) under Title I, Part D, Subpart 1 (state agencies) or Subpart 2 (local agencies) of ESEA as amended.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000193</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
