		<skos:notation>GraduateOrDoctoralExamResultsStatus</skos:notation>
		<skos:prefLabel>Graduate or Doctoral Exam Results Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001369">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indication of whether the offense was primary or secondary in nature when a single incident included more than one type of offense.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001369</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Incident Multiple Offense Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>An indication of whether the offense was primary or secondary in nature when a single incident included more than one type of offense.</skos:definition>
		<skos:notation>IncidentMultipleOffenseType</skos:notation>
		<skos:prefLabel>Incident Multiple Offense Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001372">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Information on the type of individual who committed an incident. A "perpetrator" is an individual involved in an incident as an offender (the person who committed the infraction constituting the incident).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001372</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Incident Perpetrator Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Information on the type of individual who committed an incident. A "perpetrator" is an individual involved in an incident as an offender (the person who committed the infraction constituting the incident).</skos:definition>
		<skos:notation>IncidentPerpetratorType</skos:notation>
		<skos:prefLabel>Incident Perpetrator Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001378">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Information on the type of individual who was injured or otherwise harmed as a direct result of the incident. A "victim" is the individual who suffers injury or harm that directly results from the incident.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001378</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Incident Victim Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Information on the type of individual who was injured or otherwise harmed as a direct result of the incident. A "victim" is the individual who suffers injury or harm that directly results from the incident.</skos:definition>
		<skos:notation>IncidentVictimType</skos:notation>
		<skos:prefLabel>Incident Victim Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001380">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Information on the type of individual who witnessed the incident and can give a firsthand account of an incident that was seen, heard, or experienced.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001380</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Incident Witness Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Information on the type of individual who witnessed the incident and can give a firsthand account of an incident that was seen, heard, or experienced.</skos:definition>
		<skos:notation>IncidentWitnessType</skos:notation>
		<skos:prefLabel>Incident Witness Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001373">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The role or type of participation of a person in a discipline incident.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001373</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Incident Person Role Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>The role or type of participation of a person in a discipline incident.</skos:definition>
		<skos:notation>IncidentPersonRoleType</skos:notation>
		<skos:prefLabel>Incident Person Role Type</skos:prefLabel>
	</owl:Class>
