	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001650151062">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A non-profit organization that operates or manages multiple charter schools (i.e., either through a contract with the charter schools or as the charter holder) linked by centralized support, operations, and oversight.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001650151062</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001650" />
