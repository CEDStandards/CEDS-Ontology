		<skos:definition>Used for reporting gifts and other additions to endowments that are permanently nonexpendable.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001672" />
		<skos:notation>Additionstopermanentendowments</skos:notation>
