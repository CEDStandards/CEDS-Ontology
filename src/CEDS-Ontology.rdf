		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Shows functioning expected for age in all or almost all everyday situations</rdfs:label>
		<skos:definition>Child shows functioning expected for his or her age in all or almost all everyday situations that are part of the child's life. Functioning is considered appropriate for his or her age.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001509" />
		<skos:notation>07</skos:notation>
		<skos:prefLabel>Shows functioning expected for age in all or almost all everyday situations</skos:prefLabel>
