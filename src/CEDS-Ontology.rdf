			</editHistoryEntry>
		</editHistory>
		<skos:definition>The circumstances under which the student exited from membership in a course section.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001161">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001161</dc:identifier>
