		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001437</dc:identifier>
		<rdfs:label>Professional Development Activity Credits</rdfs:label>
