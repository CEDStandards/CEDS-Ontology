		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>RubricCriterionWeight</skos:notation>
		<dc:description>A numeric weight assigned to this Rubric Criterion, used for scored rubrics.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>A numeric weight assigned to this Rubric Criterion, used for scored rubrics.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001471">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001471</dc:identifier>
		<rdfs:label>Rubric Criterion Level Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200355" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>RubricCriterionLevelDescription</skos:notation>
		<dc:description>Text describing  one or more benchmarks that must be met to achieve a degree of achievement on a product, process, or performance task.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Text describing  one or more benchmarks that must be met to achieve a degree of achievement on a product, process, or performance task.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001472">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001472</dc:identifier>
		<rdfs:label>Rubric Criterion Level Feedback</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200355" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>RubricCriterionLevelFeedback</skos:notation>
		<dc:description>Pre-defined feedback text to be relayed to the person or organization being evaluated.  This may include guidance and suggestions for improvement or development.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Pre-defined feedback text to be relayed to the person or organization being evaluated.  This may include guidance and suggestions for improvement or development.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001473">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001473</dc:identifier>
		<rdfs:label>Rubric Criterion Level Position</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200355" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>RubricCriterionLevelPosition</skos:notation>
		<dc:description>A numeric value representing the level's position in the list of levels defined for the Rubric Criterion.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>A numeric value representing the level's position in the list of levels defined for the Rubric Criterion.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001474">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001474</dc:identifier>
		<rdfs:label>Rubric Criterion Level Quality Label</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200355" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>RubricCriterionLevelQualityLabel</skos:notation>
		<dc:description>A qualitative description of this degree of achievement used for column headers or row labels in tabular rubrics.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A qualitative description of this degree of achievement used for column headers or row labels in tabular rubrics.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001475">
