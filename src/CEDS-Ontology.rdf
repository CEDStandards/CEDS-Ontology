	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164047">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Metalwork�Workplace Experience courses provide students with work experience in the welding, machine technologies, or metalwork fields. Goals are typically set cooperatively by the student, teacher, and employer (although students are not necessarily paid). These courses may include classroom activities as well, involving further study of the field or discussion regarding experiences that students encounter in the workplace.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164047</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Metalwork�Workplace Experience</rdfs:label>
		<skos:definition>Metalwork�Workplace Experience courses provide students with work experience in the welding, machine technologies, or metalwork fields. Goals are typically set cooperatively by the student, teacher, and employer (although students are not necessarily paid). These courses may include classroom activities as well, involving further study of the field or discussion regarding experiences that students encounter in the workplace.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>13248</skos:notation>
		<skos:prefLabel>Metalwork�Workplace Experience</skos:prefLabel>
	</owl:NamedIndividual>
