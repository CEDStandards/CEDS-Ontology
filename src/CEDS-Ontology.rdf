			<editHistoryEntry> 	
				<changeDescription>Added new element to DES to support reporting requirements</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001987">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001987</dc:identifier>
		<rdfs:label>Staff Evaluation Part Scale</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200367" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>StaffEvaluationPartScale</skos:notation>
		<dc:description>The quantitative or qualitative range of possible scores/rating for a person's performance on a component part (e.g., 0 - 10; Poor, Fair, Average, Good, Excellent).</dc:description>
		<maxLength>80</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The quantitative or qualitative range of possible scores/rating for a person's performance on a component part (e.g., 0 - 10; Poor, Fair, Average, Good, Excellent).</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES to support reporting requirements</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000302">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000302</dc:identifier>
		<rdfs:label>Years of Prior Teaching Experience</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200368" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>YearsOfPriorTeachingExperience</skos:notation>
		<dc:description>The total number of years prior to this job that a person has previously held a teaching position in one or more education institutions.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The total number of years prior to this job that a person has previously held a teaching position in one or more education institutions.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updating element definition for "YearsOfPriorTeachingExperience" to clarify that it means prior to the current job.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002060">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002060</dc:identifier>
		<rdfs:label>Years of Total Experience</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200368" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>YearsOfTotalExperience</skos:notation>
		<dc:description>The total number of years that a person has held this position or a similar position in one or more organizations.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The total number of years that a person has held this position or a similar position in one or more organizations.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002061">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002061</dc:identifier>
		<rdfs:label>Years of Prior Professional Experience</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200368" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>YearsOfPriorProfessionalExperience</skos:notation>
		<dc:description>The total number of years that an individual has previously held a similar professional position in one or more education institutions prior to the current school year.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The total number of years that an individual has previously held a similar professional position in one or more education institutions prior to the current school year.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001061">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001061</dc:identifier>
		<rdfs:label>Staff Professional Development Activity Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200369" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>StaffProfessionalDevelopmentActivityStartDate</skos:notation>
		<dc:description>The year, month and day on which an individual begins a course, an education program or a staff development activity.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day on which an individual begins a course, an education program or a staff development activity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>"Staff" added to element name.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001062">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001062</dc:identifier>
		<rdfs:label>Staff Professional Development Activity Completion Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200369" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>StaffProfessionalDevelopmentActivityCompletionDate</skos:notation>
		<dc:description>The year, month and day on which an individual completed a course, an education program or a staff development activity.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day on which an individual completed a course, an education program or a staff development activity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>"Staff" added to element name.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000455">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000455</dc:identifier>
		<rdfs:label>Date State Received Title III Allocation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200206" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>DateStateReceivedTitleIIIAllocation</skos:notation>
		<dc:description>Annual date the State receives the Title III allocation from U.S. Department of Education (ED).</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>Annual date the State receives the Title III allocation from U.S. Department of Education (ED).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000456">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000456</dc:identifier>
		<rdfs:label>Date Title III Funds Available to Subgrantees</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200206" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>DateTitleIIIFundsAvailableToSubgrantees</skos:notation>
		<dc:description>Annual date that Title III funds are available to approved subgrantees.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>Annual date that Title III funds are available to approved subgrantees.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000457">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000457</dc:identifier>
		<rdfs:label>Number of Days for Title III Subgrants</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200206" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>NumberOfDaysForTitleIIISubgrants</skos:notation>
		<dc:description>Average number of days for States receiving Title III funds to make subgrants to subgrantees beginning from July 1 of each year, except under conditions where funds are being withheld.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>Average number of days for States receiving Title III funds to make subgrants to subgrantees beginning from July 1 of each year, except under conditions where funds are being withheld.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000279">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000279</dc:identifier>
		<rdfs:label>Telephone Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200272" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>TelephoneNumber</skos:notation>
		<dc:description>The telephone number including the area code, and extension, if applicable.</dc:description>
		<maxLength>24</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The telephone number including the area code, and extension, if applicable.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000991">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000991</dc:identifier>
		<rdfs:label>Person Employed in Multiple Jobs Count</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200373" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>PersonEmployedInMultipleJobsCount</skos:notation>
		<dc:description>The number of jobs held by a person during the reference period.</dc:description>
		<rdfs:comment>Workforce Notes: The data sources represent employment during a three month period. Students found employed may have multiple jobs during a reference period with no indication of their sequence. The option set provides a set of numeric ranges for these instances. Many states report these numbers, some as indications of employment stability. Note that it may be desirable to collect these data over time, in a longitudinal sense, to measure things related to persistence, change, and growth in employment.</rdfs:comment>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The number of jobs held by a person during the reference period.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Person Employed in Multiple Jobs.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001938">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001938</dc:identifier>
		<rdfs:label>Cohort Median Earnings</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200374" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>CohortMedianEarnings</skos:notation>
		<dc:description>The midpoint between the lowest and highest quarterly wage, in U.S. dollars, for the total number of persons included in the cohort for the period of time between the Employment Record Reference Period Start Date and Employment Record Reference Period End Date.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The midpoint between the lowest and highest quarterly wage, in U.S. dollars, for the total number of persons included in the cohort for the period of time between the Employment Record Reference Period Start Date and Employment Record Reference Period End Date.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002142">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002142</dc:identifier>
		<rdfs:label>Adaptive and Specialized Equipment or Furniture Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200012" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<skos:notation>AdaptiveAndSpecializedEquipmentOrFurnitureDescription</skos:notation>
		<dc:description>The description of the furniture or equipment used to address physical or sensory needs.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The description of the furniture or equipment used to address physical or sensory needs.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New</changeDescription>
				<changeVersion>13</changeVersion>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002125">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002125</dc:identifier>
		<rdfs:label>Anticipated Date of Transition</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200102" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<skos:notation>AnticipatedDateofTransition</skos:notation>
		<dc:description>The anticipated date services will end under IDEA Part C and begin under Part B 619 or another early learning program or service.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The anticipated date services will end under IDEA Part C and begin under Part B 619 or another early learning program or service.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New</changeDescription>
				<changeVersion>13</changeVersion>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002155">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002155</dc:identifier>
		<rdfs:label>Assessment Extended Time Duration</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200012" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<skos:notation>AssessmentExtendedTimeDuration</skos:notation>
		<dc:description>Additional time, recorded in minutes, to complete an assessment beyond the standard duration.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
