			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates whether a student receiving Title III funds exited an English language instruction educational program as a result of attaining English language proficiency.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002179">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002179</dc:identifier>
		<rdfs:label>Has EDFacts Cohort Graduation Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200212" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002179" />
		<skos:notation>hasEdFactsCohortGraduationStatus</skos:notation>
		<dc:description>An indication of whether students in a cohort graduated with a high school diploma within the allowable timeframe.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New element created to support EDFacts File Specification 151</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/824</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether students in a cohort graduated with a high school diploma within the allowable timeframe.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002180">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002180</dc:identifier>
		<rdfs:label>Has Neglected or Delinquent Long Term Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200321" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002180" />
		<skos:notation>hasNeglectedOrDelinquentLongTermStatus</skos:notation>
		<dc:description>An indication that students were served for at least 90 consecutive days during the reporting period by Title I, Part D of ESEA as amended.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New element created to support EDFacts File Specification 127</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/848</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that students were served for at least 90 consecutive days during the reporting period by Title I, Part D of ESEA as amended.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002181">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002181</dc:identifier>
		<rdfs:label>Has Neglected or Delinquent Program Enrollment Subpart</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200321" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002181" />
		<skos:notation>hasNeglectedOrDelinquentProgramEnrollmentSubpart</skos:notation>
		<dc:description>Indicates the Title I, Part D subpart under which a student is enrolled in a program for neglected or delinquent students, as defined in the Elementary and Secondary Education Act (ESEA), as amended.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New element created to support EDFacts FSs 218, 219, 220, 221</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/850</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates the Title I, Part D subpart under which a student is enrolled in a program for neglected or delinquent students, as defined in the Elementary and Secondary Education Act (ESEA), as amended.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002206">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002206</dc:identifier>
		<rdfs:label>Death Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200418" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>DeathDate</skos:notation>
		<dc:description>The year, month, and day on which a person died.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month, and day on which a person died.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry>
				<changeDescription>New property created</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/922</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002183">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002183</dc:identifier>
		<rdfs:label>Has Magnet or Special Program Emphasis Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200199" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002183" />
		<skos:notation>hasMagnetOrSpecialProgramEmphasisType</skos:notation>
		<dc:description>The type of emphasis a school or special program has as it relates to its population.</dc:description>
		<rdfs:comment>This element may be used with Magnet or Special Program Emphasis School to respond to Civil Rights Data Collection, School Form, School Characteristics (SCHR-5).</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC School Characteristics module (SCHR-5)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1062</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of emphasis a school or special program has as it relates to its population.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002184">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002184</dc:identifier>
		<rdfs:label>Has Service Charge Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200315" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002184" />
		<skos:notation>hasServiceChargeIndicator</skos:notation>
		<dc:description>An indication of the charge to parent or guardian for a service and/or program.</dc:description>
		<rdfs:comment>Used for Civil Rights Data Collection reporting, specifically SSPR-7 and SSPR-13 of the LEA Form. See 2023-2024 LEA Form.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Students, Schools and Programs module (SSPR-7 and SSPR-13)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1061</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the charge to parent or guardian for a service and/or program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002185">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002185</dc:identifier>
		<rdfs:label>Has Preschool Daily Length</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200315" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002185" />
		<skos:notation>hasPreschoolDailyLength</skos:notation>
		<dc:description>The portion of a day that a preschool program is provided to the students it serves.</dc:description>
		<rdfs:comment>This element is used for Civil Rights Data Collection and defines preschool as ages 3 to 5.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Students, Schools and Programs module (SSPR-7 and SSPR-13)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1060</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The portion of a day that a preschool program is provided to the students it serves.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002186">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002186</dc:identifier>
		<rdfs:label>Has Wi-Fi Enabled Device Need Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200283" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002186" />
		<skos:notation>hasWiFiEnabledDeviceNeedIndicator</skos:notation>
		<dc:description>Indicates a student's need for a Wi-Fi enabled device to access remote instruction.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Internet Access and Devices module (INET-3)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1058</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates a student's need for a Wi-Fi enabled device to access remote instruction.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002187">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002187</dc:identifier>
		<rdfs:label>Has Wi-Fi Enabled Device Received Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200283" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002187" />
		<skos:notation>hasWiFiEnabledDeviceReceivedIndicator</skos:notation>
		<dc:description>Indicates whether a student received a Wi-Fi enabled device to access remote instruction.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Internet Access and Devices module (INET-4)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1059</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates whether a student received a Wi-Fi enabled device to access remote instruction.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002188">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002188</dc:identifier>
		<rdfs:label>Has Shooting Incident Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002188" />
		<skos:notation>hasShootingIncidentIndicator</skos:notation>
		<dc:description>An indication of whether the incident involved a shooting, regardless of whether anyone was hurt or whether a student or non-student used a firearm or explosive device.</dc:description>
		<rdfs:comment>Used to capture school shootings for Civil Rights Data Collection, Offenses Module.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Offenses module (OFFN-4)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1057</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether the incident involved a shooting, regardless of whether anyone was hurt or whether a student or non-student used a firearm or explosive device.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002189">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002189</dc:identifier>
		<rdfs:label>Has Incident Responsibility Staff Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002189" />
		<skos:notation>hasIncidentResponsibilityStaffIndicator</skos:notation>
		<dc:description>An indication of whether a staff member was determined to be involved in an incident as an offender (the person who committed the infraction constituting the incident).</dc:description>
		<rdfs:comment>Identifies incidents where staff, contractors, or volunteers were determined to be primarily responsible.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Offenses module (OFFN-7 and OFFN-8)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1054</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether a staff member was determined to be involved in an incident as an offender (the person who committed the infraction constituting the incident).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002190">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002190</dc:identifier>
		<rdfs:label>Has Hotspot Need Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200283" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002190" />
		<skos:notation>hasHotspotNeedIndicator</skos:notation>
		<dc:description>Indicates whether a student needs a Wi-Fi hotspot to access remote instruction.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Internet Access and Devices module (INET-3)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1052</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates whether a student needs a Wi-Fi hotspot to access remote instruction.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002191">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002191</dc:identifier>
		<rdfs:label>Has Hotspot Received Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200283" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002191" />
		<skos:notation>hasHotspotReceivedIndicator</skos:notation>
		<dc:description>Indicates whether a student received a Wi-Fi hotspot to access remote instruction.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Internet Access and Devices module (INET-4)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1053</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates whether a student received a Wi-Fi hotspot to access remote instruction.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002192">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002192</dc:identifier>
		<rdfs:label>Has CRDC Justice Facility Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002192" />
		<skos:notation>hasCRDCJusticeFacilityType</skos:notation>
		<dc:description>The type of public or private facility that confines pre-adjudicated/pre-convicted individuals, post-adjudicated/post-convicted individuals, or both.</dc:description>
		<rdfs:comment>For CRDC, justice facilities include, but are not limited to correctional facilities, detention centers, jails, and prisons. These facilities may confine juveniles (individuals typically under 21 years of age), adults (individuals typically 21 years of age and older), or both. Some states and jurisdictions include individuals younger than age 21 as adults due to statute/legislation and/or justice procedures. For the purposes of the CRDC, only individuals up to 21 years of age who are confined in justice facilities are of interest. Source: 2023-2024 CRDC School Form</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Justice Facilities module (JUST-1)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1051</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of public or private facility that confines pre-adjudicated/pre-convicted individuals, post-adjudicated/post-convicted individuals, or both.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002193">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002193</dc:identifier>
		<rdfs:label>Has Justice Facility Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002193" />
		<skos:notation>hasJusticeFacilityIndicator</skos:notation>
		<dc:description>An indication a facility is a public or private facility that confines pre-adjudicated/pre-convicted individuals, post-adjudicated/post-convicted individuals, or both.</dc:description>
		<rdfs:comment>Flags schools/programs that operate within or primarily serve a justice facility.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support CRDC Justice Facilities module (JUST-1, JUST-2, and JUST-3)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1050</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication a facility is a public or private facility that confines pre-adjudicated/pre-convicted individuals, post-adjudicated/post-convicted individuals, or both.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002194">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002194</dc:identifier>
		<rdfs:label>Has Evaluation Required Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200175" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002194" />
		<skos:notation>hasEvaluationRequiredIndicator</skos:notation>
		<dc:description>Indicates if a position must be evaluated.</dc:description>
		<rdfs:comment>Many states have laws requiring the evaluation of certain educational staff (such as teachers or specific administrators). This element identifies which positions are required to be evaluated based on law.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support Michigan's collection applications that need to identify which staffing data must include an evaluation rating</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/952</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates if a position must be evaluated.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002196">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002196</dc:identifier>
		<rdfs:label>Has Credential Award Status Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002196" />
		<skos:notation>hasCredentialAwardStatusType</skos:notation>
		<dc:description>An indication of whether a credential is valid for use.</dc:description>
		<rdfs:comment>Replaces Credential Revoked Indicator (001751) with a more comprehensive status tracking element. Allows tracking of multiple credential validity states.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to replace Credential Revoked Indicator with a comprehensive credential status tracking element per Michigan, Vermont, and Mississippi requirements</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1033</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether a credential is valid for use.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002197">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002197</dc:identifier>
		<rdfs:label>Credential Award Status Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CredentialAwardStatusDate</skos:notation>
		<dc:description>The date on which the status of a qualification, achievement, personal or organizational quality, or aspect of an identity was changed.</dc:description>
		<rdfs:comment>Replaces Credential Revoked Date (001660) with a more comprehensive status date element. Allows tracking when a credential moves between different statuses.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to replace Credential Revoked Date with a comprehensive credential status date element</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1033</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The date on which the status of a qualification, achievement, personal or organizational quality, or aspect of an identity was changed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002198">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002198</dc:identifier>
		<rdfs:label>Credential Award Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialAwardIdentifier</skos:notation>
		<dc:description>A unique number or alphanumeric code assigned to a credential award by a program, school, school system, state, or other organization.</dc:description>
		<rdfs:comment>The purpose of Credential Award Identifier and Credential Award Identification System is to provide an element where an identifier can be created and assigned when a more specific element does not exist in CEDS. As an example, if the identifier is a license, then the element Professional Certificate or License Number (001429) would be used.</rdfs:comment>
		<textFormat>Alphanumeric</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to provide internal identifier tracking for credential awards and parts of credentials.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1030</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A unique number or alphanumeric code assigned to a credential award by a program, school, school system, state, or other organization.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002199">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002199</dc:identifier>
		<rdfs:label>Has Credential Award Identification System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002199" />
		<skos:notation>hasCredentialAwardIdentificationSystem</skos:notation>
		<dc:description>A coding scheme that is used for identification and record-keeping purposes by a program, school, school system, state, or other organization to refer to the award of a credential.</dc:description>
		<rdfs:comment>The purpose of Credential Award Identifier and Credential Award Identification System is to provide an element where an identifier can be created and assigned when a more specific element does not exist in CEDS.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to identify the source/type of Credential Award Identifier.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1030</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A coding scheme that is used for identification and record-keeping purposes by a program, school, school system, state, or other organization to refer to the award of a credential.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002200">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002200</dc:identifier>
		<rdfs:label>Interscholastic Sports</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200190" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
		<skos:notation>InterscholasticSports</skos:notation>
		<dc:description>The number of interscholastic sports offered. Sports include distinct sports such as football, basketball, soccer but not intramural sports or cheerleading.</dc:description>
		<rdfs:comment>Supports CRDC Interscholastic Athletics module reporting, specifically ATHL-2. This element provides a way for an LEA or school to designate each interscholastic sport so they can provide the count required by ATHL-2.</rdfs:comment>
		<textFormat>Integer</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created for CRDC Interscholastic Athletics module reporting (ATHL-2)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1055</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The number of interscholastic sports offered. Sports include distinct sports such as football, basketball, soccer but not intramural sports or cheerleading.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002201">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002201</dc:identifier>
		<rdfs:label>Interscholastic Teams</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200190" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
		<skos:notation>InterscholasticTeams</skos:notation>
		<dc:description>The number of interscholastic teams offered. Teams include each competitive level team in each sport, such as freshman team, junior varsity team, and varsity team but not intramural sports or cheerleading.</dc:description>
		<rdfs:comment>Supports CRDC Interscholastic Athletics module reporting, specifically ATHL-2. This element provides a way for an LEA or school to designate each interscholastic team so they can provide the count required by ATHL-2.</rdfs:comment>
		<textFormat>Integer</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created for CRDC Interscholastic Athletics module reporting (ATHL-2)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1055</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The number of interscholastic teams offered. Teams include each competitive level team in each sport, such as freshman team, junior varsity team, and varsity team but not intramural sports or cheerleading.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002202">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002202</dc:identifier>
		<rdfs:label>Has Harassment or Bullying Religion Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>hasHarassmentOrBullyingReligionType</skos:notation>
		<dc:description>The actual or perceived religious affiliation of a student that is the basis of an allegation of harassment or bullying.</dc:description>
		<rdfs:comment>Supports CRDC School Form reporting, specifically HIBS-2 (Allegations of Harassment or Bullying - By Religion Type).</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created for CRDC School Form HIBS-2 reporting (Allegations of Harassment or Bullying - By Religion Type)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1056</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The actual or perceived religious affiliation of a student that is the basis of an allegation of harassment or bullying.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002203">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002203</dc:identifier>
		<rdfs:label>Has Title III Language Instruction Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200207" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002203" />
		<skos:notation>hasTitleIIILanguageInstructionIndicator</skos:notation>
		<dc:description>An indication of whether a teacher teaches in language instruction educational programs designed for English learners supported with Title III of ESEA, as amended by ESSA, funds.</dc:description>
		<rdfs:comment>The primary use case is for EDFacts file specification 067 and is intended to capture a teacher that is teaching Title III English Learners in a district receiving Title III funds.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to support EDFacts File Specification 067</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/957</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether a teacher teaches in language instruction educational programs designed for English learners supported with Title III of ESEA, as amended by ESSA, funds.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002204">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002204</dc:identifier>
		<rdfs:label>Professional Development Activity Approval Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200311" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ProfessionalDevelopmentActivityApprovalStartDate</skos:notation>
		<dc:description>The earliest date that any session of an approved activity may be offered.</dc:description>
		<rdfs:comment>Used with Professional Development Activity Approval Code to define the valid date range for an approved PD activity.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to store the start date for which a Professional Development Activity Approval is valid.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1032</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The earliest date that any session of an approved activity may be offered.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002205">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002205</dc:identifier>
		<rdfs:label>Professional Development Activity Approval End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200311" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ProfessionalDevelopmentActivityApprovalEndDate</skos:notation>
		<dc:description>The latest date that any session of an approved activity may be offered.</dc:description>
		<rdfs:comment>Used with Professional Development Activity Approval Code to define the valid date range for an approved PD activity.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created to store the end date for which a Professional Development Activity Approval is valid.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1032</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The latest date that any session of an approved activity may be offered.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600572">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600572</dc:identifier>
		<rdfs:label>Has Person Death</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200275" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200418" />
		<skos:notation>hasPersonDeath</skos:notation>
		<dc:description>References information related to the death of a person</dc:description>
		<skos:definition>References information related to the death of a person</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New property created for Person Death</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/922</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<!-- CEDS Option Sets -->
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002016">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Indicates whether or not the program has a written policy addressing diversity, equity and inclusion (DEI).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C002016</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Diversity Equity Inclusion Policy Indicator</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Indicates whether or not the program has a written policy addressing diversity, equity and inclusion (DEI).</skos:definition>
		<skos:notation>DEIPolicyIndicator</skos:notation>
		<skos:prefLabel>Diversity Equity Inclusion Policy Indicator</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002017">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An adjustment of the last known circumstances under which the student exited from membership in an educational institution.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C002017</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Adjusted Exit or Withdrawal Type</rdfs:label>
