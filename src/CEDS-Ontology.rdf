	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001199">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001199</dc:identifier>
		<rdfs:label>Has Assessment Asset Identifier Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001199" />
		<skos:notation>hasAssessmentAssetIdentifierType</skos:notation>
		<dc:description>The type of identifier that is provided for this asset.</dc:description>
		<skos:definition>The type of identifier that is provided for this asset.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001196">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001196</dc:identifier>
		<rdfs:label>Has Assessment Asset Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001196" />
		<skos:notation>hasAssessmentAssetType</skos:notation>
		<dc:description>Specifies a predominant type of assessment asset represented by the Learning Resource.  Assessment assets represent any content used to compose an assessment item, is referenced by an item but not part of the item content itself, or is content that is included as part of a section within an assessment form. Assets can be static content such as art work or dynamic assets such as calculators.</dc:description>
		<rdfs:comment>The standard option set may be extended based on local and implementation-specific requirements.  Commonly used options may be submitted for inclusion in future versions of CEDS.</rdfs:comment>
		<skos:definition>Specifies a predominant type of assessment asset represented by the Learning Resource. Assessment assets represent any content used to compose an assessment item, is referenced by an item but not part of the item content itself, or is content that is included as part of a section within an assessment form. Assets can be static content such as art work or dynamic assets such as calculators.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000605">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000605</dc:identifier>
		<rdfs:label>Has Assessment Content Standard Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000605" />
		<skos:notation>hasAssessmentContentStandardType</skos:notation>
		<dc:description>An indication as to whether an assessment conforms to a standard.</dc:description>
		<skos:definition>An indication as to whether an assessment conforms to a standard.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600068">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600068</dc:identifier>
