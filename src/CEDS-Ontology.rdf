		<rdfs:label>Program-specific capital grants and contributions.</rdfs:label>
		<skos:definition>Revenue arising from mandatory and voluntary nonexchange transactions with other governments, organizations, or individuals that are restricted for use in a particular program and that may be used for either operating expenses or for capital expenditures of the program at the discretion of the reporting government.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002066" />
		<skos:notation>300</skos:notation>
		<skos:prefLabel>Program-specific capital grants and contributions.</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002066181471">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Revenue arising from mandatory and voluntary nonexchange transactions with other governments, organizations, or individuals that are restricted for use in a particular program and that consist of capital assets or resources that are restricted for capital purposes - to purchase, construct, or renovate capital assets associated with a specific program.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002066181471</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002066" />
