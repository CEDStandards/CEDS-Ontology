		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000463</dc:identifier>
		<rdfs:label>Has Migrant Education Program Project Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200198" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000463" />
		<skos:notation>hasMigrantEducationProgramProjectType</skos:notation>
		<dc:description>Type of project funded in whole or in part by MEP funds.</dc:description>
		<skos:definition>Type of project funded in whole or in part by MEP funds.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000186">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000186</dc:identifier>
		<rdfs:label>Has Migrant Education Program Services Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000186" />
		<skos:notation>hasMigrantEducationProgramServicesType</skos:notation>
		<dc:description>The type of services received by participating migrant students in the migrant education program (MEP).</dc:description>
		<skos:definition>The type of services received by participating migrant students in the migrant education program (MEP).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000187">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000187</dc:identifier>
		<rdfs:label>Has Migrant Education Program Session Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200198" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000187" />
