		<skos:notation>QualityInitiativeMaximumScore</skos:notation>
		<dc:description>The maximum score option for the QRIS or other quality initiative.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The maximum score option for the QRIS or other quality initiative.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001461">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001461</dc:identifier>
		<rdfs:label>Quality Initiative Minimum Score</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200116" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>QualityInitiativeMinimumScore</skos:notation>
		<dc:description>The minimum score option for the QRIS or other quality initiative.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The minimum score option for the QRIS or other quality initiative.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001462">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001462</dc:identifier>
		<rdfs:label>Quality Initiative Score Level</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200116" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>QualityInitiativeScoreLevel</skos:notation>
		<dc:description>The score, rating or level received by a program for its Quality Rating and Improvement System (QRIS) or other quality initiative.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The score, rating or level received by a program for its Quality Rating and Improvement System (QRIS) or other quality initiative.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001464">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001464</dc:identifier>
		<rdfs:label>Quality Initiative Participation End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200116" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>QualityInitiativeParticipationEndDate</skos:notation>
		<dc:description>The quality initiative end date.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The quality initiative end date.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001465">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001465</dc:identifier>
		<rdfs:label>Quality Initiative Participation Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200116" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>QualityInitiativeParticipationStartDate</skos:notation>
		<dc:description>The quality initiative start date.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The quality initiative start date.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000358">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000358</dc:identifier>
		<rdfs:label>Quality Rating and Improvement System Score</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200117" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>QRISScore</skos:notation>
		<dc:description>The score, rating or level received by a program for its Quality Rating and Improvement System (QRIS).</dc:description>
		<maxLength>45</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The score, rating or level received by a program for its Quality Rating and Improvement System (QRIS).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000830">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000830</dc:identifier>
		<rdfs:label>Quality Rating and Improvement System Award Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200117" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>QRISAwardDate</skos:notation>
		<dc:description>Date Quality Rating and Improvement System score, level or rating was awarded.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>Date Quality Rating and Improvement System score, level or rating was awarded.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000831">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000831</dc:identifier>
		<rdfs:label>Quality Rating and Improvement System Expiration Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200117" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>QRISExpirationDate</skos:notation>
		<dc:description>Date Quality Rating and Improvement System score, level or rating expires.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>Date Quality Rating and Improvement System score, level or rating expires.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000843">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000843</dc:identifier>
		<rdfs:label>Number of Quality Rating and Improvement System Levels</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200117" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>NumberOfQRISLevels</skos:notation>
		<dc:description>Number of quality levels in the Quality Rating and Improvement System (QRIS).</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>Number of quality levels in the Quality Rating and Improvement System (QRIS).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001614">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001614</dc:identifier>
		<rdfs:label>Memorandum of Understanding End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200118" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>MemorandumOfUnderstandingEndDate</skos:notation>
		<dc:description>The date that a Memorandum of Understanding between the Early Learning Organization and the Service Partner is determined to expire.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date that a Memorandum of Understanding between the Early Learning Organization and the Service Partner is determined to expire.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001615">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001615</dc:identifier>
		<rdfs:label>Memorandum of Understanding Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200118" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>MemorandumOfUnderstandingStartDate</skos:notation>
		<dc:description>The effective date that a Memorandum of Understanding between the Early Learning Organization and the Service Partner Organization is effective.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The effective date that a Memorandum of Understanding between the Early Learning Organization and the Service Partner Organization is effective.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001624">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001624</dc:identifier>
		<rdfs:label>Service Partner Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200118" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ServicePartnerDescription</skos:notation>
		<dc:description>A description of the type of services that the partner organization provides.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the type of services that the partner organization provides.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001625">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001625</dc:identifier>
		<rdfs:label>Service Partner Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200118" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ServicePartnerName</skos:notation>
		<dc:description>The name of a non-person entity such as an organization, institution, agency or business, that partners with the Early Learning Organization to provide services to enrolled children/families.</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of a non-person entity such as an organization, institution, agency or business, that partners with the Early Learning Organization to provide services to enrolled children/families.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000118">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000118</dc:identifier>
		<rdfs:label>Staff Full Time Equivalency</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200405" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200406" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>StaffFullTimeEquivalency</skos:notation>
		<dc:description>The ratio between the hours of work expected in a position and the hours of work normally expected in a full-time position in the same setting.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>2</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>4</decimalPlaces>
		<skos:definition>The ratio between the hours of work expected in a position and the hours of work normally expected in a full-time position in the same setting.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Changed maximum value from 1 to 2 and decimal places from 2 to 4 to accommodate FTE values greater than 1.00</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/927</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Name change: removed "(FTE)".</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000649">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000649</dc:identifier>
		<rdfs:label>Teaching Assignment Contribution Percentage</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200406" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>TeachingAssignmentContributionPercentage</skos:notation>
		<dc:description>A percentage used to weight the educator's assigned responsibility for student learning in a Class Section, particularly when more than one educator is assigned to the class section.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>100</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>A percentage used to weight the educator's assigned responsibility for student learning in a Class Section, particularly when more than one educator is assigned to the class section.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed format.  Percentage is now a number between 0 and 100 with 100 representing 100%.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000792">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000792</dc:identifier>
		<rdfs:label>Early Learning Staff Total College Credits Earned</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200121" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>EarlyLearningStaffTotalCollegeCreditsEarned</skos:notation>
		<dc:description>Total number of college credits earned, including all credits within a degree and outside a degree, regardless of whether they all are early childhood credits.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>Total number of college credits earned, including all credits within a degree and outside a degree, regardless of whether they all are early childhood credits.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000816">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000816</dc:identifier>
		<rdfs:label>Number of School-age Education Postsecondary Credit Hours</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200121" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200323" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>NumberOfSchoolageEducationPostsecondaryCreditHours</skos:notation>
		<dc:description>The number of college course credit hours an individual has successfully completed that are related to K-12 education, parks and recreation, and juvenile justice.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The number of college course credit hours an individual has successfully completed that are related to K-12 education, parks and recreation, and juvenile justice.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001086">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001086</dc:identifier>
		<rdfs:label>Total Approved Early Childhood Credits Earned</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200121" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>TotalApprovedEarlyChildhoodCreditsEarned</skos:notation>
		<dc:description>Total semester credits earned in early childhood regardless of whether credits are earned as part of an early childhood degree program, other degree program or outside of a degree program.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>Total semester credits earned in early childhood regardless of whether credits are earned as part of an early childhood degree program, other degree program or outside of a degree program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000047">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000047</dc:identifier>
		<rdfs:label>Contract Days of Service Per Year</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200405"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<skos:notation>ContractDaysOfServicePerYear</skos:notation>
		<dc:description>The number of days per year that a person is expected to work as outlined specifically in his or her employment agreement.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The number of days per year that a person is expected to work as outlined specifically in his or her employment agreement.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000744">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000744</dc:identifier>
		<rdfs:label>Annual Base Contractual Salary</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200405"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<skos:notation>AnnualBaseContractualSalary</skos:notation>
		<dc:description>The total annual base contractual salary of a person.</dc:description>
		<rdfs:comment>As defined in IPEDS</rdfs:comment>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The total annual base contractual salary of a person.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000796">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000796</dc:identifier>
		<rdfs:label>Hours Worked Per Week</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200405"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<skos:notation>HoursWorkedPerWeek</skos:notation>
		<dc:description>The number of hours worked per week in employment.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The number of hours worked per week in employment.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000797">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000797</dc:identifier>
		<rdfs:label>Hourly Wage</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200405"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<skos:notation>HourlyWage</skos:notation>
		<dc:description>Hourly wage associated with the employment position being reported.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>Hourly wage associated with the employment position being reported.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001730">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001730</dc:identifier>
		<rdfs:label>Eligibility Evaluation Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200109" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>EligibilityEvaluationDescription</skos:notation>
		<dc:description>Description of evaluation procedure and result used for determining eligibility.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Description of evaluation procedure and result used for determining eligibility.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001731">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001731</dc:identifier>
		<rdfs:label>Eligibility Evaluation Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200109" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>EligibilityEvaluationDate</skos:notation>
		<dc:description>The date when the evaluation to determine eligibility was conducted.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date when the evaluation to determine eligibility was conducted.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000504">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000504</dc:identifier>
		<rdfs:label>Facilities Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilitiesIdentifier</skos:notation>
		<dc:description>A locally assigned unique number or alphanumeric code used to capture precise information on locations specific to a school (e.g., building number, class number, hall number, school bus number, computer station number, or internet protocol (IP) address).</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A locally assigned unique number or alphanumeric code used to capture precise information on locations specific to a school (e.g., building number, class number, hall number, school bus number, computer station number, or internet protocol (IP) address).</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000602">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000602</dc:identifier>
		<rdfs:label>Building Site Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200238" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>BuildingSiteNumber</skos:notation>
		<dc:description>The number of the building on the site, if more than one building shares the same address.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The number of the building on the site, if more than one building shares the same address.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry>
				<changeDescription>Corrected maxLength to match text format of 60 characters.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/98</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Increased the max size limit.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000632">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000632</dc:identifier>
		<rdfs:label>Site Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>SiteName</skos:notation>
		<dc:description>The full, legally accepted  name of the institution at the site level.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The full, legally accepted  name of the institution at the site level.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001205">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001205</dc:identifier>
		<rdfs:label>Facility Building Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilityBuildingName</skos:notation>
		<dc:description>The full, legally accepted or popularly accepted name of a building.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The full, legally accepted or popularly accepted name of a building.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001764">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001764</dc:identifier>
		<rdfs:label>Building Area</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>BuildingArea</skos:notation>
		<dc:description>The sum of the areas at each floor level included within the principal outside faces of exterior walls, including roofed areas with finished floors that may not have exterior walls, but are connected to the main building. This sum should include all stories or areas having floor surfaces with clear standing head room (6.5 feet or 1.98 meters) but omit architectural setbacks or projections.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The sum of the areas at each floor level included within the principal outside faces of exterior walls, including roofed areas with finished floors that may not have exterior walls, but are connected to the main building. This sum should include all stories or areas having floor surfaces with clear standing head room (6.5 feet or 1.98 meters) but omit architectural setbacks or projections.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001768">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001768</dc:identifier>
		<rdfs:label>Facility Acquisition Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>FacilityAcquisitionDate</skos:notation>
		<dc:description>The date the property/facility was acquired.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date the property/facility was acquired.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001783">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001783</dc:identifier>
		<rdfs:label>Facility Expected Life</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilityExpectedLife</skos:notation>
		<dc:description>The time, in years, of the expected useful life of a facility for the purposes of depreciation.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The time, in years, of the expected useful life of a facility for the purposes of depreciation.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001785">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001785</dc:identifier>
		<rdfs:label>Building Number of Stories</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>BuildingNumberOfStories</skos:notation>
		<dc:description>The number of stories in a building, excluding the basement if its ceiling is less than three feet above ground level.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The number of stories in a building, excluding the basement if its ceiling is less than three feet above ground level.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001788">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001788</dc:identifier>
		<rdfs:label>Building Year Built</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#gYear" />
		<skos:notation>BuildingYearBuilt</skos:notation>
		<dc:description>The year a building was constructed, as indicated by cornerstone or official government records.</dc:description>
		<textFormat>YYYY</textFormat>
		<skos:definition>The year a building was constructed, as indicated by cornerstone or official government records.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001789">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001789</dc:identifier>
		<rdfs:label>Building Year of Last Modernization</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#gYear" />
		<skos:notation>BuildingYearOfLastModernization</skos:notation>
		<dc:description>The most recent year that a comprehensive upgrade of ALL major building systems and components was completed, such that it functions as a modern building, as measured by a facility condition index not greater than 15%.</dc:description>
		<textFormat>YYYY</textFormat>
		<skos:definition>The most recent year that a comprehensive upgrade of ALL major building systems and components was completed, such that it functions as a modern building, as measured by a facility condition index not greater than 15%.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002024">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002024</dc:identifier>
		<rdfs:label>Temperature Controlled Building Area</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>TemperatureControlledBuildingArea</skos:notation>
		<dc:description>The sum of the Building Area capable of being regulated and maintained within a specific temperature range for a designated purpose, employing heating, cooling, insulation, or climate control systems.</dc:description>
		<rdfs:comment>Use in conjunction with the element: Building Area.</rdfs:comment>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The sum of the Building Area capable of being regulated and maintained within a specific temperature range for a designated purpose, employing heating, cooling, insulation, or climate control systems.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001881">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001881</dc:identifier>
		<rdfs:label>Facility Audit Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200124" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>FacilityAuditDate</skos:notation>
		<dc:description>The month, day, and year of the systematic review or audit of facility quality, management, decision making processes, controls, schedule and cost.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The month, day, and year of the systematic review or audit of facility quality, management, decision making processes, controls, schedule and cost.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001837">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001837</dc:identifier>
		<rdfs:label>Facility Compliance Determination Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200125" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>FacilityComplianceDeterminationDate</skos:notation>
		<dc:description>The month, day, and year that the school, building, site, system, component, equipment, or fixture compliance status was determined.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The month, day, and year that the school, building, site, system, component, equipment, or fixture compliance status was determined.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001838">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001838</dc:identifier>
		<rdfs:label>Facility Compliance Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200125" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilityComplianceName</skos:notation>
		<dc:description>The name of the inspection or process that indicates conformity to the requirements or standards specified in federal, state, or local standards or codes.</dc:description>
		<maxLength>80</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the inspection or process that indicates conformity to the requirements or standards specified in federal, state, or local standards or codes.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001839">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001839</dc:identifier>
		<rdfs:label>Facility Component Deficiency Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200125" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilityComponentDeficiencyDescription</skos:notation>
		<dc:description>A description of the component, system, or finish that needs replacement, repair, or maintenance to perform at an optimal level.</dc:description>
		<maxLength>80</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the component, system, or finish that needs replacement, repair, or maintenance to perform at an optimal level.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001841">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001841</dc:identifier>
		<rdfs:label>Facility Estimated Cost to Eliminate Deferred Maintenance</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200125" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>FacilityEstimatedCostToEliminateDeferredMaintenance</skos:notation>
		<dc:description>The estimated cost to bring systems, components, finishes, fixtures, or equipment to a state of good repair.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The estimated cost to bring systems, components, finishes, fixtures, or equipment to a state of good repair.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001846">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001846</dc:identifier>
		<rdfs:label>Facility Inspection Score Result Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200125" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilityInspectionScoreResultDescription</skos:notation>
		<dc:description>The description of a meaningful raw score of statistical expression of the performance on an inspection.</dc:description>
		<maxLength>35</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The description of a meaningful raw score of statistical expression of the performance on an inspection.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001847">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001847</dc:identifier>
		<rdfs:label>Facility Inspection Violation Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200125" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilityInspectionViolationDescription</skos:notation>
		<dc:description>A description of the standard violation(s) found in the inspection.</dc:description>
		<maxLength>80</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the standard violation(s) found in the inspection.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001898">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001898</dc:identifier>
		<rdfs:label>Component or Fixture Check Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200125" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ComponentOrFixtureCheckDate</skos:notation>
		<dc:description>The month, day, and year that the condition of a system, component, equipment, or fixture was  checked.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The month, day, and year that the condition of a system, component, equipment, or fixture was  checked.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001834">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001834</dc:identifier>
		<rdfs:label>Building Architect Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200126" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>BuildingArchitectName</skos:notation>
		<dc:description>The name of the architect of record for the building.</dc:description>
		<maxLength>45</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the architect of record for the building.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001835">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001835</dc:identifier>
		<rdfs:label>Building Architectural Firm Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200126" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>BuildingArchitecturalFirmName</skos:notation>
		<dc:description>The name of the architectural firm responsible for the building design.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the architectural firm responsible for the building design.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001880">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001880</dc:identifier>
		<rdfs:label>Building Date of Certificate of Occupancy</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200126" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>BuildingDateOfCertificateOfOccupancy</skos:notation>
		<dc:description>The month, day and year in which a certificate of occupancy was granted by the appropriate local authority.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The month, day and year in which a certificate of occupancy was granted by the appropriate local authority.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001769">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001769</dc:identifier>
		<rdfs:label>Facility Addition Year</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200127" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#gYear" />
		<skos:notation>FacilityAdditionYear</skos:notation>
		<dc:description>The year the construction on the addition was completed.</dc:description>
		<textFormat>YYYY</textFormat>
		<skos:definition>The year the construction on the addition was completed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001771">
