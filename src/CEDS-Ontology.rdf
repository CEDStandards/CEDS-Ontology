		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>SessionStartTime</skos:notation>
		<dc:description>The hour, minute and second on which a session begins.</dc:description>
		<textFormat>HH:MM:SS</textFormat>
		<skos:definition>The hour, minute and second on which a session begins.</skos:definition>
