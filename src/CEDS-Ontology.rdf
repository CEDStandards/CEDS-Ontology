		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
