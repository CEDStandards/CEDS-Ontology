		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>SessionDescription</skos:notation>
		<dc:description>A short description of the Session.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A short description of the Session.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002021">
