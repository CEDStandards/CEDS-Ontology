		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The dollar amount of the 20 percent reservation for supplemental educational services and choice-related transportation.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000453">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000453</dc:identifier>
		<rdfs:label>State Assessment Standards Funding</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200190" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>StateAssessmentStandardsFunding</skos:notation>
		<dc:description>The percentage of funds used to pay the costs of the development of the State assessments and standards required by section 1111(b).</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>100</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
