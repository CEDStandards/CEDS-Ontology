	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001802128794">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Moving Walk is specified as a mechanical means for moving people and equipment within buildings.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001802128794</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Moving Walk</rdfs:label>
		<skos:definition>Moving Walk is specified as a mechanical means for moving people and equipment within buildings.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<skos:notation>13594</skos:notation>
		<skos:prefLabel>Moving Walk</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001802128795">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Other conveying system is specified as a mechanical means for moving people and equipment within buildings.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001802128795</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Other conveying system</rdfs:label>
		<skos:definition>Other conveying system is specified as a mechanical means for moving people and equipment within buildings.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<skos:notation>13595</skos:notation>
		<skos:prefLabel>Other conveying system</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127826">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is out of school and involved in a noninstructional activity recognized by the school, district, and/or state. Examples include such civic activities as involvement with the National Guard, service as a legislative page, jury duty, or participation on an election board. Note that "recognized activities" are not necessarily considered "excused" absences.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127826</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Noninstructional activity recognized by state, district, or school</rdfs:label>
		<skos:definition>The student is out of school and involved in a noninstructional activity recognized by the school, district, and/or state. Examples include such civic activities as involvement with the National Guard, service as a legislative page, jury duty, or participation on an election board. Note that "recognized activities" are not necessarily considered "excused" absences.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13293</skos:notation>
		<skos:prefLabel>Absent - Noninstructional activity recognized by state, district, or school</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127827">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is out of school observing a religious holiday or participating in religious instruction.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127827</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Religious observation</rdfs:label>
		<skos:definition>The student is out of school observing a religious holiday or participating in religious instruction.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13294</skos:notation>
		<skos:prefLabel>Absent - Religious observation</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127828">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is out of school because of personal physical or mental illness or injury, including health-related appointments. This may include more unusual situations, such as quarantine.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127828</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Illness, injury, health treatment, or examination</rdfs:label>
		<skos:definition>The student is out of school because of personal physical or mental illness or injury, including health-related appointments. This may include more unusual situations, such as quarantine.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13295</skos:notation>
		<skos:prefLabel>Absent - Illness, injury, health treatment, or examination</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127829">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is out of school for unexpected family reasons. Examples include lack of child care for a student with child(ren), care for a sick relative, and bereavement for a family member.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127829</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Family emergency or bereavement</rdfs:label>
		<skos:definition>The student is out of school for unexpected family reasons. Examples include lack of child care for a student with child(ren), care for a sick relative, and bereavement for a family member.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13296</skos:notation>
		<skos:prefLabel>Absent - Family emergency or bereavement</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127830">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student has been removed from the regular instructional setting for disciplinary reasons and is not receiving instruction. This may include either in-school or out-of-school suspension if instructional services are not provided. It does not include expulsion since expelled students are not enrolled in school.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127830</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Disciplinary action, not receiving instruction</rdfs:label>
		<skos:definition>The student has been removed from the regular instructional setting for disciplinary reasons and is not receiving instruction. This may include either in-school or out-of-school suspension if instructional services are not provided. It does not include expulsion since expelled students are not enrolled in school.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13297</skos:notation>
		<skos:prefLabel>Absent - Disciplinary action, not receiving instruction</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127831">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is out of school due to a legal obligation to attend judicial proceedings, required appointments, or trial or hearing dates. Or, the student is serving time in jail or is in the custody of the court and is not receiving instruction.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127831</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Legal or judicial requirement</rdfs:label>
		<skos:definition>The student is out of school due to a legal obligation to attend judicial proceedings, required appointments, or trial or hearing dates. Or, the student is serving time in jail or is in the custody of the court and is not receiving instruction.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13298</skos:notation>
		<skos:prefLabel>Absent - Legal or judicial requirement</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127832">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is out of school because of a family vacation or other activity. This also includes family time related to a parent being deployed to, or returning from, military duty.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127832</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Family activity</rdfs:label>
		<skos:definition>The student is out of school because of a family vacation or other activity. This also includes family time related to a parent being deployed to, or returning from, military duty.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13299</skos:notation>
		<skos:prefLabel>Absent - Family activity</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127833">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is out of school for employment purposes. This does not include work-study or school-related employment.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127833</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Student employment</rdfs:label>
		<skos:definition>The student is out of school for employment purposes. This does not include work-study or school-related employment.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13300</skos:notation>
		<skos:prefLabel>Absent - Student employment</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127834">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is not in school because transportation is not available. For example, roads have been closed due to flooding. This category includes school-provided transportation and the student's personal transportation.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127834</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Transportation not available</rdfs:label>
		<skos:definition>The student is not in school because transportation is not available. For example, roads have been closed due to flooding. This category includes school-provided transportation and the student's personal transportation.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13301</skos:notation>
		<skos:prefLabel>Absent - Transportation not available</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127835">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is willfully not attending school without parent or school approval.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127835</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Student is skipping school</rdfs:label>
		<skos:definition>The student is willfully not attending school without parent or school approval.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13302</skos:notation>
		<skos:prefLabel>Absent - Student is skipping school</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000599127836">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The student is not present and the reason for the absence is not known. "Situation unknown" is a default category to be used only until the correct attendance category is determined.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000599127836</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Absent - Situation unknown</rdfs:label>
		<skos:definition>The student is not present and the reason for the absence is not known. "Situation unknown" is a default category to be used only until the correct attendance category is determined.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000599" />
		<skos:notation>13303</skos:notation>
		<skos:prefLabel>Absent - Situation unknown</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002044181444">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A non-punitive discharge given to military personnel who are separated from service due to administrative reasons such as reduction in force or convenience of the government.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002044181444</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Administrative discharge</rdfs:label>
		<skos:definition>A non-punitive discharge given to military personnel who are separated from service due to administrative reasons such as reduction in force or convenience of the government.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<skos:notation>AdministrativeDischarge</skos:notation>
		<skos:prefLabel>Administrative discharge</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002044181445">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A discharge given to military personnel who have committed serious offenses such as insubordination, desertion, or assault.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002044181445</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Bad conduct discharge</rdfs:label>
		<skos:definition>A discharge given to military personnel who have committed serious offenses such as insubordination, desertion, or assault.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<skos:notation>BadConductDischarge</skos:notation>
		<skos:prefLabel>Bad conduct discharge</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002044181446">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The most severe type of discharge given to military personnel who have committed serious crimes such as espionage, murder, or rape.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002044181446</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Dishonorable discharge</rdfs:label>
		<skos:definition>The most severe type of discharge given to military personnel who have committed serious crimes such as espionage, murder, or rape.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<skos:notation>DishonorableDischarge</skos:notation>
		<skos:prefLabel>Dishonorable discharge</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002044181447">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A discharge given to military personnel who have been in service for less than 180 days and are deemed unsuitable for military service.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002044181447</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Entry level separation</rdfs:label>
		<skos:definition>A discharge given to military personnel who have been in service for less than 180 days and are deemed unsuitable for military service.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<skos:notation>EntryLevelSeparation</skos:notation>
		<skos:prefLabel>Entry level separation</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002044181448">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A discharge given to military personnel who have generally met the standards of performance and conduct, but may have had some minor disciplinary issues.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002044181448</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>General discharge under honorable conditions</rdfs:label>
		<skos:definition>A discharge given to military personnel who have generally met the standards of performance and conduct, but may have had some minor disciplinary issues.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<skos:notation>GeneralDischargeUnderHonorableConditions</skos:notation>
		<skos:prefLabel>General discharge under honorable conditions</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002044181449">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The highest discharge status given to military personnel who have met or exceeded the military's standards for performance and personal conduct during their service.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002044181449</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Honorable discharge</rdfs:label>
		<skos:definition>The highest discharge status given to military personnel who have met or exceeded the military's standards for performance and personal conduct during their service.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002044"/>
		<skos:notation>HonorableDischarge</skos:notation>
		<skos:prefLabel>Honorable discharge</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002044181450">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A non-punitive discharge given to military personnel who are medically unfit to continue service due to injury or illness.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002044181450</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Medical discharge</rdfs:label>
		<skos:definition>A non-punitive discharge given to military personnel who are medically unfit to continue service due to injury or illness.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002044" />
		<skos:notation>MedicalDischarge</skos:notation>
		<skos:prefLabel>Medical discharge</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002044181451">
