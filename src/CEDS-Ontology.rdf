	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001866128616">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>`Spotless` cleaning, such as might be found in a hospital or corporate suite. One custodian, properly supplied and equipped, should be able to clean 10,000 square feet in an 8-hour period, depending upon the condition and level of utilization of the facility.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001866128616</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Level 1 cleaning</rdfs:label>
		<skos:definition>`Spotless` cleaning, such as might be found in a hospital or corporate suite. One custodian, properly supplied and equipped, should be able to clean 10,000 square feet in an 8-hour period, depending upon the condition and level of utilization of the facility.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<skos:notation>02831</skos:notation>
		<skos:prefLabel>Level 1 cleaning</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001866128617">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Intensive cleaning, reserved for areas such as restrooms, special education areas, kindergarten areas, or food service areas. One custodian, properly supplied and equipped, can clean approximately 11,000-18,000 square feet in an 8-hour period, depending upon the condition and level of utilization of the facility.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001866128617</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Level 2 cleaning</rdfs:label>
		<skos:definition>Intensive cleaning, reserved for areas such as restrooms, special education areas, kindergarten areas, or food service areas. One custodian, properly supplied and equipped, can clean approximately 11,000-18,000 square feet in an 8-hour period, depending upon the condition and level of utilization of the facility.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<skos:notation>02832</skos:notation>
		<skos:prefLabel>Level 2 cleaning</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001866128618">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Cleaning required to ensure the health and comfort of building users. One custodian, properly supplied and equipped, should be able to clean 19,000-25,000 square feet of space in 8 hours to this standard, depending upon the condition and utilization of the facility.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001866128618</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Level 3 cleaning</rdfs:label>
		<skos:definition>Cleaning required to ensure the health and comfort of building users. One custodian, properly supplied and equipped, should be able to clean 19,000-25,000 square feet of space in 8 hours to this standard, depending upon the condition and utilization of the facility.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<skos:notation>02833</skos:notation>
		<skos:prefLabel>Level 3 cleaning</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001866128619">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Not generally acceptable for a school environment. One custodian cleans 26,000-46,000 square feet in an 8-hour period.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001866128619</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Level 4 cleaning</rdfs:label>
		<skos:definition>Not generally acceptable for a school environment. One custodian cleans 26,000-46,000 square feet in an 8-hour period.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<skos:notation>02834</skos:notation>
		<skos:prefLabel>Level 4 cleaning</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001866128620">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Not considered healthy. One custodian, even properly supplied and equipped, will not be able to clean 47,000-80,000 square feet in an 8-hour period, to a healthy standard, whatever the underlying condition or utilization of the facility.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001866128620</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Level 5 cleaning</rdfs:label>
		<skos:definition>Not considered healthy. One custodian, even properly supplied and equipped, will not be able to clean 47,000-80,000 square feet in an 8-hour period, to a healthy standard, whatever the underlying condition or utilization of the facility.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001866" />
		<skos:notation>02835</skos:notation>
		<skos:prefLabel>Level 5 cleaning</skos:prefLabel>
	</owl:NamedIndividual>
