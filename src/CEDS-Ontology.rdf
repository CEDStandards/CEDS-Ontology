		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600547</dc:identifier>
		<rdfs:label>Has Facility</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<skos:notation>hasFacility</skos:notation>
		<dc:description>References information about a piece of land, a building site, a building, or part of a building owned by and/or used for activities of an organizational unit such as a school, school system, program, or institution.</dc:description>
		<skos:definition>References information about a piece of land, a building site, a building, or part of a building owned by and/or used for activities of an organizational unit such as a school, school system, program, or institution.</skos:definition>
		<editHistory rdf:parseType="Collection">
