	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164554">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school organization classified as elementary by state and local practice and composed of any span of grades from prekindergarten, kindergarten, or grade 1 through grade 8.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164554</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Elementary</rdfs:label>
		<skos:definition>A school organization classified as elementary by state and local practice and composed of any span of grades from prekindergarten, kindergarten, or grade 1 through grade 8.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>10</skos:notation>
		<skos:prefLabel>Elementary</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164555">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school organization composed entirely of any span of ages below kindergarten. This category is normally used for students identified as needing special services, although regular education prekindergarten would also be appropriate.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164555</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Prekindergarten</rdfs:label>
		<skos:definition>A school organization composed entirely of any span of ages below kindergarten. This category is normally used for students identified as needing special services, although regular education prekindergarten would also be appropriate.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>11</skos:notation>
		<skos:prefLabel>Prekindergarten</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164556">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school organization for children in the year immediately preceding first grade.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164556</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Kindergarten</rdfs:label>
		<skos:definition>A school organization for children in the year immediately preceding first grade.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>12</skos:notation>
		<skos:prefLabel>Kindergarten</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164557">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school organization composed of any span of grades not above grade 8, except prekindergarten and kindergarten.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164557</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Other Elementary</rdfs:label>
		<skos:definition>A school organization composed of any span of grades not above grade 8, except prekindergarten and kindergarten.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>19</skos:notation>
		<skos:prefLabel>Other Elementary</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164558">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school organization composed of at least three grades, usually beginning with grade 4 through grade 6 or the equivalent and usually ending with grade 8 or grade 9. Most middle school organizations presume that students finishing middle school will go on to secondary school.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164558</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Middle</rdfs:label>
		<skos:definition>A school organization composed of at least three grades, usually beginning with grade 4 through grade 6 or the equivalent and usually ending with grade 8 or grade 9. Most middle school organizations presume that students finishing middle school will go on to secondary school.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>20</skos:notation>
		<skos:prefLabel>Middle</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164559">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school organization comprising any span of grades beginning with the next grade following an elementary or middle school, usually beginning with grade 7 through grade 10, and ending with or below grade 12.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164559</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Secondary</rdfs:label>
		<skos:definition>A school organization comprising any span of grades beginning with the next grade following an elementary or middle school, usually beginning with grade 7 through grade 10, and ending with or below grade 12.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>30</skos:notation>
		<skos:prefLabel>Secondary</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164560">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school organization comprising elementary and secondary levels of instruction, which may also include kindergarten and prekindergarten programs.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164560</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Elementary and Secondary Combined</rdfs:label>
		<skos:definition>A school organization comprising elementary and secondary levels of instruction, which may also include kindergarten and prekindergarten programs.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>37</skos:notation>
		<skos:prefLabel>Elementary and Secondary Combined</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164561">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A school organization providing formal instructional programs with a curriculum designed primarily for students who have completed the requirements for a high school diploma or the equivalent. This includes programs of an academic, vocational, and continuing professional education purpose and excludes avocational and adult education programs.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164561</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Postsecondary</rdfs:label>
		<skos:definition>A school organization providing formal instructional programs with a curriculum designed primarily for students who have completed the requirements for a high school diploma or the equivalent. This includes programs of an academic, vocational, and continuing professional education purpose and excludes avocational and adult education programs.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>40</skos:notation>
		<skos:prefLabel>Postsecondary</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164562">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A program for adults and out-of-school youth (typically 16 years of age and older who are not regularly enrolled in school) who have completed, interrupted, or not begun their formal education and are pursuing skills or knowledge in other than regularly prescribed courses. These include adult basic education programs and other programs for the pursuit of special interests or enrichment.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164562</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Programs for Adult/Continuing</rdfs:label>
		<skos:definition>A program for adults and out-of-school youth (typically 16 years of age and older who are not regularly enrolled in school) who have completed, interrupted, or not begun their formal education and are pursuing skills or knowledge in other than regularly prescribed courses. These include adult basic education programs and other programs for the pursuit of special interests or enrichment.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>41</skos:notation>
		<skos:prefLabel>Programs for Adult/Continuing</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164563">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An institution of higher education that usually offers the first 2 years of college instruction and frequently grants an associate's degree, but does not grant a bachelor's degree. It is an independently organized institution (public or nonpublic), an institution that is part of a school district, or an independently organized system of junior colleges. Junior colleges offer college transfer courses and programs; vocational, technical, and semiprofessional occupational programs; or general education programs.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164563</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Community/Junior College</rdfs:label>
		<skos:definition>An institution of higher education that usually offers the first 2 years of college instruction and frequently grants an associate's degree, but does not grant a bachelor's degree. It is an independently organized institution (public or nonpublic), an institution that is part of a school district, or an independently organized system of junior colleges. Junior colleges offer college transfer courses and programs; vocational, technical, and semiprofessional occupational programs; or general education programs.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555"/>
		<skos:notation>42</skos:notation>
		<skos:prefLabel>Community/Junior College</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164564">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>For coding expenditures that cannot be clearly assigned to a specific instructional level.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164564</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>School Wide</rdfs:label>
		<skos:definition>For coding expenditures that cannot be clearly assigned to a specific instructional level.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>50</skos:notation>
		<skos:prefLabel>School Wide</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001555164565">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An organization classified as providing services during the stage in human development from birth through the early school years during which significant social, emotional, cognitive, language, psychological, and physical development occurs.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001555164565</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Early Learning Program</rdfs:label>
		<skos:definition>An organization classified as providing services during the stage in human development from birth through the early school years during which significant social, emotional, cognitive, language, psychological, and physical development occurs.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001555" />
		<skos:notation>60</skos:notation>
		<skos:prefLabel>Early Learning Program</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001383113588">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Assistive technology services is the type of service that adapts the curriculum, materials, or instruction for students identified as needing special education because of a delay or disability.</dc:description>
