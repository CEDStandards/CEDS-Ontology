	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002169">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002169</dc:identifier>
		<rdfs:label>Has Accessibility Feature Delivery Method</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200012" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002169" />
		<skos:notation>hasAccessibilityFeatureDeliveryMethod</skos:notation>
