			<editHistoryEntry> 	
				<changeDescription>Definition updated.  Options added to option set.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added "Graduated with an alternate diploma" to the option set to support EDFacts.  &#13;
Corrected the spelling of the word "eligible" in the option set and the NDS RefSpecialEducationExitReason.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The reason children who were in special education at the start of the reporting period were not in special education at the end of the reporting period.</skos:definition>
	</rdf:Property>
