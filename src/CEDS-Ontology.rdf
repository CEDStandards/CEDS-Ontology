	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200110">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200110</dc:identifier>
		<rdfs:label>Early Learning Organization</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>EarlyLearningOrganization</skos:notation>
		<dc:description>An organization that provides educational and developmental services to children from birth through the age of kindergarten entry, including but not limited to child care centers, Head Start programs, pre-kindergarten programs, family child care homes, and other settings that support early childhood learning and development.</dc:description>
		<skos:definition>An organization that provides educational and developmental services to children from birth through the age of kindergarten entry, including but not limited to child care centers, Head Start programs, pre-kindergarten programs, family child care homes, and other settings that support early childhood learning and development.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Definition Updated. Changed from the Base class to a subclass of Organization.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/622</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdfs:Class>
