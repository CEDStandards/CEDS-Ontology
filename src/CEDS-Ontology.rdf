	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000220">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000220</dc:identifier>
		<rdfs:label>Has Professional Educational Job Classification</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200120" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200207" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000220" />
		<skos:notation>hasProfessionalEducationalJobClassification</skos:notation>
		<dc:description>A general job classification that describes staff that performs duties requiring a high degree of knowledge and skills generally acquired through at least a baccalaureate degree (or its equivalent obtained through special study and/or experience) including skills in the field of education, educational psychology, educational social work, or an education therapy field.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A general job classification that describes staff that performs duties requiring a high degree of knowledge and skills generally acquired through at least a baccalaureate degree (or its equivalent obtained through special study and/or experience) including skills in the field of education, educational psychology, educational social work, or an education therapy field.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000783">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000783</dc:identifier>
		<rdfs:label>Has Professional or Technical Credential Conferred</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200006" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200091" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200210" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200336" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200375" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000783" />
		<skos:notation>hasProfessionalOrTechnicalCredentialConferred</skos:notation>
		<dc:description>An indicator of the category of credential conferred by a state occupational licensing entity or industry organization for competency in a specific area measured by a set of pre-established standards.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Additions to option set.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indicator of the category of credential conferred by a state occupational licensing entity or industry organization for competency in a specific area measured by a set of pre-established standards.</skos:definition>
	</rdf:Property>
