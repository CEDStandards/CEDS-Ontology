		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200251" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>FinancialAccountingPeriodBudgetedValue</skos:notation>
		<dc:description>The budgeted value of a financial account for the specified accounting period or fiscal year.</dc:description>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The budgeted value of a financial account for the specified accounting period or fiscal year.</skos:definition>
