		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200408</dc:identifier>
		<rdfs:label>Staff Education Enrollment</rdfs:label>
		<skos:notation>StaffEducationEnrollment</skos:notation>
		<dc:description>A specific type of Membership that represents a staff person’s enrollment in a professional learning or educational program, characterized by properties related to their participation and progress over a defined period of time.</dc:description>
		<skos:definition>A specific type of Membership that represents a staff person’s enrollment in a professional learning or educational program, characterized by properties related to their participation and progress over a defined period of time.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200213">
