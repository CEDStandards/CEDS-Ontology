		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000949" />
		<skos:notation>hasLearnerActivityAddToGradeBookFlag</skos:notation>
		<dc:description>Identifies the assignment as one that is graded.</dc:description>
		<skos:definition>Identifies the assignment as one that is graded.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000938">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000938</dc:identifier>
		<rdfs:label>Has Learner Activity Language</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200226" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000317" />
		<skos:notation>hasLearnerActivityLanguage</skos:notation>
		<dc:description>The default language used for the assignment.</dc:description>
		<rdfs:comment>The CEDS ISO 639-2 Language Code option set comes from the &lt;a href="http://www.loc.gov/standards/iso639-2/langhome.html"&gt;ISO 639-2 standard&lt;/a&gt;, the character encoding in ISO 8859-1 download.  Discontinued codes from the ISO standard are not included in the CEDS list.</rdfs:comment>
		<skos:definition>The default language used for the assignment.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updating to reflect the latest version of the ISO 639-2 standard.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated to reflect the latest version of the ISO 639-2 standard.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
