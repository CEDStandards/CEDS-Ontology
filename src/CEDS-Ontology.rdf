	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001650">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001650</dc:identifier>
		<rdfs:label>Has Charter School Management Organization Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200379" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200199" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001650" />
		<skos:notation>hasCharterSchoolManagementOrganizationType</skos:notation>
		<dc:description>The type of organization that is a separate legal entity that 1) contracts with one or more charter schools to manage, operate, and oversee the charter schools; or 2) holds a charter, or charters, to operate multiple charter schools.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set to support EDFacts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of organization that is a separate legal entity that 1) contracts with one or more charter schools to manage, operate, and oversee the charter schools; or 2) holds a charter, or charters, to operate multiple charter schools.</skos:definition>
	</rdf:Property>
