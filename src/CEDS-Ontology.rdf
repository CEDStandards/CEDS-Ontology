	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173074">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A business, firm, institution, or other organization for whom an individual works (including self-employment) in return for financial or other compensation.</dc:description>
