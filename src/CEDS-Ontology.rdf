	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164081">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Dental Laboratory Technology courses expose students to the principals, tools, terminology, and procedures necessary for a career in a dental laboratory. These courses typically cover many of the same topics as Dental Science, but emphasize making mouth guards, taking impressions, creating various types of dental molds and models, and fabricating prostheses and dental appliances.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164081</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Dental Laboratory Technology</rdfs:label>
		<skos:definition>Dental Laboratory Technology courses expose students to the principals, tools, terminology, and procedures necessary for a career in a dental laboratory. These courses typically cover many of the same topics as Dental Science, but emphasize making mouth guards, taking impressions, creating various types of dental molds and models, and fabricating prostheses and dental appliances.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>14101</skos:notation>
		<skos:prefLabel>Dental Laboratory Technology</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164082">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Medical Lab Technology courses provide students with the knowledge and skills necessary for employment in health care-related laboratories. Topics include basic principles of anatomy and physiology, relevant concepts in microbiology and chemistry, and laboratory techniques (including preparation and analysis of various cultures and specimens). The courses may also cover such components as venipuncture, EKG, and CPR procedures.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164082</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Medical Lab Technology</rdfs:label>
		<skos:definition>Medical Lab Technology courses provide students with the knowledge and skills necessary for employment in health care-related laboratories. Topics include basic principles of anatomy and physiology, relevant concepts in microbiology and chemistry, and laboratory techniques (including preparation and analysis of various cultures and specimens). The courses may also cover such components as venipuncture, EKG, and CPR procedures.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>14102</skos:notation>
		<skos:prefLabel>Medical Lab Technology</skos:prefLabel>
	</owl:NamedIndividual>
