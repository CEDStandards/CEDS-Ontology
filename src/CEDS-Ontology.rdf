	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002068181473">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>This status is assigned when the student is not enrolled, and their whereabouts cannot be determined, indicating a potential dropout. The designated reporting deadline, as defined by local, state, or federal authorities for identifying dropout status, has not yet been reached.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002068181473</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002068" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Potential Dropout</rdfs:label>
		<skos:definition>This status is assigned when the student is not enrolled, and their whereabouts cannot be determined, indicating a potential dropout. The designated reporting deadline, as defined by local, state, or federal authorities for identifying dropout status, has not yet been reached.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002068" />
		<skos:notation>Potential</skos:notation>
		<skos:prefLabel>Potential Dropout</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002068181474">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>This status is assigned when the student is not enrolled, and their whereabouts cannot be determined. The designated reporting deadline, as defined by local, state, or federal authorities for identifying dropout status, has been reached. This student is reported as a dropout.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002068181474</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002068" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Reported Dropout</rdfs:label>
		<skos:definition>This status is assigned when the student is not enrolled, and their whereabouts cannot be determined. The designated reporting deadline, as defined by local, state, or federal authorities for identifying dropout status, has been reached. This student is reported as a dropout.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002068" />
		<skos:notation>Reported</skos:notation>
		<skos:prefLabel>Reported Dropout</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002068181475">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>This status is assigned when an authoritative source provides documentation, in addition to the student's non-enrollment, indicating that this student is a dropout. The designated reporting deadline, as defined by local, state, or federal authorities for identifying dropout status, has been reached. This student is reported as a dropout.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002068181475</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002068" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Verified Reported Dropout</rdfs:label>
		<skos:definition>This status is assigned when an authoritative source provides documentation, in addition to the student's non-enrollment, indicating that this student is a dropout. The designated reporting deadline, as defined by local, state, or federal authorities for identifying dropout status, has been reached. This student is reported as a dropout.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002068"/>
		<skos:notation>VerifiedReported</skos:notation>
		<skos:prefLabel>Verified Reported Dropout</skos:prefLabel>
	</owl:NamedIndividual>
