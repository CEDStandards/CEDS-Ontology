		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<skos:notation>EarlyLearningCourse</skos:notation>
		<dc:description>The organization of early learning subject matter and related learning experiences provided for the instruction of children on a regular or systematic basis, usually for a predetermined period of time (e.g., a semester or two-week workshop) to an individual or group of children (e.g., a class or group). This further defines course at the domain level.</dc:description>
		<skos:definition>The organization of early learning subject matter and related learning experiences provided for the instruction of children on a regular or systematic basis, usually for a predetermined period of time (e.g., a semester or two-week workshop) to an individual or group of children (e.g., a class or group). This further defines course at the domain level.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200092">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200092</dc:identifier>
		<rdfs:label>Early Learning Credential</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>EarlyLearningCredential</skos:notation>
		<dc:description>The credential related to early childhood education or development held by a person.</dc:description>
		<skos:definition>The credential related to early childhood education or development held by a person.</skos:definition>
	</rdfs:Class>
