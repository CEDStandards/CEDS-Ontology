	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600451">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600451</dc:identifier>
		<rdfs:label>Has Individualized Program</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200097" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200102" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200407" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200417" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200157" />
		<skos:notation>hasIndividualizedProgram</skos:notation>
		<dc:description>References information on the type, design, dates, and participation of a student in an individualized program.</dc:description>
