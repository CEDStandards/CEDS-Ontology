		<skos:notation>LocalEducationAgencyTitleIIIProfessionalDevelopment</skos:notation>
		<dc:description>The type of Title III professional development utilized by an LEA.</dc:description>
		<skos:definition>The type of Title III professional development utilized by an LEA.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200196">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200196</dc:identifier>
		<rdfs:label>Local Education Agency Title I Support Service</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>LocalEducationAgencyTitleISupportService</skos:notation>
