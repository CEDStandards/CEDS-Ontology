		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200103" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200111" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000356" />
