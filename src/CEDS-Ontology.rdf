	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000141">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000141</dc:identifier>
		<rdfs:label>Has Highest Level of Education Completed</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200287"/>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200275"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000141"/>
		<skos:notation>hasHighestLevelOfEducationCompleted</skos:notation>
		<dc:description>The extent of formal instruction a person has received (e.g., the highest grade in school completed or its equivalent or the highest degree received).</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Code set change: 01046 - Adult basic education diploma replaced by 73063 - Adult education certification, endorsement, or degree</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Option set updated</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The extent of formal instruction a person has received (e.g., the highest grade in school completed or its equivalent or the highest degree received).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002032">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002032</dc:identifier>
		<rdfs:label>Has High Quality Instructional Material Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002032" />
		<skos:notation>hasHighQualityInstructionalMaterialIndicator</skos:notation>
		<dc:description>An indication of whether the related learning resource meets requirements to be considered high quality instructional material as defined by the organization assigning the indicator.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether the related learning resource meets requirements to be considered high quality instructional material as defined by the organization assigning the indicator.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000713">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000713</dc:identifier>
		<rdfs:label>Has High School Diploma Distinction Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200210" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000713" />
		<skos:notation>hasHighSchoolDiplomaDistinctionType</skos:notation>
		<dc:description>The distinction of the diploma or credential that is awarded to a student in recognition of their completion of the curricular requirements.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new options to option set</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The distinction of the diploma or credential that is awarded to a student in recognition of their completion of the curricular requirements.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000138">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000138</dc:identifier>
		<rdfs:label>Has High School Diploma Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200006" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200091" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200210" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000138" />
		<skos:notation>hasHighSchoolDiplomaType</skos:notation>
		<dc:description>The type of diploma/credential that is awarded to a person in recognition of his/her completion of the curricular requirements.</dc:description>
		<rdfs:comment>Use "Other Diploma" instead of "Other" option.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new option to existing option set, change option set</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Name changed.  Prior name was Diploma/Credential Type.</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>In "High School Diploma Type" element, removed option for "Other". Use "Other Diploma" instead.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of diploma/credential that is awarded to a person in recognition of his/her completion of the curricular requirements.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000140">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000140</dc:identifier>
		<rdfs:label>Has High School Graduation Rate Indicator Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200250" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000140" />
		<skos:notation>hasHighSchoolGraduationRateIndicatorStatus</skos:notation>
		<dc:description>An indication of whether the school or district met the High School Graduation Rate requirement in accordance with state definition for the purposes of determining AYP.</dc:description>
		<skos:definition>An indication of whether the school or district met the High School Graduation Rate requirement in accordance with state definition for the purposes of determining AYP.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000146">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000146</dc:identifier>
		<rdfs:label>Has Homeless Primary Nighttime Residence</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200290" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000146" />
		<skos:notation>hasHomelessPrimaryNighttimeResidence</skos:notation>
		<dc:description>The primary nighttime residence of the person at the time the person was identified as homeless.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set to support EDFacts changes and disaggregate options to be more specific. Element applied to additional DES context.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The primary nighttime residence of the person at the time the person was identified as homeless.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000147">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000147</dc:identifier>
		<rdfs:label>Has Homeless Serviced Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200407" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000147" />
		<skos:notation>hasHomelessServicedIndicator</skos:notation>
		<dc:description>An indication of whether homeless children and youth were served by a McKinney-Vento program  in the state.</dc:description>
		<skos:definition>An indication of whether homeless children and youth were served by a McKinney-Vento program in the state.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000148">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000148</dc:identifier>
		<rdfs:label>Has Homeless Unaccompanied Youth Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200309" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000148" />
		<skos:notation>hasHomelessUnaccompaniedYouthStatus</skos:notation>
		<dc:description>A homeless unaccompanied youth is a youth who is not in the physical custody of a parent or guardian and who fits the McKinney-Vento definition of homeless.  Students must be both unaccompanied and homeless to be included as unaccompanied homeless youth. There is no age range specified for an unaccompanied youth in the law. The upper age range is determined by what a state defines as school age, unless the child is in special education. The upper age range for students in special education may extend to 22 years of age. There is no lower age range. Therefore, as an example, a young child not in the physical custody of a parent or guardian, though living with a caregiver, and is living in a situation that is not fixed, regular, and adequate, would be identified as a homeless unaccompanied youth.</dc:description>
		<rdfs:comment>Homelessness Status and Primary Nighttime Residence should be known in order to collect this additional information.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add usage note, update defintion</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A homeless unaccompanied youth is a youth who is not in the physical custody of a parent or guardian and who fits the McKinney-Vento definition of homeless. Students must be both unaccompanied and homeless to be included as unaccompanied homeless youth. There is no age range specified for an unaccompanied youth in the law. The upper age range is determined by what a state defines as school age, unless the child is in special education. The upper age range for students in special education may extend to 22 years of age. There is no lower age range. Therefore, as an example, a young child not in the physical custody of a parent or guardian, though living with a caregiver, and is living in a situation that is not fixed, regular, and adequate, would be identified as a homeless unaccompanied youth.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001733">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001733</dc:identifier>
		<rdfs:label>Has IDEA Disability Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200285" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001733" />
		<skos:notation>hasIDEADisabilityType</skos:notation>
		<dc:description>A category of disability that describes a person's impairment defined by the Individuals with Disabilities Education Act.</dc:description>
		<rdfs:comment>Option set based on IDEA disability categories. Multiple disability condition could be selected. Refer to Primary Disability Type for a single disability condition based on EDFacts.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A category of disability that describes a person's impairment defined by the Individuals with Disabilities Education Act.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000556">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000556</dc:identifier>
		<rdfs:label>Has IDEA Discipline Method for Firearms Incidents</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000556" />
		<skos:notation>hasIDEADisciplineMethodForFirearmsIncidents</skos:notation>
		<dc:description>The methods used to discipline students who are children with disabilities (IDEA) involved in firearms and other outcomes of firearms incidents.</dc:description>
		<skos:definition>The methods used to discipline students who are children with disabilities (IDEA) involved in firearms and other outcomes of firearms incidents.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000559">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000559</dc:identifier>
		<rdfs:label>Has IDEA Educational Environment for Early Childhood</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200106" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200322" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000559" />
		<skos:notation>hasIDEAEducationalEnvironmentForEarlyChildhood</skos:notation>
		<dc:description>The program in which children ages 3 through 5 attend and in which these children receive special education and related services.</dc:description>
		<skos:definition>The program in which children ages 3 through 5 attend and in which these children receive special education and related services.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000535">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000535</dc:identifier>
		<rdfs:label>Has IDEA Educational Environment for School Age</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200322" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000535" />
		<skos:notation>hasIDEAEducationalEnvironmentForSchoolAge</skos:notation>
		<dc:description>The setting in which children ages 6 through 21, receive special education and related services.</dc:description>
		<skos:definition>The setting in which children ages 6 through 21, receive special education and related services.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001501">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001501</dc:identifier>
		<rdfs:label>Has IDEA IEP Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200097" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001501" />
		<skos:notation>hasIDEAIEPStatus</skos:notation>
		<dc:description>The status of an individualized services plan for a specified reporting period or on a specified date.</dc:description>
		<skos:definition>The status of an individualized services plan for a specified reporting period or on a specified date.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000151">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000151</dc:identifier>
		<rdfs:label>Has IDEA Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200309" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000151" />
		<skos:notation>hasIDEAIndicator</skos:notation>
		<dc:description>A person having intellectual disability; hearing impairment, including deafness; speech or language impairment; visual impairment, including blindness; serious emotional disturbance (hereafter referred to as emotional disturbance); orthopedic impairment; autism; traumatic brain injury; developmental delay; other health impairment; specific learning disability; deaf-blindness; or multiple disabilities and who, by reason thereof, receive special education and related services under the Individuals with Disabilities Education Act (IDEA) according to an Individualized Education Program (IEP), Individual Family Service Plan (IFSP), or service plan.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Definition updated.</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A person having intellectual disability; hearing impairment, including deafness; speech or language impairment; visual impairment, including blindness; serious emotional disturbance (hereafter referred to as emotional disturbance); orthopedic impairment; autism; traumatic brain injury; developmental delay; other health impairment; specific learning disability; deaf-blindness; or multiple disabilities and who, by reason thereof, receive special education and related services under the Individuals with Disabilities Education Act (IDEA) according to an Individualized Education Program (IEP), Individual Family Service Plan (IFSP), or service plan.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000541">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000541</dc:identifier>
		<rdfs:label>Has IDEA Interim Removal</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000541" />
		<skos:notation>hasIDEAInterimRemoval</skos:notation>
		<dc:description>The type of interim removal from current educational setting experienced by children with disabilities (IDEA).</dc:description>
		<skos:definition>The type of interim removal from current educational setting experienced by children with disabilities (IDEA).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000539">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000539</dc:identifier>
		<rdfs:label>Has IDEA Interim Removal Reason</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200215" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000539" />
		<skos:notation>hasIDEAInterimRemovalReason</skos:notation>
		<dc:description>The reasons why children with disabilities were unilaterally removed from their current educational placement to an interim alternative educational setting.</dc:description>
		<skos:definition>The reasons why children with disabilities were unilaterally removed from their current educational placement to an interim alternative educational setting.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001656">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001656</dc:identifier>
		<rdfs:label>Has IDEA Part C Eligibility Category</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200097" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001656" />
		<skos:notation>hasIDEAPartCEligibilityCategory</skos:notation>
		<dc:description>The category under which a person under 3 years of age is eligible for early intervention services under IDEA Part C.</dc:description>
		<rdfs:comment>&lt;a href="http://idea.ed.gov/part-c/statutes"&gt;http://idea.ed.gov/part-c/statutes&lt;/a&gt;</rdfs:comment>
		<skos:definition>The category under which a person under 3 years of age is eligible for early intervention services under IDEA Part C.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001190">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001190</dc:identifier>
		<rdfs:label>Has Identification System for Assessment Form Section</rdfs:label>
