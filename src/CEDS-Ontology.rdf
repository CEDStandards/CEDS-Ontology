		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001190" />
		<skos:notation>hasIdentificationSystemForAssessmentFormSection</skos:notation>
		<dc:description>A coding scheme that is used for identification of an Assessment Form Section.</dc:description>
		<skos:definition>A coding scheme that is used for identification of an Assessment Form Section.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600088">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600088</dc:identifier>
