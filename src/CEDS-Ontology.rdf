	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001353117371">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An intangible asset is a capital asset that lacks physical substance, is nonfinancial in nature, and has an initial useful life of more than 1 year. Intangible assets may be purchased or licensed, acquired through nonexchange transactions, or internally generated. Examples include easements, contractual rights, patents, trademarks, and computer software.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001353117371</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001353" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Intangible Assets</rdfs:label>
		<skos:definition>An intangible asset is a capital asset that lacks physical substance, is nonfinancial in nature, and has an initial useful life of more than 1 year. Intangible assets may be purchased or licensed, acquired through nonexchange transactions, or internally generated. Examples include easements, contractual rights, patents, trademarks, and computer software.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001353" />
		<skos:notation>281</skos:notation>
		<skos:prefLabel>Intangible Assets</skos:prefLabel>
	</owl:NamedIndividual>
