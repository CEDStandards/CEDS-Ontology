	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173079">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An institution, organization, federation, or other such group that is responsible for accrediting or endorsing an individual's preparation, skills, or performance.</dc:description>
