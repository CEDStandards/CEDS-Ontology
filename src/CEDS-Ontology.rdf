	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000581">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000581</dc:identifier>
		<rdfs:label>Has Perkins English Learner Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200309" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000581" />
		<skos:notation>hasPerkinsEnglishLearnerStatus</skos:notation>
		<dc:description>A secondary student, an adult, or an out-of-school youth, who has limited ability in speaking, reading, writing, or understanding English language, and (a) whose native language is a language other than English, or (b) who lives in a family or community environment in which a language other than English is the dominant language.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed Name, Definition, Technical Name and removed Alternate Name.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A secondary student, an adult, or an out-of-school youth, who has limited ability in speaking, reading, writing, or understanding English language, and (a) whose native language is a language other than English, or (b) who lives in a family or community environment in which a language other than English is the dominant language.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002087">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002087</dc:identifier>
		<rdfs:label>Has Perkins Post-Program Placement Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002087" />
		<skos:notation>hasPerkinsPostProgramPlacementIndicator</skos:notation>
		<dc:description>An indication of the post-program status of a CTE Concentrator in the second quarter after exiting from secondary education.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the post-program status of a CTE Concentrator in the second quarter after exiting from secondary education.</skos:definition>
	</rdf:Property>
