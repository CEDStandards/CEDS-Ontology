		<skos:prefLabel>State Abbreviation</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001576">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indication that the student's parent or guardian is on Active Duty, in the National Guard, or in the Reserve components of the United States military services</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001576</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
