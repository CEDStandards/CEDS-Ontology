		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002113" />
		<skos:notation>hasDropoutReasonType</skos:notation>
		<dc:description>The reason or reasons the student dropped out of school.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The reason or reasons the student dropped out of school.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000345">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000345</dc:identifier>
		<rdfs:label>Has Early Childhood Credential</rdfs:label>
