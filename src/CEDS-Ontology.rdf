	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173068">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An administrative unit at the local level which exists primarily to operate schools or to contract for educational services. These units may or may not be co-extensive with county, city, or town boundaries.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001156173068</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Local Education Agency (LEA)</rdfs:label>
		<skos:definition>An administrative unit at the local level which exists primarily to operate schools or to contract for educational services. These units may or may not be co-extensive with county, city, or town boundaries.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<skos:notation>LEA</skos:notation>
		<skos:prefLabel>Local Education Agency (LEA)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173069">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An institution that provides educational services; has one or more grade groups (PK through 12); has one or more teachers; is located in one or more buildings; has an assigned administrator(s).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001156173069</dc:identifier>
