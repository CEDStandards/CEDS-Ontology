	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164220">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Plumbing and Heating courses address the installation, assembly, maintenance, and repair of piping, plumbing, heating equipment, and water and drainage systems. Topics covered include the computation of heat losses and BTU requirements and blueprint reading. Students gain experience with electric, gas, and oil furnaces; vacuum pumps; air compressors; and mechanical and pneumatic testing equipment.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164220</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Plumbing and Heating</rdfs:label>
		<skos:definition>Plumbing and Heating courses address the installation, assembly, maintenance, and repair of piping, plumbing, heating equipment, and water and drainage systems. Topics covered include the computation of heat losses and BTU requirements and blueprint reading. Students gain experience with electric, gas, and oil furnaces; vacuum pumps; air compressors; and mechanical and pneumatic testing equipment.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>17059</skos:notation>
		<skos:prefLabel>Plumbing and Heating</skos:prefLabel>
	</owl:NamedIndividual>
