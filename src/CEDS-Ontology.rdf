		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Particular Topics in Accounting</rdfs:label>
		<skos:definition>These courses examine particular topics, such as auditing or non-profit accounting, rather than provide a general overview.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>12111</skos:notation>
		<skos:prefLabel>Particular Topics in Accounting</skos:prefLabel>
	</owl:NamedIndividual>
