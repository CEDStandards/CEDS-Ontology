	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000087140668">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Professional staff member who provides direct and indirect support, including prevention and intervention, to evaluate and address student's intellectual development, academic success, social-emotional learning, and mental and behavioral health.</dc:description>
