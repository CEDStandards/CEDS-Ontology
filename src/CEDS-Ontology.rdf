	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127576">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all current assets, including cash and cash equivalents, investments, accounts and notes receivables (net of allowance for uncollectible amounts), inventories, and all other assets classified as current assets.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127576</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Total current assets</rdfs:label>
		<skos:definition>Used for reporting all current assets, including cash and cash equivalents, investments, accounts and notes receivables (net of allowance for uncollectible amounts), inventories, and all other assets classified as current assets.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Totalcurrentassets</skos:notation>
		<skos:prefLabel>Total current assets</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127577">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all capital assets reduced by the total accumulated depreciation, including improvements to land, easements, buildings, building improvements, vehicles, machinery, equipment, infrastructure, and all other tangible or intangible depreciable assets that are used in operations and that have initial useful lives extending beyond a single reporting period. Includes the net amount of all depreciable capital assets after reducing the gross amount for accumulated depreciation.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127577</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Depreciable capital assets, net of depreciation</rdfs:label>
		<skos:definition>Used for reporting all capital assets reduced by the total accumulated depreciation, including improvements to land, easements, buildings, building improvements, vehicles, machinery, equipment, infrastructure, and all other tangible or intangible depreciable assets that are used in operations and that have initial useful lives extending beyond a single reporting period. Includes the net amount of all depreciable capital assets after reducing the gross amount for accumulated depreciation.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Depreciablecapitalassetsnetofdepreciation</skos:notation>
		<skos:prefLabel>Depreciable capital assets, net of depreciation</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127579">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting the deferred outflows of resources as recognized in the institution's GPFS and in accordance with GASB 63.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127579</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Deferred outflows of resources</rdfs:label>
		<skos:definition>Used for reporting the deferred outflows of resources as recognized in the institution's GPFS and in accordance with GASB 63.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Deferredoutflowsofresources</skos:notation>
		<skos:prefLabel>Deferred outflows of resources</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127580">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting the amount due in the next operating cycle (usually a year) for amounts otherwise reported as long-term or noncurrent debt. Includes only outstanding debt.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127580</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Long-term debt, current portion</rdfs:label>
		<skos:definition>Used for reporting the amount due in the next operating cycle (usually a year) for amounts otherwise reported as long-term or noncurrent debt. Includes only outstanding debt.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Longtermdebtcurrentportion</skos:notation>
		<skos:prefLabel>Long-term debt, current portion</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127582">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting the amount for long-term debt arising from debt issuance and lease-purchase agreements.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127582</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Long-term debt</rdfs:label>
		<skos:definition>Used for reporting the amount for long-term debt arising from debt issuance and lease-purchase agreements.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Longtermdebt</skos:notation>
		<skos:prefLabel>Long-term debt</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127584">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting the deferred inflows of resources as recognized in the institution's GPFS and in accordance with GASB 63.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127584</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Deferred inflows of resources</rdfs:label>
		<skos:definition>Used for reporting the deferred inflows of resources as recognized in the institution's GPFS and in accordance with GASB 63.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Deferredinflowsofresources</skos:notation>
		<skos:prefLabel>Deferred inflows of resources</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127585">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting the component of net assets represented by the total of all capital assets, reduced by accumulated depreciation, and reduced by the amount of outstanding bonds, mortgages, notes, or other borrowings that are attributable to the acquisition, construction, or improvement of those assets (see indebtedness on capital assets). Some outstanding debt may be reported in both current and noncurrent liabilities.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127585</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Net assets invested in capital assets, net of related debt</rdfs:label>
		<skos:definition>Used for reporting the component of net assets represented by the total of all capital assets, reduced by accumulated depreciation, and reduced by the amount of outstanding bonds, mortgages, notes, or other borrowings that are attributable to the acquisition, construction, or improvement of those assets (see indebtedness on capital assets). Some outstanding debt may be reported in both current and noncurrent liabilities.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Netassetsinvestedincapitalassetsnetofrelateddebt</skos:notation>
		<skos:prefLabel>Net assets invested in capital assets, net of related debt</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127586">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting restricted net assets that are expendable. Net assets should be reported as restricted when constraints placed on use are either (a) externally imposed by creditors, grantors, contributors, or laws and regulations of other governments or (b) imposed by law through constitutional provisions or enabling legislation. Expendable net assets are all those not required to be retained in perpetuity.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127586</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Restricted expendable net assets</rdfs:label>
		<skos:definition>Used for reporting restricted net assets that are expendable. Net assets should be reported as restricted when constraints placed on use are either (a) externally imposed by creditors, grantors, contributors, or laws and regulations of other governments or (b) imposed by law through constitutional provisions or enabling legislation. Expendable net assets are all those not required to be retained in perpetuity.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Restrictedexpendablenetassets</skos:notation>
		<skos:prefLabel>Restricted expendable net assets</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127587">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting net assets that are restricted and nonexpendable. Net assets should be reported as restricted when constraints placed on use are either (a) externally imposed by creditors, grantors, contributors, or laws and regulations of other governments or (b) imposed by law through constitutional provisions or enabling legislation. Nonexpendable net assets are those that are required to be retained in perpetuity.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127587</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Restricted non-expendable net assets</rdfs:label>
		<skos:definition>Used for reporting net assets that are restricted and nonexpendable. Net assets should be reported as restricted when constraints placed on use are either (a) externally imposed by creditors, grantors, contributors, or laws and regulations of other governments or (b) imposed by law through constitutional provisions or enabling legislation. Nonexpendable net assets are those that are required to be retained in perpetuity.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Restrictednonexpendablenetassets</skos:notation>
		<skos:prefLabel>Restricted non-expendable net assets</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127588">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>This should be the amount of net assets that do not meet the definition of "restricted" or "invested in capital assets, net of related debt."</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127588</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Unrestricted net assets</rdfs:label>
		<skos:definition>This should be the amount of net assets that do not meet the definition of "restricted" or "invested in capital assets, net of related debt."</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>Unrestrictednetassets</skos:notation>
		<skos:prefLabel>Unrestricted net assets</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127589">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting land and other land improvements, such as athletic fields, golf courses, lakes, etc.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127589</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Capital Assets: Land and land improvements</rdfs:label>
		<skos:definition>Used for reporting land and other land improvements, such as athletic fields, golf courses, lakes, etc.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>CapitalAssetsLandlandimprovements</skos:notation>
		<skos:prefLabel>Capital Assets: Land and land improvements</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127590">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting infrastructure assets such as roads, bridges, drainage systems, water and sewer systems, etc.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127590</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Capital Assets: Infrastructure</rdfs:label>
		<skos:definition>Used for reporting infrastructure assets such as roads, bridges, drainage systems, water and sewer systems, etc.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>CapitalAssetsInfrastructure</skos:notation>
		<skos:prefLabel>Capital Assets: Infrastructure</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127591">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting structures built for occupancy or use, such as for classrooms, research, administrative offices, storage, etc. Includes built-in fixtures and equipment that are essentially part of the permanent structure.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127591</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Capital Assets: Buildings</rdfs:label>
		<skos:definition>Used for reporting structures built for occupancy or use, such as for classrooms, research, administrative offices, storage, etc. Includes built-in fixtures and equipment that are essentially part of the permanent structure.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>CapitalAssetsBuildings</skos:notation>
		<skos:prefLabel>Capital Assets: Buildings</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127592">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting moveable tangible property such as research equipment, vehicles, office equipment, library collections (capitalized amount of books, films, tapes, and other materials maintained in library collections intended for use by patrons), and capitalized art collections.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127592</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Capital Assets: Equipment, including art and library collections</rdfs:label>
		<skos:definition>Used for reporting moveable tangible property such as research equipment, vehicles, office equipment, library collections (capitalized amount of books, films, tapes, and other materials maintained in library collections intended for use by patrons), and capitalized art collections.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>CapitalAssetsEquipmentincludingartlibrary</skos:notation>
		<skos:prefLabel>Capital Assets: Equipment, including art and library collections</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127593">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting capital assets under construction and not yet placed into service.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127593</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Capital Assets: Construction in progress</rdfs:label>
		<skos:definition>Used for reporting capital assets under construction and not yet placed into service.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>CapitalAssetsConstructioninprogress</skos:notation>
		<skos:prefLabel>Capital Assets: Construction in progress</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127594">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all depreciation amounts, including depreciation on assets that may not be included in other capital assets categories.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127594</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Capital Assets: Accumulated depreciation</rdfs:label>
		<skos:definition>Used for reporting all depreciation amounts, including depreciation on assets that may not be included in other capital assets categories.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>CapitalAssetsAccumulateddepreciation</skos:notation>
		<skos:prefLabel>Capital Assets: Accumulated depreciation</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001670127595">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all assets consisting of certain nonmaterial rights and benefits of an institution, such as patents, copyrights, trademarks and goodwill. The amount should be reduced by total accumulated amortization.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001670127595</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Capital Assets: Intangible assets, net of accumulated amortization</rdfs:label>
		<skos:definition>Used for reporting all assets consisting of certain nonmaterial rights and benefits of an institution, such as patents, copyrights, trademarks and goodwill. The amount should be reduced by total accumulated amortization.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001670" />
		<skos:notation>CapitalAssetsIntangibleassetsnetof</skos:notation>
		<skos:prefLabel>Capital Assets: Intangible assets, net of accumulated amortization</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001740127790">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Awards of the credential are ongoing.</dc:description>
