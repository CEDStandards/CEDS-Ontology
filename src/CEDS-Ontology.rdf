	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001939162256">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The participant exits the program because the participant is a member of the National Guard or other reserve military unit of the armed forces and is called to active duty for at least 90 days.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001939162256</dc:identifier>
