	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001755127817">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A secondary school that focuses primarily on providing formal preparation for skilled, technical or professional occupations or careers.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001755127817</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
