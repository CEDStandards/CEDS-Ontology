		<rdfs:label>Charter Management Organization</rdfs:label>
		<skos:definition>A non-profit organization that operates or manages a network of charter schools (either through a contract with the charter schools or as the charter holder) linked by centralized support, operations, and oversight.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001650" />
