		<skos:notation>LearningResourceAuthorEmail</skos:notation>
		<dc:description>An email address for the author of the learning resource.</dc:description>
		<minLength>7</minLength>
		<maxLength>128</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An email address for the author of the learning resource.</skos:definition>
	</rdf:Property>
