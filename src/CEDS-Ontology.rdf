		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000345" />
		<skos:notation>hasEarlyChildhoodCredential</skos:notation>
		<dc:description>The credential related to early childhood education or development held by a person.</dc:description>
