		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600125</dc:identifier>
		<rdfs:label>Has Assessment Item Characteristic</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
