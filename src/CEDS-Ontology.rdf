		<dc:description>The time of year that a Migrant Education Program operates.</dc:description>
		<skos:definition>The time of year that a Migrant Education Program operates.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000188">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000188</dc:identifier>
		<rdfs:label>Has Migrant Education Program Staff Category</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200207" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000188" />
		<skos:notation>hasMigrantEducationProgramStaffCategory</skos:notation>
		<dc:description>Titles of employment, official status, or rank of staff working in the Migrant Education Program (MEP).</dc:description>
		<rdfs:comment>Funded by Title I-C.</rdfs:comment>
		<skos:definition>Titles of employment, official status, or rank of staff working in the Migrant Education Program (MEP).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000189">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000189</dc:identifier>
		<rdfs:label>Has Migrant Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200309" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000189" />
		<skos:notation>hasMigrantStatus</skos:notation>
		<dc:description>Persons who are, or whose parents or spouses are, migratory agricultural workers, including migratory dairy workers, or migratory fishers, and who, in the preceding 36 months, in order to obtain, or accompany such parents or spouses, in order to obtain, temporary or seasonal employment in agricultural or fishing work (A) have moved from one LEA to another; (B) in a state that comprises a single LEA, have moved from one administrative area to another within such LEA; or (C) reside in an LEA of more than 15,000 square miles, and migrate a distance of 20 miles or more to a temporary residence to engage in a fishing activity.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Persons who are, or whose parents or spouses are, migratory agricultural workers, including migratory dairy workers, or migratory fishers, and who, in the preceding 36 months, in order to obtain, or accompany such parents or spouses, in order to obtain, temporary or seasonal employment in agricultural or fishing work (A) have moved from one LEA to another; (B) in a state that comprises a single LEA, have moved from one administrative area to another within such LEA; or (C) reside in an LEA of more than 15,000 square miles, and migrate a distance of 20 miles or more to a temporary residence to engage in a fishing activity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001640">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001640</dc:identifier>
		<rdfs:label>Has Military Branch</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001640" />
		<skos:notation>hasMilitaryBranch</skos:notation>
		<dc:description>A branch of the U.S. Military applicable for specifying more details when using Military Connected Student Indicator, Military Active Student Indicator,  Military Veteran Student Indicator, and Military Enlistment After Exit elements.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set to include Space Force. Element applied to additional DES contexts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A branch of the U.S. Military applicable for specifying more details when using Military Connected Student Indicator, Military Active Student Indicator, Military Veteran Student Indicator, and Military Enlistment After Exit elements.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002050">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002050</dc:identifier>
		<rdfs:label>Has Military Campaigns</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200297" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002050" />
		<skos:notation>hasMilitaryCampaigns</skos:notation>
		<dc:description>A military campaign in which the person has been involved during the service period.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A military campaign in which the person has been involved during the service period.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001576">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001576</dc:identifier>
		<rdfs:label>Has Military Connected Student Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001576" />
		<skos:notation>hasMilitaryConnectedStudentIndicator</skos:notation>
		<dc:description>An indication that the student's parent or guardian is on Active Duty, in the National Guard, or in the Reserve components of the United States military services</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Two of the definitions in the Option Set for this element have been corrected to meet EDFacts reporting requirements. The attached &lt;a href="https://ceds.ed.gov/pdf/military-connected-student-indicator-erratum.pdf"&gt;erratum&lt;/a&gt; explains the change and provides a summary for the reason for the change.</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that the student's parent or guardian is on Active Duty, in the National Guard, or in the Reserve components of the United States military services</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002051">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002051</dc:identifier>
		<rdfs:label>Has Military Deployment Status Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200298" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002051" />
		<skos:notation>hasMilitaryDeploymentStatusCode</skos:notation>
		<dc:description>Deployment status code issued to military personnel by the U.S. military.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
