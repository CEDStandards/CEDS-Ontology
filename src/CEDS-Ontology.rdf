		<skos:notation>AdjustedExitOrWithdrawalType</skos:notation>
		<skos:prefLabel>Adjusted Exit or Withdrawal Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002018">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The type of eligibility for transporting a person at public expense.</dc:description>
