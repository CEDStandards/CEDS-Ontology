	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164319">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Cosmetology�Independent Study courses, often conducted with instructors as mentors, enable students to explore topics of interest related to cosmetology. Independent Study courses may serve as an opportunity for students to expand their expertise in a particular application, to explore a topic in greater detail, or to develop more advanced skills.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164319</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Cosmetology�Independent Study</rdfs:label>
		<skos:definition>Cosmetology�Independent Study courses, often conducted with instructors as mentors, enable students to explore topics of interest related to cosmetology. Independent Study courses may serve as an opportunity for students to expand their expertise in a particular application, to explore a topic in greater detail, or to develop more advanced skills.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>19147</skos:notation>
		<skos:prefLabel>Cosmetology�Independent Study</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164320">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Cosmetology�Workplace Experience courses provide students with work experience in the cosmetology field. Goals are typically set cooperatively by the student, teacher, and employer (although students are not necessarily paid). These courses may include classroom activities as well, involving further study of the field or discussion regarding experiences that students encounter in the workplace.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164320</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Cosmetology�Workplace Experience</rdfs:label>
		<skos:definition>Cosmetology�Workplace Experience courses provide students with work experience in the cosmetology field. Goals are typically set cooperatively by the student, teacher, and employer (although students are not necessarily paid). These courses may include classroom activities as well, involving further study of the field or discussion regarding experiences that students encounter in the workplace.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>19148</skos:notation>
		<skos:prefLabel>Cosmetology�Workplace Experience</skos:prefLabel>
	</owl:NamedIndividual>
