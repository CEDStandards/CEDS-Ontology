	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002114">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A coding scheme of identifiers assigned to an individual, distinguishing between various roles and contexts within an educational or organizational setting. It ensures accurate identification and classification of individuals based on their specific type of identifier.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C002114</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
		<rdfs:label>Person Identifier Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>A coding scheme of identifiers assigned to an individual, distinguishing between various roles and contexts within an educational or organizational setting. It ensures accurate identification and classification of individuals based on their specific type of identifier.</skos:definition>
		<skos:notation>PersonIdentifierType</skos:notation>
		<skos:prefLabel>Person Identifier Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C200416">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A code that identifies the type of identifier assigned to an organization. This element distinguishes among various identification systems or authorities (e.g., state-assigned ID, NCES ID, federal EIN) that issue unique identifiers to education organizations such as schools, districts, or agencies.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200416</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
		<rdfs:label>Organization Identifier Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>A code that identifies the type of identifier assigned to an organization. This element distinguishes among various identification systems or authorities (e.g., state-assigned ID, NCES ID, federal EIN) that issue unique identifiers to education organizations such as schools, districts, or agencies.</skos:definition>
		<skos:notation>OrganizationIdentifierType</skos:notation>
		<skos:prefLabel>Organization Identifier Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000267">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The abbreviation for the state (within the United States) or outlying area in which an address is located.</dc:description>
