	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600466">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600466</dc:identifier>
		<rdfs:label>Has Learning Resource Order</rdfs:label>
