		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600298</dc:identifier>
		<rdfs:label>Has Building System Component Service</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200061" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200062" />
		<skos:notation>hasBuildingSystemComponentService</skos:notation>
		<dc:description>References information that tracks the service record of a building system component.</dc:description>
		<skos:definition>References information that tracks the service record of a building system component.</skos:definition>
