		<rdfs:label>Internet Download Speed</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200284" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>InternetDownloadSpeed</skos:notation>
		<dc:description>The speed that data or information can be downloaded from a server on the internet to one's device in megabits per second.</dc:description>
		<rdfs:comment>This information is collected via an internet speed test. In 2021, the FCC minimum broadband threshold is 25 Mbps. Display Example: 25.0</rdfs:comment>
		<textFormat>Numeric</textFormat>
		<skos:definition>The speed that data or information can be downloaded from a server on the internet to one's device in megabits per second.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001977">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001977</dc:identifier>
		<rdfs:label>Internet Speed Test Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200284" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>InternetSpeedTestDateTime</skos:notation>
		<dc:description>The date and, optionally, time that the information was gathered.</dc:description>
		<rdfs:comment>This information is collected and stored as part of each speed test. Display Example: 2021-09-20T10:30:00</rdfs:comment>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>The date and, optionally, time that the information was gathered.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000330">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000330</dc:identifier>
		<rdfs:label>Number of People in Family</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200287" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>NumberOfPeopleInFamily</skos:notation>
		<dc:description>Total number of persons in immediate family. Family means for the purposes of the regulations in this part all persons: (i) Living in the same household who are: (A) Supported by the income of the parent(s) or guardian(s) of the child enrolling or participating in the program; or (B) Related to the child by blood, marriage, or adoption; or &#13;
(ii) Related to the child enrolling or participating in the program as parents or siblings, by blood, marriage, or adoption.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000331">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000331</dc:identifier>
		<rdfs:label>Number of People in Household</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200287" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>NumberOfPeopleInHousehold</skos:notation>
		<dc:description>Total number of persons residing in the same household.</dc:description>
		<rdfs:comment>For FAFSA, this includes the number of family members that are in the household, including the student, their spouse, children, and any other persons living in the household to whom they will provide more than half of their support</rdfs:comment>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>Total number of persons residing in the same household.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added element to DES contexts and usage note to support reporting information collected on the FAFSA</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000332">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000332</dc:identifier>
		<rdfs:label>Family Income</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200287" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>FamilyIncome</skos:notation>
		<dc:description>Total income of family from all sources. Income includes money, wages or salary before deductions; net income from non-farm self-employment; net income from farm self-employment; regular payments from Social Security or railroad retirement; payments from unemployment compensation, strike benefits from union funds, workers' compensation, veterans benefits (with the exception noted below), public assistance (including Temporary Assistance for Needy Families, Supplemental Security Income, Emergency Assistance money payments, and non-Federally funded General Assistance or General Relief money payments); training stipends; alimony, child support, and military family allotments or other regular support from an absent family member or someone not living in the household; private pensions, government employee pensions (including military retirement pay), and regular insurance or annuity payments; college or university scholarships, grants, fellowships, and assistantships; and dividends, interest, net rental income, net royalties, and periodic receipts from estates or trusts; and net gambling or lottery winnings.</dc:description>
		<rdfs:comment>Family Income is calculated based on the method specified by "Income Calculation Method."</rdfs:comment>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>Total income of family from all sources. Income includes money, wages or salary before deductions; net income from non-farm self-employment; net income from farm self-employment; regular payments from Social Security or railroad retirement; payments from unemployment compensation, strike benefits from union funds, workers' compensation, veterans benefits (with the exception noted below), public assistance (including Temporary Assistance for Needy Families, Supplemental Security Income, Emergency Assistance money payments, and non-Federally funded General Assistance or General Relief money payments); training stipends; alimony, child support, and military family allotments or other regular support from an absent family member or someone not living in the household; private pensions, government employee pensions (including military retirement pay), and regular insurance or annuity payments; college or university scholarships, grants, fellowships, and assistantships; and dividends, interest, net rental income, net royalties, and periodic receipts from estates or trusts; and net gambling or lottery winnings.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added usage note.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000787">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000787</dc:identifier>
		<rdfs:label>Family Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200287" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FamilyIdentifier</skos:notation>
		<dc:description>A unique number or alphanumeric code assigned to a family by a school, school system, a state, or other agency or entity.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique number or alphanumeric code assigned to a family by a school, school system, a state, or other agency or entity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001982">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001982</dc:identifier>
		<rdfs:label>Number of Household College Students</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200287" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>NumberOfHouseholdCollegeStudents</skos:notation>
		<dc:description>Number of people, including the student, who will attend at least half-time in the current academic year, a program that leads to a college degree or certificate</dc:description>
		<rdfs:comment>This information is collected on the FAFSA</rdfs:comment>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>Number of people, including the student, who will attend at least half-time in the current academic year, a program that leads to a college degree or certificate</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES to support reporting information collected on the FAFSA</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000703">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000703</dc:identifier>
		<rdfs:label>Vision Screening Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200288" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>VisionScreeningDate</skos:notation>
		<dc:description>The year, month and day of a vision screening.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day of a vision screening.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000705">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000705</dc:identifier>
		<rdfs:label>Hearing Screening Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200288" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>HearingScreeningDate</skos:notation>
		<dc:description>The year, month and day of a hearing screening.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day of a hearing screening.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000706">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000706</dc:identifier>
		<rdfs:label>Dental Screening Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200288" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>DentalScreeningDate</skos:notation>
		<dc:description>The year, month and day of a dental screening</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day of a dental screening</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001358">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001358</dc:identifier>
		<rdfs:label>Health Screening Equipment Used</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200288" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>HealthScreeningEquipmentUsed</skos:notation>
		<dc:description>The screening equipment used for the hearing screening or the method used for the vision screening</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The screening equipment used for the hearing screening or the method used for the vision screening</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001359">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001359</dc:identifier>
		<rdfs:label>Health Screening Follow-up Recommendation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200288" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>HealthScreeningFollowUpRecommendation</skos:notation>
		<dc:description>Recommendations for follow-up after a health screening.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Recommendations for follow-up after a health screening.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Correction to element definition for "Health Screening Follow-up Recommendation"</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000312">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000312</dc:identifier>
		<rdfs:label>Weight at Birth</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200289" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>WeightAtBirth</skos:notation>
		<dc:description>The weight of a child at birth in pounds and ounces.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The weight of a child at birth in pounds and ounces.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000313">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000313</dc:identifier>
		<rdfs:label>Weeks of Gestation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200289" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>WeeksOfGestation</skos:notation>
		<dc:description>The number of weeks during gestational period.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>46</maxInclusive>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The number of weeks during gestational period.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000306">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000306</dc:identifier>
		<rdfs:label>Immunization Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200292" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ImmunizationDate</skos:notation>
		<dc:description>The year, month and day of an immunization.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day of an immunization.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002039">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002039</dc:identifier>
		<rdfs:label>Military Induction Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>MilitaryInductionDate</skos:notation>
		<dc:description>The date when a person was inducted into active military service.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<textFormat>YYYY-MM-DD or YYYY-MM</textFormat>
		<skos:definition>The date when a person was inducted into active military service.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002040">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002040</dc:identifier>
		<rdfs:label>Military Discharge Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>MilitaryDischargeDate</skos:notation>
		<dc:description>The date when a person was released from further military obligations.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<textFormat>YYYY-MM-DD or YYYY-MM</textFormat>
		<skos:definition>The date when a person was released from further military obligations.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002041">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002041</dc:identifier>
		<rdfs:label>Military Release Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>MilitaryReleaseDate</skos:notation>
		<dc:description>The date a person was released from active military service.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<textFormat>YYYY-MM-DD or YYYY-MM</textFormat>
		<skos:definition>The date a person was released from active military service.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002045">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002045</dc:identifier>
		<rdfs:label>Military Induction Rank</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>MilitaryInductionRank</skos:notation>
		<dc:description>A rank at the time a person started their military experience.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A rank at the time a person started their military experience.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002046">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002046</dc:identifier>
		<rdfs:label>Military Discharge Rank</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>MilitaryDischargeRank</skos:notation>
		<dc:description>A rank at time a person was discharged from military service.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A rank at time a person was discharged from military service.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002047">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002047</dc:identifier>
		<rdfs:label>Military Highest Rank</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>MilitaryHighestRank</skos:notation>
		<dc:description>The highest rank achieved by a person in military service.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The highest rank achieved by a person in military service.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002048">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002048</dc:identifier>
		<rdfs:label>Military Current Rank</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200296" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>MilitaryCurrentRank</skos:notation>
		<dc:description>The rank a person currently holds as part of active service. Do not use this indicator if the person is no longer holding this rank.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The rank a person currently holds as part of active service. Do not use this indicator if the person is no longer holding this rank.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002042">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002042</dc:identifier>
		<rdfs:label>Military Deployment Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200298" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>MilitaryDeploymentStartDate</skos:notation>
		<dc:description>The date when a person's military deployment started.</dc:description>
		<rdfs:comment>This element is applicable for specifying more details when using indicators related to U.S. Military service, such as Military Connected Student Indicator, Active Military Status Indicator, Military Veteran Status Indicator and Military Enlistment After Exit elements.</rdfs:comment>
		<textFormat>YYYY-MM-DD or YYYY-MM</textFormat>
		<skos:definition>The date when a person's military deployment started.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002043">
