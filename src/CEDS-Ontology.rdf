		<rdfs:label>Learning Activity</rdfs:label>
		<skos:definition>Activities engaged in by the learner for the purpose of acquiring certain skills, concepts, or knowledge, whether guided by an instructor or not. A Lesson may define one or more learning activities.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C000928"/>
		<skos:notation>LearningActivity</skos:notation>
		<skos:prefLabel>Learning Activity</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000928116021">
