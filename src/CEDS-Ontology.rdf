	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001543105796">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Any of 100 equal parts into which the range of the values of a set of data can be divided in order to show the distribution of those values. The part may be represented as an integer between 0 and 100, or further broken down into tenths or hundredths. (e.g. 87, 5.2, 45.74)</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001543105796</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001543" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Percentile</rdfs:label>
		<skos:definition>Any of 100 equal parts into which the range of the values of a set of data can be divided in order to show the distribution of those values. The part may be represented as an integer between 0 and 100, or further broken down into tenths or hundredths. (e.g. 87, 5.2, 45.74)</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001543"/>
		<skos:notation>Percentile</skos:notation>
		<skos:prefLabel>Percentile</skos:prefLabel>
	</owl:NamedIndividual>
