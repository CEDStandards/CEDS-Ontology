		<skos:notation>TransportationStatusType</skos:notation>
		<skos:prefLabel>Transportation Status Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002020">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The qualification status for the transportation of a person that entitles an organization to receive state transportation aid.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C002020</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Transportation State Aid Qualification Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
