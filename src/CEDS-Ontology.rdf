		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001263" />
		<skos:notation>hasAssessmentItemReleaseStatus</skos:notation>
		<dc:description>Indicates that the assessment item has been released to the public.</dc:description>
		<skos:definition>Indicates that the assessment item has been released to the public.</skos:definition>
