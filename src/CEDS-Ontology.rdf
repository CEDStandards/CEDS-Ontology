	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001672127647">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all other revenues and additions not reported elsewhere.</dc:description>
