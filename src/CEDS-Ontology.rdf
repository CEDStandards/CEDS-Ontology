	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000027">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The method that the instructor of the course uses to report the performance and achievement of all students. It may be a qualitative method such as individualized teacher comments or a quantitative method such as a letter or a numerical grade. In some cases, more than one type of reporting method may be used.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000027</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Course Section Assessment Reporting Method</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>The method that the instructor of the course uses to report the performance and achievement of all students. It may be a qualitative method such as individualized teacher comments or a quantitative method such as a letter or a numerical grade. In some cases, more than one type of reporting method may be used.</skos:definition>
		<skos:notation>CourseSectionAssessmentReportingMethod</skos:notation>
		<skos:prefLabel>Course Section Assessment Reporting Method</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000369">
		<dc:creator>Common Education Data Standards</dc:creator>
