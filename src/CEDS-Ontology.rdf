		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AYPAppealProcessDate</skos:notation>
		<dc:description>The last date that an appeal of an AYP designation was processed.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The last date that an appeal of an AYP designation was processed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001350">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001350</dc:identifier>
