		<skos:definition>Includes amounts for any accrued liabilities, including accrued interest payable, salary and benefit (payroll) accruals, and similar accrued expenses not found in another category. (FARM para. 420)</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001671" />
		<skos:notation>LiabilitiesOtheraccruedliabilities</skos:notation>
