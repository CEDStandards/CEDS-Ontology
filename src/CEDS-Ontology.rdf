	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002085181559">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A group home is a long-term facility in which residents are allowed extensive contact with the community, such as attending school or holding a job. Includes halfway houses.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002085181559</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002085" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Group Homes</rdfs:label>
		<skos:definition>A group home is a long-term facility in which residents are allowed extensive contact with the community, such as attending school or holding a job. Includes halfway houses.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002085" />
		<skos:notation>GRPHOMES</skos:notation>
		<skos:prefLabel>Group Homes</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002085181560">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A juvenile detention center is a shorter term institution that provide care to children who require secure custody pending court adjudication, court disposition, or execution of a court order, or care to children after commitment.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002085181560</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002085" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Juvenile detention centers</rdfs:label>
		<skos:definition>A juvenile detention center is a shorter term institution that provide care to children who require secure custody pending court adjudication, court disposition, or execution of a court order, or care to children after commitment.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002085" />
		<skos:notation>JUVDET</skos:notation>
		<skos:prefLabel>Juvenile detention centers</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002085181561">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A long-term secure facility is a public or private residential facility that provides confinement of its residents, for the care of children who have been adjudicated to be delinquent or in need of supervision. Similar to juvenile correctional facility.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002085181561</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002085" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Long-term secure juvenile facility</rdfs:label>
		<skos:definition>A long-term secure facility is a public or private residential facility that provides confinement of its residents, for the care of children who have been adjudicated to be delinquent or in need of supervision. Similar to juvenile correctional facility.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002085" />
		<skos:notation>JUVLNGTRMFAC</skos:notation>
		<skos:prefLabel>Long-term secure juvenile facility</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002085181562">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Any other facility or program, not defined above, which meet the definition of an institution for delinquent children and youth.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002085181562</dc:identifier>
