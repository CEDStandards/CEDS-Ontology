		<dc:description>The location at which the identified hazardous material is found.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The location at which the identified hazardous material is found.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001810">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001810</dc:identifier>
