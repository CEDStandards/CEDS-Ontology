		<skos:notation>CredentialingOrganization</skos:notation>
		<dc:description>An institution, organization, federation, or other such group that is responsible for accrediting or endorsing an individual's preparation, skills, or performance.</dc:description>
		<skos:definition>An institution, organization, federation, or other such group that is responsible for accrediting or endorsing an individual's preparation, skills, or performance.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200088">
