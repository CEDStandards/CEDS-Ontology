	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164263">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Viticulture courses prepare students for further studies in grape-growing, viticulture, and wine-making industry. Course topics typically include establishing and managing vineyards; harvesting; fermentation and wine making; marketing; and exploring career options within the industry. Agricultural applications specific to vineyards and wineries are emphasized.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164263</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Viticulture</rdfs:label>
		<skos:definition>Viticulture courses prepare students for further studies in grape-growing, viticulture, and wine-making industry. Course topics typically include establishing and managing vineyards; harvesting; fermentation and wine making; marketing; and exploring career options within the industry. Agricultural applications specific to vineyards and wineries are emphasized.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>18311</skos:notation>
		<skos:prefLabel>Viticulture</skos:prefLabel>
	</owl:NamedIndividual>
