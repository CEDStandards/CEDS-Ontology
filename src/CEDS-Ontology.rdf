		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000437" />
		<skos:notation>hasMigrantEducationProgramEnrollmentType</skos:notation>
		<dc:description>The type of school/migrant education project in which instruction and/or support services are provided.</dc:description>
		<skos:definition>The type of school/migrant education project in which instruction and/or support services are provided.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000185">
