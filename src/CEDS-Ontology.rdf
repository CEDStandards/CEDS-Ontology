		<skos:notation>NeglectedOrDelinquentStatus</skos:notation>
		<skos:prefLabel>Neglected or Delinquent Status</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Updated definition to include Subpart 2 (local agencies)</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/850</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</owl:Class>
