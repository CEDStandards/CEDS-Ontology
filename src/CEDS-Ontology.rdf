			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600467">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600467</dc:identifier>
		<rdfs:label>Has Learning Resource Peer Rating</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200275" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200234" />
		<skos:notation>hasLearningResourcePeerRating</skos:notation>
		<dc:description>References information about a rating given to a learning resource. (LearningResourceAggregatePeerRating is a CEDS Connection to also support aggregate ratings.)</dc:description>
		<skos:definition>References information about a rating given to a learning resource. (LearningResourceAggregatePeerRating is a CEDS Connection to also support aggregate ratings.)</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
