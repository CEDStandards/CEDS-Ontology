		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>K12 School</rdfs:label>
		<skos:definition>An institution that provides educational services; has one or more grade groups (PK through 12); has one or more teachers; is located in one or more buildings; has an assigned administrator(s).</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<skos:notation>K12School</skos:notation>
		<skos:prefLabel>K12 School</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173070">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A regional, multi-services public agency authorized by State law to develop, manage, and provide services, programs, or other support (e.g., construction, food services, technology services) to LEAs.</dc:description>
