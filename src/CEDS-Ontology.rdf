	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001755127809">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A public school offering special instruction and programs not available elsewhere, designed to attract a more diverse student body from throughout a school district.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001755127809</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Magnet/Competitive Admissions School</rdfs:label>
		<skos:definition>A public school offering special instruction and programs not available elsewhere, designed to attract a more diverse student body from throughout a school district.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<skos:notation>Magnet</skos:notation>
		<skos:prefLabel>Magnet/Competitive Admissions School</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001755127810">
