	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001806">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001806</dc:identifier>
