		<skos:definition>A classroom designed for instruction of a particular age group, but not a specific subject.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001817">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001817</dc:identifier>
		<rdfs:label>Has Building Career-Technical Education Space Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200058" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001817" />
		<skos:notation>hasBuildingCareer-TechnicalEducationSpaceType</skos:notation>
		<dc:description>The classroom, laboratory, or shop specially located, designed, furnished, and equipped to support instruction of technical and technology related curriculum, usually tied to particular industry, for example, bio-tech, construction, or agriculture.</dc:description>
		<skos:definition>The classroom, laboratory, or shop specially located, designed, furnished, and equipped to support instruction of technical and technology related curriculum, usually tied to particular industry, for example, bio-tech, construction, or agriculture.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001865">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001865</dc:identifier>
		<rdfs:label>Has Building Charter School Realty Access Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200134" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001865" />
		<skos:notation>hasBuildingCharterSchoolRealtyAccessType</skos:notation>
		<dc:description>The type of real estate vehicle through which a public charter school has access and control of its building space.</dc:description>
		<skos:definition>The type of real estate vehicle through which a public charter school has access and control of its building space.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001818">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001818</dc:identifier>
