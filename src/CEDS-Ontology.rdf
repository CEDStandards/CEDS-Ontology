		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200089" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200177" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<skos:notation>hasCredentialDefinition</skos:notation>
		<dc:description>References information that defines a qualification, achievement, personal or organizational quality, or aspect of an identity typically used to indicate suitability.</dc:description>
		<skos:definition>References information that defines a qualification, achievement, personal or organizational quality, or aspect of an identity typically used to indicate suitability.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600359">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600359</dc:identifier>
