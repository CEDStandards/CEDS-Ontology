		<skos:notation>hasCredentialAwardRelationshipType</skos:notation>
		<dc:description>The nature of a credential award's relationship to another credential award.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Renamed from Credential Award Relationship to Credential Award Relationship Type for naming consistency with Organization Relationship Type and Person Relationship Type</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1000</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry>
				<changeDescription>Move this property to the Credential Award Relationship Detail class and fixed the pointer to the option set.</changeDescription>
				<changeVersion>13</changeVersion>
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The nature of a credential award's relationship to another credential award.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600571">
