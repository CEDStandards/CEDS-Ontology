		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001007" />
		<skos:notation>hasAssessmentResultPreliminaryIndicator</skos:notation>
		<dc:description>If this score is preliminary, then this attribute value should be set.  Preliminary scores may be provided for early use by the assessment program or user while final scoring is occurring.</dc:description>
