		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200142" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000547" />
		<skos:notation>hasFederalProgramCode</skos:notation>
