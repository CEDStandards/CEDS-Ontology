	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000954">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Indicates that the response is to a scaffolding problem rather than the main/assigned problem. A scaffolding item is a follow-up formative assessment item used to assess prerequisite or component skills, presented immediately after a learner gives an incorrect answer on the previous item.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000954</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Assessment Item Response Scaffolding Item Flag</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:definition>Indicates that the response is to a scaffolding problem rather than the main/assigned problem. A scaffolding item is a follow-up formative assessment item used to assess prerequisite or component skills, presented immediately after a learner gives an incorrect answer on the previous item.</skos:definition>
		<skos:notation>AssessmentItemResponseScaffoldingItemFlag</skos:notation>
		<skos:prefLabel>Assessment Item Response Scaffolding Item Flag</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000956">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Indicates that one of the hints presented included the correct answer.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000956</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Assessment Item Response Hint Included Answer</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Indicates that one of the hints presented included the correct answer.</skos:definition>
		<skos:notation>AssessmentItemResponseHintIncludedAnswer</skos:notation>
		<skos:prefLabel>Assessment Item Response Hint Included Answer</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000972">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Indicates that the student is excluded from calculation of value-added or growth attribution calculations used for teacher evaluation.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000972</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Teacher Student Data Link Exclusion Flag</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Indicates that the student is excluded from calculation of value-added or growth attribution calculations used for teacher evaluation.</skos:definition>
		<skos:notation>TeacherStudentDataLinkExclusionFlag</skos:notation>
		<skos:prefLabel>Teacher Student Data Link Exclusion Flag</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001004">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Defines whether or not the individual needs the kind of support defined by the entity.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001004</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Assessment Personal Needs Profile Assigned Support</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>Defines whether or not the individual needs the kind of support defined by the entity.</skos:definition>
		<skos:notation>AssessmentPersonalNeedsProfileAssignedSupport</skos:notation>
		<skos:prefLabel>Assessment Personal Needs Profile Assigned Support</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001005">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Determines if the alternative accessible content is rendered as the default content for the learner.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001005</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Assessment Personal Needs Profile Activate by Default</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
