		<skos:definition>An organization that primarily operates online.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<skos:notation>PrimarilyOnline</skos:notation>
		<skos:prefLabel>Primarily Online</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001755127814">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A membership organization primarily engaged in promoting the interests of a particular profession, the interests of individuals engaged in that profession, and providing them with services that may involve the provision of education and credentialing services.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001755127814</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Professional Association</rdfs:label>
		<skos:definition>A membership organization primarily engaged in promoting the interests of a particular profession, the interests of individuals engaged in that profession, and providing them with services that may involve the provision of education and credentialing services.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<skos:notation>ProfessionalAssociation</skos:notation>
		<skos:prefLabel>Professional Association</skos:prefLabel>
	</owl:NamedIndividual>
