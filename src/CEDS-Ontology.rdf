				<changeDescription>Added to option set.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the pre-determined criteria for granting the teaching credential that a person holds.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000278">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000278</dc:identifier>
		<rdfs:label>Has Teaching Credential Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200323" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200364" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000278" />
		<skos:notation>hasTeachingCredentialType</skos:notation>
		<dc:description>An indication of the category of a legal document giving authorization to perform teaching assignment services.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Added this property to the Credential Definition class per request from CEPI in Michigan.</changeDescription> 	
				<changeVersion>13</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the category of a legal document giving authorization to perform teaching assignment services.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001494">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001494</dc:identifier>
		<rdfs:label>Has Technical Assistance Delivery Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200271" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200370" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001494" />
		<skos:notation>hasTechnicalAssistanceDeliveryType</skos:notation>
		<dc:description>The method of delivery of technical assistance received/provided</dc:description>
		<rdfs:comment>Technical assistance may be for organizations or staff depending on context. See the document &lt;a href="https://ceds.ed.gov/pdf/ceds-addresses-professional-development-data-elements.pdf"&gt;https://ceds.ed.gov/pdf/ceds-addresses-professional-development-data-elements.pdf&lt;/a&gt;.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add usage note to make it clear that "technical assistance" may have to do with assistance to organizations or individuals including professional development.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The method of delivery of technical assistance received/provided</skos:definition>
	</rdf:Property>
