		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000392" />
		<skos:notation>hasAssessmentItemCharacteristicType</skos:notation>
		<dc:description>The type of psychometric measure provided for assessment item.</dc:description>
		<skos:definition>The type of psychometric measure provided for assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001217">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001217</dc:identifier>
		<rdfs:label>Has Assessment Item Possible Response Correct Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200027" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001217" />
		<skos:notation>hasAssessmentItemPossibleResponseCorrectIndicator</skos:notation>
		<dc:description>Indicates that the possible response is the correct response.</dc:description>
		<skos:definition>Indicates that the possible response is the correct response.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000956">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000956</dc:identifier>
		<rdfs:label>Has Assessment Item Response Hint Included Answer</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000956" />
		<skos:notation>hasAssessmentItemResponseHintIncludedAnswer</skos:notation>
		<dc:description>Indicates that one of the hints presented included the correct answer.</dc:description>
		<rdfs:comment>A typical scenario for an online tutoring application may present a series of hints for a formative assessment item with the last hint being the correct answer.  The learner must enter the correct answer before continuing.  This data element is a flag that the learner was presented with the "bottom hint", which is the correct answer.</rdfs:comment>
		<skos:definition>Indicates that one of the hints presented included the correct answer.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000954">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000954</dc:identifier>
		<rdfs:label>Has Assessment Item Response Scaffolding Item Flag</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000954" />
		<skos:notation>hasAssessmentItemResponseScaffoldingItemFlag</skos:notation>
		<dc:description>Indicates that the response is to a scaffolding problem rather than the main/assigned problem.  A scaffolding item is a follow-up formative assessment item used to assess prerequisite or component skills, presented immediately after a learner gives an incorrect answer on the previous item.</dc:description>
		<skos:definition>Indicates that the response is to a scaffolding problem rather than the main/assigned problem. A scaffolding item is a follow-up formative assessment item used to assess prerequisite or component skills, presented immediately after a learner gives an incorrect answer on the previous item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600131">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600131</dc:identifier>
