	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001270">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001270</dc:identifier>
		<rdfs:label>Session Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200245" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>SessionCode</skos:notation>
		<dc:description>A local code given to the session, usually for a session that represents a term within the school year such as a marking term.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A local code given to the session, usually for a session that represents a term within the school year such as a marking term.</skos:definition>
	</rdf:Property>
