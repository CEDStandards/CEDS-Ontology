	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164532">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Pre-Engineering Technology courses integrate technology-oriented applications of mathematics and science into pre-engineering activities for students. Course topics may include material sciences, technology processes, enterprises, and career opportunities.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164532</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
