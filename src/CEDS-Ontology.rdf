	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001155">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001155</dc:identifier>
		<rdfs:label>Competency Definition Text Complexity Maximum Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>CompetencyDefinitionTextComplexityMaximumValue</skos:notation>
		<dc:description>The maximum value in the range of text complexity applicable to a language competency definition using the scaling system defined by Text Complexity System, e.g. Lexile(tm).</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The maximum value in the range of text complexity applicable to a language competency definition using the scaling system defined by Text Complexity System, e.g. Lexile(tm).</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001249">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001249</dc:identifier>
		<rdfs:label>Competency Definition Notes</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyDefinitionNotes</skos:notation>
		<dc:description>Information about the derivation of a Competency Definition Statement.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Information about the derivation of a Competency Definition Statement.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001250">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001250</dc:identifier>
		<rdfs:label>Competency Definition Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyDefinitionVersion</skos:notation>
		<dc:description>A label assigned by the publisher indicating the version of the competency framework statement.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A label assigned by the publisher indicating the version of the competency framework statement.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001409">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001409</dc:identifier>
		<rdfs:label>Competency Definition Short Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyDefinitionShortName</skos:notation>
		<dc:description>The short name or label for the competency definition or its node in a competency framework.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The short name or label for the competency definition or its node in a competency framework.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated the element name and definition to reflect a broader use of the element by stakeholders.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001511">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001511</dc:identifier>
		<rdfs:label>Competency Definition Valid End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CompetencyDefinitionValidEndDate</skos:notation>
		<dc:description>The year, month and day the competency definition was deprecated/replaced by the jurisdiction in which it was intended to apply.</dc:description>
		<rdfs:comment>When not specified, the entity is assumed to contain the most current version of the specified competency definition. All CEDS Exit and End Dates represent the last day of the date range specified, in this case the last day the competency definition was valid.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day the competency definition was deprecated/replaced by the jurisdiction in which it was intended to apply.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001512">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001512</dc:identifier>
		<rdfs:label>Competency Definition Valid Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CompetencyDefinitionValidStartDate</skos:notation>
		<dc:description>The year, month and day the competency definition was adopted by the jurisdiction in which it was intended to apply.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day the competency definition was adopted by the jurisdiction in which it was intended to apply.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001524">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001524</dc:identifier>
		<rdfs:label>Competency Definition Previous Version Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyDefinitionPreviousVersionIdentifier</skos:notation>
		<dc:description>The unique identifier of the previous version of the Competency Definition if the statement was modified.</dc:description>
		<rdfs:comment>This element supports version histories at the statement level. If corrections have been made to individual items/statements that are not part of a new Competency Framework, the elements 'Competency Definition Previous Version Identifier' and 'Competency Definition Current Version Indicator' provide a reference to historical versions of the current statement. In such uses the 'Competency Definition Code' could be the same for multiple versions of a statement and 'Competency Definition URL' could resolve to the most current version of the statement.&lt;br/&gt;&lt;br/&gt;&lt;BR/&gt;CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces.&lt;br/&gt;&lt;br/&gt;&lt;BR/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The unique identifier of the previous version of the Competency Definition if the statement was modified.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001570">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001570</dc:identifier>
		<rdfs:label>Competency Definition Sequence</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyDefinitionSequence</skos:notation>
		<dc:description>A set of one or more alphanumeric characters and/or symbols denoting the positioning of the statement being described in a sequential listing of statements.</dc:description>
		<rdfs:comment>Based on ASN's ListID. (add reference URL)</rdfs:comment>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A set of one or more alphanumeric characters and/or symbols denoting the positioning of the statement being described in a sequential listing of statements.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001757">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001757</dc:identifier>
		<rdfs:label>Competency Definition Type URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyDefinitionTypeURL</skos:notation>
		<dc:description>The class of statement in the structure of statements in the Competency Framework according to a controlled vocabulary, specified as a URI referencing a controlled vocabulary.</dc:description>
		<rdfs:comment>This property points to a class, not to instances of that class. For example, where two competencies in a competency framework have been identified respectively  as \"Strand: Renaissance\" and \"Strand: Social history\", the competency category for both these competencies is \"Strand\"."</rdfs:comment>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The class of statement in the structure of statements in the Competency Framework according to a controlled vocabulary, specified as a URI referencing a controlled vocabulary.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>This updated definition and usage note better aligns with concept in CEASN vocabulary. It provides a URL as a universal identifier for the type or class of the Competency Item.  It is based on ceasn:competencyCategory.  &#13;
&#13;
Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001908">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001908</dc:identifier>
		<rdfs:label>Competency Definition Typical Age Range Minimum</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>CompetencyDefinitionTypicalAgeRangeMinimum</skos:notation>
		<dc:description>The typical minimum age at which a person learns the defined competency.</dc:description>
		<rdfs:comment>Use this element with "Competency Definition Typical Age Range Maximum" instead of "Competency Item Typical Age Range"</rdfs:comment>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The typical minimum age at which a person learns the defined competency.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>This is one of two new elements that split the existing Competency Item Typical Age Range from a single element into separate elements for minimum and maximum values. The intent is to make the values machine readable without parsing.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001909">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001909</dc:identifier>
		<rdfs:label>Competency Definition Typical Age Range Maximum</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>CompetencyDefinitionTypicalAgeRangeMaximum</skos:notation>
		<dc:description>The typical maximum age at which a person learns the defined competency.</dc:description>
		<rdfs:comment>Use this element with "Competency Definition Typical Age Range Minimum" instead of "Competency Item Typical Age Range"</rdfs:comment>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The typical maximum age at which a person learns the defined competency.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>This is one of two new elements that split the existing Competency Item Typical Age Range from a single element into separate elements for minimum and maximum values. The intent is to make the values machine readable without parsing.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000715">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000715</dc:identifier>
		<rdfs:label>Competency Definition Prerequisite Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>CompetencyDefinitionPrerequisiteIdentifier</skos:notation>
		<dc:description>The unique identifier of an immediate prerequisite Competency Definition, a competency needed prior to learning this one. (Some items may have no prerequisites while others may have one or more prerequisites. This should only be used to represent the immediate predecessors in a competency-based pathway, i.e. not prerequisites of prerequisites.)</dc:description>
		<rdfs:comment>The recommended approach is to use the entity Learning Standard Item Association instead of this data element. Learning Standard Item Association also supports associating other entities, such as Learning Resources, to learning standard items.&#13;
&#13;
&#13;
&#13;
CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces.&#13;
&#13;
&#13;
&#13;
An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The unique identifier of an immediate prerequisite Competency Definition, a competency needed prior to learning this one. (Some items may have no prerequisites while others may have one or more prerequisites. This should only be used to represent the immediate predecessors in a competency-based pathway, i.e. not prerequisites of prerequisites.)</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000871">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000871</dc:identifier>
		<rdfs:label>Competency Association Identifier URI</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyAssociationIdentifierURI</skos:notation>
		<dc:description>A URI that establishes uniqueness of an association between a competency definition and another competency item or other objects such as learning resources.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A URI that establishes uniqueness of an association between a competency definition and another competency item or other objects such as learning resources.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changes toward common naming throughout the Credentials Ecosystem Mapping community</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001402">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001402</dc:identifier>
		<rdfs:label>Competency Association Connection Citation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyAssociationConnectionCitation</skos:notation>
		<dc:description>Any citation appropriate to evidence the connection between nodes</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Any citation appropriate to evidence the connection between nodes</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changes toward common naming throughout the Credentials Ecosystem Mapping community</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001403">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001403</dc:identifier>
		<rdfs:label>Competency Association Destination Node Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyAssociationDestinationNodeName</skos:notation>
		<dc:description>Name of the destination node when the Competency Association is used as a connector in a learning map.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Name of the destination node when the Competency Association is used as a connector in a learning map.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changes toward common naming throughout the Credentials Ecosystem Mapping community</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001404">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001404</dc:identifier>
		<rdfs:label>Competency Association Destination Node URI</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyAssociationDestinationNodeURI</skos:notation>
		<dc:description>URI of the destination node when the Competency Association is used as a connector in a learning map.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>URI of the destination node when the Competency Association is used as a connector in a learning map.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changes toward common naming throughout the Credentials Ecosystem Mapping community</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001405">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001405</dc:identifier>
		<rdfs:label>Competency Association Origin Node Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyAssociationOriginNodeName</skos:notation>
		<dc:description>Name of the origin node when the Competency Association is used as a connector in a learning map.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Name of the origin node when the Competency Association is used as a connector in a learning map.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changes toward common naming throughout the Credentials Ecosystem Mapping community</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001406">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001406</dc:identifier>
		<rdfs:label>Competency Association Origin Node URI</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyAssociationOriginNodeURI</skos:notation>
		<dc:description>URI of the origin node when the Competency Association is used as a connector in a learning map.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>URI of the origin node when the Competency Association is used as a connector in a learning map.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changes toward common naming throughout the Credentials Ecosystem Mapping community</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001407">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001407</dc:identifier>
		<rdfs:label>Competency Association Weight</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>CompetencyAssociationWeight</skos:notation>
		<dc:description>Indicates the relative significance this connection has for the destination node in a learning map.</dc:description>
		<rdfs:comment>This element is used to support learning maps and may be used in two ways 1) use a 1.000 to flag incoming nodes as important prerequisites/predecessors and 0.000 to indicate those with less significance, or 2) to indicate a levels of significance for the connection as a decimal between 0.000 and 1.000.</rdfs:comment>
		<minInclusive>0</minInclusive>
		<maxInclusive>1</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>3</decimalPlaces>
		<skos:definition>Indicates the relative significance this connection has for the destination node in a learning map.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changes toward common naming throughout the Credentials Ecosystem Mapping community</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000693">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000693</dc:identifier>
		<rdfs:label>Competency Framework Identifier URI</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkIdentifierURI</skos:notation>
		<dc:description>An unambiguous reference to the competency framework using a network-resolvable URI.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An unambiguous reference to the competency framework using a network-resolvable URI.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000694">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000694</dc:identifier>
		<rdfs:label>Competency Framework Title</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkTitle</skos:notation>
		<dc:description>The name of the competency framework.</dc:description>
		<maxLength>120</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the competency framework.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000695">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000695</dc:identifier>
		<rdfs:label>Competency Framework Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkVersion</skos:notation>
		<dc:description>Defines the revision of the competency framework as a version number or date.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Defines the revision of the competency framework as a version number or date.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000696">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000696</dc:identifier>
		<rdfs:label>Competency Framework Creator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkCreator</skos:notation>
		<dc:description>The person or organization chiefly responsible for the intellectual content of the competency framework.</dc:description>
		<rdfs:comment>Implementations may choose to model this element as a repeatable field to support the case of multiple authors.  Others may just use a comma delimited string for multiple authors.</rdfs:comment>
		<maxLength>120</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The person or organization chiefly responsible for the intellectual content of the competency framework.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000697">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000697</dc:identifier>
		<rdfs:label>Competency Framework Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkDescription</skos:notation>
		<dc:description>A textual description of the scope and contents of the competency framework.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A textual description of the scope and contents of the competency framework.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000699">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000699</dc:identifier>
		<rdfs:label>Competency Framework Jurisdiction</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkJurisdiction</skos:notation>
		<dc:description>A legal, quasi-legal, organizational or institutional domain of the entity mandating the use of the statement--e.g., California.</dc:description>
		<maxLength>120</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A legal, quasi-legal, organizational or institutional domain of the entity mandating the use of the statement--e.g., California.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000700">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000700</dc:identifier>
		<rdfs:label>Competency Framework Valid Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CompetencyFrameworkValidStartDate</skos:notation>
		<dc:description>The year, month and day the competency framework was adopted by the jurisdiction in which it was intended to apply.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day the competency framework was adopted by the jurisdiction in which it was intended to apply.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000701">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000701</dc:identifier>
		<rdfs:label>Competency Framework Valid End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CompetencyFrameworkValidEndDate</skos:notation>
		<dc:description>The year, month and day the competency framework was deprecated/replaced by the jurisdiction in which it was intended to apply.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The year, month and day the competency framework was deprecated/replaced by the jurisdiction in which it was intended to apply.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000702">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000702</dc:identifier>
		<rdfs:label>Competency Framework Subject</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkSubject</skos:notation>
		<dc:description>The topic or academic subject of the competency framework.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The topic or academic subject of the competency framework.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000882">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000882</dc:identifier>
		<rdfs:label>Competency Framework License</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkLicense</skos:notation>
		<dc:description>A legal document giving official permission to do something with the competency framework.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A legal document giving official permission to do something with the competency framework.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000884">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000884</dc:identifier>
		<rdfs:label>Competency Framework Publisher</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkPublisher</skos:notation>
		<dc:description>The entity responsible for making the competency framework available.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The entity responsible for making the competency framework available.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000885">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000885</dc:identifier>
		<rdfs:label>Competency Framework Rights</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkRights</skos:notation>
		<dc:description>The information about rights held in and over the resource.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The information about rights held in and over the resource.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000886">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000886</dc:identifier>
		<rdfs:label>Competency Framework Rights Holder</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkRightsHolder</skos:notation>
		<dc:description>The person or organization owning or managing rights over the competency framework.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The person or organization owning or managing rights over the competency framework.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001569">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001569</dc:identifier>
		<rdfs:label>Competency Framework Publication Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CompetencyFrameworkPublicationDate</skos:notation>
		<dc:description>The date on which this content was first published.</dc:description>
		<rdfs:comment>This may or may not be different from the Learning Standard Document Valid Start Date.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which this content was first published.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL and other credential work</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001907">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001907</dc:identifier>
		<rdfs:label>Competency Framework Source URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200067" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CompetencyFrameworkSourceURL</skos:notation>
		<dc:description>A URL that resolves to the original or authoritative competency framework document.</dc:description>
		<rdfs:comment>This is the URL of a human-readable artifact. Often this document is published in html and/or pdf and is used by the standard setting entity as part of its approval process.</rdfs:comment>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A URL that resolves to the original or authoritative competency framework document.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>This new element "Competency Framework Source URL" aligns with concept in IMS CASE and ASN-DL. Definition adapted from ASN-DL property.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000878">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000878</dc:identifier>
		<rdfs:label>Competency Set Completion Criteria Threshold</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200068" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>CompetencySetCompletionCriteriaThreshold</skos:notation>
		<dc:description>The minimum number of competencies in the set that must be achieved for completion or partial completion of a unit, course, program, degree, certification, or other achievement/award.</dc:description>
		<rdfs:comment>Used to define the completion criteria when Competency Set Completion Criteria is "At Least".  Not used when Competency Set Completion Criteria is "All".</rdfs:comment>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The minimum number of competencies in the set that must be achieved for completion or partial completion of a unit, course, program, degree, certification, or other achievement/award.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES context to support K12 Implementation.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000058">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000058</dc:identifier>
		<rdfs:label>Credit Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>CreditValue</skos:notation>
		<dc:description>The amount of credit available to the student who successfully meets the objectives of the course or learning opportunity based on the units defined by Credit Unit Type.</dc:description>
		<rdfs:comment>For K-12 a course meeting every day for one period of the school day over the span of a school year typically offers one Carnegie unit. In this case a Carnegie unit is  a measure of "seat time" rather than a measure of attainment of the course objectives.</rdfs:comment>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The amount of credit available to the student who successfully meets the objectives of the course or learning opportunity based on the units defined by Credit Unit Type.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000066">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000066</dc:identifier>
		<rdfs:label>Course Subject Abbreviation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CourseSubjectAbbreviation</skos:notation>
		<dc:description>The alphabetic abbreviation of the academic department or discipline offering the course. It is one part of the total course identifier number.</dc:description>
		<maxLength>10</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The alphabetic abbreviation of the academic department or discipline offering the course. It is one part of the total course identifier number.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000250">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000250</dc:identifier>
		<rdfs:label>School Courses for the Exchange of Data Sequence of Course</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>SCEDSequenceOfCourse</skos:notation>
		<dc:description>Where a specific course lies when it is part of a consecutive sequence of courses. This element should be interpreted as "part 'n' of 'm' parts.</dc:description>
		<rdfs:comment>For example: if a school offers 4 years of Theater, Theater 3 within this school would be indicated in the sequence elements as 3 4, denoting the 3rd part of a 4-part sequence of courses.</rdfs:comment>
		<maxLength>10</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Where a specific course lies when it is part of a consecutive sequence of courses. This element should be interpreted as "part 'n' of 'm' parts.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from School Codes for the Exchange of Data Sequence of Course.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000499">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000499</dc:identifier>
		<rdfs:label>Instructional Minutes</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200245" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>InstructionalMinutes</skos:notation>
		<dc:description>The total number of instruction minutes in a given session, as determined by time in class, time on task (e.g., engaged in a class), or as estimated by a qualified course designer.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The total number of instruction minutes in a given session, as determined by time in class, time on task (e.g., engaged in a class), or as estimated by a qualified course designer.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES context to support K12 Implementation.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000517">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000517</dc:identifier>
		<rdfs:label>Course Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CourseDescription</skos:notation>
		<dc:description>A description of the course content and/or goals. Reference may be made to state or national content standards.</dc:description>
		<maxLength>1024</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the course content and/or goals. Reference may be made to state or national content standards.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry>
				<changeDescription>Corrected maxLength to match text format of 1024 characters.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/98</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Update format</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Definition updated</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001302">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001302</dc:identifier>
		<rdfs:label>Course Certification Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CourseCertificationDescription</skos:notation>
		<dc:description>A description of the certification or recognition associated with this course (ex. Networking, CAD, etc.)</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the certification or recognition associated with this course (ex. Networking, CAD, etc.)</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001667">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001667</dc:identifier>
		<rdfs:label>Course Repeatability Maximum Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>CourseRepeatabilityMaximumNumber</skos:notation>
		<dc:description>The maximum number of times the course may be taken or completed for credit.</dc:description>
		<textFormat>Integer</textFormat>
		<skos:definition>The maximum number of times the course may be taken or completed for credit.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Based on suggestion from PESC COMMON CREDENTIAL draft standard., change source: PESC</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002023">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002023</dc:identifier>
		<rdfs:label>Sequence of Course</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>SequenceOfCourse</skos:notation>
		<dc:description>Where a specific course lies when it is part of a consecutive sequence of courses.</dc:description>
		<rdfs:comment>For example: if a school offers 4 years of Theater, Theater 3 within this school would be indicated in the sequence elements as 3 4, denoting the 3rd part of a 4-part sequence of courses.</rdfs:comment>
		<maxLength>10</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Where a specific course lies when it is part of a consecutive sequence of courses.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000101">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000101</dc:identifier>
		<rdfs:label>Course Section Time Required for Completion</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>CourseSectionTimeRequiredForCompletion</skos:notation>
		<dc:description>The actual or estimated number of clock minutes required for course completion. This number is especially important for career and technical education course and may represent (in minutes) the clock hour requirement of the course, the number of minutes (or clock hours) of class time per week, times the number of equivalent weeks the class typically meets.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The actual or estimated number of clock minutes required for course completion. This number is especially important for career and technical education course and may represent (in minutes) the clock hour requirement of the course, the number of minutes (or clock hours) of class time per week, times the number of equivalent weeks the class typically meets.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000231">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000231</dc:identifier>
		<rdfs:label>Related Competency Definitions</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>RelatedCompetencyDefinitions</skos:notation>
		<dc:description>An indication of the competency definition(s) addressed in the Course Section.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An indication of the competency definition(s) addressed in the Course Section.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Competency Item" to "Competency Definition" to support alignment across standards and reduce confusion by those who might think this is a "competency assertion" that is attributed to a person rather than what it is, a definition of a competency that could apply to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001655">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001655</dc:identifier>
		<rdfs:label>Course Section Maximum Capacity</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>CourseSectionMaximumCapacity</skos:notation>
		<dc:description>The maximum number of students the Course Section can maintain.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The maximum number of students the Course Section can maintain.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000519">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000519</dc:identifier>
		<rdfs:label>Class Beginning Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200078" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>ClassBeginningTime</skos:notation>
		<dc:description>An indication of the time of day the class begins.</dc:description>
		<textFormat>HH:MM:SS</textFormat>
		<skos:definition>An indication of the time of day the class begins.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000520">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000520</dc:identifier>
		<rdfs:label>Class Ending Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200078" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>ClassEndingTime</skos:notation>
		<dc:description>An indication of the time of day the class ends.</dc:description>
		<textFormat>HH:MM:SS</textFormat>
		<skos:definition>An indication of the time of day the class ends.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000521">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000521</dc:identifier>
		<rdfs:label>Class Meeting Days</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200078" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ClassMeetingDays</skos:notation>
		<dc:description>The day(s) of the week (e.g., Monday, Wednesday) that the class meets or an indication that a class meets "out-of-school" or "self-paced".</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The day(s) of the week (e.g., Monday, Wednesday) that the class meets or an indication that a class meets "out-of-school" or "self-paced".</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000522">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000522</dc:identifier>
		<rdfs:label>Class Period</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200078" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ClassPeriod</skos:notation>
		<dc:description>An indication of the portion of a typical daily session in which students receive instruction in a specified subject (e.g., morning, sixth period, block period, or AB schedules).</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An indication of the portion of a typical daily session in which students receive instruction in a specified subject (e.g., morning, sixth period, block period, or AB schedules).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000523">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000523</dc:identifier>
		<rdfs:label>Timetable Day Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200078" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>TimetableDayIdentifier</skos:notation>
		<dc:description>The unique identifier for the locally defined rotation cycle date code when the class meets (e.g., in a two day schedule, valid values could be "A" and "B", or "1" and "2").</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The unique identifier for the locally defined rotation cycle date code when the class meets (e.g., in a two day schedule, valid values could be "A" and "B", or "1" and "2").</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001163">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001163</dc:identifier>
		<rdfs:label>Credential Award Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CredentialAwardStartDate</skos:notation>
		<dc:description>The date on which the qualification, achievement, personal or organizational quality, or aspect of an identity was conferred.</dc:description>
		<rdfs:comment>Diploma or Credential Award Date is the same concept but used when only month and year are known or needed.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the qualification, achievement, personal or organizational quality, or aspect of an identity was conferred.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Elements for Credential Award were incorrectly included in Credential (Definition). Proposed corrections:&#13;
1. Remove "Credential Start Date" and "Credential End Date" from DES under "Credential" ( keep under Credential Award) &#13;
2. Rename "Credential Start Date" to "Credential Award Start Date"&#13;
3. Rename " Credential End Date" to "Credential Award End Date"</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001164">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001164</dc:identifier>
		<rdfs:label>Credential Award End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CredentialAwardEndDate</skos:notation>
		<dc:description>The date, if any, on which the qualification, achievement, personal or organizational quality, or aspect of an identity expires or requires renewal.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date, if any, on which the qualification, achievement, personal or organizational quality, or aspect of an identity expires or requires renewal.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Elements for Credential Award were incorrectly included in Credential (Definition). Proposed corrections:&#13;
1. Remove "Credential Start Date" and "Credential End Date" from DES under "Credential" ( keep under Credential Award) &#13;
2. Rename "Credential Start Date" to "Credential Award Start Date"&#13;
3. Rename " Credential End Date" to "Credential Award End Date" &#13;
&#13;
Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001660">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001660</dc:identifier>
		<rdfs:label>Credential Revoked Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CredentialRevokedDate</skos:notation>
		<dc:description>The date on which the qualification, achievement, personal or organizational quality, or aspect of an identity was revoked.</dc:description>
		<rdfs:comment>An empty string means the assertion was not revoked. Some uses (e.g. OpenBadges) may append time info in ISO 8601 format.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the qualification, achievement, personal or organizational quality, or aspect of an identity was revoked.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: Badges 2.0 spec</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001661">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001661</dc:identifier>
		<rdfs:label>Credential Revoked Reason</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialRevokedReason</skos:notation>
		<dc:description>Published reason for revocation of a credential award.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Published reason for revocation of a credential award.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: Badges 2.0 spec</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001664">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001664</dc:identifier>
		<rdfs:label>Credential Completion Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CredentialCompletionDate</skos:notation>
		<dc:description>The date on which the person's requirements for earning a credential were met or completed.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the person's requirements for earning a credential were met or completed.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Based on suggestion from PESC COMMON CREDENTIAL draft standard., change source: PESC</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001669">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001669</dc:identifier>
		<rdfs:label>Credential Award Evidence URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200079" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialAwardEvidenceURL</skos:notation>
		<dc:description>A URL to a page that describes the evidence that the learner met the criteria for attainment of the credential award.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A URL to a page that describes the evidence that the learner met the criteria for attainment of the credential award.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Based on suggestion from PESC COMMON CREDENTIAL draft standard., change source: PESC</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001734">
