		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200005</dc:identifier>
		<rdfs:label>Adult Education Staff</rdfs:label>
		<skos:notation>AdultEducationStaff</skos:notation>
		<dc:description>Information about a person specific to their role as a staff member in an adult education context.</dc:description>
		<skos:definition>Information about a person specific to their role as a staff member in an adult education context.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200006">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200006</dc:identifier>
		<rdfs:label>Adult Education Student Academic Record</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AdultEducationStudentAcademicRecord</skos:notation>
		<dc:description>Information in a student's academic record specific to adult education program participation.</dc:description>
		<skos:definition>Information in a student's academic record specific to adult education program participation.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200007">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200007</dc:identifier>
		<rdfs:label>Adult Education Student Employment</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AdultEducationStudentEmployment</skos:notation>
		<dc:description>Information about student employment specific to the adult education context.</dc:description>
		<skos:definition>Information about student employment specific to the adult education context.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200392">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200392</dc:identifier>
		<rdfs:label>Affiliated Institution</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>AffiliatedInstitution</skos:notation>
		<dc:description>An institution that has an ongoing, functional relationship with the education institution in order to provide improved educational experiences to an individual and/or the school.</dc:description>
		<skos:definition>An institution that has an ongoing, functional relationship with the education institution in order to provide improved educational experiences to an individual and/or the school.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200008">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200008</dc:identifier>
		<rdfs:label>Apip Interaction</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>ApipInteraction</skos:notation>
		<dc:description>Information defining an assessment item interaction that may be specified using the IMS Global Accessible Portable Item Protocol APIP(R) standards.</dc:description>
		<skos:definition>Information defining an assessment item interaction that may be specified using the IMS Global Accessible Portable Item Protocol APIP(R) standards.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200009">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200009</dc:identifier>
		<rdfs:label>Application</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Application</skos:notation>
		<dc:description>Information about a software application used for authentication and access.</dc:description>
		<skos:definition>Information about a software application used for authentication and access.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200010">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200010</dc:identifier>
		<rdfs:label>Assessment</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Assessment</skos:notation>
		<dc:description>An instrument used to evaluate a person typically having at-least one AssessmentForm, AssessmentSection, and AssessmentItem.</dc:description>
		<skos:definition>An instrument used to evaluate a person typically having at-least one AssessmentForm, AssessmentSection, and AssessmentItem.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200012">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200012</dc:identifier>
		<rdfs:label>Accessibility Feature</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AccessibilityFeature</skos:notation>
		<dc:description>Information defining the type of design elements or functionalities integrated into products, services, or environments to ensure equitable access for all individuals, aiming to eliminate barriers and facilitate ease of use.</dc:description>
		<skos:definition>Information defining the type of design elements or functionalities integrated into products, services, or environments to ensure equitable access for all individuals, aiming to eliminate barriers and facilitate ease of use.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Renamed from Assessment Accommodation to Accessibility Feature. Definition Updated.</changeDescription> 	
				<changeVersion>13</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200013">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200013</dc:identifier>
		<rdfs:label>Assessment Administration</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentAdministration</skos:notation>
		<dc:description>Information for an assessment event or administration period.</dc:description>
		<skos:definition>Information for an assessment event or administration period.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200015">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200015</dc:identifier>
		<rdfs:label>Assessment Asset</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentAsset</skos:notation>
		<dc:description>Information about content used to compose an Assessment Item, is referenced by an item but not part of the item content itself, or is content that is included as part of a section within an assessment form. Assets can be static content such as artwork or dynamic assets such as calculators or other tools.</dc:description>
		<skos:definition>Information about content used to compose an Assessment Item, is referenced by an item but not part of the item content itself, or is content that is included as part of a section within an assessment form. Assets can be static content such as artwork or dynamic assets such as calculators or other tools.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200017">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200017</dc:identifier>
		<rdfs:label>Assessment Form</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentForm</skos:notation>
		<dc:description>An instance of an a sessment that can equate scores with another instance of that same assessment.</dc:description>
		<skos:definition>An instance of an a sessment that can equate scores with another instance of that same assessment.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200019">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200019</dc:identifier>
		<rdfs:label>Assessment Form Assessment Form Section</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentFormAssessmentFormSection</skos:notation>
		<dc:description>Information linking sections within an assessment form to the form and the order in which the sections are designed to be offered.</dc:description>
		<skos:definition>Information linking sections within an assessment form to the form and the order in which the sections are designed to be offered.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200020">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200020</dc:identifier>
		<rdfs:label>Assessment Form Section</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentFormSection</skos:notation>
		<dc:description>Information about a grouping of assessment items intended to be delivered together.</dc:description>
		<skos:definition>Information about a grouping of assessment items intended to be delivered together.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200022">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200022</dc:identifier>
		<rdfs:label>Assessment Form Section Assessment Item</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentFormSectionAssessmentItem</skos:notation>
		<dc:description>Information linking assessment items to an assessment form section.</dc:description>
		<skos:definition>Information linking assessment items to an assessment form section.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200023">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200023</dc:identifier>
		<rdfs:label>Assessment Item</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentItem</skos:notation>
		<dc:description>A specific prompt that defines a question or protocol for a measurable activity that triggers a response from a person used to determine whether the person has mastered a learning objective.</dc:description>
		<skos:definition>A specific prompt that defines a question or protocol for a measurable activity that triggers a response from a person used to determine whether the person has mastered a learning objective.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200024">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200024</dc:identifier>
		<rdfs:label>Assessment Item Apip</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentItemApip</skos:notation>
		<dc:description>Accessible Portable Item Protocol information for an assessment item that may use the IMS Global APIP(R) standards.</dc:description>
		<skos:definition>Accessible Portable Item Protocol information for an assessment item that may use the IMS Global APIP(R) standards.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200025">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200025</dc:identifier>
		<rdfs:label>Assessment Item Apip Description</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentItemApipDescription</skos:notation>
		<dc:description>Accessible Portable Item Protocol description for an assessment item that may use the IMS Global APIP(R) standards.</dc:description>
		<skos:definition>Accessible Portable Item Protocol description for an assessment item that may use the IMS Global APIP(R) standards.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200026">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200026</dc:identifier>
		<rdfs:label>Assessment Item Characteristic</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentItemCharacteristic</skos:notation>
		<dc:description>The type and value for a psychometric measure.</dc:description>
		<skos:definition>The type and value for a psychometric measure.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200027">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200027</dc:identifier>
		<rdfs:label>Assessment Item Possible Response Detail</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000"/>
		<skos:notation>AssessmentItemPossibleResponseDetail</skos:notation>
		<dc:description>Information about one of the possible responses that a person may give in response to an assessment item prompt.</dc:description>
		<skos:definition>Information about one of the possible responses that a person may give in response to an assessment item prompt.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200028">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200028</dc:identifier>
		<rdfs:label>Assessment Item Response</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentItemResponse</skos:notation>
		<dc:description>AssessmentItemResponse includes information about a learner response and subsequent information about feedback and scoring of the response. Some properties like DescriptiveFeedback are for support of a formative assessment process. Some properties are used within intelligent tutoring systems such as HintCount and ScaffoldingItemFlag.</dc:description>
		<skos:definition>AssessmentItemResponse includes information about a learner response and subsequent information about feedback and scoring of the response. Some properties like DescriptiveFeedback are for support of a formative assessment process. Some properties are used within intelligent tutoring systems such as HintCount and ScaffoldingItemFlag.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200029">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200029</dc:identifier>
		<rdfs:label>Assessment Item Response Theory</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentItemResponseTheory</skos:notation>
		<dc:description>Information representing the difficulty of an assessment itme and other measures of the relationship between any individuals' performances on the test item and the test takers' levels of performance on an overall measure of the ability that item was designed to measure.</dc:description>
		<skos:definition>Information representing the difficulty of an assessment itme and other measures of the relationship between any individuals' performances on the test item and the test takers' levels of performance on an overall measure of the ability that item was designed to measure.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200030">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200030</dc:identifier>
		<rdfs:label>Assessment Item Rubric Criterion Result</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentItemRubricCriterionResult</skos:notation>
		<dc:description>Information about an assessment result or score derived using a rubic criterion.</dc:description>
		<skos:definition>Information about an assessment result or score derived using a rubic criterion.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200032">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200032</dc:identifier>
		<rdfs:label>Assessment Need Apip Content</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentNeedApipContent</skos:notation>
		<dc:description>Used as part of an Assessment Personal Needs Profile to define the content preferences and representation.</dc:description>
		<skos:definition>Used as part of an Assessment Personal Needs Profile to define the content preferences and representation.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200033">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200033</dc:identifier>
		<rdfs:label>Assessment Need Apip Control</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentNeedApipControl</skos:notation>
		<dc:description>Used as part of an Assessment Personal Needs Profile to define the control attributes.</dc:description>
		<skos:definition>Used as part of an Assessment Personal Needs Profile to define the control attributes.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200034">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200034</dc:identifier>
		<rdfs:label>Assessment Need Apip Display</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentNeedApipDisplay</skos:notation>
		<dc:description>Used as part of an Assessment Personal Needs Profile to define the display attributes.</dc:description>
		<skos:definition>Used as part of an Assessment Personal Needs Profile to define the display attributes.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200035">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200035</dc:identifier>
		<rdfs:label>Assessment Need Braille</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentNeedBraille</skos:notation>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the attributes for Braille display</dc:description>
		<skos:definition>Defines as part of an Assessment Personal Needs Profile the attributes for Braille display</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200036">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200036</dc:identifier>
		<rdfs:label>Assessment Need Screen Enhancement</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentNeedScreenEnhancement</skos:notation>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the attributes for screen enhancement.</dc:description>
		<skos:definition>Defines as part of an Assessment Personal Needs Profile the attributes for screen enhancement.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200037">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200037</dc:identifier>
		<rdfs:label>Assessment Participant Session</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentParticipantSession</skos:notation>
		<dc:description>Information about a specific person's participation in an Assessment Session.</dc:description>
		<skos:definition>Information about a specific person's participation in an Assessment Session.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200038">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200038</dc:identifier>
		<rdfs:label>Assessment Performance Level</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentPerformanceLevel</skos:notation>
		<dc:description>information about the performance levels that may be assigned to an Assessment Subtest Result and specifications for selecting the performance level based on a score. Four styles are supported: 1) specification of performance level by lower and upper cut score, 2) specification of performance level by lower cut score only, 3) specification of performance level without any mapping to scores, and 4) Specification of performance level by mapping to other scores.</dc:description>
		<skos:definition>information about the performance levels that may be assigned to an Assessment Subtest Result and specifications for selecting the performance level based on a score. Four styles are supported: 1) specification of performance level by lower and upper cut score, 2) specification of performance level by lower cut score only, 3) specification of performance level without any mapping to scores, and 4) Specification of performance level by mapping to other scores.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200039">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200039</dc:identifier>
		<rdfs:label>Assessment Personal Need Language Learner</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentPersonalNeedLanguageLearner</skos:notation>
		<dc:description>Information that indicates a person's need related as a language learner that may be used to deternine the need for an assessment accomodation.</dc:description>
		<skos:definition>Information that indicates a person's need related as a language learner that may be used to deternine the need for an assessment accomodation.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200040">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200040</dc:identifier>
		<rdfs:label>Assessment Personal Need Screen Reader</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentPersonalNeedScreenReader</skos:notation>
		<dc:description>Information that indicates a person's need that calls for use of a screen reader accomodation during assessment.</dc:description>
		<skos:definition>Information that indicates a person's need that calls for use of a screen reader accomodation during assessment.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200041">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200041</dc:identifier>
		<rdfs:label>Assessment Personal Needs Profile</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentPersonalNeedsProfile</skos:notation>
		<dc:description>An entity that includes information about the personal needs and preferences for assessment participants, based on the IMS Global (R) Accessible Portable Item Protocol (R)</dc:description>
		<skos:definition>An entity that includes information about the personal needs and preferences for assessment participants, based on the IMS Global (R) Accessible Portable Item Protocol (R)</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200042">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200042</dc:identifier>
		<rdfs:label>Assessment Personal Needs Profile Content</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentPersonalNeedsProfileContent</skos:notation>
		<dc:description>An entity that includes information about the personal needs and preferences related to content presented within an assessment delivery.</dc:description>
		<skos:definition>An entity that includes information about the personal needs and preferences related to content presented within an assessment delivery.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200043">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200043</dc:identifier>
		<rdfs:label>Assessment Personal Needs Profile Control</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentPersonalNeedsProfileControl</skos:notation>
		<dc:description>An entity that includes information about the personal needs and preferences related to control of presentation during delivery of assessments.</dc:description>
		<skos:definition>An entity that includes information about the personal needs and preferences related to control of presentation during delivery of assessments.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200044">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200044</dc:identifier>
		<rdfs:label>Assessment Personal Needs Profile Display</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentPersonalNeedsProfileDisplay</skos:notation>
		<dc:description>An entity that includes information about the personal needs and preferences related to displays of assessment content.</dc:description>
		<skos:definition>An entity that includes information about the personal needs and preferences related to displays of assessment content.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200045">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200045</dc:identifier>
		<rdfs:label>Assessment Personal Needs Profile Screen Enhancement</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentPersonalNeedsProfileScreenEnhancement</skos:notation>
		<dc:description>An entity that includes information about the personal needs and preferences related to screen enhancements during delivery of an assessment.</dc:description>
		<skos:definition>An entity that includes information about the personal needs and preferences related to screen enhancements during delivery of an assessment.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200046">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200046</dc:identifier>
		<rdfs:label>Assessment Registration</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentRegistration</skos:notation>
		<dc:description>Information related to a specific person registered for an Assessment Administration, assigned a specific Assessment Form for participation in one or more Assessment Sessions.</dc:description>
		<skos:definition>Information related to a specific person registered for an Assessment Administration, assigned a specific Assessment Form for participation in one or more Assessment Sessions.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200047">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200047</dc:identifier>
		<rdfs:label>Assessment Result</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentResult</skos:notation>
		<dc:description>An entity that includes information about a person's results from an assessment which may be for the entire assessment or one aspect of evaluation. The scoring method is defined by the related Assessment Subtest. The entity includes the score value and information about the score, such as a diagnostic statement.</dc:description>
		<skos:definition>An entity that includes information about a person's results from an assessment which may be for the entire assessment or one aspect of evaluation. The scoring method is defined by the related Assessment Subtest. The entity includes the score value and information about the score, such as a diagnostic statement.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200048">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200048</dc:identifier>
		<rdfs:label>Assessment Result Rubric Criterion Result</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentResultRubricCriterionResult</skos:notation>
		<dc:description>This join links an assessment result record to a result defined within a RubricCriterion.</dc:description>
		<skos:definition>This join links an assessment result record to a result defined within a RubricCriterion.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200049">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200049</dc:identifier>
		<rdfs:label>Assessment Session</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentSession</skos:notation>
		<dc:description>Information related to an instance of delivering an assessment during a specific period of time.</dc:description>
		<skos:definition>Information related to an instance of delivering an assessment during a specific period of time.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200050">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200050</dc:identifier>
		<rdfs:label>Assessment Session Staff Role</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentSessionStaffRole</skos:notation>
		<dc:description>Roles served related to the administration of an assessment session.</dc:description>
		<skos:definition>Roles served related to the administration of an assessment session.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200051">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200051</dc:identifier>
		<rdfs:label>Assessment Subtest</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentSubtest</skos:notation>
		<dc:description>Information for scoring an Assessment Form based on a set of Assessment Item responses with explicit rules to produce an Assessment Subtest Result, which may be for the entire Assessment Form or one aspect of evaluation based on a subset of Assessment Items.</dc:description>
		<skos:definition>Information for scoring an Assessment Form based on a set of Assessment Item responses with explicit rules to produce an Assessment Subtest Result, which may be for the entire Assessment Form or one aspect of evaluation based on a subset of Assessment Items.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200052">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200052</dc:identifier>
		<rdfs:label>Assessment Subtest Assessment Item</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AssessmentSubtestAssessmentItem</skos:notation>
		<dc:description>This join links an assessment subtest to an assessment item.</dc:description>
		<skos:definition>This join links an assessment subtest to an assessment item.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200054">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200054</dc:identifier>
		<rdfs:label>Authentication</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Authentication</skos:notation>
		<dc:description>An application or service that can authenticate the identity of a person. The CEDS entity that includes information about an authentication provider, the login identifier used to authenticate a person's identity, and other information related to authentication of a person's identity.</dc:description>
		<skos:definition>An application or service that can authenticate the identity of a person. The CEDS entity that includes information about an authentication provider, the login identifier used to authenticate a person's identity, and other information related to authentication of a person's identity.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200055">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200055</dc:identifier>
		<rdfs:label>Authorization</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Authorization</skos:notation>
		<dc:description>Information about a data system or application which an authenticated person may access.</dc:description>
		<skos:definition>Information about a data system or application which an authenticated person may access.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200056">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200056</dc:identifier>
		<rdfs:label>Authorization Document</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>AuthorizationDocument</skos:notation>
		<dc:description>Information about a document that authorizes a deision or plan such as a document authorizing an IEP.</dc:description>
		<skos:definition>Information about a document that authorizes a deision or plan such as a document authorizing an IEP.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200057">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200057</dc:identifier>
		<rdfs:label>Board Membership</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>BoardMembership</skos:notation>
		<dc:description>Information related to persons as board members within an organization.</dc:description>
		<skos:definition>Information related to persons as board members within an organization.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200058">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200058</dc:identifier>
		<rdfs:label>Building Space</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>BuildingSpace</skos:notation>
		<dc:description>Information describing and defining the uses of space within a building.</dc:description>
		<skos:definition>Information describing and defining the uses of space within a building.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200059">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200059</dc:identifier>
		<rdfs:label>Building Space Utilization</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>BuildingSpaceUtilization</skos:notation>
		<dc:description>Information about the capacity and assigned utilization of an area within a building including if the area is unassigned.</dc:description>
		<skos:definition>Information about the capacity and assigned utilization of an area within a building including if the area is unassigned.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200060">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200060</dc:identifier>
		<rdfs:label>Building System Category</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>BuildingSystemCategory</skos:notation>
		<dc:description>Type of building within a school such as a playground, gym, or classroom.</dc:description>
		<skos:definition>Type of building within a school such as a playground, gym, or classroom.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200061">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200061</dc:identifier>
		<rdfs:label>Building System Component</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>BuildingSystemComponent</skos:notation>
		<dc:description>Information about a component of a system within a facility including the installation date, lifecycle cost, description, and useful life.</dc:description>
		<skos:definition>Information about a component of a system within a facility including the installation date, lifecycle cost, description, and useful life.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200062">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200062</dc:identifier>
		<rdfs:label>Building System Component Service</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>BuildingSystemComponentService</skos:notation>
		<dc:description>Information that tracks the service record of a building system component.</dc:description>
		<skos:definition>Information that tracks the service record of a building system component.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200069">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200069</dc:identifier>
		<rdfs:label>Campus</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Campus</skos:notation>
		<dc:description>A location where the postsecondary institution provides services (admin, residential, education). May be virtual or physical. May be called by other terms (e.g., branch, location site regional campus).</dc:description>
		<skos:definition>A location where the postsecondary institution provides services (admin, residential, education). May be virtual or physical. May be called by other terms (e.g., branch, location site regional campus).</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200090">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200090</dc:identifier>
		<rdfs:label>Career And Technical Course</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CareerAndTechnicalCourse</skos:notation>
		<dc:description>The organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time (e.g., a semester or two-week workshop) to an individual or group of students (e.g., a class).</dc:description>
		<skos:definition>The organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time (e.g., a semester or two-week workshop) to an individual or group of students (e.g., a class).</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200091">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200091</dc:identifier>
		<rdfs:label>Career And Technical Student Academic Record</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CareerAndTechnicalStudentAcademicRecord</skos:notation>
		<dc:description>Summary academic record information for a career and technical education student.</dc:description>
		<skos:definition>Summary academic record information for a career and technical education student.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200021">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200021</dc:identifier>
		<rdfs:label>Charter School Authorizing Organization</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>CharterSchoolAuthorizingOrganization</skos:notation>
		<dc:description>An organization responsible for authorizing charter schools.</dc:description>
		<skos:definition>An organization responsible for authorizing charter schools.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200379">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200379</dc:identifier>
		<rdfs:label>Charter School Management Organization</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>CharterSchoolManagementOrganization</skos:notation>
		<dc:description>A separate legal entity that 1) contracts with one or more charter schools to manage, operate, and oversee the charter schools; or 2) holds a charter, or charters, to operate multiple charter schools. (see Charter School Management Organization Type)</dc:description>
		<skos:definition>A separate legal entity that 1) contracts with one or more charter schools to manage, operate, and oversee the charter schools; or 2) holds a charter, or charters, to operate multiple charter schools. (see Charter School Management Organization Type)</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200063">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200063</dc:identifier>
		<rdfs:label>Classroom</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Classroom</skos:notation>
		<dc:description>A room where educational services are provided by a school, school system, state, or other agency or entity.</dc:description>
		<skos:definition>A room where educational services are provided by a school, school system, state, or other agency or entity.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200065">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200065</dc:identifier>
		<rdfs:label>Competency Definition</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CompetencyDefinition</skos:notation>
		<dc:description>A resource that states a capability or behavior that a person may learn or be able to do within a given context with references to potential levels of competence, a mastery threshold, and other contextualizing metadata.</dc:description>
		<skos:definition>A resource that states a capability or behavior that a person may learn or be able to do within a given context with references to potential levels of competence, a mastery threshold, and other contextualizing metadata.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200064">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200064</dc:identifier>
		<rdfs:label>Competency Definition Association</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CompetencyDefinitionAssociation</skos:notation>
		<dc:description>The relation of competency definitions to other competency definitions and/or competency frameworks to competency frameworks to support competency maps or competency sub frameworks or linked controlled vocabulary terms as metadata to further define a competency definition. (In CEDS IDS CompetencyDefAssociation also provides a mechanism to link any other object in the model to a CompetencyDefinition, e.g. to RubricCriterion, LearningResource, Course, or AssessmentItem.)</dc:description>
		<skos:definition>The relation of competency definitions to other competency definitions and/or competency frameworks to competency frameworks to support competency maps or competency sub frameworks or linked controlled vocabulary terms as metadata to further define a competency definition. (In CEDS IDS CompetencyDefAssociation also provides a mechanism to link any other object in the model to a CompetencyDefinition, e.g. to RubricCriterion, LearningResource, Course, or AssessmentItem.)</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200067">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200067</dc:identifier>
		<rdfs:label>Competency Framework</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CompetencyFramework</skos:notation>
		<dc:description>A resource that identifies a collection of logically related CompetencyDefinitions, CompetencyDefAssociations, and contextualizing metadata.</dc:description>
		<skos:definition>A resource that identifies a collection of logically related CompetencyDefinitions, CompetencyDefAssociations, and contextualizing metadata.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200068">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200068</dc:identifier>
		<rdfs:label>Competency Set</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CompetencySet</skos:notation>
		<dc:description>CompetencySet supports defining criteria for award or recognition of a credential or micro-credential based on a person's attainment of one or more CompetencyFrameworkItem(s). The set may have a completion criteria specifying if all or some of the items are required. If only some are required then Completion Criteria Threshold is used to specify how many. Competency Set may also include other Competency Sets so it is possible to make a rule such as "the person must complete these three required competency items and 2 out of 3 of these items specified in this sub set."</dc:description>
		<skos:definition>CompetencySet supports defining criteria for award or recognition of a credential or micro-credential based on a person's attainment of one or more CompetencyFrameworkItem(s). The set may have a completion criteria specifying if all or some of the items are required. If only some are required then Completion Criteria Threshold is used to specify how many. Competency Set may also include other Competency Sets so it is possible to make a rule such as "the person must complete these three required competency items and 2 out of 3 of these items specified in this sub set."</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200071">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200071</dc:identifier>
		<rdfs:label>Core Knowledge Area</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CoreKnowledgeArea</skos:notation>
		<dc:description>The core knowledge areas addressed by a professional development activity most commonly used in the early learning domain.</dc:description>
		<skos:definition>The core knowledge areas addressed by a professional development activity most commonly used in the early learning domain.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200072">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200072</dc:identifier>
		<rdfs:label>Course</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Course</skos:notation>
		<dc:description>The organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time.</dc:description>
		<skos:definition>The organization of subject matter and related learning experiences provided for the instruction of students on a regular or systematic basis, usually for a predetermined period of time.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200073">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200073</dc:identifier>
		<rdfs:label>Course Funding Source</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CourseFundingSource</skos:notation>
		<dc:description>The relationship between course and the financial account that would be used to fund the course.</dc:description>
		<skos:definition>The relationship between course and the financial account that would be used to fund the course.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200074">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200074</dc:identifier>
		<rdfs:label>Course Section</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<skos:notation>CourseSection</skos:notation>
		<dc:description>CourseSection represents an instance of a course offered/delivered in a specific timeframe and/or place or through specific media or mode of study or to a specific section of students. (In the CEDS IDS, CourseSection is a subclass of organization that can be linked to persons and roles using Membership. Subclasses include K12 Course, PsCourse, CteCoure, AeCourse)</dc:description>
		<skos:definition>CourseSection represents an instance of a course offered/delivered in a specific timeframe and/or place or through specific media or mode of study or to a specific section of students. (In the CEDS IDS, CourseSection is a subclass of organization that can be linked to persons and roles using Membership. Subclasses include K12 Course, PsCourse, CteCoure, AeCourse)</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200075">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200075</dc:identifier>
		<rdfs:label>Course Section Assessment Reporting</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CourseSectionAssessmentReporting</skos:notation>
		<dc:description>The method(s) that the instructor of the course uses to report the performance and achievement of all students. It may be a qualitative method such as individualized teacher comments or a quantitative method such as a letter or a numerical grade.</dc:description>
		<skos:definition>The method(s) that the instructor of the course uses to report the performance and achievement of all students. It may be a qualitative method such as individualized teacher comments or a quantitative method such as a letter or a numerical grade.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200076">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200076</dc:identifier>
		<rdfs:label>Course Section Level</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CourseSectionLevel</skos:notation>
		<dc:description>Information about an education level associated with a Course Section.</dc:description>
		<skos:definition>Information about an education level associated with a Course Section.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200077">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200077</dc:identifier>
		<rdfs:label>Course Section Location</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CourseSectionLocation</skos:notation>
		<dc:description>The location where a Course Section meets.</dc:description>
		<skos:definition>The location where a Course Section meets.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200078">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200078</dc:identifier>
		<rdfs:label>Course Section Schedule</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CourseSectionSchedule</skos:notation>
		<dc:description>CourseSectionSchedule contains the times and days that a class is scheduled to meet on a weekly basis.</dc:description>
		<skos:definition>CourseSectionSchedule contains the times and days that a class is scheduled to meet on a weekly basis.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200079">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200079</dc:identifier>
		<rdfs:label>Credential Award</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CredentialAward</skos:notation>
		<dc:description>Information about the award of a credential to a person or organization.</dc:description>
		<skos:definition>Information about the award of a credential to a person or organization.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Has Credential Award Status Type, Credential Award Status Date, Credential Award Identifier, and Has Credential Award Identification System properties were added to this class.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1033</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
				<changePropertyAddedToClass rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changePropertyAddedToClass>
			</editHistoryEntry>
		</editHistory>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200080">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200080</dc:identifier>
		<rdfs:label>Credential Award Credit</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CredentialAwardCredit</skos:notation>
		<dc:description>Credential AwardCredit may be used to record a specific course instance(CousreSection) that a Person completed to qualify for a CredentialAward using MembershipId and/or it could use CredentialCriteriaCourseId to reference the course completed.</dc:description>
		<skos:definition>Credential AwardCredit may be used to record a specific course instance(CousreSection) that a Person completed to qualify for a CredentialAward using MembershipId and/or it could use CredentialCriteriaCourseId to reference the course completed.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200081">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200081</dc:identifier>
		<rdfs:label>Credential Award Evidence</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>CredentialAwardEvidence</skos:notation>
		<dc:description>CredentialAwardEvidence includes a statement or reference describing the evidence that the learner met the criteria for attainment of the achievement and may be related to an AssessmentResult.</dc:description>
		<skos:definition>CredentialAwardEvidence includes a statement or reference describing the evidence that the learner met the criteria for attainment of the achievement and may be related to an AssessmentResult.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200082">
