		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Transportation Public Expense Eligibility Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>The type of eligibility for transporting a person at public expense.</skos:definition>
		<skos:notation>TransportationPublicExpenseEligibilityType</skos:notation>
		<skos:prefLabel>Transportation Public Expense Eligibility Type</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C002019">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The transportation status of the person.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C002019</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Transportation Status Type</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
