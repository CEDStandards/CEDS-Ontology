		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000621</dc:identifier>
		<rdfs:label>Has Employment Separation Type</rdfs:label>
