		<skos:notation>hasImmunizationRecordFlag</skos:notation>
		<dc:description>Indicates whether the school or MEP program has immunization records on file for the student.</dc:description>
		<skos:definition>Indicates whether the school or MEP program has immunization records on file for the student.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000563">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000563</dc:identifier>
		<rdfs:label>Has Migrant Education Program Continuation of Services Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000563" />
