		<rdfs:label>Location Address</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>LocationAddress</skos:notation>
		<dc:description>Location that contains a address, city, state, zip.</dc:description>
		<skos:definition>Location that contains a address, city, state, zip.</skos:definition>
