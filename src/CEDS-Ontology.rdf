		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600282</dc:identifier>
		<rdfs:label>Has Competency Definition</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200176" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200065" />
		<skos:notation>hasCompetencyDefinition</skos:notation>
		<dc:description>References a resource that states a capability or behavior that a person may learn or be able to do within a given context with references to potential levels of competence, a mastery threshold, and other contextualizing metadata.</dc:description>
		<skos:definition>References a resource that states a capability or behavior that a person may learn or be able to do within a given context with references to potential levels of competence, a mastery threshold, and other contextualizing metadata.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
