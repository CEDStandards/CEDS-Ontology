		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<skos:notation>02516</skos:notation>
		<skos:prefLabel>Elevator</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001802128792">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Escalator is specified as a mechanical means for moving people and equipment within buildings.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001802128792</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Escalator</rdfs:label>
		<skos:definition>Escalator is specified as a mechanical means for moving people and equipment within buildings.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<skos:notation>02517</skos:notation>
		<skos:prefLabel>Escalator</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001802128793">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Lift is specified as a mechanical means for moving people and equipment within buildings.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001802128793</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Lift</rdfs:label>
		<skos:definition>Lift is specified as a mechanical means for moving people and equipment within buildings.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001802" />
		<skos:notation>13593</skos:notation>
		<skos:prefLabel>Lift</skos:prefLabel>
