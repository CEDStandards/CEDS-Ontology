		<rdfs:label>Assistive technology services</rdfs:label>
		<skos:definition>Assistive technology services is the type of service that adapts the curriculum, materials, or instruction for students identified as needing special education because of a delay or disability.
		</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001383"/>
		<skos:notation>01</skos:notation>
