		<rdfs:label>Does not show functioning expected at age - does not include immediate foundational skills</rdfs:label>
		<skos:definition>Child does not yet show functioning expected of a child his or her age in any situation. Child's functioning does not yet include immediate foundational skills upon which to build age-appropriate functioning. Child functioning reflects skills that developmentally come before immediate foundational skills.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001507" />
		<skos:notation>01</skos:notation>
		<skos:prefLabel>Does not show functioning expected at age - does not include immediate foundational skills</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001507105748">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child occasionally uses immediate foundational skills across settings and situations. More functioning reflects skills that are not immediate foundational than are immediate foundational.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001507105748</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001507" />
