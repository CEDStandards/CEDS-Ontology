	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200257">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200257</dc:identifier>
		<rdfs:label>Membership</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Membership</skos:notation>
		<dc:description>The relationship between a person and an organization, expressed as a role held over a defined period of time.</dc:description>
		<skos:definition>The relationship between a person and an organization, expressed as a role held over a defined period of time.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200402">
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600559"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000097"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600560"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000107"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200402</dc:identifier>
		<rdfs:label>Enrollment</rdfs:label>
		<skos:notation>Enrollment</skos:notation>
		<dc:description>A specific type of Membership that represents a student's association with an educational organization, characterized by properties related to their enrollment status, participation, and educational engagement over a defined period of time.</dc:description>
		<skos:definition>A specific type of Membership that represents a student's association with an educational organization, characterized by properties related to their enrollment status, participation, and educational engagement over a defined period of time.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200403">
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600559"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000007"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600560"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000008"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200403</dc:identifier>
		<rdfs:label>Activity Membership</rdfs:label>
		<skos:notation>ActivityMembership</skos:notation>
		<dc:description>A specific type of Membership that represents a person's association with an organized activity within an educational organization, characterized by properties related to their participation, involvement, and engagement over a defined period of time.</dc:description>
		<skos:definition>A specific type of Membership that represents a person's association with an organized activity within an educational organization, characterized by properties related to their participation, involvement, and engagement over a defined period of time.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200404">
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600559"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000326"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600560"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000327"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200404</dc:identifier>
		<rdfs:label>Service Membership</rdfs:label>
		<skos:notation>ServiceMembership</skos:notation>
		<dc:description>A specific type of Membership that represents a student's association with a service provided by an organization, characterized by properties related to their access, participation, and engagement with the service over a defined period of time.</dc:description>
		<skos:definition>A specific type of Membership that represents a student's association with a service provided by an organization, characterized by properties related to their access, participation, and engagement with the service over a defined period of time.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200405">
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600559"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000346"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600560"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000795"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200405</dc:identifier>
		<rdfs:label>Employment</rdfs:label>
		<skos:notation>Employment</skos:notation>
		<dc:description>A specific type of Membership that represents a staff person's association with an organization, characterized by properties related to their employment over a defined period of time. This includes linking a person in the role of a staff person with the organization, capturing elements such as the start and end dates of the employment period, the specific role or position held, job responsibilities, employment status, and associated benefits.</dc:description>
		<skos:definition>A specific type of Membership that represents a staff person's association with an organization, characterized by properties related to their employment over a defined period of time. This includes linking a person in the role of a staff person with the organization, capturing elements such as the start and end dates of the employment period, the specific role or position held, job responsibilities, employment status, and associated benefits.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200406">
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600559"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000526"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600560"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000527"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200406</dc:identifier>
		<rdfs:label>Assignment</rdfs:label>
		<skos:notation>Assignment</skos:notation>
		<dc:description>A specific type of Membership that represents a staff person's assignment within an educational institution, characterized by properties related to their specific duties and responsibilities. This includes linking a staff person to particular assignments such as course sections, administrative roles, or other institutional tasks over a defined period of time. The concept captures elements such as the start and end dates of the assignment, the specific role or position held, and the nature of the duties performed.</dc:description>
		<skos:definition>A specific type of Membership that represents a staff person's assignment within an educational institution, characterized by properties related to their specific duties and responsibilities. This includes linking a staff person to particular assignments such as course sections, administrative roles, or other institutional tasks over a defined period of time. The concept captures elements such as the start and end dates of the assignment, the specific role or position held, and the nature of the duties performed.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200407">
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600559"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000590"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf> 
			<owl:Restriction>
				<owl:onProperty rdf:resource="https://w3id.org/CEDStandards/terms/P600560"/>
				<owl:allValuesFrom rdf:resource="https://w3id.org/CEDStandards/terms/P000591"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200407</dc:identifier>
		<rdfs:label>Program Participation</rdfs:label>
		<skos:notation>ProgramParticipation</skos:notation>
		<dc:description>A specific type of Membership that represents a student's involvement in a program offered by an educational institution. This includes linking a student to particular programs such as Title I, Title III, and other similar initiatives, capturing elements such as the start and end dates of the involvement, the specific program details, and the nature of the services or support provided. The concept encompasses various aspects of the student's participation, such as eligibility criteria, progress, and outcomes related to the program.</dc:description>
		<skos:definition>A specific type of Membership that represents a student's involvement in a program offered by an educational institution. This includes linking a student to particular programs such as Title I, Title III, and other similar initiatives, capturing elements such as the start and end dates of the involvement, the specific program details, and the nature of the services or support provided. The concept encompasses various aspects of the student's participation, such as eligibility criteria, progress, and outcomes related to the program.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Has English Learner Exited Status and Has Individualized Program properties were added to this class.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/958</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
				<changePropertyAddedToClass rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changePropertyAddedToClass>
			</editHistoryEntry>
		</editHistory>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200408">
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
