		<skos:notation>StaffEvaluationScoreOrRating</skos:notation>
		<dc:description>The actual quantitative or qualitative assessment of a person's overall performance.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
