	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164049">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Appliance Repair courses provide students with the knowledge and experience to repair, install, service, and inspect appliances such as stoves, refrigerators, washers, dryers, air conditioners, water heaters, and so on. Students gain an understanding of the mechanics and working systems of these appliances, the skills to read blueprints and specifications, and proficiency in using related tools and products.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164049</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Appliance Repair</rdfs:label>
		<skos:definition>Appliance Repair courses provide students with the knowledge and experience to repair, install, service, and inspect appliances such as stoves, refrigerators, washers, dryers, air conditioners, water heaters, and so on. Students gain an understanding of the mechanics and working systems of these appliances, the skills to read blueprints and specifications, and proficiency in using related tools and products.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>13301</skos:notation>
		<skos:prefLabel>Appliance Repair</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164050">
