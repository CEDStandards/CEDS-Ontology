		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>FacilitiesPlanDescription</skos:notation>
		<dc:description>A description of the management and accountability plan.</dc:description>
		<maxLength>80</maxLength>
		<textFormat>Alphanumeric</textFormat>
