		<dc:description>An indication that migrant children are receiving instructional or support services under the continuation of services authority ESEA Title III Section 1304(e)(2)-(3).</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added Migrant Education Program to name.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that migrant children are receiving instructional or support services under the continuation of services authority ESEA Title III Section 1304(e)(2)-(3).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000562">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000562</dc:identifier>
		<rdfs:label>Has Migrant Prioritized for Services</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200320" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000562" />
		<skos:notation>hasMigrantPrioritizedForServices</skos:notation>
		<dc:description>An indication that a migratory child 1) is failing to meet, or most at risk of failing to meet, the state's challenging academic content standards and student academic achievement standards; and 2) has experienced interruptions in their education during the regular school year.</dc:description>
		<skos:definition>An indication that a migratory child 1) is failing to meet, or most at risk of failing to meet, the state's challenging academic content standards and student academic achievement standards; and 2) has experienced interruptions in their education during the regular school year.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000635">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000635</dc:identifier>
		<rdfs:label>Has Neglected or Delinquent Academic Achievement Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200321" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000635" />
		<skos:notation>hasNeglectedOrDelinquentAcademicAchievementIndicator</skos:notation>
		<dc:description>Student was served by Title I, Part D, Subpart 1 of ESEA as amended for at least 90 consecutive days during the reporting period who took both a pre- and post-test.</dc:description>
		<rdfs:comment>The elements "Neglected or Delinquent Academic Achievement Indicator" and "Neglected or Delinquent Academic Outcome Indicator" are different, although similarly worded.&lt;BR/&gt;&#13;
	EDFacts guidance: The Neglected or Delinquent Academic Achievement indicator should only be used for Subpart 1; the Neglected or Delinquent Academic Outcome Indicator should be used for Subpart 2.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Corrected duplicate words in usage note.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Student was served by Title I, Part D, Subpart 1 of ESEA as amended for at least 90 consecutive days during the reporting period who took both a pre- and post-test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000636">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000636</dc:identifier>
		<rdfs:label>Has Neglected or Delinquent Academic Outcome Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200321" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000636" />
		<skos:notation>hasNeglectedOrDelinquentAcademicOutcomeIndicator</skos:notation>
		<dc:description>Student was served by Title I, Part D, Subpart 2 of ESEA as amended for at least 90 consecutive days during the reporting period who took both a pre- and post-test.</dc:description>
		<rdfs:comment>The elements "Neglected or Delinquent Academic Achievement Indicator" and "Neglected or Delinquent Academic Outcome Indicator" are different, although similarly worded.&lt;BR/&gt;&#13;
	EDFacts guidance: The Neglected or Delinquent Academic Achievement indicator should only be used for Subpart 1; the Neglected or Delinquent Academic Outcome Indicator should be used for Subpart 2.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Corrected duplicate words in usage note.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Student was served by Title I, Part D, Subpart 2 of ESEA as amended for at least 90 consecutive days during the reporting period who took both a pre- and post-test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000484">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000484</dc:identifier>
		<rdfs:label>Has Neglected or Delinquent Obtained Employment</rdfs:label>
