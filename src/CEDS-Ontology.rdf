	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164444">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Standardized Test Preparation courses help prepare students for national standardized tests such as the PSAT, SAT, and ACT. In particular, these courses assist students in developing and/or expanding their vocabulary, test-taking, and reasoning skills through study, lecture, and practice drills. Course topics may include vocabulary review; root words, prefixes, and suffixes; mathematical concepts, logic, and rules; and general problem-solving and test-taking strategies.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164444</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Standardized Test Preparation</rdfs:label>
		<skos:definition>Standardized Test Preparation courses help prepare students for national standardized tests such as the PSAT, SAT, and ACT. In particular, these courses assist students in developing and/or expanding their vocabulary, test-taking, and reasoning skills through study, lecture, and practice drills. Course topics may include vocabulary review; root words, prefixes, and suffixes; mathematical concepts, logic, and rules; and general problem-solving and test-taking strategies.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>22001</skos:notation>
		<skos:prefLabel>Standardized Test Preparation</skos:prefLabel>
	</owl:NamedIndividual>
