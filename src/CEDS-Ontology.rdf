		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>LearningResourceDateModified</skos:notation>
		<dc:description>The most recent date that the learning resource was updated.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The most recent date that the learning resource was updated.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001566">
