		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200258" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>ApplicationDate</skos:notation>
