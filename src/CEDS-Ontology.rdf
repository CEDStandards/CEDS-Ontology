			<editHistoryEntry> 	
				<changeDescription>Added new element to DES to support reporting requirements</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001986">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001986</dc:identifier>
		<rdfs:label>Staff Evaluation Part Score or Rating</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200367" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>StaffEvaluationPartScoreOrRating</skos:notation>
		<dc:description>The actual quantitative or qualitative assessment of a person's performance on a component part that is being evaluated.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The actual quantitative or qualitative assessment of a person's performance on a component part that is being evaluated.</skos:definition>
