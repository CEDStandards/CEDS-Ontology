		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000440" />
		<skos:notation>hasMigrantEducationProgramProjectBased</skos:notation>
		<dc:description>Indicates the type of MEP project based on the location where the MEP services are held.</dc:description>
		<skos:definition>Indicates the type of MEP project based on the location where the MEP services are held.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000463">
