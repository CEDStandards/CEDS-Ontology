	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000569">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indication that a student is identified as a truant as defined by state rules.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000569</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
