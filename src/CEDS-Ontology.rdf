		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New</changeDescription>
				<changeVersion>13</changeVersion>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002150">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002150</dc:identifier>
		<rdfs:label>Break Duration</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200012" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<skos:notation>BreakDuration</skos:notation>
		<dc:description>The duration of the pause, recorded in minutes, allowing the individual to temporarily suspend activities.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
