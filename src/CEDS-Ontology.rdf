	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001517">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The five-digit SCED code. The first two-digits of the code represent the Course Subject Area and the next three digits identify the course number. These identifiers are fairly general but provide enough specificity to identify the course's topic and to distinguish it from other courses in that subject area.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001517</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
