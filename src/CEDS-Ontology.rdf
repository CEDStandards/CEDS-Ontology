	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164166">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Exploration of Lodging Careers courses provide an overview of the lodging industry. Topics covered include lodging terminology, the history of lodging, introduction to marketing, and the various careers available in the lodging industry.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164166</dc:identifier>
