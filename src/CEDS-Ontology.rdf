		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New</changeDescription>
				<changeVersion>13</changeVersion>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002126">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002126</dc:identifier>
		<rdfs:label>Early Learning Outcome Measurement Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
