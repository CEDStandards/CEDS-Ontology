	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000827">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000827</dc:identifier>
		<rdfs:label>Has Organization Identification System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200252" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000827" />
		<skos:notation>hasOrganizationIdentificationSystem</skos:notation>
		<dc:description>A coding scheme that is used for identification and record-keeping purposes by schools, social services, or other agencies to refer to an organization.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added option for SAM to support transition from DUNS to UEI</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL&amp; IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>The "Credential Offered" entity requires at minimum the OrganizationId, Credential(Definition)Id, a "Start Date" and "End Date". Existing start and end date elements in CEDS are contextualized. &#13;
&#13;
Added "Licence Number" option. &#13;
&#13;
Added DES context "Program Identifier, Organization Identifier, Organization Identifier System" to K12 &gt; LEA &gt; Programs and Services.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A coding scheme that is used for identification and record-keeping purposes by schools, social services, or other agencies to refer to an organization.</skos:definition>
	</rdf:Property>
