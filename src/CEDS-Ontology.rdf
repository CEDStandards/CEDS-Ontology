		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200230" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:notation>LearningResourceIdentifier</skos:notation>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001750">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001750</dc:identifier>
		<dc:description>A unique number or alphanumeric code assigned to a learning resource by an organization.</dc:description>
