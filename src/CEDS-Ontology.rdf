	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163798">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Drivers' Education�Classroom Only courses provide students with the knowledge to become safe drivers on America's roadways. Topics in these courses include legal obligations and responsibility, rules of the road and traffic procedures, safe driving strategies and practices, and the physical and mental factors affecting the driver's capability (including alcohol and other drugs).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517163798</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdfs:label>Drivers' Education�Classroom Only</rdfs:label>
		<skos:definition>Drivers' Education�Classroom Only courses provide students with the knowledge to become safe drivers on America's roadways. Topics in these courses include legal obligations and responsibility, rules of the road and traffic procedures, safe driving strategies and practices, and the physical and mental factors affecting the driver's capability (including alcohol and other drugs).</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517"/>
		<skos:notation>08151</skos:notation>
		<skos:prefLabel>Drivers' Education�Classroom Only</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163799">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Drivers' Education�Classroom and Laboratory courses provide students with the knowledge and experience to become safe drivers on America's roadways. Topics in these courses cover legal obligations and responsibility, rules of the road and traffic procedures, safe driving strategies and practices, and the physical and mental factors affecting the driver's capability (including alcohol and other drugs). Experience in driving a vehicle is an essential component of these courses.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517163799</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517"/>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<rdfs:label>Drivers' Education�Classroom and Laboratory</rdfs:label>
		<skos:definition>Drivers' Education�Classroom and Laboratory courses provide students with the knowledge and experience to become safe drivers on America's roadways. Topics in these courses cover legal obligations and responsibility, rules of the road and traffic procedures, safe driving strategies and practices, and the physical and mental factors affecting the driver's capability (including alcohol and other drugs). Experience in driving a vehicle is an essential component of these courses.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517"/>
		<skos:notation>08152</skos:notation>
		<skos:prefLabel>Drivers' Education�Classroom and Laboratory</skos:prefLabel>
	</owl:NamedIndividual>
