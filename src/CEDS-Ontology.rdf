	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001389">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001389</dc:identifier>
		<rdfs:label>Has Learning Resource Access API Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001389" />
		<skos:notation>hasLearningResourceAccessAPIType</skos:notation>
		<dc:description>Indicates that the learning resource is compatible with the referenced accessibility application programming interface (API).</dc:description>
		<rdfs:comment> Options derive primarily from IMS Global's Access for All (AfA) specification, specifically:  apiInteroperable.</rdfs:comment>
		<skos:definition>Indicates that the learning resource is compatible with the referenced accessibility application programming interface (API).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001390">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001390</dc:identifier>
		<rdfs:label>Has Learning Resource Access Hazard Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001390" />
		<skos:notation>hasLearningResourceAccessHazardType</skos:notation>
		<dc:description>A characteristic of the described learning resource that is physiologically dangerous to some users.</dc:description>
		<skos:definition>A characteristic of the described learning resource that is physiologically dangerous to some users.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001391">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001391</dc:identifier>
		<rdfs:label>Has Learning Resource Access Mode Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001391" />
		<skos:notation>hasLearningResourceAccessModeType</skos:notation>
		<dc:description>An access mode through which the intellectual content of a described learning resource or adaptation is communicated; if adaptations for the resource are known, the access modes of those adaptations are not included.</dc:description>
		<rdfs:comment>Options derive primarily from IMS Global's Access for All (AfA) specification, specifically: AccessModeRequired.Type/existingAccessMode.</rdfs:comment>
		<skos:definition>An access mode through which the intellectual content of a described learning resource or adaptation is communicated; if adaptations for the resource are known, the access modes of those adaptations are not included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001561">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001561</dc:identifier>
		<rdfs:label>Has Learning Resource Access Rights URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001561" />
		<skos:notation>hasLearningResourceAccessRightsURL</skos:notation>
		<dc:description>A Uniform Resource Locator (URL) that identifies the conditions that govern the user's ability to access a learning resource.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>update element names to consistently use "URL"</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A Uniform Resource Locator (URL) that identifies the conditions that govern the user's ability to access a learning resource.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001562">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001562</dc:identifier>
		<rdfs:label>Has Learning Resource Author Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001562" />
		<skos:notation>hasLearningResourceAuthorType</skos:notation>
		<dc:description>The type of entity, organization or person, that authored the learning resource.</dc:description>
		<skos:definition>The type of entity, organization or person, that authored the learning resource.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001394">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001394</dc:identifier>
		<rdfs:label>Has Learning Resource Book Format Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001394" />
		<skos:notation>hasLearningResourceBookFormatType</skos:notation>
		<dc:description>Specifies the format for a learning resource that is a book.  Other options may be considered for inclusion in the option set.</dc:description>
		<skos:definition>Specifies the format for a learning resource that is a book. Other options may be considered for inclusion in the option set.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000879">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000879</dc:identifier>
		<rdfs:label>Has Learning Resource Competency Alignment Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200064" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000879" />
		<skos:notation>hasLearningResourceCompetencyAlignmentType</skos:notation>
		<dc:description>The alignment relationship between the resource and a competency definition object.</dc:description>
		<rdfs:comment>A community of SEAs have agreed to use a limited set of Learning Resource Competency Alignment Type options when tagging learning resources in shared resource repositories. Those options are assesses, teaches, and requires.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>From LRMI</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added usage note.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed wording to "competency definition" instead of "competency" to avoid ambiguity.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The alignment relationship between the resource and a competency definition object.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001395">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001395</dc:identifier>
		<rdfs:label>Has Learning Resource Control Flexibility Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001395" />
		<skos:notation>hasLearningResourceControlFlexibilityType</skos:notation>
		<dc:description>Identifies a single input method that is sufficient to control the described learning resource.</dc:description>
		<skos:definition>Identifies a single input method that is sufficient to control the described learning resource.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001396">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001396</dc:identifier>
		<rdfs:label>Has Learning Resource Digital Media Sub Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="dc:format" />
		<skos:notation>hasLearningResourceDigitalMediaSubType</skos:notation>
		<dc:description>The media or file subtype of the digital resource being based on the Media Types and Subtypes, formerly known as MIME types, defined by the Internet Assigned Numbers Authority (IANA).</dc:description>
		<skos:definition>The media or file subtype of the digital resource being based on the Media Types and Subtypes, formerly known as MIME types, defined by the Internet Assigned Numbers Authority (IANA).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001397">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001397</dc:identifier>
		<rdfs:label>Has Learning Resource Digital Media Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001397" />
		<skos:notation>hasLearningResourceDigitalMediaType</skos:notation>
		<dc:description>The media or file type of the digital resource being based on the media types defined by the Internet Assigned Numbers Authority (AINA) at http://www.iana.org/assignments/media-types.</dc:description>
		<skos:definition>The media or file type of the digital resource being based on the media types defined by the Internet Assigned Numbers Authority (AINA) at http://www.iana.org/assignments/media-types.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001002">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001002</dc:identifier>
		<rdfs:label>Has Learning Resource Educational Use</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001002" />
		<skos:notation>hasLearningResourceEducationalUse</skos:notation>
