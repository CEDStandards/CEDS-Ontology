	<!-- CEDS Properties -->
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600559">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600559</dc:identifier>
		<rdfs:label>Membership Entry Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<skos:notation>MembershipEntryDate</skos:notation>
		<dc:description>The date associated with the commencement/entry/start of a role for a person at an organization.</dc:description>
		<skos:definition>The date associated with the commencement/entry/start of a role for a person at an organization.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600560">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600560</dc:identifier>
		<rdfs:label>Membership Exit Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200257"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<skos:notation>MembershipExitDate</skos:notation>
		<dc:description>The date associated with the termination/exit/end of a role for a person at an organization.</dc:description>
		<skos:definition>The date associated with the termination/exit/end of a role for a person at an organization.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001572">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001572</dc:identifier>
		<rdfs:label>Person Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200291" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#token" />
		<skos:notation>PersonIdentifier</skos:notation>
		<dc:description>A unique number or alphanumeric code assigned to a person by a school, school system, a state, or other agency or entity.</dc:description>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique number or alphanumeric code assigned to a person by a school, school system, a state, or other agency or entity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001571">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001571</dc:identifier>
		<rdfs:label>Has Person Identification System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200291" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001571" />
		<skos:notation>hasPersonIdentificationSystem</skos:notation>
		<dc:description>A coding scheme that is used for identification of a person.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Added new option to existing option set</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A coding scheme that is used for identification of a person.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002114">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002114</dc:identifier>
		<rdfs:label>Has Person Identifier Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200291" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002114" />
		<skos:notation>hasPersonIdentifierType</skos:notation>
		<dc:description>A coding scheme of identifiers assigned to an individual, distinguishing between various roles and contexts within an educational or organizational setting. It ensures accurate identification and classification of individuals based on their specific type of identifier.</dc:description>
		<skos:definition>A coding scheme of identifiers assigned to an individual, distinguishing between various roles and contexts within an educational or organizational setting. It ensures accurate identification and classification of individuals based on their specific type of identifier.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000826">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000826</dc:identifier>
		<rdfs:label>Organization Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200252" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#token" />
		<skos:notation>OrganizationIdentifier</skos:notation>
		<dc:description>A unique number or alphanumeric code assigned to an organization by a school, school system, a state, or other agency or entity.</dc:description>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique number or alphanumeric code assigned to an organization by a school, school system, a state, or other agency or entity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001530">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001530</dc:identifier>
		<rdfs:label>Activity Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200001" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ActivityDescription</skos:notation>
		<dc:description>A description of the events and procedures that take place under the purview of an organized activity, such as a co-curricular or extra-curricular activity that is offered at an education institution.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the events and procedures that take place under the purview of an organized activity, such as a co-curricular or extra-curricular activity that is offered at an education institution.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000788">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000788</dc:identifier>
		<rdfs:label>Years of Prior Adult Education Teaching Experience</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200005" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200368" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>YearsofPriorAETeachingExperience</skos:notation>
		<dc:description>The total number of years that a person has previously held a teaching position in one or more adult education programs.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The total number of years that a person has previously held a teaching position in one or more adult education programs.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000081">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000081</dc:identifier>
		<rdfs:label>Diploma or Credential Award Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200006" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200091" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200210" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200281" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200336" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200364" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200375" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>DiplomaOrCredentialAwardDate</skos:notation>
		<dc:description>The month and year on which the diploma/credential is awarded to a student in recognition of his/her completion of the curricular requirements.</dc:description>
		<textFormat>YYYY-MM</textFormat>
		<skos:definition>The month and year on which the diploma/credential is awarded to a student in recognition of his/her completion of the curricular requirements.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name change: replace "/" with "or".</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001102">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001102</dc:identifier>
		<rdfs:label>Assessment Item Body Custom Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyCustomInteractionXML</skos:notation>
		<dc:description>The custom interaction provides an opportunity for extensibility of this specification to include support for interactions not currently documented.  The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The custom interaction provides an opportunity for extensibility of this specification to include support for interactions not currently documented.  The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001103">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001103</dc:identifier>
		<rdfs:label>Assessment Item Body Drawing Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyDrawingInteractionXML</skos:notation>
		<dc:description>The drawing interaction allows the candidate to use a common set of drawing tools to modify a given graphical image (the canvas). It must be bound to a response variable with base-type file and single cardinality. The result is a file in the same format as the original image. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The drawing interaction allows the candidate to use a common set of drawing tools to modify a given graphical image (the canvas). It must be bound to a response variable with base-type file and single cardinality. The result is a file in the same format as the original image. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001104">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001104</dc:identifier>
		<rdfs:label>Assessment Item Body Gap Match Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyGapMatchInteractionXML</skos:notation>
		<dc:description>A gap match interaction contains a number gaps that the candidate can fill from an associated set of choices. The candidate must be able to review the content with the gaps filled in context, as indicated by their choices. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A gap match interaction contains a number gaps that the candidate can fill from an associated set of choices. The candidate must be able to review the content with the gaps filled in context, as indicated by their choices. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001105">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001105</dc:identifier>
		<rdfs:label>Assessment Item Body Match Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyMatchInteractionXML</skos:notation>
		<dc:description>A match interaction presents candidates with two sets of choices and allows them to create associates between pairs of choices in the two sets, but not between pairs of choices in the same set. Further restrictions can still be placed on the allowable associations using the matchMax attribute of the choices. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A match interaction presents candidates with two sets of choices and allows them to create associates between pairs of choices in the two sets, but not between pairs of choices in the same set. Further restrictions can still be placed on the allowable associations using the matchMax attribute of the choices. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001106">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001106</dc:identifier>
		<rdfs:label>Assessment Item Body Graphic Gap Match Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyGraphicGapMatchInteractionXML</skos:notation>
		<dc:description>A graphic gap-match interaction is a graphical interaction with a set of gaps that are defined as areas (hotspots) of the graphic image and an additional set of gap choices that are defined outside the image. The candidate must associate the gap choices with the gaps in the image and be able to review the image with the gaps filled in context, as indicated by their choices. Care should be taken when designing these interactions to ensure that the gaps in the image are a suitable size to receive the required gap choices. It must be clear to the candidate which hotspot each choice has been associated with. When associated, choices must appear wholly inside the gaps if at all possible and, where overlaps are required, should not hide each other completely. If the candidate indicates the association by positioning the choice over the gap (e.g., drag and drop) the system should 'snap' it to the nearest position that satisfies these requirements. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A graphic gap-match interaction is a graphical interaction with a set of gaps that are defined as areas (hotspots) of the graphic image and an additional set of gap choices that are defined outside the image. The candidate must associate the gap choices with the gaps in the image and be able to review the image with the gaps filled in context, as indicated by their choices. Care should be taken when designing these interactions to ensure that the gaps in the image are a suitable size to receive the required gap choices. It must be clear to the candidate which hotspot each choice has been associated with. When associated, choices must appear wholly inside the gaps if at all possible and, where overlaps are required, should not hide each other completely. If the candidate indicates the association by positioning the choice over the gap (e.g., drag and drop) the system should 'snap' it to the nearest position that satisfies these requirements. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001107">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001107</dc:identifier>
		<rdfs:label>Assessment Item Body Hot Spot Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyHotSpotInteractionXML</skos:notation>
		<dc:description>A hotspot interaction is a graphical interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to select one or more of the areas (hotspots). The hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, choiceInteraction should be used instead with separate material for each option. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A hotspot interaction is a graphical interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to select one or more of the areas (hotspots). The hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, choiceInteraction should be used instead with separate material for each option. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001108">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001108</dc:identifier>
		<rdfs:label>Assessment Item Body Graphic Order Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyGraphicOrderInteractionXML</skos:notation>
		<dc:description>A graphic order interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to impose an ordering on the areas (hotspots). The order hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, orderInteraction should be used instead with separate material for each option. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A graphic order interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to impose an ordering on the areas (hotspots). The order hotspot interaction should only be used when the spatial relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, orderInteraction should be used instead with separate material for each option. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001109">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001109</dc:identifier>
		<rdfs:label>Assessment Item Body Select Point Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodySelectPointInteractionXML</skos:notation>
		<dc:description>Like hotspotInteraction, a select point interaction is a graphic interaction. The candidate's task is to select one or more points. The associated response may have an areaMapping that scores the response on the basis of comparing it against predefined areas but the delivery engine must not indicate these areas of the image. Only the actual point(s) selected by the candidate shall be indicated. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Like hotspotInteraction, a select point interaction is a graphic interaction. The candidate's task is to select one or more points. The associated response may have an areaMapping that scores the response on the basis of comparing it against predefined areas but the delivery engine must not indicate these areas of the image. Only the actual point(s) selected by the candidate shall be indicated. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001110">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001110</dc:identifier>
		<rdfs:label>Assessment Item Body Select Point Interaction</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodySelectPointInteraction</skos:notation>
		<dc:description>A graphic associate interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to associate the areas (hotspots) with each other. The graphic associate interaction should only be used when the graphical relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, associateInteraction should be used instead with separate Material for each option. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A graphic associate interaction is a graphic interaction with a corresponding set of choices that are defined as areas of the graphic image. The candidate's task is to associate the areas (hotspots) with each other. The graphic associate interaction should only be used when the graphical relationship of the choices with respect to each other (as represented by the graphic image) is important to the needs of the item. Otherwise, associateInteraction should be used instead with separate Material for each option. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001111">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001111</dc:identifier>
		<rdfs:label>Assessment Item Body Slider Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodySliderInteractionXML</skos:notation>
		<dc:description>The slider interaction presents the candidate with a control for selecting a numerical value between a lower and upper bound. It must be bound to a response variable with single cardinality with a base-type of either integer or float. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The slider interaction presents the candidate with a control for selecting a numerical value between a lower and upper bound. It must be bound to a response variable with single cardinality with a base-type of either integer or float. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001112">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001112</dc:identifier>
		<rdfs:label>Assessment Item Body Choice Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyChoiceInteractionXML</skos:notation>
		<dc:description>The choice interaction presents a set of choices to the candidate. The candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is always initialized with no choices selected. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The choice interaction presents a set of choices to the candidate. The candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is always initialized with no choices selected. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001114">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001114</dc:identifier>
		<rdfs:label>Assessment Item Body Inline Choice Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyInlineChoiceInteractionXML</skos:notation>
		<dc:description>A inline choice is an inline interaction that presents the user with a set of choices, each of which is a simple piece of text. The candidate's task is to select one of the choices. Unlike the Choice Interaction, the delivery engine must allow the candidate to review their choice within the context of the surrounding text.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A inline choice is an inline interaction that presents the user with a set of choices, each of which is a simple piece of text. The candidate's task is to select one of the choices. Unlike the Choice Interaction, the delivery engine must allow the candidate to review their choice within the context of the surrounding text.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001115">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001115</dc:identifier>
		<rdfs:label>Assessment Item Body Media Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyMediaInteractionXML</skos:notation>
		<dc:description>The media interaction allows more control over the way the candidate interacts with a time-based media object and allows the number of times the media object was experienced to be reported in the value of the associated response variable, which must be of base-type integer and single cardinality. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The media interaction allows more control over the way the candidate interacts with a time-based media object and allows the number of times the media object was experienced to be reported in the value of the associated response variable, which must be of base-type integer and single cardinality. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001116">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001116</dc:identifier>
		<rdfs:label>Assessment Item Body Hottext Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyHottextInteractionXML</skos:notation>
		<dc:description>The hottext interaction presents a set of choices to the candidate represented as selectable runs of text embedded within a surrounding context, such as a simple passage of text. Like choiceInteraction, the candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is initialized from the defaultValue of the associated response variable, a NULL value indicating that no choices are selected (the usual case). The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The hottext interaction presents a set of choices to the candidate represented as selectable runs of text embedded within a surrounding context, such as a simple passage of text. Like choiceInteraction, the candidate's task is to select one or more of the choices, up to a maximum of maxChoices. The interaction is initialized from the defaultValue of the associated response variable, a NULL value indicating that no choices are selected (the usual case). The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001117">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001117</dc:identifier>
		<rdfs:label>Assessment Item Body Order Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyOrderInteractionXML</skos:notation>
		<dc:description>In an order interaction the candidate's task is to reorder the choices, the order in which the choices are displayed initially is significant. By default the candidate's task is to order all of the choices but a subset of the choices can be requested using the maxChoices and minChoices attributes. When specified the candidate must select a subset of the choices and impose an ordering on them. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>In an order interaction the candidate's task is to reorder the choices, the order in which the choices are displayed initially is significant. By default the candidate's task is to order all of the choices but a subset of the choices can be requested using the maxChoices and minChoices attributes. When specified the candidate must select a subset of the choices and impose an ordering on them. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001118">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001118</dc:identifier>
		<rdfs:label>Assessment Item Body Position Object Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyPositionObjectInteractionXML</skos:notation>
		<dc:description>The position object interaction consists of a single image which must be positioned on another graphic image (the stage) by the candidate. Like selectPointInteraction, the associated response may have an areaMapping that scores the response on the basis of comparing it against predefined areas but the delivery engine must not indicate these areas of the stage. Only the actual position(s) selected by the candidate shall be indicated. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The position object interaction consists of a single image which must be positioned on another graphic image (the stage) by the candidate. Like selectPointInteraction, the associated response may have an areaMapping that scores the response on the basis of comparing it against predefined areas but the delivery engine must not indicate these areas of the stage. Only the actual position(s) selected by the candidate shall be indicated. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001119">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001119</dc:identifier>
		<rdfs:label>Assessment Item Body Text Entry Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyTextEntryInteractionXML</skos:notation>
		<dc:description>A textEntry interaction obtains a simple piece of text from the candidate. Like inlineChoiceInteraction, the delivery engine must allow the candidate to review their choice within the context of the surrounding text. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A textEntry interaction obtains a simple piece of text from the candidate. Like inlineChoiceInteraction, the delivery engine must allow the candidate to review their choice within the context of the surrounding text. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001120">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001120</dc:identifier>
		<rdfs:label>Assessment Item Body Extended Text Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyExtendedTextInteractionXML</skos:notation>
		<dc:description>An extended text interaction allows the candidate to enter an extended amount of text. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An extended text interaction allows the candidate to enter an extended amount of text. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001121">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001121</dc:identifier>
		<rdfs:label>Assessment Item Body End Attempt Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyEndAttemptInteractionXML</skos:notation>
		<dc:description>The end attempt interaction is a special type of interaction which allows item authors to provide the candidate with control over the way in which the candidate terminates an attempt. The candidate can use the interaction to terminate the attempt (triggering response processing) immediately, typically to request a hint. It must be bound to a response variable with base-type boolean and single cardinality. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The end attempt interaction is a special type of interaction which allows item authors to provide the candidate with control over the way in which the candidate terminates an attempt. The candidate can use the interaction to terminate the attempt (triggering response processing) immediately, typically to request a hint. It must be bound to a response variable with base-type boolean and single cardinality. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001123">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001123</dc:identifier>
		<rdfs:label>Assessment Item Body Associate Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyAssociateInteractionXML</skos:notation>
		<dc:description>An associate interaction presents candidates with a number of choices and allows them to create associations between them. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An associate interaction presents candidates with a number of choices and allows them to create associations between them. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001222">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001222</dc:identifier>
		<rdfs:label>Assessment Item Body Upload Interaction XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyUploadInteractionXML</skos:notation>
		<dc:description>The upload interaction allows the candidate to upload a pre-prepared file representing their response. It must be bound to a response variable with base-type file and single cardinality. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The upload interaction allows the candidate to upload a pre-prepared file representing their response. It must be bound to a response variable with base-type file and single cardinality. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001529">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001529</dc:identifier>
		<rdfs:label>APIP Interaction Sequence Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200008" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>APIPInteractionSequenceNumber</skos:notation>
		<dc:description>The position of this APIP Interaction in a sequence of interactions.</dc:description>
		<minInclusive>0</minInclusive>
		<textFormat>Numeric</textFormat>
		<skos:definition>The position of this APIP Interaction in a sequence of interactions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001173">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001173</dc:identifier>
		<rdfs:label>Authorization Application Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200009" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AuthorizationApplicationName</skos:notation>
		<dc:description>The name of a data system or application which an authenticated person may access.</dc:description>
		<maxLength>120</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of a data system or application which an authenticated person may access.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001174">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001174</dc:identifier>
		<rdfs:label>Authorization Application URI</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200009" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AuthorizationApplicationURI</skos:notation>
		<dc:description>The Uniform Resource Identifier (URI) of a data system or application which an authenticated person may access.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The Uniform Resource Identifier (URI) of a data system or application which an authenticated person may access.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000028">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000028</dc:identifier>
		<rdfs:label>Assessment Title</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentTitle</skos:notation>
		<dc:description>The title or name of the assessment.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The title or name of the assessment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000382">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000382</dc:identifier>
		<rdfs:label>Assessment Objective</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentObjective</skos:notation>
		<dc:description>This is the objective that the assessment is measuring.</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>This is the objective that the assessment is measuring.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000931">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000931</dc:identifier>
		<rdfs:label>Assessment Short Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentShortName</skos:notation>
		<dc:description>An abbreviated title for an assessment.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An abbreviated title for an assessment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000932">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000932</dc:identifier>
		<rdfs:label>Assessment Family Title</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFamilyTitle</skos:notation>
		<dc:description>The full title of the Assessment Family. An Assessment Family is a set of assessments with a common name, jurisdiction, or focus, such as Graduate Record Exam or National Assessment of Educational Progress.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The full title of the Assessment Family. An Assessment Family is a set of assessments with a common name, jurisdiction, or focus, such as Graduate Record Exam or National Assessment of Educational Progress.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000933">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000933</dc:identifier>
		<rdfs:label>Assessment Family Short Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFamilyShortName</skos:notation>
		<dc:description>The abbreviated title of the Assessment Family. An Assessment Family is a set of assessments with a common name, jurisdiction, or focus.</dc:description>
		<rdfs:comment>Examples: SAT, GRE, NAEP</rdfs:comment>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The abbreviated title of the Assessment Family. An Assessment Family is a set of assessments with a common name, jurisdiction, or focus.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000967">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000967</dc:identifier>
		<rdfs:label>Assessment Administration Assessment Family</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200246" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAdministrationAssessmentFamily</skos:notation>
		<dc:description>The title of the assessment family to be administered.</dc:description>
		<rdfs:comment>A typical scenario for an assessment administration is a state-wide administration of an accountability test.  For example, in Florida "Florida Comprehensive Assessment Test".</rdfs:comment>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The title of the assessment family to be administered.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001006">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001006</dc:identifier>
		<rdfs:label>Assessment Provider</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentProvider</skos:notation>
		<dc:description>Identifies the provider or publisher of the assessment.</dc:description>
		<rdfs:comment>AIF property</rdfs:comment>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Identifies the provider or publisher of the assessment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001067">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001067</dc:identifier>
		<rdfs:label>Assessment Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentIdentifier</skos:notation>
		<dc:description>A unique number or alphanumeric code assigned to an assessment by a school, school system, a state, or other agency or entity.  This may be the publisher identifier.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique number or alphanumeric code assigned to an assessment by a school, school system, a state, or other agency or entity.  This may be the publisher identifier.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry>
				<changeDescription>Corrected the maxLength to reflect 100 characters maximum</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/98</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Increased Format to Alphanumeric- 100 characters.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Name change</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001544">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001544</dc:identifier>
		<rdfs:label>Assessment Revision Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200010" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentRevisionDate</skos:notation>
		<dc:description>The month, day, and year that the conceptual design for the assessment was most recently revised substantially.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The month, day, and year that the conceptual design for the assessment was most recently revised substantially.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001157">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001157</dc:identifier>
		<rdfs:label>Accessibility Feature Other Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200012" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AccessibilityFeatureOtherDescription</skos:notation>
		<dc:description>The description of the accessibility feature when 'Accessibility Feature Type' is set to 'Other'.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The description of the accessibility feature when 'Accessibility Feature Type' is set to 'Other'.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Changed name and definition to Accessibility Feature; increased description size.</changeDescription> 	
				<changeVersion>13</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000961">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000961</dc:identifier>
		<rdfs:label>Assessment Administration Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200013" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAdministrationCode</skos:notation>
		<dc:description>The code given to the assessment event by a state or other authority directing overall administration.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The code given to the assessment event by a state or other authority directing overall administration.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000962">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000962</dc:identifier>
		<rdfs:label>Assessment Administration Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200013" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentAdministrationStartDate</skos:notation>
		<dc:description>The start date of the time period designated for the assessment administration.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The start date of the time period designated for the assessment administration.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000963">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000963</dc:identifier>
		<rdfs:label>Assessment Administration Start Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200013" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>AssessmentAdministrationStartTime</skos:notation>
		<dc:description>The start time of the time period designated for the assessment administration.</dc:description>
		<textFormat>HH:MM:SS</textFormat>
		<skos:definition>The start time of the time period designated for the assessment administration.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000964">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000964</dc:identifier>
		<rdfs:label>Assessment Administration Finish Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200013" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentAdministrationFinishDate</skos:notation>
		<dc:description>The finish date of the time period designated for the assessment administration.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The finish date of the time period designated for the assessment administration.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000965">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000965</dc:identifier>
		<rdfs:label>Assessment Administration Finish Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200013" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>AssessmentAdministrationFinishTime</skos:notation>
		<dc:description>The finish time of the time period designated for the assessment administration.</dc:description>
		<textFormat>HH:MM:SS</textFormat>
		<skos:definition>The finish time of the time period designated for the assessment administration.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000977">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000977</dc:identifier>
		<rdfs:label>Assessment Administration Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200013" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAdministrationName</skos:notation>
		<dc:description>The name given to an assessment event.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name given to an assessment event.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001531">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001531</dc:identifier>
		<rdfs:label>Assessment Administration Period Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200013" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAdministrationPeriodDescription</skos:notation>
		<dc:description>The period or window in which an assessment is supposed to be administered.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The period or window in which an assessment is supposed to be administered.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001195">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001195</dc:identifier>
		<rdfs:label>Assessment Asset Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAssetVersion</skos:notation>
		<dc:description>A version number or label defined by the publisher.</dc:description>
		<rdfs:comment>In some use cases a date, such as Learning Resource Date Created may be used as an alternative to a version number.  Each use case may adopt different rules depending on the application requirements for maintenance of current version only or the multiple objects/records representing the complete version history.</rdfs:comment>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A version number or label defined by the publisher.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001197">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001197</dc:identifier>
		<rdfs:label>Assessment Asset Published Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentAssetPublishedDate</skos:notation>
		<dc:description>The date that this version of the asset was made available for use.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date that this version of the asset was made available for use.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001198">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001198</dc:identifier>
		<rdfs:label>Assessment Asset Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAssetIdentifier</skos:notation>
		<dc:description>A unique code identifying the Assessment Asset provided by the authoring system.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique code identifying the Assessment Asset provided by the authoring system.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001200">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001200</dc:identifier>
		<rdfs:label>Assessment Asset Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAssetName</skos:notation>
		<dc:description>The name of the Assessment Asset.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the Assessment Asset.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001201">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001201</dc:identifier>
		<rdfs:label>Assessment Asset Owner</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAssetOwner</skos:notation>
		<dc:description>The name of the ownership rights holder or publisher of the asset.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the ownership rights holder or publisher of the asset.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001202">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001202</dc:identifier>
		<rdfs:label>Assessment Asset Content XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAssetContentXML</skos:notation>
		<dc:description>XML encoded in UTF-8 representing the content of the Assessment Asset.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>XML encoded in UTF-8 representing the content of the Assessment Asset.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001203">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001203</dc:identifier>
		<rdfs:label>Assessment Asset Content Mime Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAssetContentMimeType</skos:notation>
		<dc:description>MIME type to specifically indicate the Assessment Asset content type.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>MIME type to specifically indicate the Assessment Asset content type.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001204">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001204</dc:identifier>
		<rdfs:label>Assessment Asset Content URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200015" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentAssetContentURL</skos:notation>
		<dc:description>The Uniform Resource Locator (URL) location of the external Assessment Asset content.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The Uniform Resource Locator (URL) location of the external Assessment Asset content.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000024">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000024</dc:identifier>
		<rdfs:label>Assessment Form Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormName</skos:notation>
		<dc:description>The name of a given assessment form.</dc:description>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of a given assessment form.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name and definition were modified.  Old name was Assessment Form.</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000366">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000366</dc:identifier>
		<rdfs:label>Assessment Form Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormNumber</skos:notation>
		<dc:description>The number of a given assessment form.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The number of a given assessment form.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001181">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001181</dc:identifier>
		<rdfs:label>Assessment Item Bank Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBankIdentifier</skos:notation>
		<dc:description>If the assessment is provided with an item bank, then this identifies the item bank: a unique code or number used by the item banking system.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>If the assessment is provided with an item bank, then this identifies the item bank: a unique code or number used by the item banking system.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001182">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001182</dc:identifier>
		<rdfs:label>Assessment Item Bank Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBankName</skos:notation>
		<dc:description>If the assessment is provided with an item bank, then this is the name of the item bank.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>If the assessment is provided with an item bank, then this is the name of the item bank.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001183">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001183</dc:identifier>
		<rdfs:label>Assessment Form Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormVersion</skos:notation>
		<dc:description>The version number of the Assessment Form.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The version number of the Assessment Form.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001184">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001184</dc:identifier>
		<rdfs:label>Learning Resource Published Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>LearningResourcePublishedDate</skos:notation>
		<dc:description>The published date of an educational resource, such as instructional media, an assessment form, or section of an assessment form.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The published date of an educational resource, such as instructional media, an assessment form, or section of an assessment form.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001185">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001185</dc:identifier>
		<rdfs:label>Assessment Form Accessibility Feature List</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormAccessibilityFeatureList</skos:notation>
		<dc:description>The human readable list of one or more of the specific accessibility features available. If no accessibility features are provided, then this list will not be present.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The human readable list of one or more of the specific accessibility features available. If no accessibility features are provided, then this list will not be present.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001186">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001186</dc:identifier>
		<rdfs:label>Intended Administration Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>IntendedAdministrationStartDate</skos:notation>
		<dc:description>The beginning date of the time period in which the form is intended to be administered.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The beginning date of the time period in which the form is intended to be administered.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001187">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001187</dc:identifier>
		<rdfs:label>Assessment Form Intended Administration End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentFormIntendedAdministrationEndDate</skos:notation>
		<dc:description>The ending date of the time period in which the assessment form is intended to be administered.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The ending date of the time period in which the assessment form is intended to be administered.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Rename "Intended Administration End Date" to "Assessment Form Intended Administration End Date".  Name change to conform to CEDS naming conventions.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001188">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001188</dc:identifier>
		<rdfs:label>Assessment Form Platforms Supported</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormPlatformsSupported</skos:notation>
		<dc:description>A human readable list of delivery platforms the form will support.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A human readable list of delivery platforms the form will support.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001533">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001533</dc:identifier>
		<rdfs:label>Assessment Form Algorithm Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormAlgorithmIdentifier</skos:notation>
		<dc:description>An identifier for algorithm used to generate a custom form for an adaptive test.</dc:description>
		<rdfs:comment>The algorithm is typically used to generate the entire assessment form, but there may be cases in which it is used to generate only one part (Assessment Form Section).&lt;br/&gt;&lt;br/&gt;CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt; An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An identifier for algorithm used to generate a custom form for an adaptive test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001534">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001534</dc:identifier>
		<rdfs:label>Assessment Form Algorithm Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormAlgorithmVersion</skos:notation>
		<dc:description>The version of the algorithm used to generate a custom form for an adaptive test.</dc:description>
		<rdfs:comment>The algorithm is typically used to generate the entire assessment form, but there may be cases in which it is used to generate only one part (Assessment Form Section).</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The version of the algorithm used to generate a custom form for an adaptive test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000979">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000979</dc:identifier>
		<rdfs:label>Assessment Form Section Sequence Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200019" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200022" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentFormSectionSequenceNumber</skos:notation>
		<dc:description>The position of the assessment section presented in the sequence of sections within an assessment form.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The position of the assessment section presented in the sequence of sections within an assessment form.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001189">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001189</dc:identifier>
		<rdfs:label>Assessment Form Section Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormSectionVersion</skos:notation>
		<dc:description>The version number of the Assessment Form Section.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The version number of the Assessment Form Section.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001191">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001191</dc:identifier>
		<rdfs:label>Assessment Form Section Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentFormSectionIdentifier</skos:notation>
		<dc:description>A unique number or alphanumeric code assigned to the Assessment Form Section using the system specified by Identification System for Assessment Form Section.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique number or alphanumeric code assigned to the Assessment Form Section using the system specified by Identification System for Assessment Form Section.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001192">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001192</dc:identifier>
		<rdfs:label>Assessment Form Section Time Limit</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>AssessmentFormSectionTimeLimit</skos:notation>
		<dc:description>If this section is timed, then this will identify the maximum amount of time the test taker can spend within this section.</dc:description>
		<textFormat>HH:MM:SS</textFormat>
		<skos:definition>If this section is timed, then this will identify the maximum amount of time the test taker can spend within this section.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000391">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000391</dc:identifier>
		<rdfs:label>Assessment Item Difficulty</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentItemDifficulty</skos:notation>
		<dc:description>The percentage of students who answered the item correctly during trial testing of the item.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>100</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The percentage of students who answered the item correctly during trial testing of the item.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed definition.  Changed format.  Percentage is now a number between 0 and 100 with 100 representing 100%.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000398">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000398</dc:identifier>
		<rdfs:label>Assessment Item Distractor Analysis</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemDistractorAnalysis</skos:notation>
		<dc:description>The analysis of the distractors provided for a specific assessment.</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The analysis of the distractors provided for a specific assessment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000400">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000400</dc:identifier>
		<rdfs:label>Assessment Item Stem</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemStem</skos:notation>
		<dc:description>The statement of the question or prompt for an Assessment Item to which the student responds.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The statement of the question or prompt for an Assessment Item to which the student responds.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Definition updated.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000403">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000403</dc:identifier>
		<rdfs:label>Assessment Item Allotted Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>AssessmentItemAllottedTime</skos:notation>
		<dc:description>The amount of time allotted for a specific item.</dc:description>
		<textFormat>HH:MM:SS</textFormat>
		<skos:definition>The amount of time allotted for a specific item.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Corrected XML type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000630">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000630</dc:identifier>
		<rdfs:label>Assessment Item Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemIdentifier</skos:notation>
		<dc:description>The identifier that uniquely identifies an assessment item.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The identifier that uniquely identifies an assessment item.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000707">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000707</dc:identifier>
		<rdfs:label>Assessment Item Maximum Score</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemMaximumScore</skos:notation>
		<dc:description>The maximum number of points possible for the assessment item.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The maximum number of points possible for the assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000708">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000708</dc:identifier>
		<rdfs:label>Assessment Item Minimum Score</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemMinimumScore</skos:notation>
		<dc:description>The minimum number of points possible for the assessment item.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The minimum number of points possible for the assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000906">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000906</dc:identifier>
		<rdfs:label>Assessment Item Text Complexity Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemTextComplexityValue</skos:notation>
		<dc:description>The complexity of the text using the scaling system defined by Text Complexity System, e.g. Lexile� for assessment items with a reading passage.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The complexity of the text using the scaling system defined by Text Complexity System, e.g. Lexile� for assessment items with a reading passage.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001267">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001267</dc:identifier>
		<rdfs:label>Assessment Item Body Text</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemBodyText</skos:notation>
		<dc:description>The complete text of an assessment item including all applicable parts such as stimulus, stem, and possible response options presented.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The complete text of an assessment item including all applicable parts such as stimulus, stem, and possible response options presented.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001268">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001268</dc:identifier>
		<rdfs:label>Assessment Item Stimulus</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200023" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemStimulus</skos:notation>
		<dc:description> The text, source (e.g., video clip), and/or graphic about which the assessment item is written. The stimulus provides the context of the item/task to which the student must respond.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition> The text, source (e.g., video clip), and/or graphic about which the assessment item is written. The stimulus provides the context of the item/task to which the student must respond.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001131">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001131</dc:identifier>
		<rdfs:label>Assessment Item APIP Response Processing Template URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemAPIPResponseProcessingTemplateURL</skos:notation>
		<dc:description>These templates are described using the processing language defined in IMS Global APIP specification and are distributed (in XML form) along with it. Delivery engines that support generalized response processing do not need to implement special mechanisms to support them as a template file can be parsed directly while processing the assessment item that refers to it. This element provides the URL for the template.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>These templates are described using the processing language defined in IMS Global APIP specification and are distributed (in XML form) along with it. Delivery engines that support generalized response processing do not need to implement special mechanisms to support them as a template file can be parsed directly while processing the assessment item that refers to it. This element provides the URL for the template.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed maximum size.  Changed XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001132">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001132</dc:identifier>
		<rdfs:label>Assessment Item APIP Response Processing XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemAPIPResponseProcessingXML</skos:notation>
		<dc:description>Response processing is the process by which the Delivery Engine assigns outcomes based on the learner's responses. The outcomes may be used to provide feedback to the learner Feedback is either provided immediately following the end of the learner's attempt or it is provided at some later time, perhaps as part of a summary report on the item session. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Response processing is the process by which the Delivery Engine assigns outcomes based on the learner's responses. The outcomes may be used to provide feedback to the learner Feedback is either provided immediately following the end of the learner's attempt or it is provided at some later time, perhaps as part of a summary report on the item session. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001133">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001133</dc:identifier>
		<rdfs:label>Assessment Item APIP Response Declaration XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemAPIPResponseDeclarationXML</skos:notation>
		<dc:description>Response declarations state what the response variables include.  The response declaration may assign an optional correct response. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Response declarations state what the response variables include.  The response declaration may assign an optional correct response. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001134">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001134</dc:identifier>
		<rdfs:label>Assessment Item APIP Outcome Declaration XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemAPIPOutcomeDeclarationXML</skos:notation>
		<dc:description>Outcome variables are declared by outcome declarations. Their value is set either from a default given in the declaration itself or by a responseRule during response processing.  The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Outcome variables are declared by outcome declarations. Their value is set either from a default given in the declaration itself or by a responseRule during response processing.  The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001135">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001135</dc:identifier>
		<rdfs:label>Assessment Item APIP Template Declaration XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemAPIPTemplateDeclarationXML</skos:notation>
		<dc:description>Template declarations declare item variables that are to be used specifically for the purposes of cloning items. They can have their value set only during template processing. They are referred to within the item body in order to individualize the clone and possibly also within the response Processing rules if the cloning process affects the way the item is scored.  The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Template declarations declare item variables that are to be used specifically for the purposes of cloning items. They can have their value set only during template processing. They are referred to within the item body in order to individualize the clone and possibly also within the response Processing rules if the cloning process affects the way the item is scored.  The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001136">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001136</dc:identifier>
		<rdfs:label>Assessment Item APIP Template Processing XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemAPIPTemplateProcessingXML</skos:notation>
		<dc:description>Template processing consists of one or more template rules that are followed by the cloning engine or delivery system in order to assign values to the template variables. Template processing is identical in form to responseProcessing except that the purpose is to assign values to template variables, not outcome variables. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Template processing consists of one or more template rules that are followed by the cloning engine or delivery system in order to assign values to the template variables. Template processing is identical in form to responseProcessing except that the purpose is to assign values to template variables, not outcome variables. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001137">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001137</dc:identifier>
		<rdfs:label>Assessment Item APIP Modal Feedback XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemAPIPModalFeedbackXML</skos:notation>
		<dc:description>Modal feedback is shown to the candidate directly following response processing. The value of an outcome variable is used in conjunction with the showHide and identifier attributes to determine whether or not the feedback is shown in a similar way to feedbackElement. The XML from the IMS Global APIP Specification would be included.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Modal feedback is shown to the candidate directly following response processing. The value of an outcome variable is used in conjunction with the showHide and identifier attributes to determine whether or not the feedback is shown in a similar way to feedbackElement. The XML from the IMS Global APIP Specification would be included.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001138">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001138</dc:identifier>
		<rdfs:label>Assessment Item APIP Item Body XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200024" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemAPIPItemBodyXML</skos:notation>
		<dc:description>The item body contains the text, graphics, media objects, and interactions that describe the item's content and information about how it is structured. The body is presented by combining it with stylesheet information, either explicitly or implicitly using the default style rules of the delivery or authoring system. This element contains the appropriate XML from the IMS Global APIP Specification defining the various item body interactions.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The item body contains the text, graphics, media objects, and interactions that describe the item's content and information about how it is structured. The body is presented by combining it with stylesheet information, either explicitly or implicitly using the default style rules of the delivery or authoring system. This element contains the appropriate XML from the IMS Global APIP Specification defining the various item body interactions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000393">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000393</dc:identifier>
		<rdfs:label>Assessment Item Response Choice Pattern</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200026" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemResponseChoicePattern</skos:notation>
		<dc:description>The distribution of responses for each choice in the assessment item.</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The distribution of responses for each choice in the assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000709">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000709</dc:identifier>
		<rdfs:label>Assessment Item Characteristic Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200026" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemCharacteristicValue</skos:notation>
		<dc:description>A psychometric measure provided for an assessment item.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A psychometric measure provided for an assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000904">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000904</dc:identifier>
		<rdfs:label>Assessment Item Possible Response Feedback Message</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200027" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemPossibleResponseFeedbackMessage</skos:notation>
		<dc:description>A message provided to the person being assessed after giving a response that matches the possible response.</dc:description>
		<rdfs:comment>This may be a message of affirmation for a correct answer or descriptive feedback for an incorrect answer.  For example, if the item asked the question what is 2 times 3 and the learner answered 5, the Feedback Message might be "Try multiplication instead of addition."</rdfs:comment>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A message provided to the person being assessed after giving a response that matches the possible response.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000905">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000905</dc:identifier>
		<rdfs:label>Assessment Item Possible Response Sequence Number</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200027" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemPossibleResponseSequenceNumber</skos:notation>
		<dc:description>The position of this response in the list of responses displayed, such as for a multiple choice item type.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The position of this response in the list of responses displayed, such as for a multiple choice item type.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001269">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001269</dc:identifier>
		<rdfs:label>Assessment Item Possible Response Option</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200027" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemPossibleResponseOption</skos:notation>
		<dc:description>The possible response presented to the participant within a selected-response/multiple-choice assessment item.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The possible response presented to the participant within a selected-response/multiple-choice assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000402">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000402</dc:identifier>
		<rdfs:label>Assessment Item Response Duration</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>AssessmentItemResponseDuration</skos:notation>
		<dc:description>The total amount of time in seconds or milliseconds  that a person spent responding to a given assessment item.</dc:description>
		<textFormat>HH:MM:SS or HH:MM:SS.sss</textFormat>
		<skos:definition>The total amount of time in seconds or milliseconds  that a person spent responding to a given assessment item.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name and definition.  Element now specific to a session.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000406">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000406</dc:identifier>
		<rdfs:label>Assessment Item Response Aid Set Used</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemResponseAidSetUsed</skos:notation>
		<dc:description>A tool or aid set used while viewing the item. This can include things like a calculator, reference tools, etc.</dc:description>
		<rdfs:comment>This a permissible set of tools suggested for use for successful completion of a test question, not an accommodation.</rdfs:comment>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A tool or aid set used while viewing the item. This can include things like a calculator, reference tools, etc.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Names changed from Assessment Item Aid Set Used.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000724">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000724</dc:identifier>
		<rdfs:label>Assessment Item Response Score Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemResponseScoreValue</skos:notation>
		<dc:description>The score given to a person's response to an assessment item.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The score given to a person's response to an assessment item.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Assessment Item Score Value.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000891">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000891</dc:identifier>
		<rdfs:label>Assessment Item Response Descriptive Feedback</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemResponseDescriptiveFeedback</skos:notation>
		<dc:description>The formative descriptive feedback that was given to a learner in response to the results from a scored/evaluated assessment item.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The formative descriptive feedback that was given to a learner in response to the results from a scored/evaluated assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000955">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000955</dc:identifier>
		<rdfs:label>Assessment Item Response Hint Count</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseHintCount</skos:notation>
		<dc:description>The total number of hints presented as the learner responded to a formative assessment item.  This may include hints requested by the learner or hints automatically presented such as in an online tutoring system. Presentation of a scaffolding item is a separate response record and not counted as a hint.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The total number of hints presented as the learner responded to a formative assessment item.  This may include hints requested by the learner or hints automatically presented such as in an online tutoring system. Presentation of a scaffolding item is a separate response record and not counted as a hint.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000957">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000957</dc:identifier>
		<rdfs:label>Assessment Item Response First Attempt Duration</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>AssessmentItemResponseFirstAttemptDuration</skos:notation>
		<dc:description>The amount of time in seconds or milliseconds that a person took to give an initial response, a first attempt to answer a formative assessment item.</dc:description>
		<rdfs:comment>Formative assessments often allow learners to make multiple attempts until a correct or acceptable answer is given.  In such cases it is valuable to know both the time it took for the initial response and the total time spent responding to the problem.</rdfs:comment>
		<textFormat>HH:MM:SS or HH:MM:SS.sss</textFormat>
		<skos:definition>The amount of time in seconds or milliseconds that a person took to give an initial response, a first attempt to answer a formative assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000958">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000958</dc:identifier>
		<rdfs:label>Assessment Item Response Start Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>AssessmentItemResponseStartTime</skos:notation>
		<dc:description>The time of day that the assessment item was presented to the learner.</dc:description>
		<textFormat>HH:MM:SS or HH:MM:SS.sss</textFormat>
		<skos:definition>The time of day that the assessment item was presented to the learner.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000959">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000959</dc:identifier>
		<rdfs:label>Assessment Item Response Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentItemResponseStartDate</skos:notation>
		<dc:description>The date on which the assessment item was presented to the learner.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the assessment item was presented to the learner.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000969">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000969</dc:identifier>
		<rdfs:label>Assessment Item Response Security Issue</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemResponseSecurityIssue</skos:notation>
		<dc:description>The description of security issue, if any, related to a learner's response to an assessment item.</dc:description>
		<rdfs:comment>For example: Suspected plagiarism ; Computer left test window ; Excessive response time ; Proctor suspected copying ; Student identity not confirmed ; No proctor present ; Student carried wireless mobile device during test ; Student terminated test early and restarted ; Excessive erasures on test form ; Response pattern identical to another student's</rdfs:comment>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The description of security issue, if any, related to a learner's response to an assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001063">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001063</dc:identifier>
		<rdfs:label>Assessment Item Response Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemResponseValue</skos:notation>
		<dc:description>A specific response to an assessment item by the person being assessed.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A specific response to an assessment item by the person being assessed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001284">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001284</dc:identifier>
		<rdfs:label>Assessment Item Result XML</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentItemResultXML</skos:notation>
		<dc:description>The  assessment item result formatted according to the IMS Global QTI  Specification.</dc:description>
		<rdfs:comment>See http://www.imsglobal.org/question/qtiv2p1/imsqti_resultv2p1.html#element10818</rdfs:comment>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The  assessment item result formatted according to the IMS Global QTI  Specification.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001537">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001537</dc:identifier>
		<rdfs:label>Assessment Item Response Descriptive Feedback Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200028" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>AssessmentItemResponseDescriptiveFeedbackDate</skos:notation>
		<dc:description>The date and time the descriptive feedback was entered in response to the results from a scored/evaluated assessment item.</dc:description>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>The date and time the descriptive feedback was entered in response to the results from a scored/evaluated assessment item.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001251">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001251</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter A</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterA</skos:notation>
		<dc:description>The Item Response Theory value representing the discrimination of the item. The a parameter is found by taking the slope of the line tangent to the item characteristic curve at the inflection point, B. The parameter is the steepness of the curve at its steepest point.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The Item Response Theory value representing the discrimination of the item. The a parameter is found by taking the slope of the line tangent to the item characteristic curve at the inflection point, B. The parameter is the steepness of the curve at its steepest point.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001252">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001252</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter B</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterB</skos:notation>
		<dc:description>The Item Response Theory value representing the difficulty of the item.   It is the Theta value for the location of the inflection point of the item characteristic curve.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The Item Response Theory value representing the difficulty of the item.   It is the Theta value for the location of the inflection point of the item characteristic curve.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001254">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001254</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter C</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterC</skos:notation>
		<dc:description>The Item Response Theory value for multiple choice items representing the guessing of the item. The c parameter is a lower asymptote. It is the low point of the curve as it moves to negative infinity on the horizontal axis. You can think of c as the probability that a chicken would get the item right.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The Item Response Theory value for multiple choice items representing the guessing of the item. The c parameter is a lower asymptote. It is the low point of the curve as it moves to negative infinity on the horizontal axis. You can think of c as the probability that a chicken would get the item right.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001255">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001255</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter D1</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterD1</skos:notation>
		<dc:description>For   polytomous assessment items with more than two possible responses, this is the item response theory value representing the threshold between the first and second item characteristic functions.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>For   polytomous assessment items with more than two possible responses, this is the item response theory value representing the threshold between the first and second item characteristic functions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001256">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001256</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter D2</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterD2</skos:notation>
		<dc:description>For   polytomous assessment items with more than two possible responses, this is the item response theory value representing the threshold between the second and third item characteristic functions.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>For   polytomous assessment items with more than two possible responses, this is the item response theory value representing the threshold between the second and third item characteristic functions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001257">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001257</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter D3</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterD3</skos:notation>
		<dc:description>For   polytomous assessment items with more than three possible responses, this is the item response theory value representing the threshold between the third and fourth item characteristic functions.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>For   polytomous assessment items with more than three possible responses, this is the item response theory value representing the threshold between the third and fourth item characteristic functions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001258">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001258</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter D4</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterD4</skos:notation>
		<dc:description>For   polytomous assessment items with more than four possible responses, this is the item response theory value representing the threshold between the fourth and fifth item characteristic functions.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>For   polytomous assessment items with more than four possible responses, this is the item response theory value representing the threshold between the fourth and fifth item characteristic functions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001259">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001259</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter D5</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterD5</skos:notation>
		<dc:description>For   polytomous assessment items with more than five possible responses, this is the item response theory value representing the threshold between the fifth and sixth item characteristic functions.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>For   polytomous assessment items with more than five possible responses, this is the item response theory value representing the threshold between the fifth and sixth item characteristic functions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001260">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001260</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Parameter D6</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryParameterD6</skos:notation>
		<dc:description>For   polytomous assessment items with more than six possible responses, this is the item response theory value representing the threshold between the sixth and seventh item characteristic functions.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>For   polytomous assessment items with more than six possible responses, this is the item response theory value representing the threshold between the sixth and seventh item characteristic functions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001262">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001262</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Point Biserial Correlation Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryPointBiserialCorrelationValue</skos:notation>
		<dc:description>The correlation between correct answers on this item and total correct answers on the test during a previous administration.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The correlation between correct answers on this item and total correct answers on the test during a previous administration.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001264">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001264</dc:identifier>
		<rdfs:label>Assessment Item Response Theory DIF Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryDIFValue</skos:notation>
		<dc:description>A value representing the Differential Item Functioning, also referred to as  measurement bias, for the assessment item.  The value represents differences in the functioning of the item across groups which are matched on the attribute being measure by the item.  The value is calculated using Mantel-Haenszel approach or a comparable algorithm so that a value of 1.0 represents no bias.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>A value representing the Differential Item Functioning, also referred to as  measurement bias, for the assessment item.  The value represents differences in the functioning of the item across groups which are matched on the attribute being measure by the item.  The value is calculated using Mantel-Haenszel approach or a comparable algorithm so that a value of 1.0 represents no bias.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001265">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001265</dc:identifier>
		<rdfs:label>Assessment Item Response Theory Kappa Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200029" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentItemResponseTheoryKappaValue</skos:notation>
		<dc:description>The measure used to represent the degree of agreement among raters.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>The measure used to represent the degree of agreement among raters.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001049">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001049</dc:identifier>
		<rdfs:label>Assessment Need Time Multiplier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200033" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentNeedTimeMultiplier</skos:notation>
		<dc:description>Defines the multiplier to be applied to the time limit to determine the total testing time allowed when Additional Testing Time is specified as part of an Assessment Personal Needs Profile.  If the value is 'unlimited' then there is no time limit for the test.</dc:description>
		<maxLength>9</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Defines the multiplier to be applied to the time limit to determine the total testing time allowed when Additional Testing Time is specified as part of an Assessment Personal Needs Profile.  If the value is 'unlimited' then there is no time limit for the test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001050">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001050</dc:identifier>
		<rdfs:label>Assessment Need Line Reader Highlight Color</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200033" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentNeedLineReaderHighlightColor</skos:notation>
		<dc:description>The color defined as part of an Assessment Personal Needs Profile to be used to highlight the point of line reader activity i.e. the line being read.</dc:description>
		<minLength>6</minLength>
		<maxLength>6</maxLength>
		<textFormat>Color hex code</textFormat>
		<skos:definition>The color defined as part of an Assessment Personal Needs Profile to be used to highlight the point of line reader activity i.e. the line being read.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001051">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001051</dc:identifier>
		<rdfs:label>Assessment Need Overlay Color</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200033" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentNeedOverlayColor</skos:notation>
		<dc:description>This is the preferred color for the overlay for screen enhancement defined as part of an Assessment Personal Needs Profile.</dc:description>
		<minLength>6</minLength>
		<maxLength>6</maxLength>
		<textFormat>Color hex code</textFormat>
		<skos:definition>This is the preferred color for the overlay for screen enhancement defined as part of an Assessment Personal Needs Profile.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001053">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001053</dc:identifier>
		<rdfs:label>Assessment Need Background Color</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200033" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentNeedBackgroundColor</skos:notation>
		<dc:description>This is the preferred Background color for screen enhancement defined as part of an Assessment Personal Needs Profile.</dc:description>
		<minLength>6</minLength>
		<maxLength>6</maxLength>
		<textFormat>Color hex code</textFormat>
		<skos:definition>This is the preferred Background color for screen enhancement defined as part of an Assessment Personal Needs Profile.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001047">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001047</dc:identifier>
		<rdfs:label>Assessment Need Text Messaging String</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200034" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentNeedTextMessagingString</skos:notation>
		<dc:description>The text string that is to be displayed to the user as an expression of encouragement when Masking is specified as part of an Assessment Personal Needs Profile.  It is left to the system to determine when to display this string.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The text string that is to be displayed to the user as an expression of encouragement when Masking is specified as part of an Assessment Personal Needs Profile.  It is left to the system to determine when to display this string.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001048">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001048</dc:identifier>
		<rdfs:label>Assessment Need Sound File URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200034" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentNeedSoundFileURL</skos:notation>
		<dc:description>The URI of the sound file that is to be played to the user as an expression of encouragement when Masking is specified as part of an Assessment Personal Needs Profile. It is left to the system to determine when to play this audio file.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The URI of the sound file that is to be played to the user as an expression of encouragement when Masking is specified as part of an Assessment Personal Needs Profile. It is left to the system to determine when to play this audio file.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001034">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001034</dc:identifier>
		<rdfs:label>Assessment Need Number of Braille Cells</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200035" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentNeedNumberOfBrailleCells</skos:notation>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the number of active Braille cells in a Braille display.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>Defines as part of an Assessment Personal Needs Profile the number of active Braille cells in a Braille display.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001036">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001036</dc:identifier>
		<rdfs:label>Assessment Need Braille Dot Pressure</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200035" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentNeedBrailleDotPressure</skos:notation>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the resistance pressure of Braille display pins.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>999999</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>4</decimalPlaces>
		<skos:definition>Defines as part of an Assessment Personal Needs Profile the resistance pressure of Braille display pins.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001031">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001031</dc:identifier>
		<rdfs:label>Assessment Need Magnification</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200036" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentNeedMagnification</skos:notation>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the preferred magnification of the screen as a factor of a screen's original size.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>999999</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>4</decimalPlaces>
		<skos:definition>Defines as part of an Assessment Personal Needs Profile the preferred magnification of the screen as a factor of a screen's original size.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001052">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001052</dc:identifier>
		<rdfs:label>Assessment Need Foreground Color</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200036" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentNeedForegroundColor</skos:notation>
		<dc:description>This is the preferred Foreground color for screen enhancement defined as part of an Assessment Personal Needs Profile.</dc:description>
		<minLength>6</minLength>
		<maxLength>6</maxLength>
		<textFormat>Color hex code</textFormat>
		<skos:definition>This is the preferred Foreground color for screen enhancement defined as part of an Assessment Personal Needs Profile.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000407">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000407</dc:identifier>
		<rdfs:label>Assessment Participant Session Time Assessed</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentParticipantSessionTimeAssessed</skos:notation>
		<dc:description>The overall time a learner actually spent during the  assessment session.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The overall time a learner actually spent during the  assessment session.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name and definition.  Element now specific to a session.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001003">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001003</dc:identifier>
		<rdfs:label>Assessment Participant Session Delivery Device Details</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentParticipantSessionDeliveryDeviceDetails</skos:notation>
		<dc:description>The details about the device or platform by with which the assessment was delivered to the learner.</dc:description>
		<rdfs:comment>For example web browser version and screen resolution.</rdfs:comment>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The details about the device or platform by with which the assessment was delivered to the learner.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001021">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001021</dc:identifier>
		<rdfs:label>Assessment Session Actual Start Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200049" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>AssessmentSessionActualStartDateTime</skos:notation>
		<dc:description>Date and time the assessment actually began.</dc:description>
		<rdfs:comment>When associated to an assessment session this is the actual start date and time.  When associated to an individual taking an assessment, this is the actual date and time when the individual started.</rdfs:comment>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>Date and time the assessment actually began.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001022">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001022</dc:identifier>
		<rdfs:label>Assessment Session Actual End Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200049" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>AssessmentSessionActualEndDateTime</skos:notation>
		<dc:description>Date and time the assessment actually ended.</dc:description>
		<rdfs:comment>When associated to an assessment session this is the actual end date and time.  When associated to an individual taking an assessment, this is the actual date and time when the individual finished.</rdfs:comment>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>Date and time the assessment actually ended.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001093">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001093</dc:identifier>
		<rdfs:label>Assessment Session Special Event Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200049" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSessionSpecialEventDescription</skos:notation>
		<dc:description>Describes special events that occur before during or after the assessment session that may impact use of results according to rules related to the Assessment Registration Testing Indicator.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Describes special events that occur before during or after the assessment session that may impact use of results according to rules related to the Assessment Registration Testing Indicator.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001130">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001130</dc:identifier>
		<rdfs:label>Assessment Participant Session Security Issue</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentParticipantSessionSecurityIssue</skos:notation>
		<dc:description>Describes an issue related to the security of a testing instrument identified during a specific instance of delivering an assessment to a specific person during a specific time period.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Describes an issue related to the security of a testing instrument identified during a specific instance of delivering an assessment to a specific person during a specific time period.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001152">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001152</dc:identifier>
		<rdfs:label>Assessment Participant Session Platform User Agent</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentParticipantSessionPlatformUserAgent</skos:notation>
		<dc:description> A list of product tokens (keywords) with optional comments that identifies the client hardware and software with which the assessment was delivered to the student during the assessment session.</dc:description>
		<rdfs:comment>Implementation Note: The recommended approach is to store the User-Agent string returned as part of an HTTP header.  For example, an assessment session delivery via iPad might have "Mozilla/5.0 (iPad; U; CPU OS 3_2_1 like Mac OS X; en-us) AppleWebKit/531.21.10 (KHTML, like Gecko) Mobile/7B405"</rdfs:comment>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition> A list of product tokens (keywords) with optional comments that identifies the client hardware and software with which the assessment was delivered to the student during the assessment session.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001539">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001539</dc:identifier>
		<rdfs:label>Assessment Participant Session Database Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200037" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentParticipantSessionDatabaseName</skos:notation>
		<dc:description>The name of the database that was used to administer the test.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the database that was used to administer the test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000417">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000417</dc:identifier>
		<rdfs:label>Has Assessment Performance Level Score Metric</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200038" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000417" />
		<skos:notation>hasAssessmentPerformanceLevelScoreMetric</skos:notation>
		<dc:description>The metric or scale used for score reporting.</dc:description>
		<skos:definition>The metric or scale used for score reporting.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000418">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000418</dc:identifier>
		<rdfs:label>Assessment Performance Level Lower Cut Score</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200038" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentPerformanceLevelLowerCutScore</skos:notation>
		<dc:description>Lowest possible score for the performance level.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Lowest possible score for the performance level.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name from Assessment Performance Level Minimum Cut Score.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000419">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000419</dc:identifier>
		<rdfs:label>Assessment Performance Level Upper Cut Score</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200038" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentPerformanceLevelUpperCutScore</skos:notation>
		<dc:description>Highest possible score for the performance level.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Highest possible score for the performance level.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name from Assessment Performance Level Maximum Cut Score.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000717">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000717</dc:identifier>
		<rdfs:label>Assessment Performance Level Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200038" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentPerformanceLevelIdentifier</skos:notation>
		<dc:description>A unique number or alphanumeric code assigned to an assessment performance level.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique number or alphanumeric code assigned to an assessment performance level.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000718">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000718</dc:identifier>
		<rdfs:label>Assessment Performance Level Label</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200038" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentPerformanceLevelLabel</skos:notation>
		<dc:description>A label representing the performance level appropriate for use on a report.</dc:description>
		<maxLength>20</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A label representing the performance level appropriate for use on a report.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Element name changed from Assessment Performance Level Short Name.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001218">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001218</dc:identifier>
		<rdfs:label>Assessment Performance Level Descriptive Feedback</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200038" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentPerformanceLevelDescriptiveFeedback</skos:notation>
		<dc:description>A feedback message designed to be reported with the assessment performance level.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A feedback message designed to be reported with the assessment performance level.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001028">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001028</dc:identifier>
		<rdfs:label>Assessment Need Speech Rate</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200040" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentNeedSpeechRate</skos:notation>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the rate of speech of a speech synthesizer.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>Defines as part of an Assessment Personal Needs Profile the rate of speech of a speech synthesizer.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001029">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001029</dc:identifier>
		<rdfs:label>Assessment Need Volume</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200040" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentNeedVolume</skos:notation>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the volume of a speech synthesizer.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>999999</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>4</decimalPlaces>
		<skos:definition>Defines as part of an Assessment Personal Needs Profile the volume of a speech synthesizer.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001087">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001087</dc:identifier>
		<rdfs:label>Assessment Need Pitch</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200040" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentNeedPitch</skos:notation>
		<dc:description>Defines as part of an Assessment Personal Needs Profile the pitch of a speech synthesizer.</dc:description>
		<minInclusive>0</minInclusive>
		<maxInclusive>999999</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>4</decimalPlaces>
		<skos:definition>Defines as part of an Assessment Personal Needs Profile the pitch of a speech synthesizer.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001127">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001127</dc:identifier>
		<rdfs:label>Assessment Need Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200041" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentNeedType</skos:notation>
		<dc:description>A type of need identified for a learner as part of an assessment need profile.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A type of need identified for a learner as part of an assessment need profile.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000889">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000889</dc:identifier>
		<rdfs:label>Assessment Registration Assignor Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200046" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentRegistrationAssignorIdentifier</skos:notation>
		<dc:description>The unique identifier of the person who assigned the assessment to the learner.</dc:description>
		<rdfs:comment>For example, the unique identifier of a classroom teacher or school principal.&lt;BR/&gt;&lt;BR/&gt;CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;BR/&gt;&lt;BR/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The unique identifier of the person who assigned the assessment to the learner.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001015">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001015</dc:identifier>
		<rdfs:label>Assessment Registration Days of Instruction</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200046" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentRegistrationDaysOfInstruction</skos:notation>
		<dc:description>The number of days of instruction the student has taken prior to testing.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The number of days of instruction the student has taken prior to testing.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001017">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001017</dc:identifier>
		<rdfs:label>Assessment Registration Creation Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200046" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>AssessmentRegistrationCreationDate</skos:notation>
		<dc:description>Date/time assignment is made.</dc:description>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>Date/time assignment is made.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001055">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001055</dc:identifier>
		<rdfs:label>Assessment Registration Testing Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200046" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentRegistrationTestingIndicator</skos:notation>
		<dc:description>Indicates rules about use of results based on Special Events before, during or after the test. The option set values are determined by the testing program.</dc:description>
		<rdfs:comment>For example, "do not score", "do not report".</rdfs:comment>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Indicates rules about use of results based on Special Events before, during or after the test. The option set values are determined by the testing program.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Correcting element definition for "Assessment Registration Testing Indicator", adding a comma between the words "before" and "during"</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001056">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001056</dc:identifier>
		<rdfs:label>Assessment Registration Score Publish Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200046" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentRegistrationScorePublishDate</skos:notation>
		<dc:description>The date set by the testing program when the test scores are published.  For formative or classroom assessments, this will likely be the date when the scored the individual test.  For summative assessments, this date is likely set for a group of assessments when the processing system releases the scores.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date set by the testing program when the test scores are published.  For formative or classroom assessments, this will likely be the date when the scored the individual test.  For summative assessments, this date is likely set for a group of assessments when the processing system releases the scores.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001162">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001162</dc:identifier>
		<rdfs:label>Assessment Registration Test Attempt Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200046" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentRegistrationTestAttemptIdentifier</skos:notation>
		<dc:description>A unique identifier for the test attempt assigned by the delivery system.</dc:description>
		<rdfs:comment>For paper-based tests this is typically a batch/stack/serial number and for online tests it is likely a unique internal identifier. Used to locate the original attempt.&lt;br/&gt;&lt;br/&gt;CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique identifier for the test attempt assigned by the delivery system.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001542">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001542</dc:identifier>
		<rdfs:label>Assessment Registration Completion Status Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200046" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>AssessmentRegistrationCompletionStatusDateTime</skos:notation>
		<dc:description>The date and time the completion and scoring status was changed for an instance of a person taking an assessment.</dc:description>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>The date and time the completion and scoring status was changed for an instance of a person taking an assessment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000245">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000245</dc:identifier>
		<rdfs:label>Assessment Result Score Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentResultScoreValue</skos:notation>
		<dc:description>A meaningful raw score, derived score, or statistical expression of the performance of a person on an assessment. The type of result is indicated by the Assessment Score Metric Type element. The results can be expressed as a number, percentile, range, level, etc. The score relates to all scored items or a sub test scoring one aspect of performance on the test. This value may or may not correspond to one or more Performance Levels.</dc:description>
		<rdfs:comment>Information for interpreting the score is defined by elements in the related Assessment Subtest entity.  This includes the minimum, maximum, and optimal values for the measurement. Assessment Subtest defines information for scoring an Assessment Form, which may be for the entire assessment or one aspect of evaluation. The Assessment Subtest may in turn be associated with one or more content standards using the Learning Standard Item Association entity.</rdfs:comment>
		<maxLength>35</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A meaningful raw score, derived score, or statistical expression of the performance of a person on an assessment. The type of result is indicated by the Assessment Score Metric Type element. The results can be expressed as a number, percentile, range, level, etc. The score relates to all scored items or a sub test scoring one aspect of performance on the test. This value may or may not correspond to one or more Performance Levels.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Subtest Result Score Value.  Definition was modified.  Added Usage Note.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000370">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000370</dc:identifier>
		<rdfs:label>Instructional Recommendation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>InstructionalRecommendation</skos:notation>
		<dc:description>This provides the next steps for instruction for the student based upon the assessment results and student characteristics.</dc:description>
		<maxLength>100</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>This provides the next steps for instruction for the student based upon the assessment results and student characteristics.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000890">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000890</dc:identifier>
		<rdfs:label>Assessment Result Descriptive Feedback</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentResultDescriptiveFeedback</skos:notation>
		<dc:description>The formative descriptive feedback that was given to a learner based on a scored/evaluated portion of an assessment as recorded in the result entity.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The formative descriptive feedback that was given to a learner based on a scored/evaluated portion of an assessment as recorded in the result entity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Subtest Result Descriptive Feedback.  Updated defintion.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000970">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000970</dc:identifier>
		<rdfs:label>Assessment Result Date Updated</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentResultDateUpdated</skos:notation>
		<dc:description>The most recent date that the result was calculated/updated.  The value should be the same as Assessment Result Date Created if the subtest has only been scored once, but may be different if the score was recalculated with a different result.</dc:description>
		<rdfs:comment>This flag is to handle cases when a subtest result is originally scored using incorrect parameters and then rescored, such as if the grade level attributed to the student was originally encoded incorrectly and later corrected.  An operational system may also capture the history of if rescored more than once.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The most recent date that the result was calculated/updated.  The value should be the same as Assessment Result Date Created if the subtest has only been scored once, but may be different if the score was recalculated with a different result.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Subtest Result Date Updated.  Modified definition.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000971">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000971</dc:identifier>
		<rdfs:label>Assessment Result Date Created</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentResultDateCreated</skos:notation>
		<dc:description>The date on which the assessment result was generated.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the assessment result was generated.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Subtest Result Date Created.  Modified definition.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001008">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001008</dc:identifier>
		<rdfs:label>Diagnostic Statement Source</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>DiagnosticStatementSource</skos:notation>
		<dc:description>Identifies the source of the Diagnostic Statement based on a scored/evaluated portion of an assessment.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Identifies the source of the Diagnostic Statement based on a scored/evaluated portion of an assessment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001009">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001009</dc:identifier>
		<rdfs:label>Assessment Result Number of Responses</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentResultNumberOfResponses</skos:notation>
		<dc:description>The number of responses that are included with the Student Score Set. Responses are those items that were attempted (partially or fully answered) by the student and not necessarily the number of items in the assessment (which can be determined from the assessment object).</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>The number of responses that are included with the Student Score Set. Responses are those items that were attempted (partially or fully answered) by the student and not necessarily the number of items in the assessment (which can be determined from the assessment object).</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Subtest Result Number of Responses.  Updated definition.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001092">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001092</dc:identifier>
		<rdfs:label>Assessment Result Descriptive Feedback Source</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentResultDescriptiveFeedbackSource</skos:notation>
		<dc:description>Identifies the source of the descriptive feedback that was given to a learner based on a scored/evaluated portion of an assessment. May indicate if this is teacher, scorer, or system generated feedback. Values for this attribute would be determined by the assessment program.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Identifies the source of the descriptive feedback that was given to a learner based on a scored/evaluated portion of an assessment. May indicate if this is teacher, scorer, or system generated feedback. Values for this attribute would be determined by the assessment program.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Subtest Result Descriptive Feedback Source.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001219">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001219</dc:identifier>
		<rdfs:label>Assessment Result Diagnostic Statement</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentResultDiagnosticStatement</skos:notation>
		<dc:description>A statement intended for use by education professionals, using professional terminology, to interpret learner needs based on the scored/evaluated portion of an assessment.  This statement may inform Descriptive Feedback given to the learner.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A statement intended for use by education professionals, using professional terminology, to interpret learner needs based on the scored/evaluated portion of an assessment.  This statement may inform Descriptive Feedback given to the learner.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Subtest Result Diagnostic Statement.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001545">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001545</dc:identifier>
		<rdfs:label>Assessment Result Descriptive Feedback Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>AssessmentResultDescriptiveFeedbackDateTime</skos:notation>
		<dc:description>The date and time the descriptive feedback was entered for a scored/evaluated portion of an assessment.</dc:description>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>The date and time the descriptive feedback was entered for a scored/evaluated portion of an assessment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001546">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001546</dc:identifier>
		<rdfs:label>Assessment Result Score Value Standard Error</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentResultScoreValueStandardError</skos:notation>
		<dc:description>The measure of sampling variability and measurement error for the score, the amount of error to be expected in the score.</dc:description>
		<rdfs:comment>See http://nces.ed.gov/nationsreportcard/NDEHelp/WebHelp/standard_error.htm</rdfs:comment>
		<textFormat>Numeric</textFormat>
		<skos:definition>The measure of sampling variability and measurement error for the score, the amount of error to be expected in the score.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Renamed from Assessment Result Score Standard Error to Assessment Result Score Value Standard Error for consistency with Assessment Result Score Value</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1005</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000408">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000408</dc:identifier>
		<rdfs:label>Assessment Session Allotted Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200049" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>AssessmentSessionAllottedTime</skos:notation>
		<dc:description>The duration of time allotted for the assessment session.</dc:description>
		<textFormat>HH:MM:SS or HH:MM:SS.sss</textFormat>
		<skos:definition>The duration of time allotted for the assessment session.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name and definition.  Element now specific to a session.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000597">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000597</dc:identifier>
		<rdfs:label>Assessment Session Location</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200049" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSessionLocation</skos:notation>
		<dc:description> The description of the place where an assessment is administered.</dc:description>
		<maxLength>45</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition> The description of the place where an assessment is administered.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name: added Session.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000968">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000968</dc:identifier>
		<rdfs:label>Assessment Session Security Issue</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200049" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSessionSecurityIssue</skos:notation>
		<dc:description>The description of a security issue, if any, discovered for an administration of an assessment, such as suspected cheating by a student or a teacher changing answers after a student takes the test.</dc:description>
		<rdfs:comment>For example: Suspected plagiarism ; Computer left test window ; Excessive response time ; Proctor suspected copying ; Student identity not confirmed ; No proctor present ; Student carried wireless mobile device during test ; Student terminated test early and restarted ; Excessive erasures on test form ; Response pattern identical to another student's</rdfs:comment>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The description of a security issue, if any, discovered for an administration of an assessment, such as suspected cheating by a student or a teacher changing answers after a student takes the test.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001019">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001019</dc:identifier>
		<rdfs:label>Assessment Session Scheduled Start Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200049" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>AssessmentSessionScheduledStartDateTime</skos:notation>
		<dc:description>Date and time the assessment is scheduled to begin.</dc:description>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>Date and time the assessment is scheduled to begin.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001020">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001020</dc:identifier>
		<rdfs:label>Assessment Session Scheduled End Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200049" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>AssessmentSessionScheduledEndDateTime</skos:notation>
		<dc:description>Date and time the assessment is scheduled to end.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>Date and time the assessment is scheduled to end.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000274">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000274</dc:identifier>
		<rdfs:label>Assessment Subtest Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestDescription</skos:notation>
		<dc:description>The description of the subtest (e.g., vocabulary, measurement, or geometry).</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The description of the subtest (e.g., vocabulary, measurement, or geometry).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000275">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000275</dc:identifier>
		<rdfs:label>Assessment Subtest Title</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestTitle</skos:notation>
		<dc:description>The name or title of the subtest.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>300 characters maximum</textFormat>
		<skos:definition>The name or title of the subtest.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry>
				<changeDescription>Corrected maxLength to match text format of 300 characters.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/98</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Modify element format maximum length</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Subtest Name.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Duplicate of other assessment element.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000367">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000367</dc:identifier>
		<rdfs:label>Assessment Subtest Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestIdentifier</skos:notation>
		<dc:description>A unique number or alphanumeric code assigned to an assessment subtest.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A unique number or alphanumeric code assigned to an assessment subtest.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000368">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000368</dc:identifier>
		<rdfs:label>Assessment Subtest Abbreviation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestAbbreviation</skos:notation>
		<dc:description>The shortened name identifying the assessment for use in reference and/or reports.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The shortened name identifying the assessment for use in reference and/or reports.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000388">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000388</dc:identifier>
		<rdfs:label>Assessment Subtest Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestVersion</skos:notation>
		<dc:description>The version of the subtest that is included for the assessment.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The version of the subtest that is included for the assessment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000395">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000395</dc:identifier>
		<rdfs:label>Assessment Subtest Minimum Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestMinimumValue</skos:notation>
		<dc:description>The minimum value possible for the measurement.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The minimum value possible for the measurement.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Score Scale Minimum Value.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000396">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000396</dc:identifier>
		<rdfs:label>Assessment Subtest Maximum Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestMaximumValue</skos:notation>
		<dc:description>The maximum value for the measurement.</dc:description>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The maximum value for the measurement.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Score Scale Maximum Value.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000397">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000397</dc:identifier>
		<rdfs:label>Assessment Subtest Optimal Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestScaleOptimalValue</skos:notation>
		<dc:description>The optimal value for this measurement.</dc:description>
		<rdfs:comment>The Optimal Value may be the same as the Maximum Value, the Minimum Value, or something in between.</rdfs:comment>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The optimal value for this measurement.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Assessment Score Scale Optimal Value.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000719">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000719</dc:identifier>
		<rdfs:label>Assessment Subtest Rules</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AssessmentSubtestRules</skos:notation>
		<dc:description>A description of the rules to produce a student test/subtest score from for a grouping of student item scores.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the rules to produce a student test/subtest score from for a grouping of student item scores.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001091">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001091</dc:identifier>
		<rdfs:label>Assessment Subtest Published Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AssessmentSubtestPublishedDate</skos:notation>
		<dc:description>The date on which the Subtest was published.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the Subtest was published.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001214">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001214</dc:identifier>
		<rdfs:label>Assessment Form Subtest Tier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#int" />
		<skos:notation>AssessmentFormSubtestTier</skos:notation>
		<dc:description>In a hierarchy of subtests, this element represents the level of the sub test in the hierarchy.  The top tier and default is zero.</dc:description>
		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>In a hierarchy of subtests, this element represents the level of the sub test in the hierarchy.  The top tier and default is zero.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001010">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001010</dc:identifier>
		<rdfs:label>Assessment Form Subtest Item Weight Correct</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200052" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentFormSubtestItemWeightCorrect</skos:notation>
		<dc:description>A weighting factor for how the item score is used to compute a sub-test score when the item is correct or partially correct. Item weight of 1 indicates the full item score is used. A weight of .5 would indicate the item only contributes one half of the item score to the subtest. A weight of 0 indicates the item does not affect the sub test score.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>A weighting factor for how the item score is used to compute a sub-test score when the item is correct or partially correct. Item weight of 1 indicates the full item score is used. A weight of .5 would indicate the item only contributes one half of the item score to the subtest. A weight of 0 indicates the item does not affect the sub test score.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001012">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001012</dc:identifier>
		<rdfs:label>Assessment Form Subtest Item Weight Incorrect</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200052" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentFormSubtestItemWeightIncorrect</skos:notation>
		<dc:description>A weighting factor for how the item score is used to compute a sub-test score when the item is attempted and incorrect. Item weight should be a negative value if the item subtracts from the score if missed.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>A weighting factor for how the item score is used to compute a sub-test score when the item is attempted and incorrect. Item weight should be a negative value if the item subtracts from the score if missed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001013">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001013</dc:identifier>
		<rdfs:label>Assessment Form Subtest Item Weight Not Attempted</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200052" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>AssessmentFormSubtestItemWeightNotAttempted</skos:notation>
		<dc:description>A weighting factor for how the item score is used to compute a sub-test score when the item has not been attempted by the student. Item weight should be a negative value if the item subtracts from the score if not attempted.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>A weighting factor for how the item score is used to compute a sub-test score when the item has not been attempted by the student. Item weight should be a negative value if the item subtracts from the score if not attempted.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001168">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001168</dc:identifier>
		<rdfs:label>Authentication Identity Provider Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200054" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AuthenticationIdentityProviderName</skos:notation>
		<dc:description>The name of a provider that can authenticate the identity of an person.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of a provider that can authenticate the identity of an person.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001169">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001169</dc:identifier>
		<rdfs:label>Authentication Identity Provider URI</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200054" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AuthenticationIdentityProviderURI</skos:notation>
		<dc:description>The Uniform Resource Identifier (URI) of the  Authentication Identity Provider.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The Uniform Resource Identifier (URI) of the  Authentication Identity Provider.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001170">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001170</dc:identifier>
		<rdfs:label>Authentication Identity Provider Login Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200054" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AuthenticationIdentityProviderLoginIdentifier</skos:notation>
		<dc:description>The login identifier for the person for the specified Authentication Identity Provider.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &lt;br/&gt;&lt;br/&gt;An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The login identifier for the person for the specified Authentication Identity Provider.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed size and XML Schema type.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001171">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001171</dc:identifier>
		<rdfs:label>Authentication Identity Provider Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200054" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AuthenticationIdentityProviderStartDate</skos:notation>
		<dc:description>The date on which the  an associated person may begin to use the specified Authentication Identity Provider to authenticate identity.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the  an associated person may begin to use the specified Authentication Identity Provider to authenticate identity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001172">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001172</dc:identifier>
		<rdfs:label>Authentication Identity Provider End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200054" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AuthenticationIdentityProviderEndDate</skos:notation>
		<dc:description>The date after which the  an associated person is no longer allowed to use the specified Authentication Identity Provider to authenticate identity.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date after which the  an associated person is no longer allowed to use the specified Authentication Identity Provider to authenticate identity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001175">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001175</dc:identifier>
		<rdfs:label>Authorization Application Role Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200055" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AuthorizationApplicationRoleName</skos:notation>
		<dc:description>The user role for which the person is allowed.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The user role for which the person is allowed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001176">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001176</dc:identifier>
		<rdfs:label>Authorization Start Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200055" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AuthorizationStartDate</skos:notation>
		<dc:description>The date on which the  an associated person  is authorized to start using the application with the specified role.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date on which the  an associated person  is authorized to start using the application with the specified role.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001177">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001177</dc:identifier>
		<rdfs:label>Authorization End Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200055" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>AuthorizationEndDate</skos:notation>
		<dc:description>The date after which the  an associated person is no longer allowed to use the application with the specified role.</dc:description>
		<rdfs:comment>All CEDS Exit and End Dates represent the last day of the date range specified, such as the last day that a person was enrolled, participated, or received services.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>The date after which the  an associated person is no longer allowed to use the application with the specified role.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding usage note to clarify that exit dates are inclusive, i.e. the dates represent the last day that the person was enrolled, participated, or received services, not the day after.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001722">
		<dc:creator>Common Education Data Standards</dc:creator>
