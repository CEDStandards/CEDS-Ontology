	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002022">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002022</dc:identifier>
		<rdfs:label>Has Chronic Student Absenteeism Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200350" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002022" />
		<skos:notation>hasChronicStudentAbsenteeismIndicator</skos:notation>
		<dc:description>Indicates whether a student was absent 10% or more school days during the school year with an absence being defined as a student not physically on school grounds and was not participating in instruction or instruction-related activities at an approved off-grounds location for at least half the school day.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates whether a student was absent 10% or more school days during the school year with an absence being defined as a student not physically on school grounds and was not participating in instruction or instruction-related activities at an approved off-grounds location for at least half the school day.</skos:definition>
	</rdf:Property>
