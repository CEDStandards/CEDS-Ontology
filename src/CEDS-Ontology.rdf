		<skos:definition>The type of work assigned to the learner.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600395">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600395</dc:identifier>
		<rdfs:label>Has Learning Resource Adaptation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200229" />
		<skos:notation>hasLearningResourceAdaptation</skos:notation>
		<dc:description>References information that links a learning resource record to one or more available aptations based on this resource.</dc:description>
