	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000105">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000105</dc:identifier>
		<rdfs:label>Staff Evaluation System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200366" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>StaffEvaluationSystem</skos:notation>
		<dc:description>The instrument and/or set of procedures with which a person's performance is assessed.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The instrument and/or set of procedures with which a person's performance is assessed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001985">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001985</dc:identifier>
		<rdfs:label>Staff Evaluation Part Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200367" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>StaffEvaluationPartName</skos:notation>
		<dc:description>The name of the component part that is being evaluated and scored.</dc:description>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The name of the component part that is being evaluated and scored.</skos:definition>
