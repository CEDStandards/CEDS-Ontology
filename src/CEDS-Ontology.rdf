				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002202928283">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who follows the monotheistic religion of Catholic Christianity, especially that of the Roman Catholic Church. Followers of this faith believe the teachings of the Bible, and place emphasis on church traditions, including the historical continuity of the church, the Pope as the head of the church, and the requirement of celibacy of those in the priesthood.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002202928283</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Catholic</rdfs:label>
		<skos:definition>A person who follows the monotheistic religion of Catholic Christianity, especially that of the Roman Catholic Church. Followers of this faith believe the teachings of the Bible, and place emphasis on church traditions, including the historical continuity of the church, the Pope as the head of the church, and the requirement of celibacy of those in the priesthood.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>Catholic</skos:notation>
		<skos:prefLabel>Catholic</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New named individual (option set) created for Harassment or Bullying Religion Type per CRDC requirements</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1056</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002202928284">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who follows the monotheistic religion of the Eastern Christian Church. This faith follows the teachings of the Bible and church traditions, accords primacy of honor to the Patriarch of Constantinople as head of the church, and adheres to the decisions of the First Seven Ecumenical Councils and the Byzantine Rite.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002202928284</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Eastern Orthodox (Russian, Greek, Other)</rdfs:label>
		<skos:definition>A person who follows the monotheistic religion of the Eastern Christian Church. This faith follows the teachings of the Bible and church traditions, accords primacy of honor to the Patriarch of Constantinople as head of the church, and adheres to the decisions of the First Seven Ecumenical Councils and the Byzantine Rite.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>EasternOrthodox</skos:notation>
		<skos:prefLabel>Eastern Orthodox (Russian, Greek, Other)</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New named individual (option set) created for Harassment or Bullying Religion Type per CRDC requirements</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1056</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002202928285">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who observes the traditions and practices of the dominant religion of India, which include acceptance of the sanctity of the Vedas (sacred texts); the understanding of one Divine Reality manifested in multiple forms; acceptance of the laws of karma (principle of cause and effect), dharma (righteous modes of conduct), belief in reincarnation, and the ultimate spiritual goal of enlightenment (moksha).</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002202928285</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Hindu</rdfs:label>
		<skos:definition>A person who observes the traditions and practices of the dominant religion of India, which include acceptance of the sanctity of the Vedas (sacred texts); the understanding of one Divine Reality manifested in multiple forms; acceptance of the laws of karma (principle of cause and effect), dharma (righteous modes of conduct), belief in reincarnation, and the ultimate spiritual goal of enlightenment (moksha).</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>Hindu</skos:notation>
		<skos:prefLabel>Hindu</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New named individual (option set) created for Harassment or Bullying Religion Type per CRDC requirements</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1056</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002202928286">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who follows the monotheistic religion of Muslims, which includes belief in Allah as the sole deity and in Muhamad as his prophet. Practitioners of the Islamic faith follow the teachings of the Koran and practice the Five Pillars of Islam: praying, fasting during Ramadan, almsgiving, pilgrimage, and declaration of faith.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002202928286</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Islamic (Muslim)</rdfs:label>
		<skos:definition>A person who follows the monotheistic religion of Muslims, which includes belief in Allah as the sole deity and in Muhamad as his prophet. Practitioners of the Islamic faith follow the teachings of the Koran and practice the Five Pillars of Islam: praying, fasting during Ramadan, almsgiving, pilgrimage, and declaration of faith.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>Islamic</skos:notation>
		<skos:prefLabel>Islamic (Muslim)</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New named individual (option set) created for Harassment or Bullying Religion Type per CRDC requirements</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1056</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002202928287">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who follows the religion founded by Charles Taze Russell. Members witness by distributing literature and by personal evangelism of beliefs in the theocratic rule of God, the sinfulness of organized religions and governments, and an imminent millennium. The activities of Jehovah's Witnesses are governed by the Watchtower Society which makes all major decisions, interprets the Bible, and counsels Witnesses using Watchtower materials. Members of the faith are often seen giving generously of their time in proclaiming their faith and teaching in private homes.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002202928287</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Jehovah's Witness</rdfs:label>
		<skos:definition>A person who follows the religion founded by Charles Taze Russell. Members witness by distributing literature and by personal evangelism of beliefs in the theocratic rule of God, the sinfulness of organized religions and governments, and an imminent millennium. The activities of Jehovah's Witnesses are governed by the Watchtower Society which makes all major decisions, interprets the Bible, and counsels Witnesses using Watchtower materials. Members of the faith are often seen giving generously of their time in proclaiming their faith and teaching in private homes.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>JehovahsWitness</skos:notation>
		<skos:prefLabel>Jehovah's Witness</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
		<editHistoryEntry>
				<changeDescription>New named individual (option set) created for Harassment or Bullying Religion Type per CRDC requirements</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1056</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002202928288">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who identifies himself or herself as a member of the religious and/or ethnic group that descended from the ancient Hebrews and is characterized by belief in one transcendent God who revealed Himself to Abraham, Moses, and the Hebrew prophets. Jewish religious practice is based on the Hebrew Scriptures (the "Torah") and rabbinic laws and customs.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002202928288</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Jewish (Judaism)</rdfs:label>
		<skos:definition>A person who identifies himself or herself as a member of the religious and/or ethnic group that descended from the ancient Hebrews and is characterized by belief in one transcendent God who revealed Himself to Abraham, Moses, and the Hebrew prophets. Jewish religious practice is based on the Hebrew Scriptures (the "Torah") and rabbinic laws and customs.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>Jewish</skos:notation>
		<skos:prefLabel>Jewish (Judaism)</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New named individual (option set) created for Harassment or Bullying Religion Type per CRDC requirements</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1056</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002202928289">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A person who follows the Church of Jesus Christ of Latter-day Saints tracing its modern origin to Joseph Smith and accepting the Book of Mormon as scripture. Latter-day Saints consider the following writings to be scripture: 1) The Holy Bible; 2) The Book of Mormon, Another Testament of Jesus Christ; 3) The Doctrine and Covenants; and 4) The Pearl of Great Price. Mormons are often associated with members of the faith who serve as full-time volunteer missionaries in the U.S. and abroad.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002202928289</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Mormon (Latter-day Saint)</rdfs:label>
		<skos:definition>A person who follows the Church of Jesus Christ of Latter-day Saints tracing its modern origin to Joseph Smith and accepting the Book of Mormon as scripture. Latter-day Saints consider the following writings to be scripture: 1) The Holy Bible; 2) The Book of Mormon, Another Testament of Jesus Christ; 3) The Doctrine and Covenants; and 4) The Pearl of Great Price. Mormons are often associated with members of the faith who serve as full-time volunteer missionaries in the U.S. and abroad.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>Mormon</skos:notation>
		<skos:prefLabel>Mormon (Latter-day Saint)</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New named individual (option set) created for Harassment or Bullying Religion Type per CRDC requirements</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/1056</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI002202928290">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A group of persons demonstrating a commitment or devotion to religious faith or observance based upon multiple faiths.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI002202928290</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Multiple Religions, Group</rdfs:label>
		<skos:definition>A group of persons demonstrating a commitment or devotion to religious faith or observance based upon multiple faiths.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C002202" />
		<skos:notation>MultipleReligions</skos:notation>
		<skos:prefLabel>Multiple Religions, Group</skos:prefLabel>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>New named individual (option set) created for Harassment or Bullying Religion Type per CRDC requirements</changeDescription>
