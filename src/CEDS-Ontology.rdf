		<skos:notation>Probationary</skos:notation>
		<skos:prefLabel>Probationary</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001740127793">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The credential is no longer awarded and has been superseded by another credential.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001740127793</dc:identifier>
