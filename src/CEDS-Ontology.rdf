	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000811">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indication of whether a scholarship was received for the person to participate in the professional development.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000811</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
		<rdfs:label>Professional Development Scholarship Status</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:definition>An indication of whether a scholarship was received for the person to participate in the professional development.</skos:definition>
		<skos:notation>ProfessionalDevelopmentScholarshipStatus</skos:notation>
		<skos:prefLabel>Professional Development Scholarship Status</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C000814">
