		<rdfs:label>Particular Topics in Foundation Mathematics</rdfs:label>
		<skos:definition>These courses examine particular topics in Foundation Mathematics, such as arithmetic, sequences, or basic conceptual skills, rather than provide a general overview.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>02003</skos:notation>
		<skos:prefLabel>Particular Topics in Foundation Mathematics</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163261">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Mathematics (early childhood education) courses cover foundational skills and concepts related to mathematics. Content is age appropriate and conforms to any existing state standards for early childhood education.</dc:description>
