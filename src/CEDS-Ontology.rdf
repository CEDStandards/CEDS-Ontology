		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added two new options and changed the description and definition of the "Correspondence" option code</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Element applied to additional DES contexts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the function and context in which a person uses a language to communicate.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000451">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000451</dc:identifier>
		<rdfs:label>Has Local Education Agency Funds Transfer Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200187" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000451" />
		<skos:notation>hasLEAFundsTransferType</skos:notation>
		<dc:description>An indication of the type of transfer for an LEAs that transferred funds from an eligible program to another eligible program.</dc:description>
		<skos:definition>An indication of the type of transfer for an LEAs that transferred funds from an eligible program to another eligible program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002096">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002096</dc:identifier>
		<rdfs:label>Has LEA GFSA Assurance of Compliance Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200191" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002096" />
		<skos:notation>hasLEAGFSAAssuranceofComplianceIndicator</skos:notation>
		<dc:description>Indicates if a Local Education Agency (LEA) has provided an assurance that it is in compliance with the State law requiring that a student who brings a firearm to school, or possesses a firearm at school, be expelled for one year, except that such State law shall allow the chief administering officer of a local educational agency to modify such expulsion requirement for a student on a case-by-case basis if such modification is in writing.</dc:description>
		<rdfs:comment>This data is part of the requirement for LEAs to adhere to the Gun Free Schools Act (GFSA).</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates if a Local Education Agency (LEA) has provided an assurance that it is in compliance with the State law requiring that a student who brings a firearm to school, or possesses a firearm at school, be expelled for one year, except that such State law shall allow the chief administering officer of a local educational agency to modify such expulsion requirement for a student on a case-by-case basis if such modification is in writing.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002097">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002097</dc:identifier>
		<rdfs:label>Has LEA GFSA Policy Assurance Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200191" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002097" />
		<skos:notation>hasLEAGFSAPolicyAssuranceIndicator</skos:notation>
		<dc:description>Indicates if a Local Education Agency has provided an assurance that it is in compliance with the requirement in Section 4141(h) that an LEA receiving ESEA funds have in place a policy requiring referral to the criminal justice or juvenile delinquency system of any student who brings a firearm to a school or possesses a firearm at school.</dc:description>
		<rdfs:comment>This data is part of the requirement for LEAs to adhere to the Gun Free Schools Act (GFSA).</rdfs:comment>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates if a Local Education Agency has provided an assurance that it is in compliance with the requirement in Section 4141(h) that an LEA receiving ESEA funds have in place a policy requiring referral to the criminal justice or juvenile delinquency system of any student who brings a firearm to a school or possesses a firearm at school.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000173">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000173</dc:identifier>
		<rdfs:label>Has Local Education Agency Improvement Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200188" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000173" />
		<skos:notation>hasLEAImprovementStatus</skos:notation>
		<dc:description>An indication of the improvement stage for AYP of the local education agency (LEA).</dc:description>
		<skos:definition>An indication of the improvement stage for AYP of the local education agency (LEA).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600551">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600551</dc:identifier>
		<rdfs:label>Has Local Education Agency Operational Detail</rdfs:label>
