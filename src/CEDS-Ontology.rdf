		<decimalPlaces>2</decimalPlaces>
		<skos:definition>The estimated cost of replacing a facility using current per square foot estimates of total project costs.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001893">
