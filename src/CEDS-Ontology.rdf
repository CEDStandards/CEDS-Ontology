		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200072"/>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228"/>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200293"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001637"/>
		<skos:notation>hasISO6393LanguageCode</skos:notation>
		<dc:description>The code for the specific language or dialect that a person uses to communicate.</dc:description>
		<rdfs:comment>The CEDS ISO 639-3 Language Code option set comes from the &lt;a href="http://www-01.sil.org/iso639-3/default.asp"&gt;ISO 639-3 standard&lt;/a&gt;, the Latin-1 download.  Only living language code types from the ISO standard are included in the CEDS list.  Special scope and discontinued codes are excluded.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed option set</changeDescription> 	
