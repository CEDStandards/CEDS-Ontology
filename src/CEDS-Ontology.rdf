		<rdfs:label>Writing (early childhood education)</rdfs:label>
		<skos:definition>Writing (early childhood education) courses develop students' readiness for language arts, particularly focusing on writing. Content is age appropriate and conforms to any existing state standards for early childhood education.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517"/>
		<skos:notation>01128</skos:notation>
		<skos:prefLabel>Writing (early childhood education)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163220">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Writing (pre-kindergarten) courses develop students' readiness for language arts, particularly focusing on writing. Content is age appropriate and conforms to any existing state standards for pre-kindergarten education.</dc:description>
