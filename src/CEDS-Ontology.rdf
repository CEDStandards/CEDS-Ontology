		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200218" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200342" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200347" />
