		<maxInclusive>100</maxInclusive>
		<textFormat>Numeric</textFormat>
		<decimalPlaces>8</decimalPlaces>
		<skos:definition>The millage rate used to calculate property tax revenue for K-12 public education.</skos:definition>
	</rdf:Property>
