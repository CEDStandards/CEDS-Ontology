	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI000556116218">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>No disciplinary action taken was the methods used to discipline student(s) who are children with disabilities (IDEA) involved in firearms and other outcomes of firearms incidents.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI000556116218</dc:identifier>
