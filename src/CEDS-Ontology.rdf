		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Developmental Reading</rdfs:label>
		<skos:definition>Developmental Reading is the category of developmental education.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001589" />
		<skos:notation>DevelopmentalReading</skos:notation>
		<skos:prefLabel>Developmental Reading</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129118">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Interest added to the amount of the loan on the front end, or beginning of the loan repayment period. The balance (of principal and interest) is then paid by installments. This form of interest is much more expensive than simple interest paid on the entire amount for the entire term of the loan.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129118</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Add-on interest</rdfs:label>
		<skos:definition>Interest added to the amount of the loan on the front end, or beginning of the loan repayment period. The balance (of principal and interest) is then paid by installments. This form of interest is much more expensive than simple interest paid on the entire amount for the entire term of the loan.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13730</skos:notation>
		<skos:prefLabel>Add-on interest</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129119">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A mortgage in which interest and payment rates vary periodically, based on a specific index, such as 30-year Treasury bills or the Cost-of-Funds index.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129119</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Adjustable-Rate Mortgage (ARM)</rdfs:label>
		<skos:definition>A mortgage in which interest and payment rates vary periodically, based on a specific index, such as 30-year Treasury bills or the Cost-of-Funds index.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13731</skos:notation>
		<skos:prefLabel>Adjustable-Rate Mortgage (ARM)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129120">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A short-term mortgage, generally at a fixed rate of interest, to be paid back in pre-determined, equal monthly payments, with a large, final payment for the balance of the loan paid at the end of the term.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129120</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Balloon Mortgage</rdfs:label>
		<skos:definition>A short-term mortgage, generally at a fixed rate of interest, to be paid back in pre-determined, equal monthly payments, with a large, final payment for the balance of the loan paid at the end of the term.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13732</skos:notation>
		<skos:prefLabel>Balloon Mortgage</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129121">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Interest due but unpaid. Mortgages that permit negative amortization (such as a graduated-payment mortgage or a floating rate loan without a rate cap) will allow deferred interest.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129121</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Deferred Interest</rdfs:label>
		<skos:definition>Interest due but unpaid. Mortgages that permit negative amortization (such as a graduated-payment mortgage or a floating rate loan without a rate cap) will allow deferred interest.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13733</skos:notation>
		<skos:prefLabel>Deferred Interest</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129122">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Periodic payments of principal and interest on a mortgage which remain constant over the loan term.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129122</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Fixed Payment Mortgage</rdfs:label>
		<skos:definition>Periodic payments of principal and interest on a mortgage which remain constant over the loan term.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13734</skos:notation>
		<skos:prefLabel>Fixed Payment Mortgage</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129123">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A mortgage in which the interest rate does not change during the entire term of the loan.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129123</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Fixed-rate Mortgage</rdfs:label>
		<skos:definition>A mortgage in which the interest rate does not change during the entire term of the loan.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13735</skos:notation>
		<skos:prefLabel>Fixed-rate Mortgage</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129124">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An interest rate on a loan which changes during the life of the loan, often monthly, but can change quarterly or annually. These variable rates are based on an index rate and can be used for mortgages and other loans such as lines of credit.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129124</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Floating Rate</rdfs:label>
		<skos:definition>An interest rate on a loan which changes during the life of the loan, often monthly, but can change quarterly or annually. These variable rates are based on an index rate and can be used for mortgages and other loans such as lines of credit.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13736</skos:notation>
		<skos:prefLabel>Floating Rate</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129125">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A method of loan amortization in which equal periodic payments completely repay the loan during the loan term.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129125</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Fully Amortizing Mortgage</rdfs:label>
		<skos:definition>A method of loan amortization in which equal periodic payments completely repay the loan during the loan term.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13737</skos:notation>
		<skos:prefLabel>Fully Amortizing Mortgage</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129126">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A type of stepped-payment loan in which the borrower's payments are initially lower than those on a comparable level-rate mortgage. The payments gradually increase over a predetermined period, and then cap at a final level for the duration of the mortgage.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129126</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Graduated-payment Mortgage (GPM)</rdfs:label>
		<skos:definition>A type of stepped-payment loan in which the borrower's payments are initially lower than those on a comparable level-rate mortgage. The payments gradually increase over a predetermined period, and then cap at a final level for the duration of the mortgage.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891"/>
		<skos:notation>13738</skos:notation>
		<skos:prefLabel>Graduated-payment Mortgage (GPM)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129127">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A method of loan amortization in which interest is paid periodically over the term of the loan and the entire loan amount (principal) is paid at maturity.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129127</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Interest-only loan</rdfs:label>
		<skos:definition>A method of loan amortization in which interest is paid periodically over the term of the loan and the entire loan amount (principal) is paid at maturity.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13739</skos:notation>
		<skos:prefLabel>Interest-only loan</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001891129128">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A mortgage agreement that allows the mortgagor to borrow additional funds from the mortgage lender in the future, normally with a borrowing limit. This limit may be based on loan-to-value or may simply be the original loan amount.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001891129128</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Open-end Mortgage</rdfs:label>
		<skos:definition>A mortgage agreement that allows the mortgagor to borrow additional funds from the mortgage lender in the future, normally with a borrowing limit. This limit may be based on loan-to-value or may simply be the original loan amount.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001891" />
		<skos:notation>13740</skos:notation>
		<skos:prefLabel>Open-end Mortgage</skos:prefLabel>
	</owl:NamedIndividual>
