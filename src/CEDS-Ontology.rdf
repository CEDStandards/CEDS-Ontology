			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The child's parent or guardian is a teen parent between ages 10 to 19 years.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000219">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000219</dc:identifier>
		<rdfs:label>Has Primary Telephone Number Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200272" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000219" />
		<skos:notation>hasPrimaryTelephoneNumberIndicator</skos:notation>
		<dc:description>An indication that the telephone number should be used as the principal number for a person or organization.</dc:description>
		<skos:definition>An indication that the telephone number should be used as the principal number for a person or organization.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001927">
		<dc:creator>Common Education Data Standards</dc:creator>
