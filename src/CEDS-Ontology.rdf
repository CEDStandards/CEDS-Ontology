		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>RubricCriterionDescription</skos:notation>
		<dc:description>Text describing a criterion that must be met to demonstrate quality for a product, process, or performance task.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Text describing a criterion that must be met to demonstrate quality for a product, process, or performance task.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001476">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001476</dc:identifier>
