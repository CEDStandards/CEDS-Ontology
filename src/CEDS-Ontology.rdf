		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001719</dc:identifier>
		<rdfs:label>Has IEP Authorization Document Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200151" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001719" />
		<skos:notation>hasIEPAuthorizationDocumentType</skos:notation>
		<dc:description>Type of Individualized Education Plan document authorized.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Type of Individualized Education Plan document authorized.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001728">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001728</dc:identifier>
		<rdfs:label>Has IEP Eligibility Evaluation Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200165" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001728" />
		<skos:notation>hasIEPEligibilityEvaluationType</skos:notation>
		<dc:description>Purpose within the IEP lifecycle for which the eligibility evaluation is conducted.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Purpose within the IEP lifecycle for which the eligibility evaluation is conducted.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001698">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001698</dc:identifier>
		<rdfs:label>Has IEP Goal Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200166" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001698" />
		<skos:notation>hasIEPGoalType</skos:notation>
		<dc:description>Legal category for an IEP annual goal or short-term objectives.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Legal category for an IEP annual goal or short-term objectives.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001248">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001248</dc:identifier>
		<rdfs:label>Has Immunization Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200292" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001248" />
		<skos:notation>hasImmunizationType</skos:notation>
		<dc:description>An indication of the type of immunization that an individual has satisfactorily received. (Note: The International Classification of Diseases (ICD) is maintained by the World Health Organization. The ICD is revised periodically to incorporate changes in the medical field, the most updated and detailed list of International Statistical Classification of Diseases and Related Health Problems can be found at http://www.who.int/classifications/apps/icd/icd10online).</dc:description>
		<skos:definition>An indication of the type of immunization that an individual has satisfactorily received. (Note: The International Classification of Diseases (ICD) is maintained by the World Health Organization. The ICD is revised periodically to incorporate changes in the medical field, the most updated and detailed list of International Statistical Classification of Diseases and Related Health Problems can be found at http://www.who.int/classifications/apps/icd/icd10online).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600094">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600094</dc:identifier>
		<rdfs:label>Has Incident Person</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200275" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200156" />
		<skos:notation>hasIncidentPerson</skos:notation>
		<dc:description>References the relationship between a person and an Incident involving a student or school.</dc:description>
		<skos:definition>References the relationship between a person and an Incident involving a student or school.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001375">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001375</dc:identifier>
		<rdfs:label>Has Incident Related to Disability Manifestation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001375" />
		<skos:notation>hasIncidentRelatedToDisabilityManifestation</skos:notation>
		<dc:description>An indication whether a student's behavior (offense) was a manifestation of, or related to, a disability condition.</dc:description>
		<rdfs:comment>Under IDEA �300.530(e), a manifestation determination must occur within 10 days of any decision to change the child's placement because of a violation of a code of student conduct.</rdfs:comment>
		<skos:definition>An indication whether a student's behavior (offense) was a manifestation of, or related to, a disability condition.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001376">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001376</dc:identifier>
		<rdfs:label>Has Incident Reported to Law Enforcement Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001376" />
		<skos:notation>hasIncidentReportedToLawEnforcementIndicator</skos:notation>
		<dc:description>An indication that the school resource officer or any other law enforcement official was notified about the incident, regardless of whether official action is taken.</dc:description>
		<skos:definition>An indication that the school resource officer or any other law enforcement official was notified about the incident, regardless of whether official action is taken.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002110">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002110</dc:identifier>
		<rdfs:label>Has Incident Activity</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002110"/>
		<skos:notation>hasIncidentActivity</skos:notation>
		<dc:description>The activity taking place during the occurrence.</dc:description>
		<textFormat>Option Set</textFormat>
		<skos:definition>The activity taking place during the occurrence.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000509">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000509</dc:identifier>
		<rdfs:label>Has Incident Behavior</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000509" />
		<skos:notation>hasIncidentBehavior</skos:notation>
		<dc:description>Categories of behavior coded for use in describing an incident.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new option to existing option set</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Categories of behavior coded for use in describing an incident.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000510">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000510</dc:identifier>
		<rdfs:label>Has Incident Injury Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000510" />
		<skos:notation>hasIncidentInjuryType</skos:notation>
		<dc:description>An indication of the occurrence of physical injury to participants involved in the incident and, if so, the level of injury sustained.</dc:description>
		<rdfs:comment>Incident Injury Type can be linked to any person involved in the incident.</rdfs:comment>
		<skos:definition>An indication of the occurrence of physical injury to participants involved in the incident and, if so, the level of injury sustained.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000617">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000617</dc:identifier>
		<rdfs:label>Has Incident Location</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000617" />
		<skos:notation>hasIncidentLocation</skos:notation>
		<dc:description>Identifies where the incident occurred and whether or not it occurred on campus.</dc:description>
		<skos:definition>Identifies where the incident occurred and whether or not it occurred on campus.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001369">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001369</dc:identifier>
		<rdfs:label>Has Incident Multiple Offense Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001369" />
		<skos:notation>hasIncidentMultipleOffenseType</skos:notation>
		<dc:description>An indication of whether the offense was primary or secondary in nature when a single incident included more than one type of offense.</dc:description>
		<skos:definition>An indication of whether the offense was primary or secondary in nature when a single incident included more than one type of offense.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001371">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001371</dc:identifier>
		<rdfs:label>Has Incident Perpetrator Injury Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001371" />
		<skos:notation>hasIncidentPerpetratorInjuryType</skos:notation>
		<dc:description>An indication of the occurrence of physical injury to the perpetrator(s) (participants) involved in the incident and, if so, the level of injury sustained.</dc:description>
		<skos:definition>An indication of the occurrence of physical injury to the perpetrator(s) (participants) involved in the incident and, if so, the level of injury sustained.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001372">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001372</dc:identifier>
		<rdfs:label>Has Incident Perpetrator Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200156" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001372" />
		<skos:notation>hasIncidentPerpetratorType</skos:notation>
		<dc:description>Information on the type of individual who committed an incident. A "perpetrator" is an individual involved in an incident as an offender (the person who committed the infraction constituting the incident).</dc:description>
		<skos:definition>Information on the type of individual who committed an incident. A "perpetrator" is an individual involved in an incident as an offender (the person who committed the infraction constituting the incident).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001373">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001373</dc:identifier>
		<rdfs:label>Has Incident Person Role Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200156" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001373" />
		<skos:notation>hasIncidentPersonRoleType</skos:notation>
		<dc:description>The role or type of participation of a person in a discipline incident.</dc:description>
		<skos:definition>The role or type of participation of a person in a discipline incident.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000506">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000506</dc:identifier>
		<rdfs:label>Has Incident Reporter Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000506" />
		<skos:notation>hasIncidentReporterType</skos:notation>
		<dc:description>Information on the type of person who reported the incident. When known and/or if useful, use a more specific option code (e.g., "Counselor" rather than "Professional Staff").</dc:description>
		<skos:definition>Information on the type of person who reported the incident. When known and/or if useful, use a more specific option code (e.g., "Counselor" rather than "Professional Staff").</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000515">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000515</dc:identifier>
		<rdfs:label>Has Incident Time Description Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200154" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000515" />
		<skos:notation>hasIncidentTimeDescriptionCode</skos:notation>
		<dc:description>A code for the description of the time of day that an incident took place.</dc:description>
		<skos:definition>A code for the description of the time of day that an incident took place.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001378">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001378</dc:identifier>
		<rdfs:label>Has Incident Victim Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200156" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001378" />
		<skos:notation>hasIncidentVictimType</skos:notation>
		<dc:description>Information on the type of individual who was injured or otherwise harmed as a direct result of the incident. A "victim" is the individual who suffers injury or harm that directly results from the incident.</dc:description>
		<skos:definition>Information on the type of individual who was injured or otherwise harmed as a direct result of the incident. A "victim" is the individual who suffers injury or harm that directly results from the incident.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001380">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001380</dc:identifier>
		<rdfs:label>Has Incident Witness Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200156" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001380" />
		<skos:notation>hasIncidentWitnessType</skos:notation>
		<dc:description>Information on the type of individual who witnessed the incident and can give a firsthand account of an incident that was seen, heard, or experienced.</dc:description>
		<skos:definition>Information on the type of individual who witnessed the incident and can give a firsthand account of an incident that was seen, heard, or experienced.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000334">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000334</dc:identifier>
		<rdfs:label>Has Income Calculation Method</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200287" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000334" />
		<skos:notation>hasIncomeCalculationMethod</skos:notation>
		<dc:description>The calculation method used by a program to determine total family income.</dc:description>
		<skos:definition>The calculation method used by a program to determine total family income.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000164">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000164</dc:identifier>
		<rdfs:label>Has Increased Learning Time Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200199" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200329" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000164" />
		<skos:notation>hasIncreasedLearningTimeType</skos:notation>
		<dc:description>The types of increased learning time provided.</dc:description>
		<rdfs:comment>If your data is granular enough to differentiate between Before School and After School, it is recommended those options be selected over using the combined Before or After School option.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added options and usage note to support more granular before and after school data and added DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The types of increased learning time provided.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600089">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600089</dc:identifier>
		<rdfs:label>Has IEP Authorization</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200157" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200151" />
		<skos:notation>hasIEPAuthorization</skos:notation>
		<dc:description>References information about whether an evaluation has determined if a person is authorized to receive an IEP.</dc:description>
		<skos:definition>References information about whether an evaluation has determined if a person is authorized to receive an IEP.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600091">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600091</dc:identifier>
		<rdfs:label>Has IEP Present Level</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200157" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200153" />
		<skos:notation>hasIEPPresentLevel</skos:notation>
		<dc:description>References a level of ability or performance used as a baseline in an IEP. These detailed records may be included in a progress report, such as a progress report for an IEP.</dc:description>
		<skos:definition>References a level of ability or performance used as a baseline in an IEP. These detailed records may be included in a progress report, such as a progress report for an IEP.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600144">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600144</dc:identifier>
		<rdfs:label>Has Individualized Program Accessibility Feature</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200157" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200159" />
		<skos:notation>hasIndividualizedProgramAccessibilityFeature</skos:notation>
		<dc:description>References information about an accessibility feature specified as part of an individualized program such as a screen reader or spoken instructions for a visually impaired student.</dc:description>
		<skos:definition>References information about an accessibility feature specified as part of an individualized program such as a screen reader or spoken instructions for a visually impaired student.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600147">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600147</dc:identifier>
		<rdfs:label>Has Individualized Program Amendment</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200157" />
