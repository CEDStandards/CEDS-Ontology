		<rdfs:label>Property, Plant, and Equipment, net of accumulated depreciation</rdfs:label>
		<skos:definition>Includes end-of-year market value for categories such as land, buildings, improvements other than buildings, equipment, and library books, combined and net of accumulated depreciation. (FARM para. 415)</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001671" />
		<skos:notation>PropertyPlantEquipmentnetofaccumulateddepreciation</skos:notation>
		<skos:prefLabel>Property, Plant, and Equipment, net of accumulated depreciation</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001671127599">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Used for reporting all assets consisting of certain nonmaterial rights and benefits of an institution, such as patents, copyrights, trademarks and goodwill. The amount reported should be reduced by total accumulated amortization. (FARM para. 409)</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001671127599</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001671" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Intangible Assets, net of accumulated amortization</rdfs:label>
		<skos:definition>Used for reporting all assets consisting of certain nonmaterial rights and benefits of an institution, such as patents, copyrights, trademarks and goodwill. The amount reported should be reduced by total accumulated amortization. (FARM para. 409)</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001671" />
		<skos:notation>IntangibleAssetsnetofaccumulatedamortization</skos:notation>
		<skos:prefLabel>Intangible Assets, net of accumulated amortization</skos:prefLabel>
	</owl:NamedIndividual>
