	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001388">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001388</dc:identifier>
		<rdfs:label>Has Professional Development Session Language</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200313" />
