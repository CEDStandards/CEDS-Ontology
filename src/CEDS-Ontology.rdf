		<skos:notation>hasSupervisedClinicalExperience</skos:notation>
		<dc:description>An indication of whether a person is enrolled in a supervised clinical experience (including student teaching) as part of a teacher preparation program.</dc:description>
		<skos:definition>An indication of whether a person is enrolled in a supervised clinical experience (including student teaching) as part of a teacher preparation program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001924">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001924</dc:identifier>
