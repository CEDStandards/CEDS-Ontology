		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>AuthorizationDecisionExplanation</skos:notation>
		<dc:description>Authorizer's explanation regarding the authorization decision.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Authorizer's explanation regarding the authorization decision.</skos:definition>
