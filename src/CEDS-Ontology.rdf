	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600221">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600221</dc:identifier>
		<rdfs:label>Has Assessment Performance Level</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200047" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200051" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200038" />
		<skos:notation>hasAssessmentPerformanceLevel</skos:notation>
		<dc:description>References information about the performance levels that may be assigned to an Assessment Subtest Result and specifications for selecting the performance level based on a score. Four styles are supported: 1) specification of performance level by lower and upper cut score, 2) specification of performance level by lower cut score only, 3) specification of performance level without any mapping to scores, and 4) Specification of performance level by mapping to other scores.</dc:description>
		<skos:definition>References information about the performance levels that may be assigned to an Assessment Subtest Result and specifications for selecting the performance level based on a score. Four styles are supported: 1) specification of performance level by lower and upper cut score, 2) specification of performance level by lower cut score only, 3) specification of performance level without any mapping to scores, and 4) Specification of performance level by mapping to other scores.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001007">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001007</dc:identifier>
