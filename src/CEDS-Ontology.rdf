			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001811">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001811</dc:identifier>
		<rdfs:label>Has Building System Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200060" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001811" />
		<skos:notation>hasBuildingSystemType</skos:notation>
		<dc:description>The type of system that is installed in the building or site.</dc:description>
		<skos:definition>The type of system that is installed in the building or site.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001807">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001807</dc:identifier>
		<rdfs:label>Has Building Technology Wiring System Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200060" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001807" />
		<skos:notation>hasBuildingTechnologyWiringSystemType</skos:notation>
		<dc:description>The means through which voice, video, audio, and data information are conveyed.</dc:description>
		<skos:definition>The means through which voice, video, audio, and data information are conveyed.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001206">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001206</dc:identifier>
		<rdfs:label>Has Building Use Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001206" />
		<skos:notation>hasBuildingUseType</skos:notation>
		<dc:description>How a building is principally used, regardless of its original design.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed "Administrative building" to  "Administration building" option based on need from Forum facilities workgroup.</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>How a building is principally used, regardless of its original design.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001812">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001812</dc:identifier>
		<rdfs:label>Has Building Vertical Transportation System Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200060" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001812" />
		<skos:notation>hasBuildingVerticalTransportationSystemType</skos:notation>
		<dc:description>The type of system used to convey persons or freight between floors.</dc:description>
		<skos:definition>The type of system used to convey persons or freight between floors.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000603">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000603</dc:identifier>
		<rdfs:label>Has Calendar Event Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200244" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000603" />
		<skos:notation>hasCalendarEventType</skos:notation>
		<dc:description>A type of scheduled or unscheduled calendar event.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry>
					<changeDescription>New named individual (option set): Professional Development Day created for Calendar Event Type. This addition was approved for V12 but was not added in 12 or 13.</changeDescription>
					<changeVersion>14.0.0.0</changeVersion>
					<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/524</issueLink>
					<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Added new option to existing option set</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add option for Instructional day and change definitions to "calendar event" instead of "event that causes interruption in direct instruction"</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A type of scheduled or unscheduled calendar event.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000035">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000035</dc:identifier>
		<rdfs:label>Has Campus Residency Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200341" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000035" />
		<skos:notation>hasCampusResidencyType</skos:notation>
		<dc:description>A person's residency arrangement as defined in the Free Application for Federal Student Aid (FAFSA).</dc:description>
		<skos:definition>A person's residency arrangement as defined in the Free Application for Federal Student Aid (FAFSA).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001778">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001778</dc:identifier>
		<rdfs:label>Has Campus Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001778" />
		<skos:notation>hasCampusStatus</skos:notation>
		<dc:description>The generalized use or control of a campus, independent of program type.</dc:description>
		<skos:definition>The generalized use or control of a campus, independent of program type.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001897">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001897</dc:identifier>
		<rdfs:label>Has Campus Facility Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200123" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001897" />
		<skos:notation>hasCampusType</skos:notation>
		<dc:description>The primary purpose for which a campus is designed and/or used.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed the name of the element to campus facility type to clarify the purpose of the campus</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The primary purpose for which a campus is designed and/or used.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000518">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000518</dc:identifier>
		<rdfs:label>Has Core Academic Course</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200090" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000518" />
		<skos:notation>hasCoreAcademicCourse</skos:notation>
		<dc:description>The course meets the state definition of a core academic course.</dc:description>
		<skos:definition>The course meets the state definition of a core academic course.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000013">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000013</dc:identifier>
		<rdfs:label>Has Course Aligned with Standards</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200090" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000013" />
		<skos:notation>hasCourseAlignedWithStandards</skos:notation>
		<dc:description>An indication whether a course is aligned with the established standards of a curriculum framework.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Aligned with State Standards.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication whether a course is aligned with the established standards of a curriculum framework.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000137">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000137</dc:identifier>
		<rdfs:label>Has High School Course Requirement</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200003" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200090" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000137" />
		<skos:notation>hasHighSchoolCourseRequirement</skos:notation>
		<dc:description>An indication that this course credit is required for a high school diploma.</dc:description>
		<skos:definition>An indication that this course credit is required for a high school diploma.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001517">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001517</dc:identifier>
		<rdfs:label>Has School Courses for the Exchange of Data Course Code</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200090" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200105" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>hasSCEDCourseCode</skos:notation>
		<dc:description>The five-digit SCED code. The first two-digits of the code represent the Course Subject Area and the next three digits identify the course number. These identifiers are fairly general but provide enough specificity to identify the course's topic and to distinguish it from other courses in that subject area.</dc:description>
		<rdfs:comment>&lt;a href="https://nces.ed.gov/forum/SCED.asp"&gt;https://nces.ed.gov/forum/SCED.asp&lt;/a&gt;</rdfs:comment>
		<minLength>5</minLength>
		<maxLength>5</maxLength>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Depreciate four options and add two new</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added new options to the existing option set. Updated existing options. Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from School Codes for the Exchange of Data Course Code.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updating to reflect the latest version of SCED.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated to reflect the latest version of SCED.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The five-digit SCED code. The first two-digits of the code represent the Course Subject Area and the next three digits identify the course number. These identifiers are fairly general but provide enough specificity to identify the course's topic and to distinguish it from other courses in that subject area.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001288">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001288</dc:identifier>
		<rdfs:label>Has Career Cluster</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200003" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200090" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200345" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001288" />
		<skos:notation>hasCareerCluster</skos:notation>
		<dc:description>The career cluster that defines the industry or occupational focus which may be associated with a career pathways program, plan of study, or course.</dc:description>
		<rdfs:comment>Options from O*NET OnLine an application that was created for the general public to provide broad access to the O*NET database of occupational information. O*NET OnLine offers a variety of search options and occupational data, while My Next Move is a streamlined application for students and job seekers. Both applications were developed for the U.S. Department of Labor by the National Center for O*NET Development.  See onetonline.org for more information.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The career cluster that defines the industry or occupational focus which may be associated with a career pathways program, plan of study, or course.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001290">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001290</dc:identifier>
		<rdfs:label>Has Career Education Plan Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200279" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001290" />
		<skos:notation>hasCareerEducationPlanType</skos:notation>
		<dc:description>An indication of whether an individual completed an individualized guidance and counseling plan</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed the definition from "student" to "individual" to reflect the broader use of the element.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether an individual completed an individualized guidance and counseling plan</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001291">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001291</dc:identifier>
		<rdfs:label>Has Career Pathways Program Participation Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200407" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001291" />
		<skos:notation>hasCareerPathwaysProgramParticipationIndicator</skos:notation>
		<dc:description>An indication of an individual who is participating in a program that is a component of or leads to a specific or recognized career pathway, as defined by the state.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed definition.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of an individual who is participating in a program that is a component of or leads to a specific or recognized career pathway, as defined by the state.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000038">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000038</dc:identifier>
