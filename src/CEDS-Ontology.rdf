		<rdfs:label>Medical treatment</rdfs:label>
		<skos:definition>The participant exits the program because of medical treatment and that treatment is expected to last longer than 90 days and precludes entry into unsubsidized employment or continued participation in the program.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001939" />
		<skos:notation>1001</skos:notation>
		<skos:prefLabel>Medical treatment</skos:prefLabel>
	</owl:NamedIndividual>
