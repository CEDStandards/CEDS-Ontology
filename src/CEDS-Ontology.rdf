			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001532">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001532</dc:identifier>
		<rdfs:label>Has Assessment Form Adaptive Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001532" />
		<skos:notation>hasAssessmentFormAdaptiveIndicator</skos:notation>
		<dc:description>Indicates that the assessment form was generated using an algorithm rather than a fixed form.</dc:description>
		<skos:definition>Indicates that the assessment form was generated using an algorithm rather than a fixed form.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600069">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600069</dc:identifier>
		<rdfs:label>Has Assessment Form Assessment Form Section</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200019" />
		<skos:notation>hasAssessmentFormAssessmentFormSection</skos:notation>
		<dc:description>References information linking sections within an assessment form to the form and the order in which the sections are designed to be offered.</dc:description>
		<skos:definition>References information linking sections within an assessment form to the form and the order in which the sections are designed to be offered.</skos:definition>
