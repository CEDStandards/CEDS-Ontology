	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001718">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001718</dc:identifier>
		<rdfs:label>Service Setting Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200357" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ServiceSettingDescription</skos:notation>
		<dc:description>Description of the setting in which the services are delivered.</dc:description>
		<textFormat>Alphanumeric</textFormat>
