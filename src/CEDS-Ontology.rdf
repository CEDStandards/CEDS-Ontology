		<textFormat>Integer</textFormat>
		<minInclusive>0</minInclusive>
		<skos:definition>Number of child injuries at the program in the past year, as defined by the State.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001460">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001460</dc:identifier>
		<rdfs:label>Quality Initiative Maximum Score</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200116" />
