	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001740127792">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The credential award is provisional or temporary; frequently pending further assessment of qualification.</dc:description>
