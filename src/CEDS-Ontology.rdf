	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001393">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001393</dc:identifier>
		<rdfs:label>Has Learning Resource Assistive Technologies Compatible Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200228" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001393" />
		<skos:notation>hasLearningResourceAssistiveTechnologiesCompatibleIndicator</skos:notation>
		<dc:description>Indicates that the learning resource is compatible with assistive technologies.</dc:description>
		<rdfs:comment>For example, that the resource complies to Web Content Accessibility Guidelines (WCAG) 2.0 checkpoints: 1.1.1, 1.3.1, 1.3.2, 2.4.4, 3.1.1, 3.1.2, 3.3.2, 4.1.1, 4.1.2.</rdfs:comment>
		<skos:definition>Indicates that the learning resource is compatible with assistive technologies.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600396">
		<dc:creator>Common Education Data Standards</dc:creator>
