		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200341" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001230" />
		<skos:notation>hasPaternalGuardianEducation</skos:notation>
		<dc:description>The highest level of education attained by a person's father or paternal guardian</dc:description>
