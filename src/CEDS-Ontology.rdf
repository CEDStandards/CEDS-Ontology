		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001237" />
		<skos:notation>hasIndividualizedProgramServicePlanMeetingLocation</skos:notation>
		<dc:description>The place in which a child's service plan meeting is held.</dc:description>
		<skos:definition>The place in which a child's service plan meeting is held.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001681">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001681</dc:identifier>
		<rdfs:label>Has Individualized Program Service Plan Progress Report Schedule</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200171" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001681" />
		<skos:notation>hasIndividualizedProgramServicePlanProgressReportSchedule</skos:notation>
		<dc:description>Frequency by which parents are notified of the student's progress on annual goals and if the progress is sufficient to achieve the goals by the end of the individualized program service plan year.</dc:description>
