		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002031</dc:identifier>
		<rdfs:label>Has Learning Resource Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200236" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002031" />
		<skos:notation>hasLearningResourceStatus</skos:notation>
		<dc:description>The status of the Learning Resource as of the status start date.</dc:description>
