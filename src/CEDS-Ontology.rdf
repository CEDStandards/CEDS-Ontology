	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173081">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An authority that reviews an organization's educational program and staff for quality, and certifies whether the organization meets a minimal set of standards.</dc:description>
