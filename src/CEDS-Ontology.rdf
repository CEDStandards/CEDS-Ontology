		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#time" />
		<skos:notation>SessionEndTime</skos:notation>
		<dc:description>The hour, minute and second on which a session ends.</dc:description>
		<textFormat>HH:MM:SS</textFormat>
