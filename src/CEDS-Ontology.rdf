		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200136" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200125" />
		<skos:notation>hasFacilityCompliance</skos:notation>
		<dc:description>References designation that assesses whether a facility or building meets safety and teaching standards set by the school district, state, and federal agencies.</dc:description>
		<skos:definition>References designation that assesses whether a facility or building meets safety and teaching standards set by the school district, state, and federal agencies.</skos:definition>
