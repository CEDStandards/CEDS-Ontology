	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000479">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000479</dc:identifier>
		<dc:description>An indication of the percentage of the Title I, Part A allocation that the SEA reserved in accordance with Section 1003(a) of ESEA and �200.100(a) of ED's regulations governing the reservation of funds for school improvement under Section 1003(a) of ESEA.</dc:description>
		<skos:definition>An indication of the percentage of the Title I, Part A allocation that the SEA reserved in accordance with Section 1003(a) of ESEA and �200.100(a) of ED's regulations governing the reservation of funds for school improvement under Section 1003(a) of ESEA.</skos:definition>
		<rdfs:label>School Improvement Reserved Funds Percentage</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200206" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:notation>SchoolImprovementReservedFundsPercentage</skos:notation>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000480">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000480</dc:identifier>
		<dc:description>The amount of Section 1003(a) and 1003(g) allocations to LEAs and Schools.</dc:description>
		<skos:definition>The amount of Section 1003(a) and 1003(g) allocations to LEAs and Schools.</skos:definition>
		<rdfs:label>School Improvement Allocation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200187" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:notation>SchoolImprovementAllocation</skos:notation>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000549">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000549</dc:identifier>
		<dc:description>The amount of federal dollars distributed to local education agencies (LEAs), retained by the state education agency (SEA) for program administration or other approved state-level activities (including unallocated, transferred to another state agency, or distributed to entities other than LEAs).</dc:description>
		<skos:definition>The amount of federal dollars distributed to local education agencies (LEAs), retained by the state education agency (SEA) for program administration or other approved state-level activities (including unallocated, transferred to another state agency, or distributed to entities other than LEAs).</skos:definition>
		<rdfs:label>Federal Programs Funding Allocation</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200187" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:notation>FederalProgramsFundingAllocation</skos:notation>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000575">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000575</dc:identifier>
		<dc:description>The maximum dollar amount that may be spent per child for expenditures related to supplemental educational services under Title I of the ESEA.</dc:description>
		<skos:definition>The maximum dollar amount that may be spent per child for expenditures related to supplemental educational services under Title I of the ESEA.</skos:definition>
		<rdfs:label>Supplemental Educational Services Per Pupil Expenditure</rdfs:label>
		<dc:alternative>SES Per Pupil Expenditure</dc:alternative>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200187" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<textFormat>Numeric</textFormat>
		<decimalPlaces>2</decimalPlaces>
		<skos:notation>SESPerPupilExpenditure</skos:notation>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000896">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000896</dc:identifier>
		<dc:description>The criteria for competency-based completion of the qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<skos:definition>The criteria for competency-based completion of the qualification, achievement, personal or organizational quality, or aspect of an identity.</skos:definition>
		<rdfs:label>Credential Definition Criteria</rdfs:label>
		<dc:alternative>Credential Criteria</dc:alternative>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200085" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionCriteria</skos:notation>
		<dc:description>The criteria for competency-based completion of the qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000908">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000908</dc:identifier>
		<dc:description>The description of each distracter on an assessment item, explaining why it is there, what misunderstandings it exposes.</dc:description>
		<skos:definition>The description of each distracter on an assessment item, explaining why it is there, what misunderstandings it exposes.</skos:definition>
		<rdfs:label>Assessment Item Possible Response Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200027" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:notation>AssessmentItemPossibleResponseValue</skos:notation>
			<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Corrected element name to include the word "Value"</changeDescription> 	
				<changeVersion>13</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000980">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000980</dc:identifier>
		<dc:description>The globally unique identifier of an Assessment Form Section using a RFC 4122 compliant hexadecimal string.</dc:description>
		<skos:definition>The globally unique identifier of an Assessment Form Section using a RFC 4122 compliant hexadecimal string.</skos:definition>
		<rdfs:label>Assessment Form Section GUID</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:notation>AssessmentFormSectionGUID</skos:notation>
		<rdfs:comment>CEDS "GUID" elements are defined as RFC 4122 compliant 32-character hexadecimal strings (36 characters with dashes). For example, 21EC2020-3AEA-1069-A2DD-08002B30309D. Values MAY be encoded using a hash function such as HMAC-MD5 or HMAC-SHA1, resulting in a string up to 40 characters.</rdfs:comment>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000981">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000981</dc:identifier>
		<dc:description>The globally unique identifier of an Assessment using a RFC 4122 compliant hexadecimal string.</dc:description>
		<skos:definition>The globally unique identifier of an Assessment using a RFC 4122 compliant hexadecimal string.</skos:definition>
		<rdfs:label>Assessment GUID</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200020" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:notation>AssessmentGUID</skos:notation>
		<rdfs:comment>CEDS "GUID" elements are defined as RFC 4122 compliant 32-character hexadecimal strings (36 characters with dashes). For example, 21EC2020-3AEA-1069-A2DD-08002B30309D. Values MAY be encoded using a hash function such as HMAC-MD5 or HMAC-SHA1, resulting in a string up to 40 characters.</rdfs:comment>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001535">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001535</dc:identifier>
		<dc:description>The globally unique identifier of an Assessment Form.</dc:description>
		<skos:definition>The globally unique identifier of an Assessment Form.</skos:definition>
		<rdfs:label>Assessment Form GUID</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200017" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:notation>AssessmentFormGUID</skos:notation>
		<rdfs:comment>CEDS "GUID" elements are defined as RFC 4122 compliant 32-character hexadecimal strings (36 characters with dashes). For example, 21EC2020-3AEA-1069-A2DD-08002B30309D. Values MAY be encoded using a hash function such as HMAC-MD5 or HMAC-SHA1, resulting in a string up to 40 characters.</rdfs:comment>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001658">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001658</dc:identifier>
		<dc:description>A globally unique identifier by which the creator/owner/provider of a credential recognizes the qualification, achievement, personal or organizational quality, or aspect of an identity in transactions with the external environment.</dc:description>
		<skos:definition>A globally unique identifier by which the creator/owner/provider of a credential recognizes the qualification, achievement, personal or organizational quality, or aspect of an identity in transactions with the external environment.</skos:definition>
		<rdfs:label>Credential Definition Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200086" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:notation>CredentialDefinitionIdentifier</skos:notation>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
	</rdf:Property>	
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002027">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002027</dc:identifier>
		<dc:description>A unique number or alphanumeric code assigned to a learning resource by an organization.</dc:description>
		<skos:definition>A unique number or alphanumeric code assigned to a learning resource by an organization.</skos:definition>
