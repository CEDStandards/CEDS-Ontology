	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001877129132">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Arsenic is a semi-metal element in the periodic table. It is odorless and tasteless. It enters drinking water supplies from natural deposits in the earth or from agricultural and industrial practices. Non-cancer effects can include thickening and discoloration of the skin, stomach pain, nausea, vomiting; diarrhea; numbness in hands and feet; partial paralysis; and blindness. Arsenic has been linked to cancer of the bladder, lungs, skin, kidney, nasal passages, liver, and prostate.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001877129132</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001877" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Arsenic</rdfs:label>
		<skos:definition>Arsenic is a semi-metal element in the periodic table. It is odorless and tasteless. It enters drinking water supplies from natural deposits in the earth or from agricultural and industrial practices. Non-cancer effects can include thickening and discoloration of the skin, stomach pain, nausea, vomiting; diarrhea; numbness in hands and feet; partial paralysis; and blindness. Arsenic has been linked to cancer of the bladder, lungs, skin, kidney, nasal passages, liver, and prostate.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001877" />
		<skos:notation>13678</skos:notation>
		<skos:prefLabel>Arsenic</skos:prefLabel>
	</owl:NamedIndividual>
