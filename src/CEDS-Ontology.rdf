	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001353117332">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>All funds on deposit with a bank or savings and loan institution, normally in non-interest-bearing accounts. Interest-bearing accounts, however, that do not meet the definition of an investment (e.g., demand deposits that are interest-bearing) should be recorded herein as well.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001353117332</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001353" />
