			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Frequency by which parents are notified of the student's progress on annual goals and if the progress is sufficient to achieve the goals by the end of the individualized program service plan year.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001701">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001701</dc:identifier>
		<rdfs:label>Has Individualized Program Service Plan Progress Report Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200170" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200171" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001701" />
		<skos:notation>hasIndividualizedProgramServicePlanProgressReportType</skos:notation>
		<dc:description>A method by which parents are notified of the student's progress on annual goals and if the progress is sufficient to achieve the goals by the end of the individualized program service plan.</dc:description>
