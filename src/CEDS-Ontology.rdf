		<skos:notation>Technical</skos:notation>
		<skos:prefLabel>Career and Technical School</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001755127818">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An organization whose major purpose is to provide education and training services but is not a postsecondary education institution with the authority to award degrees. Includes community-based organizations, non-degree granting proprietary schools which are education and training providers that are recognized by states as schools and are Title IV eligible but do not award degrees, etc.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001755127818</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Education and Training Provider</rdfs:label>
		<skos:definition>An organization whose major purpose is to provide education and training services but is not a postsecondary education institution with the authority to award degrees. Includes community-based organizations, non-degree granting proprietary schools which are education and training providers that are recognized by states as schools and are Title IV eligible but do not award degrees, etc.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<skos:notation>TrainingProvider</skos:notation>
		<skos:prefLabel>Education and Training Provider</skos:prefLabel>
	</owl:NamedIndividual>
