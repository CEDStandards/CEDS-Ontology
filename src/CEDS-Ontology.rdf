		<skos:notation>CredentialIssuer</skos:notation>
		<dc:description>An organization or person that issues a credential.</dc:description>
		<skos:definition>An organization or person that issues a credential.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200089">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200089</dc:identifier>
		<rdfs:label>Credential Offered</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
