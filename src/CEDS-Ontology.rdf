	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001345">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>A label for a grouping of financial accounts, based on type and purpose.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C001345</dc:identifier>
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme" />
