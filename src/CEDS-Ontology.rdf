		<rdfs:label>State Education Agency (SEA)</rdfs:label>
		<skos:definition>The agency of the state charged with primary responsibility for coordinating and supervising public instruction, including the setting of standards for elementary and secondary instruction programs, and it is the state agency that administers federal grant programs.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<skos:notation>SEA</skos:notation>
		<skos:prefLabel>State Education Agency (SEA)</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173064">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An organization responsible for identifying and/or selecting prospective employees to fill vacant positions in an organization.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001156173064</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Recruiter</rdfs:label>
		<skos:definition>An organization responsible for identifying and/or selecting prospective employees to fill vacant positions in an organization.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<skos:notation>Recruiter</skos:notation>
		<skos:prefLabel>Recruiter</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173065">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An organization that supplements the regular school program or serves as early childhood education and care for children prior to reaching school-attendance age. These programs and services are often, but not solely, available through federal, state, or local agencies, non-profit organizations and/or other community-based organizations (or assistance provided by these entities). Services may be instructional or non-instructional in nature, may be direct or in-direct, and may be provided within or outside of a school building.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001156173065</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Program</rdfs:label>
		<skos:definition>An organization that supplements the regular school program or serves as early childhood education and care for children prior to reaching school-attendance age. These programs and services are often, but not solely, available through federal, state, or local agencies, non-profit organizations and/or other community-based organizations (or assistance provided by these entities). Services may be instructional or non-instructional in nature, may be direct or in-direct, and may be provided within or outside of a school building.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<skos:notation>Program</skos:notation>
		<skos:prefLabel>Program</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001156173066">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An association or corporation established for the purpose of providing services on a nonprofit basis to its members.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001156173066</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001156" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Professional Membership Organization</rdfs:label>
		<skos:definition>An association or corporation established for the purpose of providing services on a nonprofit basis to its members.</skos:definition>
