		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200375</dc:identifier>
		<rdfs:label>Workforce Program Participation</rdfs:label>
		<skos:notation>WorkforceProgramParticipation</skos:notation>
		<dc:description>Information about instruction and/or services provided to a person through a workforce and/or an employment development program.</dc:description>
		<skos:definition>Information about instruction and/or services provided to a person through a workforce and/or an employment development program.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200258">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200258</dc:identifier>
		<rdfs:label>Membership Application</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>MembershipApplication</skos:notation>
		<dc:description>Information related to a person applying for a specifing role in an organization (e.g., applying for college, applying to be enrolled in a program).</dc:description>
		<skos:definition>Information related to a person applying for a specifing role in an organization (e.g., applying for college, applying to be enrolled in a program).</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200259">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200259</dc:identifier>
		<rdfs:label>Membership Full Time Equivalency</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>MembershipFullTimeEquivalency</skos:notation>
		<dc:description>Information about the percentage of full-time equivalent work that a person contributes in a specific role for an organization.</dc:description>
		<skos:definition>Information about the percentage of full-time equivalent work that a person contributes in a specific role for an organization.</skos:definition>
	</rdfs:Class>
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200239">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200239</dc:identifier>
		<rdfs:label>Organization</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<skos:notation>Organization</skos:notation>
		<dc:description>An organized group of one or more people with particular purpose. </dc:description>
		<skos:definition>An organized group of one or more people with particular purpose. </skos:definition>
