		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200396"/>
		<skos:notation>hasLEAOperationalDetail</skos:notation>
		<dc:description>References the classification of the operational condition of a Local Education Agency, including status and effective date.</dc:description>
		<skos:definition>References the classification of the operational condition of a Local Education Agency, including status and effective date.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000174">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000174</dc:identifier>
		<rdfs:label>Has Local Education Agency Operational Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200396" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000174" />
		<skos:notation>hasLEAOperationalStatus</skos:notation>
