	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517164440">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Technology�Independent Study courses, often conducted with instructors as mentors, enable students to explore topics of interest related to technology systems and processes. Independent Study courses may serve as an opportunity for students to expand their expertise in a particular application, to explore a topic in greater detail, or to develop more advanced skills.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517164440</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
