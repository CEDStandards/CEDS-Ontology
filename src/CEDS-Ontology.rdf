<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns="https://w3id.org/CEDStandards/terms/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:schema="https://schema.org/">
	<owl:Ontology rdf:about="https://w3id.org/CEDStandards/terms/">
		<owl:versionInfo>14.0.0.0</owl:versionInfo>
	</owl:Ontology>
	<!-- CEDS Metadata Annotation Properties -->
	<owl:AnnotationProperty rdf:about="https://w3id.org/CEDStandards/terms/textFormat">
		<rdfs:label>Text Format</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<dc:description>A description of the formatting expectations or pattern for a property value.</dc:description>
		<skos:definition>A description of the formatting expectations or pattern for a property value.</skos:definition>
	</owl:AnnotationProperty>
	<owl:AnnotationProperty rdf:about="https://w3id.org/CEDStandards/terms/minCount">
		<rdfs:label>Minimum Count</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<dc:description>The minimum number of values required for a property.</dc:description>
		<skos:definition>The minimum number of values required for a property.</skos:definition>
	</owl:AnnotationProperty>
	<owl:AnnotationProperty rdf:about="https://w3id.org/CEDStandards/terms/maxCount">
		<rdfs:label>Maximum Count</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<dc:description>The maximum number of values allowed for a property.</dc:description>
		<skos:definition>The maximum number of values allowed for a property.</skos:definition>
	</owl:AnnotationProperty>
	<owl:AnnotationProperty rdf:about="https://w3id.org/CEDStandards/terms/minLength">
		<rdfs:label>Minimum Length</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<dc:description>The minimum string length for a property value.</dc:description>
		<skos:definition>The minimum string length for a property value.</skos:definition>
	</owl:AnnotationProperty>
	<owl:AnnotationProperty rdf:about="https://w3id.org/CEDStandards/terms/maxLength">
		<rdfs:label>Maximum Length</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<dc:description>The maximum string length for a property value.</dc:description>
		<skos:definition>The maximum string length for a property value.</skos:definition>
	</owl:AnnotationProperty>
	<owl:AnnotationProperty rdf:about="https://w3id.org/CEDStandards/terms/minInclusive">
		<rdfs:label>Minimum Inclusive Value</rdfs:label>
		<dc:description>The minimum value (inclusive) for a numeric property.</dc:description>
		<skos:definition>The minimum value (inclusive) for a numeric property.</skos:definition>
	</owl:AnnotationProperty>
	<owl:AnnotationProperty rdf:about="https://w3id.org/CEDStandards/terms/maxInclusive">
		<rdfs:label>Maximum Inclusive Value</rdfs:label>
		<dc:description>The maximum value (inclusive) for a numeric property.</dc:description>
		<skos:definition>The maximum value (inclusive) for a numeric property.</skos:definition>
	</owl:AnnotationProperty>
	<owl:AnnotationProperty rdf:about="https://w3id.org/CEDStandards/terms/decimalPlaces">
		<rdfs:label>Decimal Places</rdfs:label>
		<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
		<dc:description>The number of fractional decimal places to be used for a numeric property.</dc:description>
		<skos:definition>The number of fractional decimal places to be used for a numeric property.</skos:definition>
	</owl:AnnotationProperty>
	<!-- External Class Declarations for domain references -->
	<rdfs:Class rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property">
    	<rdfs:isDefinedBy rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
	</rdfs:Class>
	<rdfs:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Class">
 		<rdfs:isDefinedBy rdf:resource="http://www.w3.org/2000/01/rdf-schema#"/>
	</rdfs:Class>
	<owl:Class rdf:about="http://www.w3.org/2002/07/owl#Class">
    	<rdfs:isDefinedBy rdf:resource="http://www.w3.org/2002/07/owl#"/>
	</owl:Class>
	<owl:Class rdf:about="http://www.w3.org/2002/07/owl#NamedIndividual">
    	<rdfs:isDefinedBy rdf:resource="http://www.w3.org/2002/07/owl#"/>
	</owl:Class>
	<!-- Edit History Property -->
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/editHistory">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Edit History</rdfs:label>
		<schema:domainIncludes rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
		<schema:domainIncludes rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
		<schema:domainIncludes rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<schema:domainIncludes rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<skos:notation>editHistory</skos:notation>
		<dc:description>Records changes made to a class or property, including date, version, and optional link to GitHub ticket.</dc:description>
		<skos:definition>Records changes made to a class or property, including date, version, and optional link to GitHub ticket.</skos:definition>
	</rdf:Property>
	<!-- Edit History Entry Class to structure the history entries -->
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/editHistoryEntry">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Edit History Entry</rdfs:label>
		<skos:notation>EditHistoryEntry</skos:notation>
		<dc:description>An entry documenting a change to a class or property in the ontology.</dc:description>
		<skos:definition>An entry documenting a change to a class or property in the ontology.</skos:definition>
	</rdfs:Class>
	<!-- Properties for Edit History Entry -->
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/changeDate">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Change Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<skos:notation>changeDate</skos:notation>
		<dc:description>The date when a change was made to a class or property.</dc:description>
		<skos:definition>The date when a change was made to a class or property.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/changeVersion">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Change Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<skos:notation>changeVersion</skos:notation>
		<dc:description>The version of the ontology in which a change was made to a class or property.</dc:description>
		<skos:definition>The version of the ontology in which a change was made to a class or property.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/changeDescription">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Change Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<skos:notation>changeDescription</skos:notation>
		<dc:description>A description of the change made to a class or property.</dc:description>
		<skos:definition>A description of the change made to a class or property.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/issueLink">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Issue Link</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
		<skos:notation>issueLink</skos:notation>
		<dc:description>A link to an issue or ticket in a version control system related to the change.</dc:description>
		<skos:definition>A link to an issue or ticket in a version control system related to the change.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/changedBy">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Changed By</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<skos:notation>changedBy</skos:notation>
		<dc:description>The person or system that made the change to a class or property.</dc:description>
		<skos:definition>The person or system that made the change to a class or property.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/changeNew">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Change New</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
		<skos:notation>changeNew</skos:notation>
		<dc:description>An indication of whether this represents a new addition to the ontology in the Change version.</dc:description>
		<skos:definition>An indication of whether this represents a new addition to the ontology in the Change version.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added new property to support change history metadata.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/111</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/changeUpdated">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Change Updated</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
		<skos:notation>changeUpdated</skos:notation>
		<dc:description>An indication of whether this represents an update to the ontology in the associated Change Version.</dc:description>
		<skos:definition>An indication of whether this represents an update to the ontology in the associated Change Version.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added new property to support change history metadata.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/111</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/changePropertyAddedToClass">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Change Property Added To Class</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/editHistoryEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
		<skos:notation>changePropertyAddedToClass</skos:notation>
		<dc:description>An indication of whether this class had a new or previously existing property added in the associated Change Version.</dc:description>
		<skos:definition>An indication of whether this class had a new or previously existing property added in the associated Change Version.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added new property to support change history metadata.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/111</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>		
	<!-- Local Usage Class to structure Local Usage Entries -->
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/localUsageEntry">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Local Usage Entry</rdfs:label>
		<skos:notation>LocalUsageEntry</skos:notation>
		<dc:description>An entry documenting organization-specific usage and governance information for a CEDS element or option. Each entry represents one organization's implementation guidance.</dc:description>
		<skos:definition>An entry documenting organization-specific usage and governance information for a CEDS element or option. Each entry represents one organization's implementation guidance.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added new class to support structured local usage metadata</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/926</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdfs:Class>
	<!-- Properties for Local Usage Entry -->
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/localUsage">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Local Usage</rdfs:label>
		<schema:domainIncludes rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
		<schema:domainIncludes rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
		<schema:domainIncludes rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
		<schema:domainIncludes rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/localUsageEntry"/>
		<skos:notation>localUsage</skos:notation>
		<dc:description>Organization-specific usage and governance information for this element or option. Local usage entries should not contradict the CEDS definition but rather enrich it with specific details needed for successful implementation.</dc:description>
		<skos:definition>Organization-specific usage and governance information for this element or option. Local usage entries should not contradict the CEDS definition but rather enrich it with specific details needed for successful implementation.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added new metadata property to support organization-specific usage notes and governance documentation</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/926</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/usageNotes">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Usage Notes</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/localUsageEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<skos:notation>usageNotes</skos:notation>
		<dc:description>Usage and/or governance details designated by the organization as essential to understanding and using this element or option correctly. Usage notes should not contradict the CEDS definition but rather enrich it with any specific details needed for successful implementation.</dc:description>
		<skos:definition>Usage and/or governance details designated by the organization as essential to understanding and using this element or option correctly. Usage notes should not contradict the CEDS definition but rather enrich it with any specific details needed for successful implementation.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added new property to capture organization-specific usage notes</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/926</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/usageURL">
		<dc:creator>Common Education Data Standards</dc:creator>
		<rdfs:label>Usage URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/localUsageEntry"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
		<skos:notation>usageURL</skos:notation>
		<dc:description>The Uniform Resource Locator (URL) pointing to the local organization's data governance documentation for this element or option.</dc:description>
		<skos:definition>The Uniform Resource Locator (URL) pointing to the local organization's data governance documentation for this element or option.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added new property to link to organization's governance documentation</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Elements/issues/926</issueLink>
				<changeNew rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeNew>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<!-- CEDS Base Resource Definitions -->
	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C000000">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C000000</dc:identifier>
		<rdfs:label>Base CEDS Resource</rdfs:label>
		<skos:notation>CEDSBaseResource</skos:notation>
		<dc:description>The CEDS Base Resource class represents the base resource in the Common Education Data Standards (CEDS) ontology. It serves as the foundational class from which all other CEDS resource classes inherit common properties and attributes. Subclasses of CEDSBaseResource may include specific types of instructional resources, such as students, staff, courses, assessments, etc.</dc:description>
		<skos:definition>The CEDS Base Resource class represents the base resource in the Common Education Data Standards (CEDS) ontology. It serves as the foundational class from which all other CEDS resource classes inherit common properties and attributes. Subclasses of CEDSBaseResource may include specific types of instructional resources, such as students, staff, courses, assessments, etc.</skos:definition>
	</rdfs:Class>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002029">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002029</dc:identifier>
		<rdfs:label>Record Reference Identifier</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>RecordReferenceIdentifier</skos:notation>
		<skos:definition>A unique number or alphanumeric code assigned to a record.</skos:definition>
		<dc:description>A unique number or alphanumeric code assigned to a record.</dc:description>
		<maxLength>40</maxLength>
		<textFormat>Alphanumeric</textFormat>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002030">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002030</dc:identifier>
		<rdfs:comment>A coding scheme that is used for identification and record-keeping purposes to refer to a record.</rdfs:comment>
		<rdfs:label>Has Record Reference Identification System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002030" />
		<skos:notation>hasRecordReferenceIdentificationSystem</skos:notation>
		<dc:description>A coding scheme that is used for identification and record-keeping purposes to refer to a record.</dc:description>
		<skos:definition>A coding scheme that is used for identification and record-keeping purposes to refer to a record.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001917">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001917</dc:identifier>
		<rdfs:label>Record Start Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200410"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>RecordStartDateTime</skos:notation>
		<dc:description>The start date and, optionally, time that a record is active as used to support version control.</dc:description>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>The start date and, optionally, time that a record is active as used to support version control.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added Record Start Date Time to the Data Collection Class.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/78</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry>
				<changeDescription>Added element to DES contexts to support reporting information collected on the FAFSA</changeDescription>
				<changeVersion>10</changeVersion>
			</editHistoryEntry>
			<editHistoryEntry>
				<changeDescription>Added element to support the CEDS Integrated Data Store for use in version control.</changeDescription>
				<changeVersion>8</changeVersion>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001918">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001918</dc:identifier>
		<rdfs:label>Record End Date Time</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200410"/>
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime" />
		<skos:notation>RecordEndDateTime</skos:notation>
		<dc:description>The end date and, optionally, time that a record is active as used to support version control.</dc:description>
		<textFormat>YYYY-MM-DDTHH:MM:SS</textFormat>
		<skos:definition>The end date and, optionally, time that a record is active as used to support version control.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Added Record End Date Time to the Data Collection Class.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/78</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Added element to DES contexts to support reporting information collected on the FAFSA</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added element to support the CEDS Integrated Data Store for use in version control.</changeDescription> 	
				<changeVersion>8</changeVersion> 
