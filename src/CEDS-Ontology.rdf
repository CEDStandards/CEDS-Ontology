	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000738">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000738</dc:identifier>
		<rdfs:label>Has Tenure System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200329" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000738" />
		<skos:notation>hasTenureSystem</skos:notation>
		<dc:description>An indicator of whether an institution has personnel positions that lead to consideration for tenure.</dc:description>
