	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001508105752">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Child's functioning generally is considered appropriate for his or her age but there are some significant concerns about the child's functioning in this outcome area. These concerns are substantial enough to suggest monitoring or possible additional support.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001508105752</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001508" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Functioning generally is considered appropriate for age but there are some significant concerns</rdfs:label>
		<skos:definition>Child's functioning generally is considered appropriate for his or her age but there are some significant concerns about the child's functioning in this outcome area. These concerns are substantial enough to suggest monitoring or possible additional support.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001508" />
		<skos:notation>06</skos:notation>
		<skos:prefLabel>Functioning generally is considered appropriate for age but there are some significant concerns</skos:prefLabel>
	</owl:NamedIndividual>
