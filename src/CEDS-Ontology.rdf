		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000621" />
		<skos:notation>hasEmploymentSeparationType</skos:notation>
		<dc:description>A designation of the type of separation occurring between a person and the organization.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
