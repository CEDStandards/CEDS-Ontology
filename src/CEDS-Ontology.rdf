		<skos:notation>hasEducationVerificationMethod</skos:notation>
		<dc:description>The method by which the formal education is verified.</dc:description>
		<skos:definition>The method by which the formal education is verified.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000089">
