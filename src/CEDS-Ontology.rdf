			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Changed name from Early Childhood Program Type.  Definition and option set updated.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The system outlining activities and procedures based on a set of required services and standards in which the child is enrolled.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001553">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001553</dc:identifier>
		<rdfs:label>Has Early Childhood Services Offered</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200100" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001553" />
		<skos:notation>hasEarlyChildhoodServicesOffered</skos:notation>
		<dc:description>A type of service offered by an organization that adapts the curriculum, materials, or instruction for students identified as needing additional resources.</dc:description>
		<skos:definition>A type of service offered by an organization that adapts the curriculum, materials, or instruction for students identified as needing additional resources.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000321">
