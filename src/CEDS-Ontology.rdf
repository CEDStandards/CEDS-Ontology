		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200275</dc:identifier>
		<rdfs:label>Person</rdfs:label>
		<rdfs:subClassOf rdf:resource="https://w3id.org/CEDStandards/terms/C000000" />
