		<skos:notation>hasIEPAuthorizationRejected</skos:notation>
		<dc:description>References information about a case in which a student was authorized for an IEP but the IEP was rejected by a parent or legal guardian.</dc:description>
		<skos:definition>References information about a case in which a student was authorized for an IEP but the IEP was rejected by a parent or legal guardian.</skos:definition>
		<editHistory rdf:parseType="Collection">
