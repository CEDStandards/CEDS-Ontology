		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200364" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000277" />
		<skos:notation>hasTeachingCredentialBasis</skos:notation>
		<dc:description>An indication of the pre-determined criteria for granting the teaching credential that a person holds.</dc:description>
