		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000585" />
		<skos:notation>hasStatePovertyDesignation</skos:notation>
		<dc:description>The designation of a school's poverty quartile for purposes of determining classes taught by highly qualified teachers in high and low poverty schools, according to state's indicator of poverty.</dc:description>
