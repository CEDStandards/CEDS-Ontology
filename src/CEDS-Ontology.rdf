		<skos:notation>MilitaryConnectedStudentIndicator</skos:notation>
		<skos:prefLabel>Military Connected Student Indicator</skos:prefLabel>
	</owl:Class>
	<owl:Class rdf:about="https://w3id.org/CEDStandards/terms/C001577">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Indicates whether a person is an active member of the active duty forces, national guard, or reserve forces.</dc:description>
