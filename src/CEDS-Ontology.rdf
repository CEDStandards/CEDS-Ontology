		<skos:definition>Indicates whether the credential has been revoked by the credential provider.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600371">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600371</dc:identifier>
		<rdfs:label>Has Credential Definition Agent</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200239" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200275" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200083" />
		<skos:notation>hasCredentialDefinitionAgent</skos:notation>
		<dc:description>References information linking a person or organization to a credential definition with the applicable role such as the author, publisher, or issuer or the credential.</dc:description>
		<skos:definition>References information linking a person or organization to a credential definition with the applicable role such as the author, publisher, or issuer or the credential.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600372">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600372</dc:identifier>
		<rdfs:label>Has Credential Definition Category</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200084" />
		<skos:notation>hasCredentialDefinitionCategory</skos:notation>
		<dc:description>References information about a category defined within a specified category system that is applicable to a credential.</dc:description>
		<skos:definition>References information about a category defined within a specified category system that is applicable to a credential.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600439">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600439</dc:identifier>
		<rdfs:label>Has Credential Definition Identification</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200086" />
		<skos:notation>hasCredentialDefinitionIdentification</skos:notation>
		<dc:description>A globally unique identifier by which the creator/owner/provider of a credential recognizes the qualification, achievement, personal or organizational quality, or aspect of an identity in transactions with the external environment.</dc:description>
		<rdfs:comment>CEDS "Identifier" elements reflect the intent of the XSD:Token format, i.e. a string in which carriage return, line feed, and tab characters have been removed as well as any internal sequences of two or more spaces and any leading or trailing spaces. &#13;
&#13;
An Identifier MAY be a Universally Unique Identifier (UUID) / Globally Unique Identifier (GUID), i.e.128-bit unique identifiers generated according to the algorithms and encoding standards of RFC 4122.</rdfs:comment>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A globally unique identifier by which the creator/owner/provider of a credential recognizes the qualification, achievement, personal or organizational quality, or aspect of an identity in transactions with the external environment.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001742">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001742</dc:identifier>
		<rdfs:label>Has Credential Definition NAICS Industry Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001064" />
		<skos:notation>hasCredentialDefinitionNAICSIndustryType</skos:notation>
		<dc:description>The North American Industry Classification System (NAICS) class identifier for an industry associated with the credential.</dc:description>
		<minLength>6</minLength>
		<maxLength>6</maxLength>
		<textFormat>Integer</textFormat>
		<skos:definition>The North American Industry Classification System (NAICS) class identifier for an industry associated with the credential.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001953">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001953</dc:identifier>
		<rdfs:label>Has Credential Definition Terminal Degree Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001953" />
		<skos:notation>hasCredentialDefinitionTerminalDegreeIndicator</skos:notation>
		<dc:description>This degree is the highest degree that can be awarded in this classification of instructional programs field or program area.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>This degree is the highest degree that can be awarded in this classification of instructional programs field or program area.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001914">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001914</dc:identifier>
		<rdfs:label>Has Credential Definition Agent Role Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200083" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001914" />
		<skos:notation>hasCredentialDefinitionAgentRoleType</skos:notation>
		<dc:description>The role that an organization or person has in relation to this Credential Definition based on terms defined by Credential Engine.</dc:description>
		<rdfs:comment>Option codes and definitions are from the Credential Engine and the ceterms namespace, except the codes use Pascal case in CEDS to follow CEDS conventions and use camel case in the original  ceterms.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adding element to specify the role that an organization or person has with a Credential Definition.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The role that an organization or person has in relation to this Credential Definition based on terms defined by Credential Engine.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001738">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001738</dc:identifier>
		<rdfs:label>Has Credential Definition Assessment Method Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200085" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001738" />
		<skos:notation>hasCredentialDefinitionAssessmentMethodType</skos:notation>
		<dc:description>The method used to conduct the assessment being referenced.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The method used to conduct the assessment being referenced.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001739">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001739</dc:identifier>
		<rdfs:label>Has Credential Definition Identifier System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200086" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001739" />
		<skos:notation>hasCredentialDefinitionIdentifierSystem</skos:notation>
		<dc:description>A coding scheme that is used for identification and record-keeping purposes by a credentialing organization to refer to a qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A coding scheme that is used for identification and record-keeping purposes by a credentialing organization to refer to a qualification, achievement, personal or organizational quality, or aspect of an identity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001749">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001749</dc:identifier>
		<rdfs:label>Has Credential Definition Intended Purpose Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001749" />
		<skos:notation>hasCredentialDefinitionIntendedPurposeType</skos:notation>
		<dc:description>The intended type of application of the credential by the holder.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The intended type of application of the credential by the holder.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001740">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001740</dc:identifier>
		<rdfs:label>Has Credential Definition Status Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001740" />
		<skos:notation>hasCredentialDefinitionStatusType</skos:notation>
		<dc:description>The status of the credential offered by a credentialing organization.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The status of the credential offered by a credentialing organization.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001753">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001753</dc:identifier>
		<rdfs:label>Has Credential Definition Verification Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001753" />
		<skos:notation>hasCredentialDefinitionVerificationType</skos:notation>
		<dc:description>A resource describing the means by which someone can verify whether a credential has been attained by a person.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A resource describing the means by which someone can verify whether a credential has been attained by a person.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000071">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000071</dc:identifier>
		<rdfs:label>Has Credential Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000071" />
		<skos:notation>hasCredentialType</skos:notation>
		<dc:description>An indication of the category of credential a person holds.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Removed element from DES context to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added new option to existing option set and add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
			<editHistoryEntry> 	
				<changeDescription>Move this property to the Credential Definition class.</changeDescription> 	
				<changeVersion>13</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the category of credential a person holds.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001317">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001317</dc:identifier>
		<rdfs:label>Has Credit Hours Applied Other Program</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200336" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001317" />
		<skos:notation>hasCreditHoursAppliedOtherProgram</skos:notation>
		<dc:description>Codes identifying the set of credit hours taken in other programs or degrees that were applied to the individual's degree.</dc:description>
		<skos:definition>Codes identifying the set of credit hours taken in other programs or degrees that were applied to the individual's degree.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000072">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000072</dc:identifier>
		<rdfs:label>Has Credit Unit Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200090" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200074" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000072" />
		<skos:notation>hasCreditUnitType</skos:notation>
		<dc:description>The type of credits or units of value awarded for the completion of a course.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of credits or units of value awarded for the completion of a course.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000770">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000770</dc:identifier>
		<rdfs:label>Has Critical Teacher Shortage Area Candidate</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200323" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000770" />
		<skos:notation>hasCriticalTeacherShortageAreaCandidate</skos:notation>
		<dc:description>An indication of whether a person is pursuing licensure/certification in a field designated as a shortage area as defined by Title II.</dc:description>
		<rdfs:comment>When used in conjunction with the element Classification of Instructional Program, the field of study can be determined.</rdfs:comment>
		<skos:definition>An indication of whether a person is pursuing licensure/certification in a field designated as a shortage area as defined by Title II.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001913">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001913</dc:identifier>
		<rdfs:label>Has CTDL Audience Level Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001913" />
		<skos:notation>hasCTDLAudienceLevelType</skos:notation>
		<dc:description>Type of level indicating a point in a progression through an educational or training context, for which the credential is intended; select from an existing enumeration of such types.</dc:description>
		<rdfs:comment>This is similar to "PESC Award Level Type" and "Academic Award Level Conferred" but uses a different controlled vocabulary.  See &lt;a href="https://credreg.net/ctdl/terms/Credential#AudienceLevel"&gt;https://credreg.net/ctdl/terms/Credential#AudienceLevel&lt;/a&gt;.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>This new  element "CTDL Audience Level Type" supports alignment to the categories defined in the Credential Engine's Credential Transparency Description Language (CTDL).&#13;
It is similar to "PESC Award Level Type" and "Academic Award Level Conferred" but uses a different controlled vocabulary.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Type of level indicating a point in a progression through an educational or training context, for which the credential is intended; select from an existing enumeration of such types.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001755">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001755</dc:identifier>
		<rdfs:label>Has CTDL Organization Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200083" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200088" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001755" />
		<skos:notation>hasCTDLOrganizationType</skos:notation>
		<dc:description>The type of credentialing organization or entity as defined by the Credential Transparency Description Language.</dc:description>
		<rdfs:comment>Includes free-standing medical, law or other first-professional schools, schools that offer postbaccalaureate certificates only, those that offer graduate programs only, etc.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of credentialing organization or entity as defined by the Credential Transparency Description Language.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000075">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000075</dc:identifier>
		<rdfs:label>Has Career and Technical Education Graduation Rate Inclusion</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200250" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000075" />
		<skos:notation>hasCTEGraduationRateInclusion</skos:notation>
		<dc:description>An indication of how CTE concentrators are included in the state's computation of its graduation rate.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Definition updated</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of how CTE concentrators are included in the state's computation of its graduation rate.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000588">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000588</dc:identifier>
		<rdfs:label>Has Career Technical Education Nontraditional Gender Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200318" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000588" />
		<skos:notation>hasCTENontraditionalGenderStatus</skos:notation>
		<dc:description>An indication of whether CTE participants were members of an underrepresented gender group (where one gender comprises less than 25 percent of the persons employed in those occupations or field of work).</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added element to DES context to replace prior removal from the K12 domain</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Formerly named CTE Representation Status.  Definition updated.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of whether CTE participants were members of an underrepresented gender group (where one gender comprises less than 25 percent of the persons employed in those occupations or field of work).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000712">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000712</dc:identifier>
		<rdfs:label>Has Curriculum Framework Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200090" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200186" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000712" />
		<skos:notation>hasCurriculumFrameworkType</skos:notation>
		<dc:description>An indication of the standard curriculum used for this course.</dc:description>
		<skos:definition>An indication of the standard curriculum used for this course.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000343">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000343</dc:identifier>
		<rdfs:label>Has Degree or Certificate Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200281" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000343" />
		<skos:notation>hasDegreeOrCertificateType</skos:notation>
		<dc:description>The type of degree or certificate earned by a person.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support post-secondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Code set change: 01046 has been replaced by 73063 - Adult education certification, endorsement, or degree</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of degree or certificate earned by a person.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002016">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002016</dc:identifier>
		<rdfs:label>Has Diversity Equity Inclusion Policy Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200261" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002016" />
		<skos:notation>hasDEIPolicyIndicator</skos:notation>
		<dc:description>Indicates whether or not the program has a written policy addressing diversity, equity and inclusion (DEI).</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates whether or not the program has a written policy addressing diversity, equity and inclusion (DEI).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002085">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002085</dc:identifier>
		<rdfs:label>Has Delinquent Program Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200321" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C002085" />
		<skos:notation>hasDelinquentProgramType</skos:notation>
		<dc:description>The type of delinquent programs under Title I, Part D, Subpart 1 (State Agency) of ESEA as amended or under Title I, Part D, Subpart 2 (LEA) of ESEA, as amended.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The type of delinquent programs under Title I, Part D, Subpart 1 (State Agency) of ESEA as amended or under Title I, Part D, Subpart 2 (LEA) of ESEA, as amended.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000336">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000336</dc:identifier>
		<rdfs:label>Has Dental Insurance Coverage Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200288" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000336" />
		<skos:notation>hasDentalInsuranceCoverageType</skos:notation>
		<dc:description>The source of insurance covering an person's dental care.</dc:description>
		<rdfs:comment>Use cases may utilize subsets of the option set.  For example, the option set for Parent/Guardian may not include the "Children's health insurance program" option.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name changed from Dental Insurance Coverage.  Definition updated.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added usage note.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The source of insurance covering an person's dental care.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000310">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000310</dc:identifier>
		<rdfs:label>Has Dental Screening Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200288" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000310" />
		<skos:notation>hasDentalScreeningStatus</skos:notation>
		<dc:description>The condition of a person's mouth or oral cavity; more specifically the condition of the hard tissues (i.e., teeth and jaws) and the soft tissues (i.e., gums, tongue, lips, palate, mouth floor, and inner cheeks). Good oral health denotes the absence of clinically manifested disease or abnormalities of the oral cavity.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Changed element name from Dental Screening.</changeDescription> 	
				<changeVersion>3</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The condition of a person's mouth or oral cavity; more specifically the condition of the hard tissues (i.e., teeth and jaws) and the soft tissues (i.e., gums, tongue, lips, palate, mouth floor, and inner cheeks). Good oral health denotes the absence of clinically manifested disease or abnormalities of the oral cavity.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000079">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000079</dc:identifier>
		<rdfs:label>Has Dependency Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200341" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000079" />
		<skos:notation>hasDependencyStatus</skos:notation>
		<dc:description>A person's classification as dependent or independent with regards to eligibility for Title IV Federal Student aid.</dc:description>
		<skos:definition>A person's classification as dependent or independent with regards to eligibility for Title IV Federal Student aid.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001588">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001588</dc:identifier>
		<rdfs:label>Has Developmental Education Referral Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001588" />
		<skos:notation>hasDevelopmentalEducationReferralStatus</skos:notation>
		<dc:description>The status of a student's referral to or placement into  developmental education.</dc:description>
		<skos:definition>The status of a student's referral to or placement into developmental education.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001589">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001589</dc:identifier>
		<rdfs:label>Has Developmental Education Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200332" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001589" />
		<skos:notation>hasDevelopmentalEducationType</skos:notation>
		<dc:description>An indicator of the category of developmental education.</dc:description>
		<skos:definition>An indicator of the category of developmental education.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000315">
		<dc:creator>Common Education Data Standards</dc:creator>
