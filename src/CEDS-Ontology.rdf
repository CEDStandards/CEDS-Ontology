		<skos:notation>BuildingAdditionDescription</skos:notation>
		<dc:description>A description of the permanent structure added to the original building.</dc:description>
		<maxLength>80</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the permanent structure added to the original building.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001776">
