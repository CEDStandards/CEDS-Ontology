				<changeDescription>Name changed from Workforce Program Participation After Exit.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000329">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000329</dc:identifier>
		<rdfs:label>Has Custodial Parent or Guardian Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200308" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000329" />
		<skos:notation>hasCustodialParentOrGuardianIndicator</skos:notation>
		<dc:description>An indication that a person has legal custody of a child.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated element to reflect the CEDS Integrated Data Store structure. Options that were originally included in this element are part of the Person Relationship Type element. Element applied to additional DES contexts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that a person has legal custody of a child.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001341">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001341</dc:identifier>
		<rdfs:label>Has Emergency Contact Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200308" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001341" />
		<skos:notation>hasEmergencyContactIndicator</skos:notation>
		<dc:description>Indicates whether or not the person is a designated emergency contact for the learner.</dc:description>
		<skos:definition>Indicates whether or not the person is a designated emergency contact for the learner.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001425">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001425</dc:identifier>
		<rdfs:label>Has Person Relationship to Learner Lives with Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200308" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001425" />
		<skos:notation>hasPersonRelationshipToLearnerLivesWithIndicator</skos:notation>
		<dc:description>Indicates whether or not the learner lives with the related person.</dc:description>
		<skos:definition>Indicates whether or not the learner lives with the related person.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001428">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001428</dc:identifier>
		<rdfs:label>Has Primary Contact Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200308" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200412" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001428" />
		<skos:notation>hasPrimaryContactIndicator</skos:notation>
		<dc:description>Indicates that a person is a primary contact within the specified context, such as a primary parental contact specified in Person Relationship to Learner or a primary administrative contact for an organization.</dc:description>
		<skos:definition>Indicates that a person is a primary contact within the specified context, such as a primary parental contact specified in Person Relationship to Learner or a primary administrative contact for an organization.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000425">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000425</dc:identifier>
		<rdfs:label>Has Person Relationship Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200308" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000425" />
		<skos:notation>hasPersonRelationshipType</skos:notation>
		<dc:description>The nature of a person's relationship to another person.</dc:description>
		<rdfs:comment>For implementation in the CEDS Integrated Data Store (IDS), the "person" in the description would be the person referred to in the PersonId column in the IDS. The "related person" in the description would be the person referred to in the "RelatedPersonId" in the IDS. Example: Foster mother - The person (PersonId) is the related person's (RelatedPersonId) Foster mother.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated the element name, definition, and option definitions to remove the focus on learner and simply indicate a relationship between two persons which reflects how the CEDS Integrated Data Store is modeled. Added additional options to reflect a wider variety of person to person relationships. Element applied to additional DES contexts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The nature of a person's relationship to another person.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001668">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001668</dc:identifier>
		<rdfs:label>Has PESC Award Level Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200335" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001668" />
		<skos:notation>hasPESCAwardLevelType</skos:notation>
		<dc:description>An indicator of the category of award conferred by a college, university, or other postsecondary education institution as official recognition for the successful completion of a program of study.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Based on suggestion from PESC COMMON CREDENTIAL draft standard., change source: PESC</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set by adding Other to support stakeholder request, to include definitions, and to limit description length to 150 characters.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indicator of the category of award conferred by a college, university, or other postsecondary education institution as official recognition for the successful completion of a program of study.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001413">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001413</dc:identifier>
		<rdfs:label>Has National Collegiate Athletic Association Eligibility</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200328" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001413" />
		<skos:notation>hasNCAAEligibility</skos:notation>
		<dc:description>An indication that the course is approved for determining NCAA eligibility.</dc:description>
		<skos:definition>An indication that the course is approved for determining NCAA eligibility.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000586">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000586</dc:identifier>
		<rdfs:label>Has Postsecondary Enrollment Action</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200210" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000586" />
		<skos:notation>hasPostsecondaryEnrollmentAction</skos:notation>
		<dc:description>The action taken with respect to postsecondary enrollment by the student who graduated from the school, LEA or state in the past two years.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The action taken with respect to postsecondary enrollment by the student who graduated from the school, LEA or state in the past two years.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000096">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000096</dc:identifier>
		<rdfs:label>Has Postsecondary Enrollment Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200352" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000096" />
		<skos:notation>hasPostsecondaryEnrollmentStatus</skos:notation>
		<dc:description>An indication of the student's enrollment status for a particular term as defined by the institution</dc:description>
		<rdfs:comment>Either use option 02 or one of the options, 04 or 05, for less than full-time but at least half-time.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Additions to option set.  Added usage note.</changeDescription> 	
				<changeVersion>5</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication of the student's enrollment status for a particular term as defined by the institution</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000095">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000095</dc:identifier>
		<rdfs:label>Has Postsecondary Enrollment Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000095" />
		<skos:notation>hasPostsecondaryEnrollmentType</skos:notation>
		<dc:description>An indicator of the enrollment type associated with the enrollment award level of a person at the beginning of a term.</dc:description>
		<skos:definition>An indicator of the enrollment type associated with the enrollment award level of a person at the beginning of a term.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001617">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001617</dc:identifier>
		<rdfs:label>Has Postsecondary Exit or Withdrawal Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001617" />
		<skos:notation>hasPostsecondaryExitOrWithdrawalType</skos:notation>
		<dc:description> The circumstances under which the student exited from enrollment in a postsecondary institution.</dc:description>
		<skos:definition> The circumstances under which the student exited from enrollment in a postsecondary institution.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000748">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000748</dc:identifier>
		<rdfs:label>Has Institutionally Controlled Housing Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200329" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000748" />
		<skos:notation>hasInstitutionallyControlledHousingStatus</skos:notation>
		<dc:description>An indication of whether an institution has any residence hall or housing facility located on- or off-campus that is owned or controlled by an institution and used by the institution in direct support of or in a manner related to, the institution's educational purposes.</dc:description>
		<rdfs:comment>As defined in IPEDS</rdfs:comment>
		<skos:definition>An indication of whether an institution has any residence hall or housing facility located on- or off-campus that is owned or controlled by an institution and used by the institution in direct support of or in a manner related to, the institution's educational purposes.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600265">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600265</dc:identifier>
		<rdfs:label>Has Postsecondary Price Of Attendance</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200329" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200330" />
		<skos:notation>hasPostsecondaryPriceOfAttendance</skos:notation>
		<dc:description>References the price of attendance data for a postsecondary institution and a given session.</dc:description>
		<skos:definition>References the price of attendance data for a postsecondary institution and a given session.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001616">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001616</dc:identifier>
		<rdfs:label>Has Postsecondary Program Level</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200331" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001616" />
		<skos:notation>hasPostsecondaryProgramLevel</skos:notation>
		<dc:description>The level describing the concentration of study for a postsecondary program.</dc:description>
		<skos:definition>The level describing the concentration of study for a postsecondary program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600108">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600108</dc:identifier>
		<rdfs:label>Has Postsecondary Section Location</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200332" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200333" />
		<skos:notation>hasPostsecondarySectionLocation</skos:notation>
		<dc:description>References information about a location in which a postsecondary course section is delivered.</dc:description>
		<skos:definition>References information about a location in which a postsecondary course section is delivered.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000734">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000734</dc:identifier>
		<rdfs:label>Has Faculty Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200334" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000734" />
		<skos:notation>hasFacultyStatus</skos:notation>
		<dc:description>Persons identified by the institution as such and typically those whose initial assignments are made for the purpose of conducting instruction, research or public service as a principal activity (or activities). They may hold academic rank titles of professor, associate professor, assistant professor, instructor, lecturer or the equivalent of any of those academic ranks. Faculty may also include the chancellor/president, provost, vice provosts, deans, directors or the equivalent, as well as associate deans, assistant deans and executive officers of academic departments (chairpersons, heads or the equivalent) if their principal activity is instruction combined with research and/or public service. The designation as "faculty" is separate from the activities to which they may be currently assigned. For example, a newly appointed president of an institution may also be appointed as a faculty member. Graduate, instruction, and research assistants are not included in this category.</dc:description>
		<rdfs:comment>As defined in IPEDS.</rdfs:comment>
		<skos:definition>Persons identified by the institution as such and typically those whose initial assignments are made for the purpose of conducting instruction, research or public service as a principal activity (or activities). They may hold academic rank titles of professor, associate professor, assistant professor, instructor, lecturer or the equivalent of any of those academic ranks. Faculty may also include the chancellor/president, provost, vice provosts, deans, directors or the equivalent, as well as associate deans, assistant deans and executive officers of academic departments (chairpersons, heads or the equivalent) if their principal activity is instruction combined with research and/or public service. The designation as "faculty" is separate from the activities to which they may be currently assigned. For example, a newly appointed president of an institution may also be appointed as a faculty member. Graduate, instruction, and research assistants are not included in this category.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000742">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000742</dc:identifier>
		<rdfs:label>Has Graduate Assistant Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200334" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000742" />
		<skos:notation>hasGraduateAssistantStatus</skos:notation>
		<dc:description>Graduate-level students employed on a part-time basis, not limited to, but often employed for the primary purpose of assisting in classroom or laboratory instruction or in the conduct of research.  Graduate students having titles such as graduate assistant, teaching assistant, teaching associate, teaching fellow, or research assistant typically hold these positions.</dc:description>
		<rdfs:comment>As defined in IPEDS</rdfs:comment>
		<skos:definition>Graduate-level students employed on a part-time basis, not limited to, but often employed for the primary purpose of assisting in classroom or laboratory instruction or in the conduct of research. Graduate students having titles such as graduate assistant, teaching assistant, teaching associate, teaching fellow, or research assistant typically hold these positions.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000732">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000732</dc:identifier>
		<rdfs:label>Has Instructional Staff Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200334" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000732" />
		<skos:notation>hasInstructionalStaffStatus</skos:notation>
		<dc:description>Staff whose primary function/occupational activity is primarily instruction or instruction combined with research and/or public service.  Does not include medical school staff.</dc:description>
		<rdfs:comment>As defined in IPEDS.</rdfs:comment>
		<skos:definition>Staff whose primary function/occupational activity is primarily instruction or instruction combined with research and/or public service. Does not include medical school staff.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000733">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000733</dc:identifier>
		<rdfs:label>Has Medical School Staff Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200334" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000733" />
		<skos:notation>hasMedicalSchoolStaffStatus</skos:notation>
		<dc:description>Staff employed by or employees working in the medical school component of a postsecondary institution or in a free standing medical school.  Does not include staff employed by or employees working strictly in a hospital associated with a medical school or those who work in health or allied health schools or departments such as dentistry, veterinary medicine, nursing or dental hygiene.</dc:description>
		<rdfs:comment>As defined in IPEDS.</rdfs:comment>
		<skos:definition>Staff employed by or employees working in the medical school component of a postsecondary institution or in a free standing medical school. Does not include staff employed by or employees working strictly in a hospital associated with a medical school or those who work in health or allied health schools or departments such as dentistry, veterinary medicine, nursing or dental hygiene.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000755">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000755</dc:identifier>
		<rdfs:label>Has Postsecondary Applicant</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200338" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000755" />
		<skos:notation>hasPostsecondaryApplicant</skos:notation>
		<dc:description>An individual who has fulfilled the institution's requirements to be considered for admission (including payment or waiving of the application fee, if any) and who has been notified of one of the following actions: admission, nonadmission, placement on waiting list, or application withdrawn (by applicant or institution). Include early decision, early action, and students who began studies during summer in this cohort.</dc:description>
		<rdfs:comment>CDS definition/instructions; first part matches IPEDS</rdfs:comment>
		<skos:definition>An individual who has fulfilled the institution's requirements to be considered for admission (including payment or waiving of the application fee, if any) and who has been notified of one of the following actions: admission, nonadmission, placement on waiting list, or application withdrawn (by applicant or institution). Include early decision, early action, and students who began studies during summer in this cohort.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000757">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000757</dc:identifier>
		<rdfs:label>Has Wait Listed Student</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200338" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000757" />
		<skos:notation>hasWaitListedStudent</skos:notation>
		<dc:description>A person who meets the admission requirements but will only be offered a place in the class if space becomes available.</dc:description>
		<rdfs:comment>Common Data Set definition</rdfs:comment>
		<skos:definition>A person who meets the admission requirements but will only be offered a place in the class if space becomes available.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001984">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001984</dc:identifier>
		<rdfs:label>Has Children of Fallen Heroes Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200341" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001984" />
		<skos:notation>hasChildrenOfFallenHeroesIndicator</skos:notation>
		<dc:description>Pell-eligible students whose parent or guardian was a member of the U.S. armed forces and died as a result of military service performed in Iraq or Afghanistan after the events of 9/11 or a public safety officer and died as a result of active service in the line of duty. At the time of the parent's or guardian's death, the student must be less than 24 years of age or enrolled in college or career school at least part-time.</dc:description>
		<rdfs:comment>The Children of Fallen heroes Indicator should follow the current legislation definitions and be updated as definitions change</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES to support postsecondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Pell-eligible students whose parent or guardian was a member of the U.S. armed forces and died as a result of military service performed in Iraq or Afghanistan after the events of 9/11 or a public safety officer and died as a result of active service in the line of duty. At the time of the parent's or guardian's death, the student must be less than 24 years of age or enrolled in college or career school at least part-time.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001981">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001981</dc:identifier>
		<rdfs:label>Has Emancipated Minor</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200341" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001981" />
		<skos:notation>hasEmancipatedMinor</skos:notation>
		<dc:description>A minor student under the age of 18 who has been granted by legal action to have the power and capacity of an adult.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES to support postsecondary needs</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>A minor student under the age of 18 who has been granted by legal action to have the power and capacity of an adult.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001947">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001947</dc:identifier>
		<rdfs:label>Has First Generation College Student</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200341" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001947" />
		<skos:notation>hasFirstGenerationCollegeStudent</skos:notation>
		<dc:description>The term First Generation College Student means an individual both of whose parents did not complete a baccalaureate degree or in the case of any individual who regularly resided with and received support from only one parent, an individual whose only such parent did not complete a baccalaureate degree.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The term First Generation College Student means an individual both of whose parents did not complete a baccalaureate degree or in the case of any individual who regularly resided with and received support from only one parent, an individual whose only such parent did not complete a baccalaureate degree.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000078">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000078</dc:identifier>
		<rdfs:label>Has Degree or Certificate Seeking Student</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000078" />
		<skos:notation>hasDegreeOrCertificateSeekingStudent</skos:notation>
		<dc:description>Person is enrolled in courses for credit and recognized by the institution as seeking a degree, certificate, or other formal award. High school students also enrolled in postsecondary courses for credit are not considered degree/certificate-seeking.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Name has been modified.</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Person is enrolled in courses for credit and recognized by the institution as seeking a degree, certificate, or other formal award. High school students also enrolled in postsecondary courses for credit are not considered degree/certificate-seeking.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001323">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001323</dc:identifier>
		<rdfs:label>Has Distance Education Program Enrollment Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001323" />
		<skos:notation>hasDistanceEducationProgramEnrollmentIndicator</skos:notation>
		<dc:description>An individual's enrollment in a program for which all the required coursework for program completion is able to be completed via distance education courses. Distance education is education that uses one or more technologies to deliver instruction to individuals who are separated from the instructor and to support regular and substantive interaction between the individuals and the instructor synchronously or asynchronously.</dc:description>
		<rdfs:comment>Element defined in IPEDS</rdfs:comment>
		<skos:definition>An individual's enrollment in a program for which all the required coursework for program completion is able to be completed via distance education courses. Distance education is education that uses one or more technologies to deliver instruction to individuals who are separated from the instructor and to support regular and substantive interaction between the individuals and the instructor synchronously or asynchronously.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001324">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001324</dc:identifier>
		<rdfs:label>Has Doctoral Candidacy Admit Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001324" />
		<skos:notation>hasDoctoralCandidacyAdmitIndicator</skos:notation>
		<dc:description>The individual's status in being admitted as a doctoral candidate.</dc:description>
		<skos:definition>The individual's status in being admitted as a doctoral candidate.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000117">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000117</dc:identifier>
		<rdfs:label>Has First Time Postsecondary Student</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000117" />
		<skos:notation>hasFirstTimePostsecondaryStudent</skos:notation>
		<dc:description>A person who has no prior postsecondary experience  attending any institution for the first time at the undergraduate level since completing high school (or its equivalent). This includes persons enrolled in academic or occupational programs. It also includes persons enrolled in the fall term who attended college for the first time in the prior summer term, and persons who entered with advanced standing (college credits earned before graduation from high school).</dc:description>
		<skos:definition>A person who has no prior postsecondary experience attending any institution for the first time at the undergraduate level since completing high school (or its equivalent). This includes persons enrolled in academic or occupational programs. It also includes persons enrolled in the fall term who attended college for the first time in the prior summer term, and persons who entered with advanced standing (college credits earned before graduation from high school).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000761">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000761</dc:identifier>
		<rdfs:label>Has Fraternity Participation Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000761" />
		<skos:notation>hasFraternityParticipationStatus</skos:notation>
		<dc:description>Student is in membership of a chiefly social organization of men students at a college or university, usually designated by Greek letters.</dc:description>
		<skos:definition>Student is in membership of a chiefly social organization of men students at a college or university, usually designated by Greek letters.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001416">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001416</dc:identifier>
		<rdfs:label>Has Oral Defense Completed Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001416" />
		<skos:notation>hasOralDefenseCompletedIndicator</skos:notation>
		<dc:description>An indication of the individual's completion of an oral defense. The requirement to conduct an oral defense by doctoral individuals may vary across institutions, programs, or fields of study.</dc:description>
		<skos:definition>An indication of the individual's completion of an oral defense. The requirement to conduct an oral defense by doctoral individuals may vary across institutions, programs, or fields of study.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001426">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001426</dc:identifier>
		<rdfs:label>Has Postsecondary Entering Student Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001426" />
		<skos:notation>hasPostsecondaryEnteringStudentIndicator</skos:notation>
		<dc:description>The initial enrollment of an individual in credit bearing courses or developmental/remedial courses at an institution after completing high school or a high school equivalency program (e.g. GED, Adult High School Diploma).</dc:description>
		<rdfs:comment>An individual can only be an entering student once at an institution at the undergraduate level.</rdfs:comment>
		<skos:definition>The initial enrollment of an individual in credit bearing courses or developmental/remedial courses at an institution after completing high school or a high school equivalency program (e.g. GED, Adult High School Diploma).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000760">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000760</dc:identifier>
		<rdfs:label>Has Postsecondary Student Housing On-Campus</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000760" />
		<skos:notation>hasPostsecondaryStudentHousingOnCampus</skos:notation>
		<dc:description>The student resides in a residence hall or housing facility owned or controlled by an institution within the same reasonably contiguous geographic area and used by the institution in direct support of or in a manner related to, the institution's educational purposes.</dc:description>
		<rdfs:comment>IPEDS Definition</rdfs:comment>
		<skos:definition>The student resides in a residence hall or housing facility owned or controlled by an institution within the same reasonably contiguous geographic area and used by the institution in direct support of or in a manner related to, the institution's educational purposes.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000762">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000762</dc:identifier>
		<rdfs:label>Has Sorority Participation Status</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200343" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000762" />
		<skos:notation>hasSororityParticipationStatus</skos:notation>
		<dc:description>Student is in membership in a chiefly social organization of women students at a college or university, usually designated by Greek letters.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated definition.</changeDescription> 	
				<changeVersion>4</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Student is in membership in a chiefly social organization of women students at a college or university, usually designated by Greek letters.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000763">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000763</dc:identifier>
		<rdfs:label>Has Financial Aid Applicant</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200344" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000763" />
		<skos:notation>hasFinancialAidApplicant</skos:notation>
		<dc:description>Any applicant who submits any one of the institutionally required financial aid applications/forms, such as the  Free Application for Federal Student Aid (FAFSA).</dc:description>
		<rdfs:comment>Common Data Set definition.&lt;br/&gt;Element should be used in combination with Financial Aid Applicant Type.</rdfs:comment>
		<skos:definition>Any applicant who submits any one of the institutionally required financial aid applications/forms, such as the Free Application for Federal Student Aid (FAFSA).</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000292">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000292</dc:identifier>
		<rdfs:label>Has Title IV Participant and Recipient</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200344" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000292" />
		<skos:notation>hasTitleIVParticipantAndRecipient</skos:notation>
		<dc:description>A person who receives Title IV aid.  Title IV aid includes grant aid, work study aid, and loan aid such as: Federal Pell Grant, Federal Supplemental Educational Opportunity Grant (FSEOG), Teacher Education Assistance for College and Higher Education (TEACH) Grant, Federal Work-Study, Federal Perkins Loan, Subsidized Direct or FFEL Stafford Loan, and Unsubsidized Direct or FFEL Stafford Loan.  Title IV aid specifications are defined by the instructions for the IPEDS Student Financial Aid survey.</dc:description>
		<skos:definition>A person who receives Title IV aid. Title IV aid includes grant aid, work study aid, and loan aid such as: Federal Pell Grant, Federal Supplemental Educational Opportunity Grant (FSEOG), Teacher Education Assistance for College and Higher Education (TEACH) Grant, Federal Work-Study, Federal Perkins Loan, Subsidized Direct or FFEL Stafford Loan, and Unsubsidized Direct or FFEL Stafford Loan. Title IV aid specifications are defined by the instructions for the IPEDS Student Financial Aid survey.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000077">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000077</dc:identifier>
		<rdfs:label>Has Degree Applicability</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200346" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000077" />
		<skos:notation>hasDegreeApplicability</skos:notation>
		<dc:description>An indication that the course is a part of a degree program.</dc:description>
		<skos:definition>An indication that the course is a part of a degree program.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600277">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600277</dc:identifier>
		<rdfs:label>Has Postsecondary Student Course Section Mark</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200346" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200340" />
		<skos:notation>hasPostsecondaryStudentCourseSectionMark</skos:notation>
		<dc:description>References marks in a gradebook for a student's participation in a postescondary course.</dc:description>
		<skos:definition>References marks in a gradebook for a student's participation in a postescondary course.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000571">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000571</dc:identifier>
		<rdfs:label>Has Pre and Post Test Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200210" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200213" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000571" />
		<skos:notation>hasPreAndPostTestIndicator</skos:notation>
		<dc:description>An indication of whether students took both a pre-test and a post-test to measure academic improvement.</dc:description>
		<skos:definition>An indication of whether students took both a pre-test and a post-test to measure academic improvement.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000729">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000729</dc:identifier>
		<rdfs:label>Has Predominant Calendar System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200110" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200329" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000729" />
		<skos:notation>hasPredominantCalendarSystem</skos:notation>
		<dc:description>The method by which an institution structures most of its courses for the academic year.</dc:description>
		<rdfs:comment>Definition and code set in IPEDS</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The method by which an institution structures most of its courses for the academic year.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000490">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000490</dc:identifier>
		<rdfs:label>Has Prekindergarten Daily Length</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200198" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000490" />
		<skos:notation>hasPrekindergartenDailyLength</skos:notation>
		<dc:description>The portion of a day that a pre-kindergarten program is provided to the students it serves.</dc:description>
		<skos:definition>The portion of a day that a pre-kindergarten program is provided to the students it serves.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000216">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000216</dc:identifier>
		<rdfs:label>Has Prekindergarten Eligibility</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200192" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000216" />
		<skos:notation>hasPrekindergartenEligibility</skos:notation>
		<dc:description>The groups of students for whom pre-kindergarten programs are available.</dc:description>
		<skos:definition>The groups of students for whom pre-kindergarten programs are available.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000217">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000217</dc:identifier>
		<rdfs:label>Has Prekindergarten Eligible Ages for Non-IDEA Students</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200193" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000217" />
		<skos:notation>hasPrekindergartenEligibleAgesForNonIDEAStudents</skos:notation>
		<dc:description>The ages of children not served under IDEA to whom the LEA's pre-kindergarten services are available.  </dc:description>
		<skos:definition>The ages of children not served under IDEA to whom the LEA's pre-kindergarten services are available.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000600">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000600</dc:identifier>
		<rdfs:label>Has Present Attendance Category</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200351" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000600" />
		<skos:notation>hasPresentAttendanceCategory</skos:notation>
		<dc:description>The category that describes how the student spends his or her time when attending an instructional program approved by the state and/or school.</dc:description>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set definitions based on Forum document.</changeDescription> 	
				<changeVersion>7.1</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The category that describes how the student spends his or her time when attending an instructional program approved by the state and/or school.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000218">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000218</dc:identifier>
		<rdfs:label>Has Primary Disability Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200285" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000218" />
		<skos:notation>hasPrimaryDisabilityType</skos:notation>
		<dc:description>The major or overriding disability condition that best describes a person's impairment.</dc:description>
		<rdfs:comment>Option set based on EDFacts. Only one disability condition would be selected. Refer to IDEA Disability Type for selecting multiple disability category options and any additional IDEA disability categories.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Definition and code set have been updated.</changeDescription> 	
				<changeVersion>2</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: IEP workgroup</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The major or overriding disability condition that best describes a person's impairment.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001932">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001932</dc:identifier>
