		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200264" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001991" />
		<skos:notation>hasProjectBasedLearningIndicator</skos:notation>
		<dc:description>An indication that an instructional model is being implemented wherein a student learns through answering complex questions or solving for real-world problems. Also called problem-based learning, inquiry-based learning, or learning-by-doing.</dc:description>
		<textFormat>Option Set</textFormat>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new element to DES.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>An indication that an instructional model is being implemented wherein a student learns through answering complex questions or solving for real-world problems. Also called problem-based learning, inquiry-based learning, or learning-by-doing.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001905">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001905</dc:identifier>
		<rdfs:label>Has Organization Relationship Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200265" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001905" />
		<skos:notation>hasOrganizationRelationshipType</skos:notation>
		<dc:description>The nature of one organization's relationship to another.</dc:description>
		<rdfs:comment>Related Body would be used for a use case in which no hierarchy exists, such as a foundation related to a postsecondary institution. Neither organization has authority over the other, but is related to one another.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Add new option to existing option set. Added Usage Note.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated option set to support EDFacts.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>The nature of one organization's relationship to another.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P600523">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P600523</dc:identifier>
		<rdfs:label>Has Organization Salary Schedule Criteria Value</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200268" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200267" />
		<skos:notation>hasOrganizationSalaryScheduleCriteriaValue</skos:notation>
		<dc:description>References the possible values associated with the criteria.</dc:description>
		<skos:definition>References the possible values associated with the criteria.</skos:definition>
		<editHistory rdf:parseType="Collection">
			<editHistoryEntry>
				<changeDescription>Created definition to match the class definition it references.</changeDescription>
				<changeVersion>14.0.0.0</changeVersion>
				<issueLink>https://github.com/CEDStandards/CEDS-Ontology/issues/110</issueLink>
				<changeUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</changeUpdated>
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000273">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000273</dc:identifier>
		<rdfs:label>Has Student Support Service Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200270" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200157" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200358" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C000273" />
		<skos:notation>hasStudentSupportServiceType</skos:notation>
		<dc:description>Type of related or ancillary services offered or provided to a person or a group of persons within the formal educational system or by an outside agency which provides non-instructional services to support the general welfare of students. This includes physical and emotional health, the ability to select an appropriate course of study, admission to appropriate educational programs, and the ability to adjust to and remain in school through the completion of programs. In serving a student with an identified disability, related services include developmental, corrective, or supportive services required to ensure that the person benefits from special education.</dc:description>
		<rdfs:comment>At the organization level, this element indicates the services offered to students. At the person level, this element indicates the services received by students.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added new options to the existing option set</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add new option to option set, add new DES location</changeDescription> 	
				<changeVersion>12</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Updated definition to reflect that services can both be offered by an organization and provided to a person.</changeDescription> 	
				<changeVersion>9</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Type of related or ancillary services offered or provided to a person or a group of persons within the formal educational system or by an outside agency which provides non-instructional services to support the general welfare of students. This includes physical and emotional health, the ability to select an appropriate course of study, admission to appropriate educational programs, and the ability to adjust to and remain in school through the completion of programs. In serving a student with an identified disability, related services include developmental, corrective, or supportive services required to ensure that the person benefits from special education.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001493">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001493</dc:identifier>
		<rdfs:label>Has Technical Assistance Approved Indicator</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200271" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200370" />
		<schema:rangeIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C001493" />
		<skos:notation>hasTechnicalAssistanceApprovedIndicator</skos:notation>
		<dc:description>Indicates whether or not the technical assistance was approved.</dc:description>
		<rdfs:comment>Technical assistance may be for organizations or staff depending on context. See the document &lt;a href="https://ceds.ed.gov/pdf/ceds-addresses-professional-development-data-elements.pdf"&gt;https://ceds.ed.gov/pdf/ceds-addresses-professional-development-data-elements.pdf&lt;/a&gt;.</rdfs:comment>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Add usage note to make it clear that "technical assistance" may have to do with assistance to organizations or individuals including professional development.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
		<skos:definition>Indicates whether or not the technical assistance was approved.</skos:definition>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000634">
		<dc:creator>Common Education Data Standards</dc:creator>
