	<rdfs:Class rdf:about="https://w3id.org/CEDStandards/terms/C200410">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">C200410</dc:identifier>
		<rdfs:label>Data Collection</rdfs:label>
		<skos:notation>DataCollection</skos:notation>
		<dc:description>Data collections track the details of data submissions as part of an organized, time-bound collection event, typically governed by specific deadlines and requirements, to ensure accurate and timely data reporting in a structured system.</dc:description>
		<skos:definition>Data collections track the details of data submissions as part of an organized, time-bound collection event, typically governed by specific deadlines and requirements, to ensure accurate and timely data reporting in a structured system.</skos:definition>
