		<skos:notation>hasTeacherEducationCredentialExamScoreType</skos:notation>
		<dc:description>An indication of the type of credential exam associated with a given exam score.</dc:description>
		<rdfs:comment>Praxis I: &lt;BR/&gt;Reading&lt;BR/&gt;Mathematics&lt;BR/&gt;Writing&lt;BR/&gt;&lt;BR/&gt;Praxis II:&lt;BR/&gt;Codes at http://www.ets.org/praxis/about/praxisii/content&lt;BR/&gt;&lt;BR/&gt;ACTFL codes at http://www.languagetesting.com/</rdfs:comment>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An indication of the type of credential exam associated with a given exam score.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Added elements to DES contexts to support Early Learning needs.</changeDescription> 	
				<changeVersion>11</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000773">
		<dc:creator>Common Education Data Standards</dc:creator>
