	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000901">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000901</dc:identifier>
		<rdfs:label>Credential Evidence Statement</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200081" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialEvidenceStatement</skos:notation>
		<dc:description>A statement or reference describing the evidence that the learner met the criteria for attainment of the qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<rdfs:comment>A narrative that may connect multiple pieces of evidence OR an IRI or document describing the work that the recipient did to earn the achievement. This can be a page that links out to other pages if linking directly to the work is infeasible. May be used in an array of multiple values.</rdfs:comment>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A statement or reference describing the evidence that the learner met the criteria for attainment of the qualification, achievement, personal or organizational quality, or aspect of an identity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Consider adding Evidence Class (new CEDS Entity) and elements. This would still be aligned with OpenBadges:Achievement:narrative, change source: Badges 2.0 spec</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000893">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000893</dc:identifier>
		<rdfs:label>Credential Definition Title</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionTitle</skos:notation>
		<dc:description>The title assigned to a qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The title assigned to a qualification, achievement, personal or organizational quality, or aspect of an identity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000894">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000894</dc:identifier>
		<rdfs:label>Credential Image URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialImageURL</skos:notation>
		<dc:description>The Uniform Resource Locator (URL) for the unique address of an image representing an award or badge associated with the qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<rdfs:comment>Typical use is for online display of a badge image.</rdfs:comment>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The Uniform Resource Locator (URL) for the unique address of an image representing an award or badge associated with the qualification, achievement, personal or organizational quality, or aspect of an identity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>change source: CTDL</changeDescription> 	
				<changeVersion>7</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000895">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000895</dc:identifier>
		<rdfs:label>Credential Definition Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionDescription</skos:notation>
		<dc:description>A description of the qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A description of the qualification, achievement, personal or organizational quality, or aspect of an identity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001736">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001736</dc:identifier>
		<rdfs:label>Credential Definition Alternate Name</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionAlternateName</skos:notation>
		<dc:description>An alias for the credential, which may include acronyms, alpha-numeric notations, and other forms of name abbreviations in common use such as PhD, MA, and BA.</dc:description>
		<maxLength>300</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>An alias for the credential, which may include acronyms, alpha-numeric notations, and other forms of name abbreviations in common use such as PhD, MA, and BA.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001743">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001743</dc:identifier>
		<rdfs:label>Credential Definition Jurisdiction Region</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionJurisdictionRegion</skos:notation>
		<dc:description>The geo-political region in which the credential is applicable.</dc:description>
		<rdfs:comment>&lt;a href="http://geojson.org/geojson-spec.html#polygon"&gt;http://geojson.org/geojson-spec.html#polygon&lt;/a&gt;</rdfs:comment>
		<textFormat>GeoJSON</textFormat>
		<skos:definition>The geo-political region in which the credential is applicable.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001744">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001744</dc:identifier>
		<rdfs:label>Credential Definition Jurisdiction Region Exception</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionJurisdictionRegionException</skos:notation>
		<dc:description>A geo-political region in which the credential does not apply.</dc:description>
		<rdfs:comment>&lt;a href="http://geojson.org/geojson-spec.html#polygon"&gt;http://geojson.org/geojson-spec.html#polygon&lt;/a&gt;</rdfs:comment>
		<textFormat>GeoJSON</textFormat>
		<skos:definition>A geo-political region in which the credential does not apply.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001745">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001745</dc:identifier>
		<rdfs:label>Credential Definition Keywords</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionKeywords</skos:notation>
		<dc:description>Keywords or key phrases describing aspects of a credential considered useful for its discovery.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Keywords or key phrases describing aspects of a credential considered useful for its discovery.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001752">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001752</dc:identifier>
		<rdfs:label>Credential Definition Validation Method Description</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionValidationMethodDescription</skos:notation>
		<dc:description>Description of the methods used to evaluate the validity and reliability of a credential earned by a person.</dc:description>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>Description of the methods used to evaluate the validity and reliability of a credential earned by a person.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001754">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001754</dc:identifier>
		<rdfs:label>Credential Definition Version</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
		<skos:notation>CredentialDefinitionVersion</skos:notation>
		<dc:description>An alphanumeric identifier of a version of the credential being described that is unique within the organizational context.</dc:description>
		<textFormat>Numeric</textFormat>
		<skos:definition>An alphanumeric identifier of a version of the credential being described that is unique within the organizational context.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001910">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001910</dc:identifier>
		<rdfs:label>Credential Definition Date Effective</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200087" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
		<skos:notation>CredentialDefinitionDateEffective</skos:notation>
		<dc:description>Effective date of the content of a credential definition.</dc:description>
		<rdfs:comment>This is the date the content/definition of the credential became effective, not necessarily the date that one or more credentialing organizations began offering the credential.</rdfs:comment>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>Effective date of the content of a credential definition.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>New element to reflect the date on which a Credential Definition became effective. Based on CE term ceterms:dateEffective. Note: This is the date the content/definition of the credential became effective, not necessarily the date that one or more credentialing organizations began offering the credential.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000892">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000892</dc:identifier>
		<rdfs:label>Credential Definition Category Type</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200084" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionCategoryType</skos:notation>
		<dc:description>A category for defining the qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<rdfs:comment>Categories could include "Competency Mastered", "Competency Retained", "Course Completed", "Level Completed", "Certificate Earned", "Diploma Earned", "License Earned", "License Endorsement Earned", "Participation", "Academic Honor", "Non-Academic Honor", etc. (This element supports an emerging use case, therefore a complete set of options are not known.  Future CEDS versions may define an Achievement Type element when a fixed option set can be compiled.)  Note: The Achievement entity is most valuable when linked to a specific competency set that defined the learning standards related to the achievement.(SEE "Achievement Category System")</rdfs:comment>
		<maxLength>60</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>A category for defining the qualification, achievement, personal or organizational quality, or aspect of an identity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.&#13;
&#13;
The new wording of the element definition makes it clearer that this entity is a credential definition, not a credential assertion.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001245">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001245</dc:identifier>
		<rdfs:label>Credential Definition Category System</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200084" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionCategorySystem</skos:notation>
		<dc:description>The system that defines the categories of the qualification, achievement, personal or organizational quality, or aspect of an identity used in Credential Category Type.</dc:description>
		<rdfs:comment>This element recognizes formal adoption of categories for the Achievement Category Type to aid in comparability of data when a formally adopted vocabulary is used.</rdfs:comment>
		<maxLength>30</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The system that defines the categories of the qualification, achievement, personal or organizational quality, or aspect of an identity used in Credential Category Type.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.&#13;
&#13;
The new wording of the element definition makes it clearer that this entity is a credential definition, not a credential assertion.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001153">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001153</dc:identifier>
		<rdfs:label>Credential Definition Criteria URL</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200085" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionCriteriaURL</skos:notation>
		<dc:description>The Uniform Resource Locator (URL) for the unique address of a web page describing the competency-based completion criteria for the qualification, achievement, personal or organizational quality, or aspect of an identity.</dc:description>
		<maxLength>512</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The Uniform Resource Locator (URL) for the unique address of a web page describing the competency-based completion criteria for the qualification, achievement, personal or organizational quality, or aspect of an identity.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Adjusted credential elements, definitions, and DES context to apply to an organization in addition to a person.</changeDescription> 	
				<changeVersion>10</changeVersion> 
			</editHistoryEntry> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001741">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001741</dc:identifier>
		<rdfs:label>Credential Definition Estimated Duration</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200085" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionEstimatedDuration</skos:notation>
		<dc:description>The estimated amount of time in minutes it will take to earn the credential.</dc:description>
		<textFormat>HH:MM</textFormat>
		<skos:definition>The estimated amount of time in minutes it will take to earn the credential.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
			<editHistoryEntry> 	
				<changeDescription>Entity name changed from "Credential" to "Credential Definition" to support alignment across standards and reduce confusion by those who might think this is a "credential assertion" awarded to a person rather than what it is, i.e. a definition of a credential that could be awarded to any person.</changeDescription> 	
				<changeVersion>8</changeVersion> 
			</editHistoryEntry>
		</editHistory>
	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P001746">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P001746</dc:identifier>
		<rdfs:label>Credential Definition Maximum Duration</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200085" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>CredentialDefinitionMaximumDuration</skos:notation>
		<dc:description>The maximum amount of time in minutes it will take to earn the described credential.</dc:description>
		<textFormat>HH:MM</textFormat>
		<skos:definition>The maximum amount of time in minutes it will take to earn the described credential.</skos:definition>
		<editHistory rdf:parseType="Collection"> 
