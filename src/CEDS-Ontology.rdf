	</rdf:Property>
	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P002120">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P002120</dc:identifier>
		<rdfs:label>Eligibility Determination Date</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200399" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
		<skos:notation>EligibilityDeterminationDate</skos:notation>
		<dc:description>Upon completion of the administration of assessments and other evaluation measures, the date that a group of qualified professionals and the parent of the child determine whether the child is a child with a disability.</dc:description>
		<textFormat>YYYY-MM-DD</textFormat>
		<skos:definition>Upon completion of the administration of assessments and other evaluation measures, the date that a group of qualified professionals and the parent of the child determine whether the child is a child with a disability.</skos:definition>
