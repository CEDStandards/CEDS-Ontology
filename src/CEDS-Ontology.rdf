		<rdfs:label>Hispanic or Latino</rdfs:label>
		<skos:definition>Includes individuals of Mexican, Puerto Rican, Salvadoran, Cuban, Dominican, Guatemalan, and other Central or South American or Spanish culture or origin.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001943" />
		<skos:notation>HispanicOrLatino</skos:notation>
