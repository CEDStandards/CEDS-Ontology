	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001943162284">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>An indication that the person traces his or her origin or descent to Mexico, Puerto Rico, Cuba, Central and South America, and other Spanish cultures, regardless of race.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001943162284</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001943" />
