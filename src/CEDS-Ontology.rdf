	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI001517163007">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>Miscellaneous�Aide courses offer students the opportunity to assist instructors in preparing, organizing, or delivering course curricula or to assist other staff members in fulfilling their duties. Students may provide tutorial or instructional assistance to other students. Note: if the particular subject area is known, use the code associated with the Aide course within that subject area.</dc:description>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">NI001517163007</dc:identifier>
		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Miscellaneous�Aide</rdfs:label>
		<skos:definition>Miscellaneous�Aide courses offer students the opportunity to assist instructors in preparing, organizing, or delivering course curricula or to assist other staff members in fulfilling their duties. Students may provide tutorial or instructional assistance to other students. Note: if the particular subject area is known, use the code associated with the Aide course within that subject area.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C001517" />
		<skos:notation>22995</skos:notation>
