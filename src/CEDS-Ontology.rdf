	<rdf:Property rdf:about="https://w3id.org/CEDStandards/terms/P000088">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#token">P000088</dc:identifier>
		<rdfs:label>Electronic Mail Address</rdfs:label>
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200247" />
		<schema:domainIncludes rdf:resource="https://w3id.org/CEDStandards/terms/C200286" />
		<schema:rangeIncludes rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
		<skos:notation>ElectronicMailAddress</skos:notation>
		<dc:description>The numbers, letters, and symbols used to identify an electronic mail (e-mail) user within the network to which the person or organization belongs.</dc:description>
		<minLength>7</minLength>
		<maxLength>128</maxLength>
		<textFormat>Alphanumeric</textFormat>
		<skos:definition>The numbers, letters, and symbols used to identify an electronic mail (e-mail) user within the network to which the person or organization belongs.</skos:definition>
